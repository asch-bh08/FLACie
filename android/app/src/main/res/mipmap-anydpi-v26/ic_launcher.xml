<!-- The FLACie 1.0 icon: the whole picture (mipmap ic_launcher_art, logo/flacie.png set a little smaller on its own dark ground so the launcher's mask keeps all of it) as the background, nothing in front. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
