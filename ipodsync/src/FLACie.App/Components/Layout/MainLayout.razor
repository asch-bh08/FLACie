@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime Js
@* the Explore pages keep the side menu like every other page (owner, overhaul 9 Nov: one frame everywhere); the ☰ folds it to icons there too *@
<div class="app @(collapsed ? "collapsed" : "")">
    <TopBar Full="false" MenuOpen="false" OnMenu="Burger" />
    <nav class="rail" aria-label="Main" id="main-rail">
        @* design I: a short menu. Search holds what Explore was (browse when nothing is typed), Import is on Playlists, Downloads is in the Dashboard (administrators) *@
        @* on a phone the bottom bar is these four, wide and worded; the groups below go into the account menu (owner, overhaul 9 Nov: fewer icons, with words) *@
        <div class="rail-group rail-main">
            <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="home" />Home</NavLink>
            <a href="/search" class="@(InSearch ? "active" : "")"><Icon Name="search" />Search</a>
            <NavLink href="/favorites"><Icon Name="heart" />Favourites</NavLink>
            <NavLink href="/playlists" Match="NavLinkMatch.All"><Icon Name="playlists" />Playlists</NavLink>
        </div>
        @* Connect and Jams need the server; the phone app leaves them out *@
        @if (AppHost.Server)
        {
        <div class="rail-group rail-extra">
            <p class="rail-label">Together</p>
            <NavLink href="/devices"><Icon Name="devices" />Devices</NavLink>
            <NavLink href="/jam"><Icon Name="jam" />Jam</NavLink>
        </div>
        }
        <div class="rail-group rail-extra">
            <p class="rail-label">More</p>
            @* Settings on every page (owner, 12 Nov), not only behind the account picture *@
            <NavLink href="/settings"><Icon Name="settings" />Settings</NavLink>
            <NavLink href="/headphones"><Icon Name="headphones" />Headphone test</NavLink>
            @if (AppHost.Server) { <AdminLink /> }
        </div>
    </nav>
    <main class="content">@Body</main>
    <RemoteNowPlaying />
    <DjBar />
    <PlayerBar />
    <ToastHost />
</div>
@code {
    // "All music" is lit for its four filters and their detail pages
    bool InMusic { get { var p = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0]; return new[] { "/explore", "/songs", "/albums", "/artists", "/genres", "/charts", "/album/", "/artist/", "/genre/" }.Any(x => p.StartsWith(x, StringComparison.OrdinalIgnoreCase)); } }
    // Search is lit on the search page and everywhere you browse the music from it
    bool InSearch => InMusic || ("/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0]).StartsWith("/search", StringComparison.OrdinalIgnoreCase);
    // on a PC the ☰ folds the side menu down to its icons (and back), on every page; the choice is kept in this browser
    bool collapsed;
    async Task Burger()
    {
        collapsed = !collapsed;
        try { await Js.InvokeVoidAsync("flacie.stash", "flacie.rail", collapsed ? "1" : "0"); } catch (Exception) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { if (await Js.InvokeAsync<string?>("flacie.unstash", "flacie.rail") == "1") { collapsed = true; StateHasChanged(); } } catch (Exception) { }
    }
    protected override void OnInitialized() => Nav.LocationChanged += Moved;
    void Moved(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose() => Nav.LocationChanged -= Moved;
}
