@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject PageFrame Frame
@* the Explore pages keep the side menu like every other page (owner, overhaul 9 Nov: one frame everywhere); the ☰ folds it to icons there too *@
@* ONE APP 1k: the one frame. The page says its type (Frame.razor); a Full screen page has none of the bars *@
<div class="app @(collapsed ? "collapsed" : "") frame-@(Frame.Type.ToString().ToLowerInvariant())">
    <TopBar Full="false" MenuOpen="false" OnMenu="Burger" />
    <nav class="rail" aria-label="Main" id="main-rail">
        @* design I: a short menu. Search holds what Explore was (browse when nothing is typed), Import is on Playlists, Downloads is in the Dashboard (administrators) *@
        @* on a phone the bottom bar is these four, wide and worded; the groups below go into the account menu (owner, overhaul 9 Nov: fewer icons, with words) *@
        @* ONE APP part 10: the same five places as the phone's tabs, first on a PC and the whole bottom bar on a phone-width window: Home, Search,
           Library (Favourites and Playlists are in it), Devices (server only) and Settings; the extras follow on a PC *@
        <div class="rail-group rail-main">
            @* the lit tab is the frame's (PageFrame.TabFor): a page under a tab keeps it lit (Songs and an album: Library; Jam: Devices; Account: Settings) *@
            <a href="/" class="@On("Home")"><Icon Name="home" />Home</a>
            <a href="/search" class="@On("Search")"><Icon Name="search" />Search</a>
            <a href="/library" class="@On("Library")"><Icon Name="playlists" />Library</a>
            @if (AppHost.Server) { <a href="/devices" class="rail-tab @On("Devices")"><Icon Name="devices" />Devices</a> }
            <a href="/settings" class="@On("Settings")"><Icon Name="settings" />Settings</a>
        </div>
        <div class="rail-group rail-extra">
            <p class="rail-label">More</p>
            @* Connect and Jams need the server; the phone app leaves them out *@
            @if (AppHost.Server) { <NavLink href="/jam"><Icon Name="jam" />Jam</NavLink> }
            <NavLink href="/car"><Icon Name="car" />Car mode</NavLink>
            <NavLink href="/headphones"><Icon Name="headphones" />Headphone test</NavLink>
            @if (AppHost.Server) { <AdminLink /> }
        </div>
    </nav>
    <main class="content">@Body</main>
    <RemoteNowPlaying />
    <DjBar />
    <PlayerBar />
    <ToastHost />
</div>
@code {
    string On(string tab) => PageFrame.TabFor("/" + Nav.ToBaseRelativePath(Nav.Uri)) == tab ? "active" : "";
    // on a PC the ☰ folds the side menu down to its icons (and back), on every page; the choice is kept in this browser
    bool collapsed;
    async Task Burger()
    {
        collapsed = !collapsed;
        try { await Js.InvokeVoidAsync("flacie.stash", "flacie.rail", collapsed ? "1" : "0"); } catch (Exception) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { if (await Js.InvokeAsync<string?>("flacie.unstash", "flacie.rail") == "1") { collapsed = true; StateHasChanged(); } } catch (Exception) { }
    }
    protected override void OnInitialized() { Nav.LocationChanged += Moved; Frame.Changed += Redraw; retroGate = Nav.RegisterLocationChangingHandler(LoadRetro); }
    // the Retro / iPod theme's styles and scripts are only on /retro and /ipod (App.razor, about 30% of a page's bytes): a move there from the app
    // fetches them first, in their old places in the page, and only then goes on, so the theme has them and the music keeps playing (no reload)
    IDisposable? retroGate;
    async ValueTask LoadRetro(Microsoft.AspNetCore.Components.Routing.LocationChangingContext ctx)
    {
        // never blocks a move: an exception here would cancel the navigation (a relative target such as NavigateTo("/") once did)
        try
        {
            var path = Nav.ToAbsoluteUri(ctx.TargetLocation).AbsolutePath;
            if (!path.StartsWith("/retro", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/ipod", StringComparison.OrdinalIgnoreCase)) return;
            await Js.InvokeVoidAsync("flacieLoadRetro",
                new[] { Assets["ipod.css"], Assets["ipod-touch.css"], Assets["desk.css"], Assets["retro.css"], Assets["design-j-retro.css"] },
                new[] { Assets["desk.js"], Assets["retro.js"] });
        }
        catch (Exception) { }
    }
    // every page declares its frame (Frame.razor; the page walk 1w-frame checks it), so a move needs no reset: the new page's declaration wins
    void Moved(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    void Redraw() => InvokeAsync(StateHasChanged);
    public void Dispose() { Nav.LocationChanged -= Moved; Frame.Changed -= Redraw; retroGate?.Dispose(); }
}
