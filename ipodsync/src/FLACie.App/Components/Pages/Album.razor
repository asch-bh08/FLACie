@page "/album/{Key}"
@attribute [Authorize]
@inherits UserComponent
@inject IDownloads Downloads
@{ var g = Lib.Albums.FirstOrDefault(a => string.Equals(a.Tracks[0].AlbumKey, Uri.UnescapeDataString(Key), StringComparison.OrdinalIgnoreCase)); }
@if (g is null)
{
    @if (Session.Loading) { <Skeleton Label="Loading…" /> } else { <div class="empty-state"><p class="status">This album isn't in your library.</p><a class="btn" href="/albums">All albums</a></div> }
}
else
{
    var head = g.Tracks[0];
    // the whole tracklist (owner, 13 Nov: Random Access Memories showed 3 of 13): the catalog's songs in order, the missing ones greyed in their place
    var (rows, waiting) = AlbumRows.Build(listed ?? [], g.Tracks, (a, t) => Downloads.JobFor(Session, a, t));
    var missing = waiting.Count(w => !w.Failed && w.Status == "Not downloaded yet");
    <PageTitle>@g.Name · FLACie</PageTitle>
<header class="detail-head" @ref="headEl">
        <Cover ArtKey="@(g.ArtKey)" Class="detail-cover" />
        <div class="detail-text">
            <p class="eyebrow">Album</p>
            <h1>@Title(g.Name)</h1>
            <p class="detail-artist"><a href="/artist/@Uri.EscapeDataString(head.AlbumArtist)">@head.AlbumArtist</a></p>
            <p class="detail-facts">@Facts(g.Tracks, head.Year, rows.Count + waiting.Count)</p>
            <div class="detail-actions">
                <button class="detail-play" @onclick="() => Player.PlayInOrder(g.Tracks, g.Name)"><Icon Name="play" Size="22" />Play</button>
                <button class="detail-shuffle" @onclick="() => Player.ShuffleAll(g.Tracks, g.Name)"><Icon Name="shuffle" Size="18" />Shuffle</button>
                <ShareButton Title="@g.Name" Songs="g.Tracks" />
                @if (missing > 0 && Downloads.Ready(Session))
                {
                    <button class="detail-shuffle" @onclick="() => FetchAll(waiting)" data-testid="fetch-all"><Icon Name="download" Size="18" />Fetch all @missing</button>
                }
            </div>
        </div>
    </header>
    <TrackList Tracks="rows" Waiting="waiting" OnFetch="@(Downloads.Ready(Session) ? Fetch : null)" PlayContext="@g.Name" Numbered="true" ShowAlbum="false" />
}
@code {
    [Parameter] public string Key { get; set; } = "";
    [Inject] WebCatalog Catalog { get; set; } = default!;

    // the album's tracklist from the catalog (Deezer), asked once per album while the server runs; null until it answers, empty when it has none
    static readonly System.Collections.Concurrent.ConcurrentDictionary<string, List<CatalogSong>> tracklists = new();
    List<CatalogSong>? listed; string? listedFor;
    protected override async Task OnParametersSetAsync()
    {
        var key = Uri.UnescapeDataString(Key);
        if (listedFor == key) return;
        listedFor = key; listed = null;
        var g = Lib.Albums.FirstOrDefault(a => string.Equals(a.Tracks[0].AlbumKey, key, StringComparison.OrdinalIgnoreCase));
        if (g is null) return;
        if (!tracklists.TryGetValue(key, out var songs))
        {
            songs = [];
            try
            {
                var artist = g.Tracks[0].AlbumArtist.Length > 0 ? g.Tracks[0].AlbumArtist : g.Tracks[0].Artist;
                var name = Matching.NormTitle(WebCatalog.BaseTitle(g.Name));
                var hit = (await Catalog.AlbumsAsync(artist + " " + g.Name, 10))
                    .Where(a => Matching.NormTitle(WebCatalog.BaseTitle(a.CleanTitle)) == name && Matching.PrimaryArtist(a.Artist) == Matching.PrimaryArtist(artist))
                    .OrderByDescending(a => a.TrackCount).FirstOrDefault();
                if (hit is not null) songs = await Catalog.TracksAsync(hit);
            }
            catch (Exception e) when (e is not OperationCanceledException) { }
            if (tracklists.Count > 2000) tracklists.Clear();
            tracklists[key] = songs;
        }
        listed = songs;
        // opening an album that is missing songs fetches them, as a playlist someone looked at does (owner, 13 Nov: "we should have auto fetched this album")
        if (Downloads.Ready(Session) && fetchedFor != key)
        {
            fetchedFor = key;
            var (_, wait) = AlbumRows.Build(songs, g.Tracks, (a, t) => Downloads.JobFor(Session, a, t));
            foreach (var w in wait.Where(w => !w.Failed && w.Status == "Not downloaded yet").Take(AutoFetchMax)) Fetch(w, quiet: true);
        }
    }
    string? fetchedFor;
    /// <summary>How many of an album's missing songs opening it asks for at once (the rest with Fetch all, or when it is opened again).</summary>
    const int AutoFetchMax = 20;
    void Fetch(WaitingSong w) => Fetch(w, quiet: false);
    void Fetch(WaitingSong w, bool quiet)
    {
        Downloads.Song(Session, new CatalogSong(w.Artist, w.Title, Lib.Albums.FirstOrDefault(a => string.Equals(a.Tracks[0].AlbumKey, Uri.UnescapeDataString(Key), StringComparison.OrdinalIgnoreCase))?.Name ?? "", null, 0, 0, 0), kind: quiet ? "Playlist" : "Search");
        if (!quiet) StateHasChanged();
    }
    void FetchAll(IEnumerable<WaitingSong> waiting) { foreach (var w in waiting.Where(w => !w.Failed && w.Status == "Not downloaded yet")) Fetch(w, quiet: true); StateHasChanged(); }

    [Inject] IJSRuntime Js { get; set; } = default!;
    ElementReference headEl; string? headFor = "";
    // the hero takes the colours of the cover, once per cover, the way Home and the player do
    async Task Tint(string? artKey)
    {
        var art = artKey is not null ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(artKey) ?? artKey) : null;
        if (art == headFor) return;
        headFor = art;
        try { await Js.InvokeVoidAsync("flacie.npAccent", headEl, art); } catch (Exception) { }
    }
    // the last word of a title goes in italics, as on the player and Home
    static MarkupString Title(string s)
    {
        var e = System.Net.WebUtility.HtmlEncode(s.Trim()); var i = e.LastIndexOf(' ');
        return new MarkupString(i < 0 ? $"<i>{e}</i>" : $"{e[..(i + 1)]}<i>{e[(i + 1)..]}</i>");
    }
    static string Length(IEnumerable<Track> ts)
    {
        var min = (int)Math.Round(ts.Sum(t => t.DurationMs) / 60000.0);
        return min <= 0 ? "" : min >= 60 ? $"{min / 60} h {min % 60:00} min" : $"{min} min";
    }
    static string Formats(IEnumerable<Track> ts) => string.Join(" / ", ts.Select(QuickFormats.Of).Where(f => f.Length > 0).Distinct().Take(3).Select(f => f == "HI-RES" ? "Hi-Res" : f));

    // "3 of 13 songs" while some of the album isn't here yet
    static string Facts(IReadOnlyList<Track> ts, int year, int whole) => string.Join(" · ", new[] { year > 0 ? year.ToString() : "",
        whole > ts.Count ? $"{ts.Count} of {whole} songs" : $"{ts.Count} {(ts.Count == 1 ? "song" : "songs")}", Length(ts), Formats(ts) }.Where(x => x.Length > 0));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var g = Lib.Albums.FirstOrDefault(a => string.Equals(a.Tracks[0].AlbumKey, Uri.UnescapeDataString(Key), StringComparison.OrdinalIgnoreCase));
        if (g is not null) await Tint(g.ArtKey);
    }
}
