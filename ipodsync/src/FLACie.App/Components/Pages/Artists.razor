@page "/artists"
@attribute [Authorize]
@inherits UserComponent
@inject ExploreState X
<PageTitle>Explore · FLACie</PageTitle>
<header class="page-head"><h1><i>Explore</i></h1><p class="sub">@(X.Filtering ? list.Count + " of " + Lib.Artists.Count : Lib.Artists.Count.ToString()) artists</p></header>
<MusicTabs Active="Artists" />
<ExploreBar Tab="Artists" Changed="Refresh" />
<LibraryStatus />
@if (list.Count == 0 && Lib.Artists.Count > 0) { <div class="empty-state"><p class="status">Nothing matches these filters.<small>Try fewer, or start again with everything.</small></p><button class="btn" @onclick="ClearFilters">Clear filters</button></div> }
<ArtistGrid Artists="list" />
@code {
    List<Group> list = [];
    Library? built; int builtVersion = -1;
    void Build() { if (ReferenceEquals(built, Lib) && builtVersion == X.Version) return; built = Lib; builtVersion = X.Version; list = X.Artists(Lib); }
    void Refresh() { Build(); StateHasChanged(); }
    void ClearFilters() { X.Clear(); Refresh(); }
    protected override void OnParametersSet() => Build();
    // nothing here shows the player: a song starting or pausing does not draw every artist again, only a change of library, filters or a chosen cover
    List<Group>? drawn; int drawnRedraws;
    protected override bool ShouldRender()
    {
        Build();
        if (ReferenceEquals(drawn, list) && drawnRedraws == Player.Redraws) return false;
        drawn = list; drawnRedraws = Player.Redraws;
        return true;
    }
}
