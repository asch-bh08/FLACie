@page "/favorites"
@attribute [Authorize]
@inherits UserComponent
<PageTitle>Favourites · FLACie</PageTitle>
@{ var tracks = Session.Resolve(Session.Favorites); }
@* design I: like a playlist, a hero with the first song's cover in its own colours, a serif title with the last word in italics, mono facts, a big Play and a tinted Shuffle *@
<header class="pl-hero" @ref="heroEl">
    <Cover ArtKey="@(tracks.Select(t => t.ArtKey).FirstOrDefault(k => k is not null))" Class="pl-cover" />
    <div class="pl-hero-text">
        <h1><i>Favourites</i></h1>
        <p class="sub pl-facts">@tracks.Count @(tracks.Count == 1 ? "song" : "songs")@(Length(tracks) is { Length: > 0 } len ? " · " + len : "")</p>
        <div class="chips">
            <button class="btn primary pl-play" @onclick='() => Player.Play(tracks, 0, "Favourites")' disabled="@(tracks.Count == 0)"><Icon Name="play" Size="18" />Play</button>
            <button class="btn pl-shuffle" @onclick='() => Player.ShuffleAll(tracks, "Favourites")' disabled="@(tracks.Count == 0)"><Icon Name="shuffle" Size="18" />Shuffle</button>
        </div>
    </div>
</header>
@if (tracks.Count == 0)
{
    <p class="status">Tap the heart on a song to keep it here.</p>
}
<TrackList Tracks="tracks" PlayContext="Favourites" />
@code {
    ElementReference heroEl; string? heroFor = "";
    [Inject] IJSRuntime Js { get; set; } = default!;
    static string Length(IReadOnlyList<Track> ts) { var m = (int)(ts.Sum(t => t.DurationMs) / 60000); return m <= 0 ? "" : m >= 60 ? $"{m / 60} h {m % 60} min" : $"{m} min"; }
    // the hero takes its colours from the first favourite's cover, once per cover
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session is null) return;
        var k = Session.Resolve(Session.Favorites).Select(t => t.ArtKey).FirstOrDefault(x => x is not null);
        var art = k is not null ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(k)!) : null;
        if (art != heroFor) { heroFor = art; try { await Js.InvokeVoidAsync("flacie.npAccent", heroEl, art); } catch (Exception) { } }
    }
}
