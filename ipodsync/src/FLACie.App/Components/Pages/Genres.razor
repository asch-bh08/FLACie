@page "/genres"
@attribute [Authorize]
@inherits UserComponent
@inject ExploreState X
<PageTitle>Explore · FLACie</PageTitle>
<header class="page-head"><h1><i>Explore</i></h1><p class="sub">@list.Count genres</p></header>
<MusicTabs Active="Genres" />
<ExploreBar Tab="Genres" Changed="Refresh" />
<LibraryStatus />
@if (list.Count == 0 && Lib.Songs.Count > 0) { @if (X.Filtering) { <div class="empty-state"><p class="status">Nothing matches these filters.<small>Try fewer, or start again with everything.</small></p><button class="btn" @onclick="ClearFilters">Clear filters</button></div> }
    else { <div class="empty-state"><p class="status">None of your songs have a genre tag yet.<small>Songs show up here once their files say what genre they are.</small></p><a class="btn" href="/songs">Browse songs</a></div> } }
<div class="grid">
    @foreach (var g in list)
    {
        <a class="card" href="/genre/@Uri.EscapeDataString(g.Name)"><Cover ArtKey="@(g.ArtKey)" Class="square" /><span class="card-title">@g.Name</span><span class="card-sub">@g.Tracks.Count @(g.Tracks.Count == 1 ? "song" : "songs")</span></a>
    }
</div>
@code {
    List<Group> list = [];
    Library? built; int builtVersion = -1;
    void Build() { if (ReferenceEquals(built, Lib) && builtVersion == X.Version) return; built = Lib; builtVersion = X.Version; list = X.Genres(Lib); }
    void Refresh() { Build(); StateHasChanged(); }
    void ClearFilters() { X.Clear(); Refresh(); }
    protected override void OnParametersSet() => Build();
    protected override bool ShouldRender() { Build(); return true; }
}
