@page "/"
@attribute [Authorize]
@inherits UserComponent
@inject JellyfinClient Jf
@inject HitsService Hits
@inject IDownloads Downloads
<PageTitle>FLACie</PageTitle>
@* design I: the cover of what played last runs across the top and fades into the page, in its own colours (flacie.npAccent); a mono greeting over a serif headline *@
@{ var lastTrack = LastPlayed; }
@* a slow glow in the cover's colours behind the whole of Home (owner, 12 Nov: "aliveness, vibeyness") *@
<div class="home-aura" aria-hidden="true"><i></i><i></i><i></i></div>
<header class="home-hero" @ref="heroEl">
    @* the picture behind the greeting (owner, 12 Nov: "instead of the last played album art it should change, faded nicely, through a playlist or
       recommended or frequently played"): up to five covers from what you play most, Quick picks and your playlists, crossfading one into the next *@
    @if (HeroArt is { Count: > 0 } heroArt)
    {
        <div class="home-hero-art @(heroArt.Count > 1 ? "cycle" : "")" aria-hidden="true">
            @* five slides always (fewer covers repeat), so the crossfade keeps one rhythm *@
            @for (var hi = 0; hi < (heroArt.Count > 1 ? 5 : 1); hi++) { <Cover @key="@hi" ArtKey="@heroArt[hi % heroArt.Count]" Full="true" Class="@("hero-slide s" + hi)" /> }
        </div>
    }
    <i class="home-fade" aria-hidden="true"></i>
    <div class="home-hero-row">
        <div class="home-hero-text">
            <p class="home-greet">@Greeting.ToUpperInvariant()@(Name.Length > 0 ? ", " + Name.ToUpperInvariant() : "")</p>
            @* one heading whose words change (when the play history arrives), so it is never swapped for another element *@
            <h1>@(lastTrack is not null && !Player.Playing ? "Pick up " : "Put on ")<i>@(lastTrack is not null && !Player.Playing ? "where you left off" : "something")</i></h1>
        </div>
        <div class="home-hero-actions">
            @* what "pick up where you left off" means: the song paused in the player, else the one played last *@
            @if (lastTrack is not null && !Player.Playing)
            {
                var resume = Player.Current ?? lastTrack;
                <button class="btn primary carry-on" @onclick="() => CarryOn(resume)"><Icon Name="play" Size="18" />Carry on: <span class="carry-title">@resume.Title</span></button>
            }
            @* playing now: the song as a live card (its cover, bars that move, the name), a press opens the full-screen player (owner, 12 Nov: "alive") *@
            @if (Player.Playing && Player.Current is { } now)
            {
                <button class="home-now" data-np @onclick="Player.RequestFullScreen" aria-label="@("Playing now: " + now.Title + " by " + now.Artist + ". Open the player")">
                    <Cover ArtKey="@(now.ArtKey)" Size="56" />
                    <span class="home-now-text"><small><span class="eq on" aria-hidden="true"><i></i><i></i><i></i></span>Playing now</small><b>@now.Title</b><span>@now.Artist</span></span>
                </button>
            }
            <button class="btn @(lastTrack is not null && !Player.Playing ? "" : "primary") shuffle-all" data-np @onclick='() => ShuffleFull(Lib.Songs, "Your library")' disabled="@(Lib.Songs.Count == 0)"><Icon Name="shuffle" Size="18" />Shuffle all</button>
        </div>
    </div>
</header>
<LibraryStatus ShowLoading="@(!Waiting)" />
@if (Session.ProfileLoaded && !Session.Welcomed)
{
    @* the first visit: where things are, in three lines; it goes for good with Got it (kept in the profile, so every device knows) *@
    <section class="welcome" aria-label="Welcome to FLACie">
        <h2>Welcome to <i>FLACie</i></h2>
        <ul>
            <li><b>Home</b> has what you played last and new picks every day.</li>
            <li><b>Search</b> finds anything in your library, and anything you don't have yet, ready to download.</li>
            <li><b>Retro</b> (the cassette button in the player) plays your music on a classic-style music player.</li>
        </ul>
        <p class="sub">Press <kbd>?</kbd> any time for the keyboard shortcuts.</p>
        <button class="btn primary" @onclick="() => { Session.MarkWelcomed(); SaveProfile(); }">Got it</button>
    </section>
}
@if (Waiting) { <Skeleton Label="Loading your music…" Kind="cards" Count="6" /> }
else
{
@* the order (owner, 12 Nov: "push the important stuff to the top"): Quick picks (one press plays), then the moods, then what you play most, then your
   artists and playlists, then the rest *@
@if (mood is null && shelves.FirstOrDefault(x => x.Id == "quick-picks") is { } qp) { @ShelfView(qp) }
@* the moods (owner, 12 Nov: "these huge random relax workout party buttons, why?"): smaller cards in one row that scrolls, each with a fan of covers from
   its own songs, so you can see what is in it; a card again goes back to everything *@
@if (moods.Count > 0)
{
    <section class="shelf mood-shelf" aria-label="Browse by mood">
        <div class="shelf-head"><div><h2>Browse by <i>mood</i></h2></div><span class="shelf-nav"><Arrows /></span></div>
        <div class="row-scroll mood-cards" role="group" aria-label="Moods">
            @for (var mi = 0; mi < moods.Count; mi++)
            {
                var name = moods[mi]; var hue = mi;
                <button class="mood-tile @(mood == name ? "on" : "")" style="--h:@(hue)" aria-pressed="@((mood == name) ? "true" : "false")" @onclick="() => Pick(name)">
                    <span class="mood-name">@name</span>
                    <span class="mood-fan" aria-hidden="true">
                        @foreach (var art in MoodCovers(name)) { <Cover ArtKey="@art" Size="64" /> }
                    </span>
                </button>
            }
        </div>
    </section>
}
@if (mood is not null)
{
    <section class="shelf" aria-label="@mood">
        <div class="shelf-head"><div><h2>@Serif(mood)</h2><small>New picks each day</small></div><button class="chip small" data-np @onclick="() => PlayFull(moodTracks, 0, mood)"><Icon Name="play" Size="16" />Play all</button></div>
        <ul class="pick-grid">
            @for (var i = 0; i < moodTracks.Count; i++)
            {
                var idx = i; var t = moodTracks[i];
                <li @key="t.Path"><button class="pick @(Player.Current?.Path == t.Path ? "now" : "")" data-np data-warm="@Warm(t)" @onclick="() => PlayFull(moodTracks, idx, mood)" aria-label="@("Play " + t.Title + " by " + t.Artist)"><Cover ArtKey="@(t.ArtKey)" Size="48" /><span><b>@if (Player.Current?.Path == t.Path) { <span class="eq @(Player.Playing ? "on" : "")" aria-hidden="true"><i></i><i></i><i></i></span> }@t.Title</b><small>@t.Artist</small><DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" /></span></button></li>
            }
        </ul>
    </section>
}
else
{
    @if (shelves.FirstOrDefault(x => x.Id == "frequently-played") is { } fp) { @ShelfView(fp) }
    @* from Home C (owner, 11 Nov): the artists played most as round faces, and the songs that came in last with what they are *@
    @if (RepeatArtists is { Count: > 0 } reps)
    {
        <section class="shelf" aria-label="Artists on repeat">
            <div class="shelf-head"><div><h2>Artists on <i>repeat</i></h2></div></div>
            <div class="row-scroll artist-bubbles">
                @for (var ri = 0; ri < reps.Count; ri++)
                {
                    var (name, art) = reps[ri];
                    @* the artist playing now has a ring that turns (owner, 12 Nov: "animations visible and alive") *@
                    var on = Player.Current is { } cur && (cur.Artist.Contains(name, StringComparison.OrdinalIgnoreCase) || cur.AlbumArtist.Equals(name, StringComparison.OrdinalIgnoreCase));
                    <a class="artist-bubble @(on ? "playing" : "")" style="--i:@ri" href="/artist/@Uri.EscapeDataString(name)"><Cover ArtKey="@art" Class="round" /><span>@name</span></a>
                }
            </div>
        </section>
    }
    @if (Session.Playlists.Count > 0)
    {
        <section class="shelf" aria-label="Your playlists">
            <div class="shelf-head"><div><h2>Your <i>playlists</i></h2></div><span class="shelf-nav"><a href="/playlists">All</a><Arrows /></span></div>
            <div class="row-scroll">
                @foreach (var p in Session.Playlists.OrderByDescending(p => p.Modified).Take(14))
                {
                    var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
                    <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub">@p.Entries.Count @(p.Entries.Count == 1 ? "song" : "songs")</span></a>
                }
            </div>
        </section>
    }
    @* the rest of the shelves, after the ones Home puts at the top *@
    @foreach (var sh in shelves.Where(x => !TopShelves.Contains(x.Id)))
    {
        @ShelfView(sh)
    }
}
}
@code {
    static readonly HashSet<string> TopShelves = ["quick-picks", "frequently-played"];
    RenderFragment ShelfView(Shelf sh) => @<text>
        <section class="shelf" aria-label="@sh.Title">
    <div class="shelf-head">
        <div><h2>@Serif(sh.Title)</h2>@if (sh.Subtitle.Length > 0) { <small>@sh.Subtitle</small> }</div>
        <span class="shelf-nav">
            @if (sh.Tracks.Count > 0) { <button class="chip small" data-np @onclick="() => PlayFull(sh.Tracks, 0, sh.Title)"><Icon Name="play" Size="16" />Play all</button> }
            @if (sh.Id != "quick-picks") { <Arrows /> }
        </span>
    </div>
    @if (sh.Id == "quick-picks")
    {
        <ul class="pick-grid">
            @for (var i = 0; i < sh.Tracks.Count && i < 12; i++)
            {
                var idx = i; var t = sh.Tracks[i];
                <li @key="t.Path"><button class="pick @(Player.Current?.Path == t.Path ? "now" : "")" data-np data-warm="@Warm(t)" @onclick="() => PlayFull(sh.Tracks, idx, sh.Title)" aria-label="@("Play " + t.Title + " by " + t.Artist)"><Cover ArtKey="@(t.ArtKey)" Size="48" /><span><b>@if (Player.Current?.Path == t.Path) { <span class="eq @(Player.Playing ? "on" : "")" aria-hidden="true"><i></i><i></i><i></i></span> }@t.Title</b><small>@t.Artist</small><DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" /></span></button></li>
            }
        </ul>
    }
    else if (sh.Tracks.Count > 0 || sh.New.Count > 0)
    {
        <div class="row-scroll">
            @for (var i = 0; i < sh.Tracks.Count; i++)
            {
                var idx = i; var t = sh.Tracks[i];
                <button class="card song-card" data-np @key="t.Path" data-warm="@Warm(t)" @onclick="() => PlayFull(sh.Tracks, idx, sh.Title)" aria-label="@("Play " + t.Title + " by " + t.Artist)">
                    <Cover ArtKey="@(t.ArtKey)" Class="square" />
                    <span class="card-title">@t.Title</span>
                    <span class="card-sub">@t.Artist</span>
                    <DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" />
                </button>
            }
            @* songs the person does not have yet: tagged New, and a press fetches one the way Search's Download does (only where the server downloads at all) *@
            @foreach (var n in Downloads.Allowed ? sh.New : [])
            {
                var job = Downloads.JobFor(Session, n.Artist, n.Title);
                <button class="card song-card new-song" @key="@("new:" + n.Artist + "|" + n.Title)" disabled="@(!Session.Services.Any || job is { Finished: false })" @onclick="() => Downloads.Song(Session, n)" aria-label="@("Get " + n.Title + " by " + n.Artist)">
                    <Cover ArtKey="@(n.ArtUrl is null ? null : Art.ExternalKey(n.ArtUrl))" Class="square" />
                    <span class="card-title">@n.Title</span>
                    <span class="card-sub">@n.Artist</span>
                    <span class="badge new-tag">@(job is { Finished: false } ? "Downloading…" : "New")</span>
                    <DownloadTag Session="Session" Artist="@n.Artist" Title="@n.Title" />
                </button>
            }
        </div>
    }
    else
    {
        <div class="row-scroll">
            @foreach (var g in sh.Albums)
            {
                <a class="card" href="@AlbumLink(g)">
                    <Cover ArtKey="@(g.ArtKey)" Class="square" />
                    <span class="card-title">@g.Name</span>
                    <span class="card-sub">@(g.Tracks[0].AlbumArtist.Length > 0 ? g.Tracks[0].AlbumArtist : g.Tracks[0].Artist)</span>
                </a>
            }
        </div>
    }
</section>
    </text>;

    // the shelves are built from the account's profile (plays, favourites, playlists), so they wait for it rather than show a version with none of it
    bool Waiting => !Session.ProfileLoaded && Session.Loading;
    // playing from Home opens the full-screen player
    // each song's button is keyed by the song (@key above): when Home works its shelves out again just after it opens, a press that lands mid-update used to
    // reach the button now in that place, and the owner's Price Tag (4th) started I Gotta Feeling (1st, after the shelf changed)
    // the song's address, for flacie.js to fetch its start when the pointer rests on it (so it starts at once when pressed, not after the server's first byte)
    static string Warm(Track t) => "/stream?p=" + Uri.EscapeDataString(t.Path);
    async Task PlayFull(IReadOnlyList<Track> list, int index, string? context) { await Player.Play(list, index, context, listenContext: "home"); Player.RequestFullScreen(); }
    async Task ShuffleFull(IReadOnlyList<Track> list, string? context) { await Player.ShuffleAll(list, context, listenContext: "home"); Player.RequestFullScreen(); }

    // a title in the serif with its last word in italics ("Listen <i>again</i>")
    static RenderFragment Serif(string title) => b =>
    {
        var s = title.TrimEnd(); var i = s.LastIndexOf(' ');
        if (i > 0) b.AddContent(0, s[..(i + 1)]);
        b.OpenElement(1, "i"); b.AddContent(2, i > 0 ? s[(i + 1)..] : s); b.CloseElement();
    };
    // the song played last (the hero's picture and colours)
    // the paused song plays on from where it stopped; with nothing in the player, the song played last starts again (Autoplay carries on after it)
    Task CarryOn(Track t) => Player.Current?.Path == t.Path ? Player.Toggle() : Player.Play([t], 0, "Carry on", listenContext: "home");
        Track? LastPlayed => Session.History.Select(h => Lib.Find(h.Title, h.Artist)).FirstOrDefault(t => t is not null);
    string Name => Session.Jellyfin?.UserName is { Length: > 0 } u ? u : "";
    // the hero's covers: the last one played first, then most played, Quick picks and playlists, five different albums (worked out with the shelves)
    List<string> HeroArt = [];
    void BuildHeroArt()
    {
        var keys = new List<string>();
        void Add(string? k) { if (k is not null && keys.Count < 5 && !keys.Contains(k)) keys.Add(k); }
        Add(LastPlayed?.ArtKey);
        foreach (var id in new[] { "frequently-played", "quick-picks" })
            foreach (var t in shelves.FirstOrDefault(x => x.Id == id)?.Tracks ?? []) Add(t.ArtKey);
        foreach (var p in Session.Playlists.OrderByDescending(p => p.Modified).Take(6)) Add(Session.Resolve(p.Entries.Take(4)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null));
        HeroArt = keys;
    }

    // Home C: the artists played most (as Quick picks weighs them), each with a cover of theirs, worked out with the shelves (not on every redraw)
    List<(string Name, string? Art)> RepeatArtists = [];
    void BuildRepeat()
    {
        var byArtist = new Dictionary<string, Track>();
        foreach (var t in Lib.Songs) if (t.ArtKey is not null) byArtist.TryAdd(Matching.PrimaryArtist(t.Artist), t);
        RepeatArtists = HomeBuilder.TopArtists(Lib, Session.History, Session.Favorites, Session.Playlists, DateTime.UtcNow, Session.PlayStats, 12)
            .Select(a => byArtist.TryGetValue(Matching.PrimaryArtist(a), out var t) ? (t.Artist, t.ArtKey) : ((string, string?)?)null)
            .Where(x => x is not null).Select(x => x!.Value).ToList();
    }
    // a few covers from each mood's own songs, for its card (worked out with the shelves, not on every redraw)
    readonly Dictionary<string, List<string?>> moodCovers = [];
    List<string?> MoodCovers(string m)
    {
        if (moodCovers.TryGetValue(m, out var c)) return c;
        c = HomeBuilder.MoodTracks(Lib, m, DateTime.UtcNow, 12).Select(t => t.ArtKey).Where(k => k is not null).Distinct().Take(3).ToList();
        moodCovers[m] = c; return c;
    }


    [Inject] IJSRuntime Js { get; set; } = default!;
    ElementReference heroEl; string? heroFor = "";
    string Greeting { get { var h = DateTime.Now.Hour; return h >= 18 ? "Good evening" : h >= 12 ? "Good afternoon" : "Good morning"; } }

    List<Shelf> shelves = [];
    // what Quick picks learn from besides this site's own history: Jellyfin's play counts (every app) and the best-known songs of the artists played most
    IReadOnlySet<string>? hits; long tasteSlot = -1;
    async Task LoadTasteAsync()
    {
        try
        {
            if (Session is null) return;
            await Session.RefreshPlayStatsAsync(Jf, TimeSpan.FromHours(1));
            var artists = HomeBuilder.TopArtists(Lib, Session.History, Session.Favorites, Session.Playlists, DateTime.UtcNow, Session.PlayStats);
            if (artists.Count > 0) hits = await Hits.KeysAsync(artists);
            builtSlot = -1;   // build the shelves again with it
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { }
    }
    List<string> moods = []; string? mood; List<Track> moodTracks = [];
    long builtSlot = -1, builtLast = -1; int builtSongs = -1, builtRev = -1;

    void Pick(string m) { if (mood == m) { mood = null; return; } mood = m; moodTracks = HomeBuilder.MoodTracks(Lib, m, DateTime.UtcNow); }

    // the shelves are rebuilt when the library or history changes, and each hour (the Daily Mix moves on then)
    protected override void OnParametersSet() => Rebuild();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Session is null) return;
        // the hero takes its colours from that cover, once per cover
        var art = LastPlayed?.ArtKey is { } k ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(k)!) : null;
        if (art != heroFor) { heroFor = art; try { await Js.InvokeVoidAsync("flacie.npAccent", heroEl, art); } catch (Exception) { } }
        var slot = HomeBuilder.Slot(DateTime.UtcNow);
        if (slot != tasteSlot && Lib.Songs.Count > 0) { tasteSlot = slot; _ = LoadTasteAsync(); }
        if (slot != builtSlot || builtSongs != Lib.Songs.Count || builtRev != Session.ProfileRev) { Rebuild(); StateHasChanged(); }
    }

    void Rebuild()
    {
        if (Session is null) return;
        var slot = HomeBuilder.Slot(DateTime.UtcNow);
        var history = Session.History;
        var last = history.FirstOrDefault()?.At ?? 0;
        if (slot == builtSlot && builtSongs == Lib.Songs.Count && builtLast == last && builtRev == Session.ProfileRev) return;
        builtSlot = slot; builtSongs = Lib.Songs.Count; builtLast = last; builtRev = Session.ProfileRev;
        BuildRepeat(); moodCovers.Clear();
        // the shelves of the last visit, while nothing they come from has changed: opening Home again shows them at once instead of working them out again
        var key = (slot, Lib.Songs.Count, last, Session.ProfileRev, hits?.Count ?? -1, Session.PlayStatsAt.Ticks);
        // shelves already on screen never change under the person's pointer (Quick picks used to swap two or three times as Home opened: the library loading,
        // then the play counts arriving; owner, 1 Nov): newer ones are kept and show the next time Home opens, as on Android
        if (built.TryGetValue(Session, out var b) && b.Key.Equals(key)) { if (shelves.Count == 0) { shelves = b.Shelves; moods = b.Moods; } BuildHeroArt(); return; }
        var fresh = HomeBuilder.Build(Lib, history, Session.Favorites, Session.Playlists, DateTime.UtcNow, Session.PlayStats, hits, AppHost.ListenLog(Session), AppHost.Vibe);
        var freshMoods = HomeBuilder.MoodsAvailable(Lib);
        built.AddOrUpdate(Session, new Built(key, fresh, freshMoods));
        if (shelves.Count == 0) { shelves = fresh; moods = freshMoods; }
        BuildHeroArt();
    }
    sealed record Built((long, int, long, int, int, long) Key, List<Shelf> Shelves, List<string> Moods);
    static readonly System.Runtime.CompilerServices.ConditionalWeakTable<UserSession, Built> built = new();
}
