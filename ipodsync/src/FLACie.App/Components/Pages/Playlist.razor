@page "/playlist/{Id}"
@attribute [Authorize]
@inherits UserComponent
@{ var p = Session.Playlists.FirstOrDefault(x => x.Id == Id); }
@if (p is null)
{
    <p class="status">This playlist isn't there any more.</p>
}
else
{
    var tracks = Session.Resolve(p.Entries);
    <PageTitle>@p.Name · FLACie</PageTitle>
    @* design I: the first song's cover in its own colours (flacie.npAccent), a serif title with the last word in italics, mono facts, a big Play in the accent and a tinted Shuffle *@
    <header class="pl-hero" @ref="heroEl">
        <Cover ArtKey="@(tracks.Select(t => t.ArtKey).FirstOrDefault(k => k is not null))" Class="pl-cover" />
        <div class="pl-hero-text">
            <p class="eyebrow">Playlist</p>
            @if (renaming)
            {
                <form class="pl-rename" @onsubmit="() => Rename(p)">
                    <input @bind="newName" @bind:event="oninput" aria-label="Playlist name" maxlength="80" />
                    <button class="btn primary" type="submit" disabled="@(newName.Trim().Length == 0)">Save</button>
                    <button class="btn" type="button" @onclick="() => renaming = false">Cancel</button>
                </form>
            }
            else { var (head, last) = SplitTitle(p.Name); <h1>@head<i>@last</i></h1> }
            <p class="sub pl-facts">@tracks.Count @(tracks.Count == 1 ? "song" : "songs")@(Length(tracks) is { Length: > 0 } len ? " · " + len : "")@(tracks.Count < p.Entries.Count ? $" ({p.Entries.Count - tracks.Count} not in this library)" : "")</p>
            <div class="chips">
                <button class="btn primary pl-play" @onclick="() => Player.Play(tracks, 0, p.Name)" disabled="@(tracks.Count == 0)"><Icon Name="play" Size="18" />Play</button>
                <button class="btn pl-shuffle" @onclick="() => Player.ShuffleAll(tracks, p.Name)" disabled="@(tracks.Count == 0)"><Icon Name="shuffle" Size="18" />Shuffle</button>
                @if (confirm)
                {
                    <button class="btn danger" @onclick="Delete">Delete "@p.Name"</button>
                    <button class="btn" @onclick="() => confirm = false">Keep it</button>
                }
                else
                {
                    <button class="btn ghost" disabled="@(tracks.Count == 0)" @onclick='() => Sharing.ShareAsync(Session, "playlist", p.Name, tracks)'><Icon Name="share" Size="16" />Share</button>
                    <button class="btn ghost" @onclick="() => { renaming = true; newName = p.Name; }">Rename</button>
                    <button class="btn ghost" @onclick="() => confirm = true">Delete</button>
                }
            </div>
        </div>
    </header>
    <div class="pl-main">
    @if (tracks.Count == 0) { <p class="status">Nothing in this playlist yet. Use the ⋯ menu on any song and pick “Add to playlist”.</p> }
    <TrackList Tracks="tracks" PlayContext="@p.Name" OnRemove="i => Remove(p, tracks, i)" OnMove="(a, b) => Move(p, tracks, a, b)" />
    @{ var missing = Session.Loading || Lib.Songs.Count == 0 ? [] : p.Entries.Where(e => Session.ResolveEntry(e) is null && e.Title.Length > 0).ToList(); }
    @if (missing.Count > 0)
    {
        <section class="shelf missing-list" aria-label="Not in your library">
            <div class="shelf-head"><div><h2>Not in your library</h2><small>@missing.Count song@(missing.Count == 1 ? "" : "s") from this playlist, fetched from Soulseek or Lidarr</small></div>
                <button class="btn" disabled="@(!Session.Services.Any)" @onclick="() => Get(missing)"><Icon Name="download" Size="16" />Download all</button></div>
            @if (!Session.Services.Any) { <p class="hint">Set up downloads in <a href="/dashboard#downloads">the Dashboard</a> first.</p> }
            <ul class="tracks">
                @foreach (var m in missing)
                {
                    var e = m;
                    <li class="track gone"><span class="track-main"><Cover Size="44" /><span class="track-text"><span class="track-title">@e.Title</span><span class="track-sub">@e.Artist</span><DownloadTag Session="Session" Artist="@e.Artist" Title="@e.Title" /></span></span>
                        <button class="btn" disabled="@(!Session.Services.Any || asked.Contains(Key(e)))" @onclick="() => Get([e])">@(asked.Contains(Key(e)) ? "Requested" : "Download")</button></li>
                }
            </ul>
        </section>
    }
    </div>
}
@code {
    [Parameter] public string Id { get; set; } = "";
    bool confirm;
    ElementReference heroEl; string? heroFor = "";
    [Inject] IJSRuntime Js { get; set; } = default!;
    [Inject] Sharing Sharing { get; set; } = default!;
    // the last word goes in italics, whatever the name is
    static (string, string) SplitTitle(string n) { n = n.Trim(); var i = n.LastIndexOf(' '); return i < 0 ? ("", n) : (n[..(i + 1)], n[(i + 1)..]); }
    static string Length(IReadOnlyList<Track> ts) { var m = (int)(ts.Sum(t => t.DurationMs) / 60000); return m <= 0 ? "" : m >= 60 ? $"{m / 60} h {m % 60} min" : $"{m} min"; }
    // the hero takes its colours from the first song's cover, once per cover
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var p = Session?.Playlists.FirstOrDefault(x => x.Id == Id);
        if (p is null) return;
        var k = Session!.Resolve(p.Entries).Select(t => t.ArtKey).FirstOrDefault(x => x is not null);
        var art = k is not null ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(k)!) : null;
        if (art != heroFor) { heroFor = art; try { await Js.InvokeVoidAsync("flacie.npAccent", heroEl, art); } catch (Exception) { } }
    }
    bool renaming; string newName = "";
    void Rename(FLACie.Core.Playlist p) { var n = newName.Trim(); if (n.Length > 0) { Session.RenamePlaylist(p.Id, n); SaveProfile(); } renaming = false; }
    // the list shows only songs this library has; the playlist's own order also holds the ones it doesn't, so the move is made on the real entries
    void Move(FLACie.Core.Playlist p, IReadOnlyList<Track> tracks, int from, int to)
    {
        int At(Track t) => p.Entries.FindIndex(e => e.Path == t.Path || (e.Title == t.Title && e.Artist == t.Artist));
        if (from < 0 || to < 0 || from >= tracks.Count || to >= tracks.Count) return;
        Session.MoveInPlaylist(p.Id, At(tracks[from]), At(tracks[to])); SaveProfile();
    }
    readonly HashSet<string> asked = [];
    [Inject] IDownloads Downloads { get; set; } = default!;
    static string Key(PlaylistEntry e) => Matching.MatchKey(e.Title, e.Artist);
    void Get(IEnumerable<PlaylistEntry> entries)
    {
        foreach (var e in entries) if (asked.Add(Key(e))) _ = Downloads.FetchSongAsync(Session, "Playlist", e.Artist, e.Title, "", null, 0);
    }
    void Delete() { Session.DeletePlaylist(Id); SaveProfile(); Nav.NavigateTo("/playlists"); }
    void Remove(FLACie.Core.Playlist p, IReadOnlyList<Track> tracks, int i)
    {
        var t = tracks[i];
        Session.RemoveFromPlaylist(p.Id, p.Entries.FindIndex(e => e.Path == t.Path || (e.Title == t.Title && e.Artist == t.Artist)));
        SaveProfile();
    }
}
