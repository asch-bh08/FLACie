@page "/playlist/{Id}"
@attribute [Authorize]
@inherits UserComponent
@{ var p = Session.Playlists.FirstOrDefault(x => x.Id == Id); }
@if (p is null)
{
    <EmptyState Glyph="playlists" Line="This playlist isn't there any more." Sub="It may have been deleted on another device."><a class="btn" href="/playlists">Your playlists</a></EmptyState>
}
else
{
    var tracks = Session.Resolve(p.Entries);
    // F26.6: an imported playlist lists every song of the import in its order; the ones not here yet are greyed with their live state
    var imp = AppHost.Imports?.ForPlaylist(Session, p.Id);
    IReadOnlyList<WaitingSong>? waiting = null;
    if (imp is { } im)
    {
        var have = tracks.GroupBy(t => Matching.MatchKey(t.Title, t.Artist)).ToDictionary(g => g.Key, g => g.First());
        // the exact match first, then the import's own loose one: Spotify's "More And More - Single Version" is the "More And More" that was downloaded
        // (it showed as Waiting while the import said 99 of 99, owner 5 Nov)
        // and last the playlist's own song by that artist whose title is the same without its extras ("Scatman" for "Scatman (ski-ba-bop-ba-dop-bop)"):
        // it was counted in the list and shown as still to come as well ("87, 11 still to come" in a list of 98; owner, 6 Nov)
        var (inOrder, wait) = ImportRows.Build(im.Songs, (a, t) => have.GetValueOrDefault(Matching.MatchKey(t, a)) ?? Lib.FindLoose(t, a) ?? tracks.FirstOrDefault(x => Matching.SameSongLoosely(t, a, x)),
            (a, t) => Downloads.JobFor(Session, a, t));
        var placed = inOrder.Select(t => t.Path).ToHashSet();
        tracks = [.. inOrder, .. tracks.Where(t => !placed.Contains(t.Path))];
        waiting = wait;
    }
    <PageTitle>@p.Name · FLACie</PageTitle>
    @* design I: the first song's cover in its own colours (flacie.npAccent), a serif title with the last word in italics, mono facts, a big Play in the accent and a tinted Shuffle.
       The colours are set on the whole page, not only the hero, so the playing row and the recommendations' buttons take them too (as Now Playing's queue does) *@
    <Frame Title="@p.Name" Hero="true" />
    <div class="pl-page" @ref="heroEl">
    <header class="pl-hero">
        <Cover ArtKey="@(tracks.Select(t => t.ArtKey).FirstOrDefault(k => k is not null))" Class="pl-cover" />
        @* the cover blurred behind the card, as each Devices card has its song's (after the cover, so the cover stays the first picture here) *@
        @if (tracks.Select(t => t.ArtKey).FirstOrDefault(k => k is not null) is { } washKey) { <div class="pl-wash" aria-hidden="true"><Cover ArtKey="@washKey" /></div> }
        <div class="pl-hero-text">
            <p class="eyebrow">Playlist</p>
            @if (renaming)
            {
                <form class="pl-rename" @onsubmit="() => Rename(p)">
                    <input @bind="newName" @bind:event="oninput" aria-label="Playlist name" maxlength="80" />
                    <button class="btn primary" type="submit" disabled="@(newName.Trim().Length == 0)">Save</button>
                    <button class="btn" type="button" @onclick="() => renaming = false">Cancel</button>
                </form>
            }
            else
            {
                var (head, last) = SplitTitle(p.Name); <h1>@head<i>@last</i></h1>
            }
            <p class="sub pl-facts">@tracks.Count @(tracks.Count == 1 ? "song" : "songs")@(Length(tracks) is { Length: > 0 } len ? " · " + len : "")@(tracks.Count < p.Entries.Count ? $" ({p.Entries.Count - tracks.Count} not in this library)" : "")@(waiting is { Count: > 0 } ? $" · {waiting.Count} still to come" : "")</p>
            <div class="chips">
                <button class="btn primary pl-play" @onclick="() => Player.PlayInOrder(tracks, p.Name, DjSwitches.KeyOf(p))" disabled="@(tracks.Count == 0)"><Icon Name="play" Size="18" />Play</button>
                <button class="btn pl-shuffle" @onclick="() => Player.ShuffleAll(tracks, p.Name, DjSwitches.KeyOf(p))" disabled="@(tracks.Count == 0)"><Icon Name="shuffle" Size="18" />Shuffle</button>
                @* the quieter actions: one row of equal rounded slots, the icon over its word, as the phone's ToolSlot (owner, 26 Nov). Rename, Remove
                   duplicates and Delete are on the Edit page; a PC has the room for them one tap away in More too (owner, 27 Nov), a phone keeps four slots *@
                <div class="pl-tools">
                @* a button like the others, not an underlined link (owner, 25 Nov); the web downloads per import, not per playlist *@
                @if (imp is { } im2) { <Slot Class="btn pl-tool pl-slot pl-downloads" Href="@($"/imports/{im2.JobId}/downloads")" data-testid="pl-downloads" Title="This playlist's downloads: what came in, what is still to come" Icon="download" Label="Downloads" /> }
                @* the DJ on this playlist, remembered for it (and on the phone): Auto follows Settings → DJ; On or Off wins over that whenever this playlist plays *@
                @if (Player.Dj is { } dj)
                {
                    var djChoice = DjSwitches.OfPlaylist(dj.Settings(Session), DjSwitches.KeyOf(p));
                    <Slot Class="@($"btn pl-tool pl-slot pl-dj {(djChoice is null ? "" : "set")}")" OnClick="() => CycleDj(p)" Title="DJ on this playlist. Auto follows your DJ settings; On or Off is kept for this playlist. Tap to change." Icon="dj" Label="@($"DJ: {DjSwitches.Label(djChoice)}")" />
                }
                <Slot Class="btn pl-tool pl-slot" Disabled="@(tracks.Count == 0)" OnClick='() => Sharing.ShareAsync(Session, "playlist", p.Name, tracks)' Icon="share" Label="Share" />
                <Slot Class="btn pl-tool pl-slot pl-edit" Href="@($"/playlist/{p.Id}/edit")" Icon="pencil" Label="Edit" />
                <div class="pl-more pl-more-slot">
                    <Slot Class="btn pl-tool pl-slot" OnClick="ToggleMore" Icon="more" Label="More" aria-label="More for this playlist" aria-haspopup="menu" aria-expanded="@(more ? "true" : "false")" />
                    @if (more)
                    {
                        <div class="menu pl-menu" role="menu" aria-label="More for this playlist">
                            @if (confirm)
                            {
                                @* the same words as the Edit page and the phone: it asks first *@
                                <p class="pl-ask" role="alert">Delete “@p.Name”?</p>
                                <button role="menuitem" class="danger" @onclick="() => Delete(p)">Delete</button>
                                <button role="menuitem" @onclick="() => confirm = false">Keep it</button>
                            }
                            else
                            {
                                <button role="menuitem" @onclick="() => StartRename(p)"><Icon Name="pencil" Size="18" />Rename</button>
                                <button role="menuitem" disabled="@(p.Entries.Count < 2)" @onclick="() => Dedupe(p)"><Icon Name="check" Size="18" />Remove duplicates</button>
                                <button role="menuitem" class="danger" @onclick="() => confirm = true"><Icon Name="x" Size="18" />Delete playlist</button>
                            }
                        </div>
                    }
                </div>
                </div>
            </div>
        </div>
    </header>
    <div class="pl-main">
    @if (tracks.Count == 0 && waiting is not { Count: > 0 }) { <EmptyState Glyph="playlists" Line="Nothing in this playlist yet." Sub="Use the ⋯ menu on any song and pick “Add to playlist”."><a class="btn" href="/songs">Find songs to add</a></EmptyState> }
    <TrackList Tracks="tracks" Waiting="waiting" OnRetry="Retry" PlayContext="@p.Name" PlayContextId="@DjSwitches.KeyOf(p)" OnRemove="i => Remove(p, tracks, i)" OnMove="(a, b) => Move(p, tracks, a, b)" />
    @{ var missing = imp is not null || Session.Loading || Lib.Songs.Count == 0 ? [] : p.Entries.Where(e => Session.ResolveEntry(e) is null && e.Title.Length > 0).ToList(); }
    @if (missing.Count > 0)
    {
        <section class="shelf missing-list" aria-label="Not in your library">
            @* the songs are listed either way; the buttons only where the server downloads, and Download all only for those it lets (see SharedLink) *@
            <div class="shelf-head"><div><h2>Not in your library</h2><small>@missing.Count song@(missing.Count == 1 ? "" : "s") from this playlist</small></div>
                @if (Downloads.MayBulk(Session)) { <button class="btn" disabled="@(!Session.Services.Any)" @onclick="() => Get(missing)"><Icon Name="download" Size="16" />Download all</button> }</div>
            @if (Downloads.Allowed && !Session.Services.Any) { <p class="hint">Set up downloads in <a href="/dashboard#downloads">Server admin</a> first.</p> }
            <ul class="tracks">
                @foreach (var m in missing)
                {
                    var e = m;
                    <li class="track gone"><span class="track-main"><Cover Size="44" /><span class="track-text"><span class="track-title">@e.Title</span><span class="track-sub">@e.Artist</span><DownloadTag Session="Session" Artist="@e.Artist" Title="@e.Title" /></span></span>
                        @if (Downloads.Allowed) { <button class="btn" disabled="@(!Session.Services.Any || asked.Contains(Key(e)))" @onclick="() => Get([e])">@(asked.Contains(Key(e)) ? "Requested" : "Download")</button> }</li>
                }
            </ul>
        </section>
    }
    <PlaylistRecsSection List="p" />
    </div>
    </div>
}
@code {
    [Parameter] public string Id { get; set; } = "";
    ElementReference heroEl; string? heroFor = "";
    [Inject] IJSRuntime Js { get; set; } = default!;
    [Inject] Sharing Sharing { get; set; } = default!;
    [Inject] Toasts Toast { get; set; } = default!;
    // the PC's More (Rename, Remove duplicates, Delete): closes on a click outside it or Escape (flacie.watchOutside calls Dismiss)
    bool more, confirm, renaming; string newName = "";
    DotNetObjectReference<Playlist>? self;
    async Task ToggleMore()
    {
        more = !more; confirm = false;
        self ??= DotNetObjectReference.Create(this);
        try { if (more) await Js.InvokeVoidAsync("flacie.watchOutside", ".pl-more-slot", self); else await Js.InvokeVoidAsync("flacie.unwatchOutside"); } catch (Exception) { }
    }
    [JSInvokable] public void Dismiss() => InvokeAsync(() => { more = false; confirm = false; StateHasChanged(); });
    async Task CloseMore() { more = false; confirm = false; try { await Js.InvokeVoidAsync("flacie.unwatchOutside"); } catch (Exception) { } }
    async Task StartRename(FLACie.Core.Playlist p) { await CloseMore(); newName = p.Name; renaming = true; }
    void Rename(FLACie.Core.Playlist p) { var n = newName.Trim(); if (n.Length > 0) { Session.RenamePlaylist(p.Id, n); SaveProfile(); } renaming = false; }
    async Task Dedupe(FLACie.Core.Playlist p)
    {
        await CloseMore();
        var n = Session.RemoveDuplicates(p.Id);
        if (n > 0) SaveProfile();
        Toast.Show(n == 0 ? "No duplicates in this playlist" : $"Removed {n} duplicate{(n == 1 ? "" : "s")}");
    }
    async Task Delete(FLACie.Core.Playlist p) { await CloseMore(); Session.DeletePlaylist(p.Id); SaveProfile(); Nav.NavigateTo("/playlists"); }
    // the last word goes in italics, whatever the name is
    static (string, string) SplitTitle(string n) { n = n.Trim(); var i = n.LastIndexOf(' '); return i < 0 ? ("", n) : (n[..(i + 1)], n[(i + 1)..]); }
    static string Length(IReadOnlyList<Track> ts) { var m = (int)(ts.Sum(t => t.DurationMs) / 60000); return m <= 0 ? "" : m >= 60 ? $"{m / 60} h {m % 60} min" : $"{m} min"; }
    // the hero takes its colours from the first song's cover, once per cover
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var p = Session?.Playlists.FirstOrDefault(x => x.Id == Id);
        if (p is null) return;
        var k = Session!.Resolve(p.Entries).Select(t => t.ArtKey).FirstOrDefault(x => x is not null);
        var art = k is not null ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(k)!) : null;
        if (art != heroFor) { heroFor = art; try { await Js.InvokeVoidAsync("flacie.npAccent", heroEl, art); } catch (Exception) { } }
    }
    // the list shows only songs this library has; the playlist's own order also holds the ones it doesn't, so the move is made on the real entries
    void Move(FLACie.Core.Playlist p, IReadOnlyList<Track> tracks, int from, int to)
    {
        int At(Track t) => p.Entries.FindIndex(e => e.Path == t.Path || (e.Title == t.Title && e.Artist == t.Artist));
        if (from < 0 || to < 0 || from >= tracks.Count || to >= tracks.Count) return;
        Session.MoveInPlaylist(p.Id, At(tracks[from]), At(tracks[to])); SaveProfile();
    }
    readonly HashSet<string> asked = [];
    // a failed song of the import is tried again; its row follows the new job
    void Retry(WaitingSong w) { Downloads.Song(Session, new CatalogSong(w.Artist, w.Title, "", null, 0, 0, 0), kind: "Import"); StateHasChanged(); }
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); Downloads.Subscribe(Session, OnJobs); }
    void OnJobs() => InvokeAsync(StateHasChanged);
    public override void Dispose() { self?.Dispose(); if (Session is not null) Downloads.Unsubscribe(Session, OnJobs); base.Dispose(); }
    [Inject] IDownloads Downloads { get; set; } = default!;
    static string Key(PlaylistEntry e) => Matching.MatchKey(e.Title, e.Artist);
    void Get(IReadOnlyCollection<PlaylistEntry> entries)
    {
        if (entries.Count > 1 && !Downloads.MayBulk(Session)) return;
        foreach (var e in entries) if (asked.Add(Key(e))) _ = Downloads.FetchSongAsync(Session, "Playlist", e.Artist, e.Title, "", null, 0);
    }
    // the playlist's DJ chip: Auto, On, Off, Auto again; saved with the DJ settings on the server, so the phone shows the same
    async Task CycleDj(FLACie.Core.Playlist p)
    {
        if (Player.Dj is not { } dj) return;
        var s = DjSwitches.Copy(dj.Settings(Session)); var key = DjSwitches.KeyOf(p);
        DjSwitches.SetPlaylist(s, key, DjSwitches.NextChoice(DjSwitches.OfPlaylist(s, key)));
        dj.Save(Session, s);
        await Player.DjRefreshAsync();
    }
    void Remove(FLACie.Core.Playlist p, IReadOnlyList<Track> tracks, int i)
    {
        var t = tracks[i];
        var at = p.Entries.FindIndex(e => e.Path == t.Path || (e.Title == t.Title && e.Artist == t.Artist));
        if (at < 0) return;
        var entry = p.Entries[at];
        Session.RemoveFromPlaylist(p.Id, at);
        SaveProfile();
        // offered back: Undo puts it in the same place
        Toast.Show($"Removed “{t.Title}” from {p.Name}", "Undo", () => { Session.InsertIntoPlaylist(p.Id, at, entry); SaveProfile(); InvokeAsync(StateHasChanged); Toast.Dismiss(); });
    }
}
