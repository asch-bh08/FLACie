@page "/playlists"
@attribute [Authorize]
@inherits UserComponent
<PageTitle>Playlists · FLACie</PageTitle>
<header class="page-head">
    <h1><i>Playlists</i></h1>
    <form class="inline-form" @onsubmit="Create">
        <input @bind="name" @bind:event="oninput" placeholder="New playlist name" aria-label="New playlist name" />
        <button class="btn primary" type="submit" disabled="@string.IsNullOrWhiteSpace(name)">Create</button>
    </form>
    @* importing a playlist (iTunes, M3U, a text list) lives here now, not in the menu *@
    @if (AppHost.Server) { <a class="btn" href="/import"><Icon Name="download" Size="16" />Import a playlist</a> }
</header>
@if (Session.Playlists.Count == 0)
{
    <p class="status">No playlists yet. Name one above, choose several songs and add them to a new one, or save what is playing from Up next.</p>
}
<div class="grid pl-grid">
    @foreach (var p in Session.Playlists)
    {
        var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
        <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub">@p.Entries.Count @(p.Entries.Count == 1 ? "song" : "songs")</span></a>
    }
</div>
@code {
    string name = "";
    void Create()
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        var p = Session.CreatePlaylist(name.Trim());
        name = "";
        SaveProfile();
        Nav.NavigateTo("/playlist/" + p.Id);
    }
}
