@page "/search"
@attribute [Authorize]
@implements IDisposable
@inherits UserComponent
@inject ExploreState X
<PageTitle>@(q.Length > 0 ? q + " · " : "")Search · FLACie</PageTitle>
<h1 class="sr-only">Search</h1>
@{ var jobs = Downloads.JobsOf(Session).Where(j => j.Kind == "Search").ToList(); }
@if (jobs.Count > 0)
{
    <section class="panel wide" aria-label="Downloads">
        <h2>Downloads</h2>
        @foreach (var j in jobs)
        {
            <div class="job @(j.Stage == DownloadStage.Failed ? "bad" : "")">
                <Cover ArtKey="@(j.ArtKey)" Size="40" />
                <span class="job-text"><b>@j.Label</b><small>@j.Message</small></span>
            </div>
        }
        @if (jobs.Any(x => x.Finished)) { <button class="btn ghost" @onclick="() => Downloads.DismissFinished(Session)">Clear finished</button> }
    </section>
}
@if (q.Trim().Length == 0)
{
    @* nothing typed: Search is where you browse (what the Explore page was): its tabs, its filters and the overview *@
    <header class="page-head">
        <h2 class="page-title">Search <i>your music</i></h2>
        <p class="sub">@Lib.Songs.Count.ToString("N0") songs · @Lib.Albums.Count.ToString("N0") albums · @Lib.Artists.Count.ToString("N0") artists. Type above to search; anything you don't have shows up under More music, ready to download.</p>
    </header>
    @if (Session.RecentSearches is { Count: > 0 } recent)
    {
        <section class="recent-searches" aria-label="Recent searches">
            <div class="rs-head"><h2 class="section">Recent searches</h2><button class="btn ghost" @onclick="() => { Session.ClearRecentSearches(); SaveProfile(); }">Clear</button></div>
            <div class="chips">@foreach (var r in recent) { <a class="chip" href="@("/search?q=" + Uri.EscapeDataString(r))">@r</a> }</div>
        </section>
    }
    <MusicTabs Active="Overview" />
    <ExploreBar Tab="Overview" Changed="StateHasChanged" />
    <LibraryStatus />
    <ResultSections Query="@X.Query" Rev="@X.Version" Context="Explore" SeeAllHref="/songs" SortKey="@X.OverviewSort" OnQuery="v => { X.Query = v; X.Touch(); }" />
}
else
{
    <ExploreBar Compact="true" Changed="OnFilters" />
    @* F26.3: Playlists is one of the kind chips (one choice) and shows only playlists; genre and decade come from the Filters panel above *@
    <ResultSections Query="@q" Rev="@X.Version" Context="Search" Made="@lists" ListsKind="true" AllLists="@filterLists" OnKind="KindPicked" ShowEmpty="@(!(webBusy || webSongs.Count > 0 || webAlbums.Count > 0))" OnQuery="Suggest" />
    @if (webPaused) { <p class="hint" role="status">Online results are paused for a moment: that was a lot of searches in one minute. Your library's results are still here.</p> }
    @* music to download is songs and albums: not shown while Playlists or Artists is picked (F26.3) *@
    @if ((webBusy || webSongs.Count > 0 || webAlbums.Count > 0) && kind is "" or "songs" or "albums")
    {
        <h2 class="section">More music @(webBusy ? "(searching…)" : "")</h2>
        @* with downloads off on this server (the Dashboard's "Allow downloads") these are only what exists: no download buttons and no "set up downloads" hint *@
        @if (Downloads.Allowed && !Session.Services.Any && isAdmin) { <p class="hint">These aren't in your library. Download services you run yourself can be set up in the <a href="/dashboard#downloads">Server admin</a>; only download music you own or have permission to download.</p> }
        @if (webAlbums.Count > 0)
        {
            <div class="row-scroll">
                @foreach (var a in webAlbums)
                {
                    var ja = Downloads.JobFor(Session, a.Artist, a.CleanTitle);
                    <div class="card">
                        @* a tap on the cover or the names opens the album full screen first (its songs, Download album), as on the phone *@
                        <button type="button" class="card-open" aria-label="Open @a.CleanTitle" @onclick="() => { preSong = null; preAlbum = a; }"><Cover ArtKey="@(a.ArtUrl is null ? null : Art.ExternalKey(a.ArtUrl))" Class="square" /></button>
                        <span class="card-title">@a.CleanTitle</span>
                        <span class="card-sub">@a.Artist · @a.Kind</span>
                        @if (ja is not null) { <span class="track-dl @(ja.Stage == DownloadStage.Failed ? "bad" : ja.Stage == DownloadStage.Done ? "ok" : "")"><i aria-hidden="true"></i>@ja.Message@(ja.Current is { } ca && !ja.Finished ? " · " + OpenSourceSettings.Name(ca) : ja.Source is { } sa ? " · from " + OpenSourceSettings.Name(sa) : "")</span> }
                        @if (Downloads.Allowed) { <button class="btn" disabled="@(!Session.Services.Any || ja is { Finished: false })" @onclick="() => Downloads.Album(Session, a)"><Icon Name="download" Size="16" />@(ja is { Finished: false } ? "Downloading…" : ja is { Stage: DownloadStage.Failed } ? "Try again" : "Download")</button> }
                    </div>
                }
            </div>
        }
        @if (preAlbum is not null || preSong is not null)
        {
            <CatalogPreview Album="preAlbum" Song="preSong" Versions="@(preSong is { } ps ? webSongs.Where(x => VersionKey(x) == VersionKey(ps)).ToList() : [])" OnClose="() => { preAlbum = null; preSong = null; }" />
        }
        @if (webSongs.Count > 0)
        {
            <ul class="tracks">
                @foreach (var s in ShownWebSongs())
                {
                    var jb = Downloads.JobFor(Session, s.Artist, s.Title); var hiKey = FLACie.Core.Matching.MatchKey(s.Title, s.Artist);
                    // already playable now (a download that just finished, or one the phone reported): never offered again
                    var inLib = Lib.Find(s.Title, s.Artist) is not null;
                    <li class="track @(hiAsk == hiKey ? "asking" : "")">
                        <span class="track-main">
                            <button type="button" class="card-open" aria-label="Open @s.Title" @onclick="() => { preAlbum = null; preSong = s; }"><Cover ArtKey="@(s.ArtUrl is null ? null : Art.ExternalKey(s.ArtUrl))" Size="44" /></button>
                            <span class="track-text"><button type="button" class="track-title link-btn open-song" @onclick="() => { preAlbum = null; preSong = s; }">@s.Title</button><span class="track-sub">@s.Artist@(s.Album.Length > 0 ? " · " + s.Album : "")@if (MoreVersions(s) is > 0 and var more) { <text> · </text><button type="button" class="link-btn versions" aria-expanded="false" @onclick="() => openVersions.Add(VersionKey(s))">+@more version@(more == 1 ? "" : "s")</button> }</span>@if (jb is { Stage: DownloadStage.Failed }) { <span class="track-dl bad"><i aria-hidden="true"></i>@jb.Message</span> } else { <DownloadTag Session="Session" Artist="@s.Artist" Title="@s.Title" /> }</span>
                        </span>
                        <span class="track-time">@Time(s.DurationMs / 1000.0)</span>
                        <span class="track-actions">
                        @if (Downloads.Allowed) { <button class="btn" disabled="@(!Session.Services.Any || jb is { Finished: false } || inLib)" @onclick="() => Downloads.Song(Session, s)"><Icon Name="download" Size="16" />@(jb is { Finished: false } ? "Downloading…" : inLib ? "In your library" : jb is { Stage: DownloadStage.Failed } ? "Try again" : "Download")</button> }
                        <span class="dl-more">
                            <button class="icon-btn" aria-haspopup="menu" aria-expanded="@((dlMenu == hiKey) ? "true" : "false")" aria-label="@MoreLabel(s.Title)" @onclick="() => dlMenu = dlMenu == hiKey ? null : hiKey"><Icon Name="lines" Size="20" /></button>
                            @if (dlMenu == hiKey)
                            {
                                <button class="scrim" aria-label="Close" @onclick="() => dlMenu = null"></button>
                                <div class="dl-menu" role="menu">
                                    @if (Downloads.Allowed) { <button role="menuitem" disabled="@(!Session.Services.Any || jb is { Finished: false } || inLib)" @onclick="() => { dlMenu = null; Downloads.Song(Session, s); }"><Icon Name="download" Size="16" />Download</button> }
                                    @if (isAdmin && Downloads.Allowed && Session.Services.SoulseekReady) { <button role="menuitem" class="hi" disabled="@(jb is { Finished: false } || inLib)" @onclick="() => { dlMenu = null; hiAsk = hiKey; }"><span aria-hidden="true">✦</span> Hi-Res download…</button> }
                                    <a role="menuitem" href="https://www.youtube.com/results?search_query=@Uri.EscapeDataString(s.Artist + " " + s.Title)" target="_blank" rel="noopener" @onclick="() => dlMenu = null">Find on YouTube</a>
                                </div>
                            }
                        </span>
                        </span>
                        @if (isAdmin && hiAsk == hiKey) { <div class="hires-ask track-ask" role="group" aria-label="Download in Hi-Res?"><b>Download "@s.Title" in Hi-Res?</b><span>Hi-Res files are 2 to 5 times bigger (roughly 40 to 200 MB). If no Hi-Res copy exists, you get the normal quality instead. Only this song.</span><span class="hires-actions"><button class="btn hires solid" @onclick="() => { hiAsk = null; Downloads.Song(Session, s, true); }">Download Hi-Res</button><button class="btn ghost" @onclick="() => hiAsk = null">Cancel</button></span></div> }
                    </li>
                }
            </ul>
        }
    }
}
@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [Inject] WebCatalog Catalog { get; set; } = default!;
    [Inject] IDownloads Downloads { get; set; } = default!;
    string MoreLabel(string title) => (Downloads.Allowed ? "More download options for " : "More options for ") + title;
    [Inject] IConfiguration Conf { get; set; } = default!;
    [Inject] IServiceProvider Provider { get; set; } = default!;
    bool isAdmin => AdminAccess.Is(Session, Conf);
    string q = ""; string? hiAsk, dlMenu;
    CatalogAlbum? preAlbum; CatalogSong? preSong;
    // the catalogue's many versions of one song are one row, "+N versions" shows the rest (as on the phone, and Spotify: owner, 6 Nov)
    readonly HashSet<string> openVersions = [];
    static string VersionKey(CatalogSong s) => Matching.PrimaryArtist(s.Artist) + "|" + Matching.NormTitle(WebCatalog.BaseTitle(s.Title));
    IEnumerable<CatalogSong> ShownWebSongs() => webSongs.GroupBy(VersionKey).SelectMany(g => openVersions.Contains(g.Key) ? g : g.Take(1));
    int MoreVersions(CatalogSong s)
    {
        var k = VersionKey(s);
        if (openVersions.Contains(k)) return 0;
        var g = webSongs.Where(x => VersionKey(x) == k).ToList();
        return g.Count > 0 && ReferenceEquals(g[0], s) ? g.Count - 1 : 0;
    }
    // the Filters panel changed: the Playlists view follows its genre and decade
    async Task OnFilters() { if (kind == "playlists") { await LoadFilter(); StateHasChanged(); } }
    string kind = "";
    async Task KindPicked(string k) { kind = k; if (k == "playlists") await LoadFilter(); }
    // ---- F23: playlists from outside and our own, for the row and the Playlists filter ----
    IReadOnlyList<MadePlaylist> lists = [], filterLists = [];
    bool listsAll => kind == "playlists";

    async Task LoadLists(string query, CancellationToken ct)
    {
        if (AppHost.WebPlaylists is not { } w) { lists = Made(); return; }
        try
        {
            await Task.Delay(400, ct);   // after the typing settles: a search per keystroke would ask the sources too often
            var got = await w.ForSearchAsync(Session, query, ct);
            if (ct.IsCancellationRequested) return;
            lists = got.Select(ToMade).ToList();
            if (listsAll) await LoadFilter(ct);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception) { lists = Made(); await InvokeAsync(StateHasChanged); }
    }

    async Task LoadFilter(CancellationToken ct = default)
    {
        if (AppHost.WebPlaylists is not { } w)
        {
            // our own lists only (no outside playlists on this server): the genre and decade still narrow them, by their names
            var own = MadePlaylists.Cached(Session, () => AppHost.ListenLog(Session), DateTime.UtcNow);
            IEnumerable<MadePlaylist> pick = q.Trim().Length > 0 ? MadePlaylists.Search(own, q) : own;
            if (X.Genre.Length > 0) pick = (q.Trim().Length > 0 ? pick.Concat(MadePlaylists.Search(own, X.Genre)) : pick).Where(m => m.Name.Contains(X.Genre, StringComparison.OrdinalIgnoreCase));
            if (X.Decade.Length > 0) pick = pick.Concat(MadePlaylists.Search(own, X.Decade)).Where(m => m.Name.Contains(X.Decade, StringComparison.OrdinalIgnoreCase));
            filterLists = pick.DistinctBy(m => m.Id).ToList();
            return;
        }
        filterLists = (await w.ForFilterAsync(Session, q, X.Genre.Length > 0 ? X.Genre : null, ct, X.Decade.Length > 0 ? X.Decade : null)).Select(ToMade).ToList();
    }


    /// <summary>A list as a card: our own keeps its page; one from outside opens as "web:source:id", with the songs the library has.</summary>
    MadePlaylist ToMade(WebPlaylist l)
    {
        if (l.Source == "own" && MadePlaylists.Find(MadePlaylists.Cached(Session, () => AppHost.ListenLog(Session), DateTime.UtcNow), l.Id) is { } m) return m;
        var have = l.Tracks.Select(t => Lib.Find(t.Title, t.Artist)).OfType<Track>().ToList();
        var from = l.Source switch { "spotify" => "Spotify", "deezer" => "Deezer", "soundcloud" => "SoundCloud", _ => "FLACie" };
        // a list read by name only (F26.1) shows its size and its own picture until it is opened
        var size = Math.Max(l.Tracks.Count, l.Size);
        var art = have.Select(t => t.ArtKey).FirstOrDefault(k => k is not null) ?? (l.Picture is { Length: > 0 } pic ? Art.ExternalKey(pic) : null);
        return new MadePlaylist($"web:{l.Source}:{l.Id}", l.Name, $"{(size > 0 ? size + " songs · " : "")}{from}{(l.Editor ? " editors" : "")}", art, have.Select(t => t.Path).ToList());
    }

    List<MadePlaylist> Made() => q.Length < 2 || Lib.Songs.Count == 0 ? [] : MadePlaylists.Search(MadePlaylists.Cached(Session, () => AppHost.ListenLog(Session), DateTime.UtcNow), q);
    void Suggest(string v) => Nav.NavigateTo("/search?q=" + Uri.EscapeDataString(v));
    List<CatalogSong> webSongs = [];
    List<CatalogAlbum> webAlbums = [];
    bool webBusy, webPaused;
    CancellationTokenSource? pending;
    Action? onJobs;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        onJobs = () => InvokeAsync(StateHasChanged);
        Downloads.Subscribe(Session, onJobs);
    }

    // the query lives in the address (the top search box writes it), so Back, reload and shared links all work
    protected override void OnParametersSet()
    {
        var next = (Q ?? "").Trim();
        if (next == q) return;
        q = next;
        pending?.Cancel();
        webSongs = []; webAlbums = []; webPaused = false; openVersions.Clear(); preAlbum = null; preSong = null;
        if (q.Length < 2) { webBusy = false; lists = []; return; }
        lists = Made();
        // one online catalog search per keystroke: past the account's "search" limit a minute (typing flat out for a whole minute stays under it) the online
        // part is left out for now, so a runaway page or a stolen session cannot hammer the public catalogs from this server; the library's results are unaffected.
        // (The Windows app's own copy has no limits registered: GetService gives null there.)
        if (Provider.GetService(typeof(RateLimits)) is RateLimits limits && !limits.TryTake("search", RateKey.Of(Session.Id), out _)) { webBusy = false; webPaused = true; return; }
        var cts = pending = new CancellationTokenSource();
        // remembered once the person stops typing (the top box writes every keystroke into the address)
        var asked = q;
        _ = Task.Delay(2500, cts.Token).ContinueWith(t => { if (!t.IsCanceled && q == asked) { Session.AddRecentSearch(asked); SaveProfile(); } }, TaskScheduler.Default);
        webBusy = true;
        _ = SearchWeb(q, cts.Token);
        _ = LoadLists(q, cts.Token);
    }

    async Task SearchWeb(string query, CancellationToken ct)
    {
        try
        {
            var songs = await Catalog.SongsAsync(query, 20, ct);
            var albums = await Catalog.AlbumsWithTopAsync(query, songs.FirstOrDefault(), ct);
            // what the library already has isn't offered again
            // (the library's own match index, not every song's key worked out again on each search)
            var haveAlbums = Lib.Albums.Select(a => a.Tracks[0].AlbumKey).ToHashSet();
            webSongs = songs.Where(s => Lib.Find(s.Title, s.Artist) is null).ToList();
            webAlbums = albums.Where(a => !haveAlbums.Contains(Matching.PrimaryArtist(a.Artist) + "|" + Matching.AlbumNorm(a.CleanTitle))).ToList();
            webBusy = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception) { webBusy = false; await InvokeAsync(StateHasChanged); }
    }

    public override void Dispose() { pending?.Cancel(); if (onJobs is not null) Downloads.Unsubscribe(Session, onJobs); base.Dispose(); }
}
