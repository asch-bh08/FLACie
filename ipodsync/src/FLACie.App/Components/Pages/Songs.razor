@page "/songs"
@attribute [Authorize]
@inherits UserComponent
@inject ExploreState X
@inject Toasts Toast
<PageTitle>Explore · FLACie</PageTitle>
<header class="page-head">
    <h1><i>Explore</i></h1>
    <p class="sub">@(X.Filtering ? list.Count + " of " + Lib.Songs.Count : Lib.Songs.Count.ToString()) songs</p>
    <div class="chips"><button class="btn primary" @onclick="() => Player.ShuffleAll(list)" disabled="@(list.Count == 0)"><Icon Name="shuffle" Size="18" />Shuffle @(X.Filtering ? "these" : "all")</button></div>
</header>
<MusicTabs Active="Songs" />
<ExploreBar Tab="Songs" Changed="Refresh" />
<LibraryStatus />
@if (list.Count == 0 && Lib.Songs.Count > 0) { <p class="status">Nothing matches these filters.</p> }
<div class="tracks virtual">
    <Virtualize Items="rows" Context="row" ItemSize="60">
        <div class="track @(Player.Current?.Path == row.T.Path ? "now" : "")">
            <button class="track-main" @onclick='() => Player.Play(list, row.I, "Songs")' aria-label="Play @row.T.Title by @row.T.Artist">
                <Cover ArtKey="@(row.T.ArtKey)" Size="44" />
                <span class="track-text"><span class="track-title">@row.T.Title</span><span class="track-sub">@row.T.Artist@(row.T.Album.Length > 0 ? " · " + row.T.Album : "")@(row.T.Year > 0 ? " · " + row.T.Year : "")<span class="track-src" aria-hidden="true">@SourceLabel.Short(row.T.Source)</span></span><DownloadTag Session="Session" Artist="@row.T.Artist" Title="@row.T.Title" Track="row.T" /></span>
            </button>
            <span class="pills">
                <span class="badge @row.T.Source.ToString().ToLowerInvariant()" title="@(row.T.Source == TrackSource.Cloud ? SourceLabel.StreamingHint : "Where this song is played from")">@SourceLabel.Short(row.T.Source)</span>
                @if (QuickFormats.Of(row.T) is { Length: > 0 } fmt) { <span class="badge fmt @(fmt == "HI-RES" ? "hires" : MediaInfo.LosslessCodecs.Contains(fmt.ToLowerInvariant()) ? "lossless" : "")" title="@(fmt == "HI-RES" ? "Hi-Res: lossless at more than CD quality" : "File format")">@(fmt == "HI-RES" ? "✦ Hi-Res" : fmt)</span> }
            </span>
            <span class="track-time">@(row.T.DurationMs > 0 ? Time(row.T.DurationMs / 1000.0) : "")</span>
            <button class="icon-btn @(Session.IsFavorite(row.T) ? "on" : "")" @onclick="() => { Feedback.Heart(Session, row.T); SaveProfile(); }" aria-label="@(Session.IsFavorite(row.T) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(row.T) ? "heart-fill" : "heart")" /></button>
            <button class="icon-btn" @onclick="() => menu = menu == row.I ? -1 : row.I" aria-label="More for @row.T.Title" aria-expanded="@((menu == row.I) ? "true" : "false")"><Icon Name="more" /></button>
            @if (menu == row.I)
            {
                <div class="menu" role="menu">
                    <button role="menuitem" @onclick='() => { Player.PlayNext(row.T); Toast.Show($"“{row.T.Title}” plays next"); menu = -1; }'>Play next</button>
                    <button role="menuitem" @onclick='() => { Player.AddToQueue(row.T); Toast.Show($"Added “{row.T.Title}” to the queue"); menu = -1; }'>Add to queue</button>
                    @foreach (var p in Session.Playlists)
                    {
                        <button role="menuitem" @onclick="() => { Toast.Added(Session, p, row.T, SaveProfile); menu = -1; }">Add to @p.Name</button>
                    }
                    <button role="menuitem" @onclick='() => { menu = -1; Feedback.LessLikeThis(Session, row.T); Toast.Show($"Fewer songs like “{row.T.Title}”"); }'>Less like this</button>
                    <button role="menuitem" @onclick='() => { menu = -1; ThumbDown(row.T); }'>Thumbs down</button>
                    <DjSongMenu Player="Player" Session="Session" Song="row.T" OnDone="() => menu = -1" />
                </div>
            }
        </div>
    </Virtualize>
</div>
@code {
    record Row(Track T, int I);
    int menu = -1;
    List<Track> list = [];
    List<Row> rows = [];
    Library? built; int builtVersion = -1;
    void Build() { if (ReferenceEquals(built, Lib) && builtVersion == X.Version) return; built = Lib; builtVersion = X.Version; list = X.Songs(Lib); if (gone.Count > 0) list = list.Where(t => !gone.Contains(t.Path)).ToList(); rows = list.Select((t, i) => new Row(t, i)).ToList(); }
    // a song thumbed down leaves the list at once
    readonly HashSet<string> gone = [];
    void ThumbDown(Track t) { gone.Add(t.Path); list = list.Where(x => x.Path != t.Path).ToList(); rows = list.Select((x, i) => new Row(x, i)).ToList(); _ = Feedback.ThumbDown(Session, t, Player); Toast.Show($"“{t.Title}” will not be picked for you again"); }
    void Refresh() { Build(); StateHasChanged(); }
    protected override void OnParametersSet() => Build();
    protected override bool ShouldRender() { Build(); return true; }
}
