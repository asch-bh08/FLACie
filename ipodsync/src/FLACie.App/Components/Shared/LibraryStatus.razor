@inherits UserComponent
@if (Session.Loading && Lib.Songs.Count == 0)
{
    if (ShowLoading)
    {
        <Skeleton Label="Loading your library…" />
    }
}
else if (Session.Problem is { } p)
{
    <p class="status warn">@p <button class="btn small" disabled="@retrying" @onclick="Retry">@(retrying ? "Trying…" : "Try again")</button></p>
}
else if (!Session.Loading && Lib.Songs.Count == 0)
{
    <p class="status">No music found yet. Add a Jellyfin server or a NAS in <a href="/settings">Settings</a>.</p>
}
@code {
    /// <summary>False where the page shows its own placeholders while it loads (Home's covers): one set on screen, not two stacked.</summary>
    [Parameter] public bool ShowLoading { get; set; } = true;
    bool retrying;
    // the library could not be read (a server down, a network gone): ask again without a reload
    async Task Retry()
    {
        retrying = true;
        try { await Session.LoadAsync(Jellyfin); } catch (Exception) { }
        retrying = false;
    }
}
