@* The FLACie mark (logo/flacie.png: a neon F in a play triangle with a wave behind it) and the name set with a lighter "ie". *@
<span class="logo @Class">
    <img class="logo-mark" src="icon-64.png" width="@Size" height="@Size" alt="" style="border-radius:@(Math.Max(4, Size / 4))px" />
    @if (Name) { <span class="wordmark">FLAC<i>ie</i></span> }
</span>
@code {
    [Parameter] public int Size { get; set; } = 32;
    [Parameter] public bool Name { get; set; } = true;
    [Parameter] public string Class { get; set; } = "";
}
