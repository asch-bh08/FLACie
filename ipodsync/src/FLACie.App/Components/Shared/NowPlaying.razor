@inherits UserComponent
@implements IDisposable
@*
    The full-screen player, "Living Sleeve". The cover sets the colours of the whole screen (flacie.npAccent); two soft fields in those colours drift behind
    everything while a song plays. One column: the cover, the title, one format chip, the song's own loudness as the seek bar (flacie.npWave, from
    /api/wave), prev / a big play / next, and a dock for shuffle, the lyrics, the queue, more and repeat. The lyrics, the queue and the song's facts are one
    panel: beside the cover on a wide screen, a sheet that slides up over it on a phone. On a phone the player covers the whole screen and the dock stays
    clear of the system's home gesture at the bottom.
*@
@{ var t = Player.Current; }
<div @ref="npEl" class="np ls @(panelOpen ? "panel-open" : "") @(opts ? "opts-open" : "") @(closing ? "closing" : "") @(Player.Playing ? "" : "still")" role="dialog" aria-modal="true" aria-label="Now Playing">
    <div class="ls-fields" aria-hidden="true"><i class="np-field a"></i><i class="np-field b"></i></div>
    @if (t is not null)
    {
        @* phone: the cover full-bleed across the top, fading into the ground colour (on a PC the same picture is a card, .ls-cover) *@
        <div class="ls-hero" aria-hidden="true"><Cover @key="@(Art.KeyFor(t) is { } hk ? CoverOverrides.Map(hk) : null)" ArtKey="@(Art.KeyFor(t))" Class="ls-hero-img" Full="true" /><i class="ls-fade"></i><i class="ls-scrim"></i></div>
    }
    <header class="ls-top">
        <button class="ls-icon ls-glass" @onclick="Back" aria-label="Close Now Playing"><Icon Name="chevron-down" Size="24" /></button>
        <span class="ls-where">@(t is null ? "" : WhereLine(t))</span>
        <div class="ls-tools">
            @if (t is not null)
            {
                <button class="ls-icon ls-glass ls-opt" @onclick="() => opts = !opts" aria-label="Options" aria-expanded="@(opts ? "true" : "false")"><Icon Name="sliders" Size="22" /></button>
            }
            <a class="ls-icon ls-tint np-retro" href="/retro" aria-label="Retro" title="Retro" data-testid="np-retro"><Icon Name="retro" Size="22" /></a>
        </div>
    </header>
    @if (t is not null)
    {
        <div class="ls-body">
            <section class="ls-stage">
                <div class="ls-art">
                    @* on a PC the seek bar is a frame of bars round the cover (flacie.npWave draws whichever of the frame and the ring is on screen) *@
                    <div class="ls-frame" @ref="frameEl" @onpointerdown="hold.Press" @onpointerup="hold.Release" @onpointercancel="hold.Release"><canvas class="np-frame" @ref="frameCv" aria-hidden="true"></canvas></div>
                    <button class="ls-cover" @onclick="Player.Toggle" aria-label="@(Player.Playing ? "Pause" : "Play")">
                        @* keyed on the picture really shown, so a cover chosen on MusicBrainz replaces this one at once *@
                        <Cover @key="@(Art.KeyFor(t) is { } ck ? CoverOverrides.Map(ck) : null)" ArtKey="@(Art.KeyFor(t))" Class="np-cover" Full="true" />
                    </button>
                </div>
                <div class="ls-title">
                    <div class="ls-names">
                        <h2 class="@(t.Title.Length > 26 ? "long" : "")">@Lead(t.Title)<i>@Last(t.Title)</i></h2>
                        <div class="ls-byline">
                            <p class="ls-artist"><a href="/artist/@Uri.EscapeDataString(t.AlbumArtist.Length > 0 ? t.AlbumArtist : t.Artist)" @onclick="() => GoArtist(t)" @onclick:preventDefault="true">@t.Artist</a>@if (AlbumOf(t).Length > 0) { <span class="ls-album"> · <a href="/album/@Uri.EscapeDataString(t.AlbumKey)" @onclick="() => GoAlbum(t)" @onclick:preventDefault="true">@AlbumOf(t)</a></span> }</p>
                            @* one chip for the file: what it is (or Hi-Res) and its sampling; nothing until this song's own facts are in *@
                            <span class="ls-chips">
                                @if (t.Source == TrackSource.Cloud) { <span class="badge cloud ls-chip">Streaming</span> }
                                @if (shownInfo is { Format.Length: > 0 } fi)
                                {
                                    <span class="badge fmt ls-chip @(fi.HiRes ? "hires" : "")"><span class="ls-chip-main">@(fi.HiRes ? "Hi-Res" : fi.Format)</span>@if (shownInfo is { Sampling.Length: > 0 } si) { <span class="ls-chip-dim">@si.Sampling</span> }</span>
                                }
                                @if (t.Source != TrackSource.Cloud) { <span class="ls-chip ls-from" title="Where this song plays from">@SourceLabel.PlayingFrom(t.Source)</span> }
                            </span>
                        </div>
                        <DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" Class="np-dl" />
                    </div>
                    @MoreMenu("w", t)
                    <button class="ls-heart @(Session.IsFavorite(t) ? "on" : "")" @onclick="() => { Feedback.Heart(Session, t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" Size="24" /></button>
                </div>
                <div class="ls-bar">
                    <div class="ls-times"><span>@Time(Player.Position)</span> <span class="ls-dur">/ @Time(Player.Duration)</span></div>
                    <div class="ls-transport @(Player.Dj is null ? "" : "has-dj")">
                        <button class="ls-plain @(Player.Shuffle ? "on" : "")" @onclick="Player.ToggleShuffle" aria-label="Shuffle @(Player.Shuffle ? "on" : "off")" aria-pressed="@(Player.Shuffle ? "true" : "false")"><Icon Name="shuffle" Size="22" /></button>
                        @* the DJ for this queue only (a new queue starts on what Settings and the playlist say); press and hold, or right-click, opens the DJ settings *@
                        @if (Player.Dj is not null)
                        {
                            var djOn = Player.DjOn;
                            <button class="ls-plain ls-dj @(djOn ? "on" : "")" @onclick="Player.ToggleDjAsync" @oncontextmenu="GoDjSettings" @oncontextmenu:preventDefault="true" aria-label="DJ" aria-pressed="@(djOn ? "true" : "false")" title="@(djOn ? "DJ on for this queue" : "DJ off for this queue"). Hold, or right-click, for Settings → DJ."><Icon Name="dj" Size="22" /></button>
                        }
                        <button class="ls-pillbtn" @onclick="Player.Prev" aria-label="Previous"><Icon Name="prev" Size="24" /></button>
                        @* the seek bar is a ring: the song's own loudness as bars round the play button (flacie.npWave draws it and turns a press or drag on it into a
                           seek); the range input inside is for the keyboard and screen readers *@
                        <div class="ls-ring" @ref="ringEl" @onpointerdown="hold.Press" @onpointerup="hold.Release" @onpointercancel="hold.Release">
                            <canvas class="np-wave" @ref="waveEl" aria-hidden="true"></canvas>
                            <input type="range" min="0" max="@Math.Max(1, Player.Duration)" step="1" value="@hold.Value(Player.Position)" aria-label="Seek" aria-valuetext="@Spoken(Player.Position, Player.Duration)" @oninput="hold.Input" @onchange="OnSeek" />
                            <button class="ls-play" @onclick="Player.Toggle" aria-label="@(Player.Playing ? "Pause" : "Play")"><Icon Name="@(Player.Playing ? "pause" : "play")" Size="34" /></button>
                        </div>
                        <button class="ls-pillbtn" @onclick="Player.Next" aria-label="Next"><Icon Name="next" Size="24" /></button>
                        @* talk to the DJ: on the other side of the controls from the DJ button *@
                        <DjMic />
                        <button class="ls-plain @(Player.Repeat > 0 ? "on" : "")" @onclick="Player.CycleRepeat" aria-label="@(Player.Repeat switch { 1 => "Repeat all", 2 => "Repeat one", _ => "Repeat off" })"><Icon Name="@(Player.Repeat == 2 ? "repeat-one" : "repeat")" Size="22" /></button>
                    </div>
                </div>
                <div class="ls-actions ls-phone">
                    <button class="ls-outline @(panelOpen && tab == "lyrics" ? "on" : "")" @onclick='() => Open("lyrics")'>Lyrics</button>
                    <button class="ls-outline @(panelOpen && tab == "queue" ? "on" : "")" @onclick='() => Open("queue")'>Up next</button>
                    @* the song's facts and live graphs, one tap away (as in the Android app) *@
                    <button class="ls-outline @(panelOpen && tab == "info" ? "on" : "")" @onclick='() => Open("info")'>Info</button>
                    @MoreMenu("p", t)
                </div>
            </section>
            <section class="ls-side" aria-label="@TabTitle">
                <div class="ls-side-head">
                    <div class="ls-seg" role="tablist">
                        <button role="tab" aria-selected="@(tab == "queue" ? "true" : "false")" class="@(tab == "queue" ? "on" : "")" @onclick='() => Show("queue")'>Up next</button>
                        <button role="tab" aria-selected="@(tab == "lyrics" ? "true" : "false")" class="@(tab == "lyrics" ? "on" : "")" @onclick='() => Show("lyrics")'>Lyrics</button>
                        <button role="tab" aria-selected="@(tab == "info" ? "true" : "false")" class="@(tab == "info" ? "on" : "")" @onclick='() => Show("info")'>Info</button>
                    </div>
                    <button class="ls-icon ls-phone" @onclick="() => panelOpen = false" aria-label="Back to the cover"><Icon Name="chevron-down" Size="24" /></button>
                </div>
                <div class="ls-panel" role="tabpanel">
                    @if (tab == "lyrics")
                    {
                        @if (lyricsLoading) { <p class="ls-hint">Looking for lyrics…</p> }
                        else if (lyrics is null) { <p class="ls-hint">No lyrics for this song.</p> }
                        else
                        {
                            <ol class="ls-lyrics @(lyrics.Synced ? "synced" : "")" id="lyrics">
                                @for (var i = 0; i < lyrics.Lines.Count; i++)
                                {
                                    var line = lyrics.Lines[i];
                                    <li>
                                        @if (lyrics.Synced) { <button @onclick="() => Player.Seek(line.TimeMs / 1000.0)">@(line.Text.Length == 0 ? "♪" : line.Text)</button> }
                                        else { <span>@(line.Text.Length == 0 ? " " : line.Text)</span> }
                                    </li>
                                }
                            </ol>
                            <p class="ls-hint ls-src">Lyrics from @lyrics.Source</p>
                        }
                    }
                    else if (tab == "queue")
                    {
                        <div class="q-head">
                            <div><small>Playing from</small><b>@(Player.Context ?? "Your queue")</b></div>
                            @if (Player.UpNext(1).Any()) { <button class="q-save" aria-label="Save the queue as a playlist" title="Save the queue as a playlist" @onclick="SaveQueue"><Icon Name="plus" Size="18" /><span>Save</span></button> }
                        </div>
                        <label class="switch-row">
                            <span><b>Autoplay</b><small>Add similar songs to the end of the queue</small></span>
                            <input type="checkbox" role="switch" checked="@Player.Autoplay" @onchange="e => Player.SetAutoplayAsync((bool)(e.Value ?? false))" />
                            <i class="switch" aria-hidden="true"></i>
                        </label>
                        <ol class="upnext">
                            <li class="now"><div class="q-row"><Cover ArtKey="@(Art.KeyFor(t))" Size="44" /><span><b>@t.Title</b><small>@t.Artist</small><DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" /></span><em class="eq @(Player.Playing ? "on" : "")" role="img" aria-label="Now playing"><i></i><i></i><i></i></em></div></li>
                            @{ var shownAuto = false; var fetching = Player.AutoplayFetching; var upNext = Player.UpNext(30).ToList(); var upTotal = Player.UpNextCount; var canEdit = Player.CanEdit; }
                            @for (var k = 0; k < upNext.Count; k++)
                            {
                                var (i, u) = upNext[k]; var place = k + 1; var first = k == 0; var last = k == upTotal - 1;
                                @if (!shownAuto && Player.AutoplayFrom >= 0 && i >= Player.AutoplayFrom)
                                {
                                    shownAuto = true;
                                    <li class="q-divider">Autoplay · similar to what you were playing</li>
                                }
                                <li class="q-item">
                                    <button class="q-row" @onclick="() => Player.SkipTo(i)"><Cover ArtKey="@(Art.KeyFor(u))" Size="44" /><span><b>@u.Title</b><small>@u.Artist@(u.Album.Length > 0 ? " · " + u.Album : "")</small><DownloadTag Session="Session" Artist="@u.Artist" Title="@u.Title" Track="u" /></span><span class="q-time">@Time(u.DurationMs / 1000.0)</span></button>
                                    @if (canEdit)
                                    {
                                        <div class="q-edit">
                                            <button class="q-up" aria-label="@("Move " + u.Title + " up")" title="Move up" disabled="@first" @onclick="() => Player.MoveUpNext(i, QueueEdit.Step.Up)"><Icon Name="chevron-up" Size="18" /></button>
                                            <button class="q-down" aria-label="@("Move " + u.Title + " down")" title="Move down" disabled="@last" @onclick="() => Player.MoveUpNext(i, QueueEdit.Step.Down)"><Icon Name="chevron-down" Size="18" /></button>
                                            <button class="q-top" aria-label="@("Move " + u.Title + " to the top of the queue")" title="Play next" disabled="@first" @onclick="() => Player.MoveUpNext(i, QueueEdit.Step.Top)"><Icon Name="next" Size="18" /></button>
                                            <button class="q-remove" aria-label="@("Remove " + u.Title + " from the queue")" title="Remove from the queue" @onclick="() => RemoveUpNext(i, u, place)"><Icon Name="x" Size="18" /></button>
                                        </div>
                                    }
                                </li>
                            }
                            @if (shownAuto)
                            {
                                @* the autoplay part of the queue: songs being fetched for it are listed under the ones already there *@
                                @foreach (var f in fetching) { @Pending(f) }
                            }
                            @if (!Player.UpNext(1).Any() && Player.Autoplay && (Player.AutoplayNext.Count > 0 || fetching.Count > 0))
                            {
                                <li class="q-divider">Autoplay · up next after this</li>
                                @foreach (var u in Player.AutoplayNext)
                                {
                                    <li class="q-item">
                                        <button class="q-row" @onclick="() => Player.Play([u], 0, Player.Context)"><Cover ArtKey="@(Art.KeyFor(u))" Size="44" /><span><b>@u.Title</b><small>@u.Artist@(u.Album.Length > 0 ? " · " + u.Album : "")</small><DownloadTag Session="Session" Artist="@u.Artist" Title="@u.Title" Track="u" /></span><span class="q-time">@Time(u.DurationMs / 1000.0)</span></button>
                                        @if (canEdit) { <div class="q-edit"><button class="q-top" aria-label="@("Put " + u.Title + " at the top of the queue")" title="Play next" @onclick="() => Player.PlayNext(u)"><Icon Name="next" Size="18" /></button></div> }
                                    </li>
                                }
                                @foreach (var f in fetching) { @Pending(f) }
                            }
                        </ol>
                        @if (!Player.UpNext(1).Any() && (!Player.Autoplay || (Player.AutoplayNext.Count == 0 && fetching.Count == 0))) { <p class="hint">Nothing after this song. Turn Autoplay on to keep the music going.</p> }
                    }
                    else
                    {
                        <div class="ls-info">
                            @if (Player.WhyCurrent is { Length: > 0 } why) { <section class="ls-why" aria-label="Why this song?"><h4>Why this song?</h4><p>@why</p></section> }
                            <TrackInfoPanel Track="t" Info="shownInfo" Loading="@(infoLoading || infoFor != t.Path)" Album="@(realAlbumFor == t.Path ? realAlbum : null)" />
                        </div>
                    }
                </div>
            </section>
        </div>
        @* PC: one now-playing bar along the bottom holding every button (no seek bar or time: the frame round the cover is the seek bar); the transport sits in
           its middle. Phone: the bar is not drawn; its rating, speed, sleep and sound buttons open from the top bar's Options as before *@
        <footer class="ls-dock">
            <div class="ls-dock-l">
                <button class="ls-heart ls-dock-heart @(Session.IsFavorite(t) ? "on" : "")" @onclick="() => { Feedback.Heart(Session, t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" Size="22" /></button>
                @MoreMenu("d", t)
            </div>
            @* the room the transport takes in the middle of the bar (it is placed over this from the page), so the two sides never reach under it *@
            <div class="ls-dock-c" aria-hidden="true"></div>
            <div class="ls-dock-r">
                <div class="ls-toolset"><RatingMenu /><SpeedSleep /></div>
                <div class="ls-volume"><VolumeControl /></div>
            </div>
        </footer>
    }
</div>
@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Inject] LyricsService LyricsSvc { get; set; } = default!;
    [Inject] ITrackInfo Infos { get; set; } = default!;
    [Inject] IJSRuntime Js { get; set; } = default!;
    string? realAlbum, realAlbumFor;
    string AlbumOf(Track t) => realAlbumFor == t.Path && realAlbum is { Length: > 0 } a ? a : t.Album;
    DotNetObjectReference<NowPlaying>? self;
    string tab = "queue"; string? shownTab = "queue";
    // closing plays the slide-down (the cover pops down) before the player is taken out of the page
    bool closing;
    /// <summary>A sideways swipe on the phone player moves between its panes, left to right: Lyrics, the cover, Info, Up next (a swipe no longer skips the song).</summary>
    [JSInvokable] public void PaneSwipe(int dir) => InvokeAsync(() =>
    {
        string[] order = ["lyrics", "cover", "info", "queue"];
        var i = Array.IndexOf(order, panelOpen ? tab : "cover") + dir;
        if (i < 0 || i >= order.Length) return;
        if (order[i] == "cover") panelOpen = false; else { tab = order[i]; panelOpen = true; if (tab == "lyrics") _ = LoadLyrics(); }
        StateHasChanged();
    });
    [JSInvokable] public async Task Closed()
    {
        await InvokeAsync(async () => { closing = true; StateHasChanged(); await Task.Delay(260); });
        await OnClose.InvokeAsync();
    }
    [Inject] Toasts Toast { get; set; } = default!;
    [Inject] Sharing Sharing { get; set; } = default!;

    /// <summary>Takes a song out of Up next and offers it back (Undo puts it in the same place).</summary>
    async Task RemoveUpNext(int queueIndex, Track u, int place)
    {
        await Player.RemoveFromQueue(queueIndex);
        Toast.Show($"Removed “{u.Title}” from the queue", "Undo", () => { Player.InsertUpNext(u, place); Toast.Dismiss(); });
    }

    /// <summary>The queue as it will play (the current song first) becomes a new playlist, named after where it is playing from.</summary>
    void SaveQueue()
    {
        if (Player.Current is not { } cur) return;
        var songs = new List<Track> { cur };
        songs.AddRange(Player.UpNext(Player.UpNextCount).Select(x => x.Item2));
        var baseName = (Player.Context ?? "My queue") + " (queue)";
        var name = baseName;
        for (var n = 2; Session.Playlists.Any(p => p.Name.Equals(name, StringComparison.OrdinalIgnoreCase)); n++) name = $"{baseName} {n}";
        var pl = Session.CreatePlaylist(name);
        Session.ReplacePlaylistTracks(pl.Id, songs);
        SaveProfile();
        Toast.Show($"Saved the queue as “{name}”");
    }

    // the "..." menu: closes on a click anywhere outside it or Escape (flacie.watchOutside calls Dismiss)
    bool more, plOpen, opts; string moreAt = "w";
    [JSInvokable] public void Dismiss() => InvokeAsync(() => { CloseMore(); StateHasChanged(); });
    async Task ToggleMore(string at)
    {
        more = !(more && moreAt == at); moreAt = at; plOpen = false;
        if (more && self is not null) { try { await Js.InvokeVoidAsync("flacie.watchOutside", ".np-more." + at, self); } catch (Exception) { } }
        else { try { await Js.InvokeVoidAsync("flacie.unwatchOutside"); } catch (Exception) { } }
    }
    // a link out of the player keeps its #now-playing history entry, so Back returns to the full-screen player you came from
    Task GoArtist(Track t) => Go("/artist/" + Uri.EscapeDataString(t.AlbumArtist.Length > 0 ? t.AlbumArtist : t.Artist));
    Task GoAlbum(Track t) => Go("/album/" + Uri.EscapeDataString(t.AlbumKey));
    Task Go(string url) { CloseMore(); Nav.NavigateTo(url); return Task.CompletedTask; }
    const string DjSettingsUrl = "/settings#dj";
    // out of the full-screen player to Settings → DJ: the player closes first (flacie.npGo), so the settings are not left underneath it
    async Task GoDjSettings()
    {
        CloseMore();
        try { await Js.InvokeVoidAsync("flacie.npGo", DjSettingsUrl); } catch (Exception) { await OnClose.InvokeAsync(); Nav.NavigateTo(DjSettingsUrl); }
    }
    void CloseMore() { more = false; plOpen = false; _ = Js.InvokeVoidAsync("flacie.unwatchOutside").AsTask().ContinueWith(_ => { }); }
    void Plain(Action act, string message) { act(); Toast.Show(message); CloseMore(); }
    static string FileName(Track t) => string.Concat($"{t.Artist} - {t.Title}".Split(Path.GetInvalidFileNameChars())) + (MediaInfo.FromExtension(t.FilePath ?? "") is { Length: > 0 } e ? "." + e : "");
    // on a phone the first Back closes an open sheet (back to the cover), the next one closes the player
    async Task Back()
    {
        try { if (panelOpen && await Js.InvokeAsync<bool>("flacie.sheetMode")) { panelOpen = false; return; } } catch (Exception) { }
        try { await Js.InvokeVoidAsync("flacie.npBack"); } catch (Exception) { await OnClose.InvokeAsync(); }
    }
    string TabTitle => tab switch { "lyrics" => "Lyrics", "info" => "Info", _ => "Up next" };
    // the "Downloading · ..." / "Recently downloaded · 1s ago" line under a song is the DownloadTag component: it follows the downloads by itself. What this player has to
    // watch is which Autoplay suggestions are being fetched (they get a row of their own until they land), so a download starting or ending redraws it only when that changes.
    [Inject] IDownloads Dls { get; set; } = default!;
    Action? onDls; string fetchSig = "";
    string FetchSig() => string.Join(";", Player.AutoplayFetching.Select(f => f.Title + "|" + f.Artist));
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        fetchSig = FetchSig();
        onDls = () => { var sig = FetchSig(); if (sig == fetchSig) return; fetchSig = sig; _ = InvokeAsync(StateHasChanged); };
        Dls.Subscribe(Session, onDls);
    }
    /// <summary>A suggestion that is being downloaded and is not in the library yet: a row that says so, then the song itself takes its place.</summary>
    RenderFragment Pending(CatalogSong f) => @<li class="q-item q-pending">
        <div class="q-row"><Cover ArtKey="@(f.ArtUrl is null ? null : Art.ExternalKey(f.ArtUrl))" Size="44" /><span><b>@f.Title</b><small>@f.Artist@(f.Album.Length > 0 ? " · " + f.Album : "")</small><DownloadTag Session="Session" Artist="@f.Artist" Title="@f.Title" /></span><span class="q-time">@Time(f.DurationMs / 1000.0)</span></div>
    </li>;
    public override void Dispose() { infoCts?.Cancel(); if (onDls is not null) Dls.Unsubscribe(Session, onDls); self?.Dispose(); _ = Js.InvokeVoidAsync("flacie.npWaveStop").AsTask().ContinueWith(_ => { }); _ = Js.InvokeVoidAsync("flacie.npReset").AsTask().ContinueWith(_ => { }); base.Dispose(); }
    /// <summary>The "..." menu: drawn beside the heart (PC) and in the phone's lower row; only one of the two is shown, and it opens where it was pressed.</summary>
    RenderFragment MoreMenu(string at, Track t) => @<div class="np-more @at">
        <button class="ls-icon ls-more-btn" @onclick="() => ToggleMore(at)" aria-label="More options" aria-haspopup="menu" aria-expanded="@(more && moreAt == at ? "true" : "false")"><Icon Name="more" Size="22" /></button>
        @if (more && moreAt == at)
        {
            <div class="menu np-menu" role="menu">
                <button role="menuitem" @onclick='() => Plain(() => Player.PlayNext(t), $"“{t.Title}” plays next")'>Play next</button>
                <button role="menuitem" @onclick='() => Plain(() => Player.AddToQueue(t), $"Added “{t.Title}” to the queue")'>Add to queue</button>
                <button role="menuitem" aria-expanded="@(plOpen ? "true" : "false")" @onclick="() => plOpen = !plOpen">Add to playlist <span aria-hidden="true">@(plOpen ? "▾" : "▸")</span></button>
                @if (plOpen)
                {
                    @if (!Session.Playlists.Any()) { <small class="menu-note">No playlists yet. Make one on the Playlists page.</small> }
                    @foreach (var p in Session.Playlists)
                    {
                        <button role="menuitem" class="sub" @onclick="() => { Toast.Added(Session, p, t, SaveProfile); CloseMore(); }">@p.Name</button>
                    }
                }
                <a role="menuitem" href="/artist/@Uri.EscapeDataString(t.AlbumArtist.Length > 0 ? t.AlbumArtist : t.Artist)" @onclick="() => GoArtist(t)" @onclick:preventDefault="true">Go to artist</a>
                @if (t.Album.Length > 0) { <a role="menuitem" href="/album/@Uri.EscapeDataString(t.AlbumKey)" @onclick="() => GoAlbum(t)" @onclick:preventDefault="true">Go to album</a> }
                <a role="menuitem" href="/stream?p=@Uri.EscapeDataString(t.Path)" download="@FileName(t)" @onclick="CloseMore">Download</a>
                <button role="menuitem" @onclick='async () => { CloseMore(); await Sharing.ShareAsync(Session, "song", t.Title, [t]); }'>Share</button>
                <button role="menuitem" @onclick='() => { Open("info"); CloseMore(); }'>Song info</button>
                <button role="menuitem" @onclick='() => Plain(() => Feedback.LessLikeThis(Session, t), $"Fewer songs like “{t.Title}”")'>Less like this</button>
                <button role="menuitem" @onclick='() => Plain(() => _ = Feedback.ThumbDown(Session, t, Player), $"“{t.Title}” will not be picked for you again")'>Thumbs down</button>
                <DjSongMenu Player="Player" Session="Session" Song="t" OnDone="CloseMore" />
            </div>
        }
    </div>;
    // the title's last word is set in italics (design I)
    static string Lead(string title) { var s = title.TrimEnd(); var i = s.LastIndexOf(' '); return i < 0 ? "" : s[..(i + 1)]; }
    static string Last(string title) { var s = title.TrimEnd(); var i = s.LastIndexOf(' '); return i < 0 ? s : s[(i + 1)..]; }
    // the top pill: "ALBUM · TRACK n", or where it plays from when the song has no album or number
    string WhereLine(Track t) => AlbumOf(t) is { Length: > 0 } a && t.TrackNo > 0 ? $"{a.ToUpperInvariant()} · TRACK {t.TrackNo}" : SourceLabel.PlayingFromLine(t.Source);
    Lyrics? lyrics; bool lyricsLoading; string? lyricsFor;
    MediaInfo? info; bool infoLoading; string? infoFor;
    MediaInfo? shownInfo => Player.Current is { } cur && infoFor == cur.Path ? info : null;
    string? lyricsPushed;

    // on a phone the panel is a sheet over the cover: a tab opens it, the same tab again closes it (on a wide screen it is always there)
    ElementReference npEl, waveEl, ringEl, frameEl, frameCv;
    string? accentFor = "", waveFor;
    void OpenQueue() { tab = "queue"; panelOpen = true; }
    void PeekKey(KeyboardEventArgs e) { if (e.Key is "Enter" or " ") OpenQueue(); }
    bool panelOpen;
    void Show(string t) { tab = t; panelOpen = true; if (t == "lyrics") _ = LoadLyrics(); }
    void Open(string t) { if (tab == t && panelOpen) { panelOpen = false; return; } tab = t; panelOpen = true; if (t == "lyrics") _ = LoadLyrics(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { self = DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("flacie.npOpen", self); } catch (Exception) { } }
        if (shownTab != tab) { shownTab = tab; try { await Js.InvokeVoidAsync("flacie.panelTop"); } catch (Exception) { } }
        if (Player.Current is not { } t) return;
        // the player's colour comes from the cover: read once per cover in the browser (flacie.js npAccent)
        var coverUrl = Art.KeyFor(t) is { } art ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(art)!) : null;
        if (coverUrl != accentFor) { accentFor = coverUrl; try { await Js.InvokeVoidAsync("flacie.npAccent", npEl, coverUrl); } catch (Exception) { } }
        // the seek bar's shape: this song's own loudness (the server works it out once)
        if (t.Path != waveFor) { waveFor = t.Path; try { await Js.InvokeVoidAsync("flacie.npWave", waveEl, "/api/wave?p=" + Uri.EscapeDataString(t.Path), ringEl, frameCv, frameEl); } catch (Exception) { } }
        // a new song: refresh whatever is showing
        if (infoFor != t.Path) { await LoadInfo(); _ = LoadRealAlbum(t); }
        if (tab == "lyrics" && lyricsFor != t.Path) await LoadLyrics();
        // the highlight runs in the browser (flacie.js) off the audio clock itself, so it never trails the singer by a round trip
        var wantLyrics = tab == "lyrics" && lyrics is { Synced: true } ? t.Path : null;
        if (wantLyrics != lyricsPushed)
        {
            lyricsPushed = wantLyrics;
            try { if (wantLyrics is null) await Js.InvokeVoidAsync("flacie.clearLyrics"); else await Js.InvokeVoidAsync("flacie.setLyrics", lyrics!.Lines.Select(l => l.TimeMs).ToArray()); } catch (Exception) { }
        }
    }

    // a song filed on a compilation shows the album it really belongs to
    async Task LoadRealAlbum(Track t)
    {
        realAlbumFor = null; realAlbum = null;
        if (!Art.OnCompilation(t.Artist, t.AlbumArtist, t.Album)) return;
        if (AppHost.OnlineAlbum is not { } online) return;
        var album = await online(t.Artist, t.Title, CancellationToken.None);
        if (Player.Current?.Path != t.Path || album is not { Length: > 0 }) return;
        realAlbum = album; realAlbumFor = t.Path;
        await InvokeAsync(StateHasChanged);
    }

    CancellationTokenSource? infoCts;

    async Task LoadInfo()
    {
        if (Player.Current is not { } t) return;
        // the song before this one is no longer wanted: its read is cancelled (a request still queued at the gate never reaches Jellyfin)
        infoCts?.Cancel();
        var cts = infoCts = new CancellationTokenSource(); var ct = cts.Token;
        infoFor = t.Path; infoLoading = true; info = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            // a burst of skips must not ask Jellyfin about every song it passes: a song whose facts are not known yet waits a moment, and is dropped if the queue moved on
            if (!Infos.IsCached(t)) { await Task.Delay(300, ct); if (infoFor != t.Path) return; }
            var got = await Infos.GetAsync(Session, t, ct: ct);
            if (infoFor == t.Path) { info = got; infoLoading = false; }
            await InvokeAsync(StateHasChanged);
            // the source could not tell yet (nothing was cached): ask again a few times, for this song only, so a hiccup never leaves a guess on screen
            for (var retry = 0; retry < 4 && infoFor == t.Path && !got.Known; retry++)
            {
                await Task.Delay(2000, ct);
                if (infoFor != t.Path) return;
                got = await Infos.GetAsync(Session, t, ct: ct);
                if (infoFor == t.Path && got.Known) { info = got; await InvokeAsync(StateHasChanged); }
            }
        }
        catch (OperationCanceledException) { }
    }

    async Task LoadLyrics()
    {
        if (Player.Current is not { } t) return;
        lyricsFor = t.Path; lyricsLoading = true; lyrics = null; lyricsPushed = null;
        await InvokeAsync(StateHasChanged);
        var got = await LyricsSvc.GetAsync(t, Session.Jellyfin);
        if (lyricsFor == t.Path) { lyrics = got; lyricsLoading = false; }
        await InvokeAsync(StateHasChanged);
    }

    static string SourceName(Track t) => SourceLabel.PlayingFrom(t.Source);
    readonly SeekHold hold = new();
    Task OnSeek(ChangeEventArgs e) { if (!SeekHold.Parse(e.Value, out var s)) return Task.CompletedTask; hold.Changed(s); return Player.Seek(s); }
}
