@inherits UserComponent
@if (Player.Current is { } t)
{
    @if (open) { <NowPlaying OnClose="() => open = false" /> }
    @* data-pip-*: what the mini player (flacie-pip.js) shows beside the song: the next song and the seek bar's loudness shape *@
    <section class="player" aria-label="Player" @ref="barEl" data-pip-path="@t.Path" data-pip-next="@NextLine()">
        <input class="bar-progress" type="range" min="0" max="@Math.Max(1, Player.Duration)" step="1" value="@hold.Value(Player.Position)" aria-label="Seek" aria-valuetext="@Spoken(Player.Position, Player.Duration)" style="@Fill(hold.Value(Player.Position), Player.Duration)" @onpointerdown="hold.Press" @onpointerup="hold.Release" @onpointercancel="hold.Release" @oninput="hold.Input" @onchange="OnSeek" />
        <div class="bar" @onclick="() => open = true">
            <button class="bar-song" data-np @key="t.Path" @onclick="() => open = true" aria-label="Open Now Playing">
                <Cover ArtKey="@(Art.KeyFor(t))" Size="52" Eager="true" />
                <span class="bar-text"><b>@Title(t.Title)</b><small>@t.Artist</small>@if (chip is { Length: > 0 }) { <span class="bar-chip">@chip</span> }<DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" /></span>
            </button>
            <div class="bar-controls">
                <div class="buttons" @onclick:stopPropagation="true">
                    <button class="icon-btn @(Player.Shuffle ? "on" : "")" data-pip="shuffle" @onclick="Player.ToggleShuffle" aria-label="Shuffle @(Player.Shuffle ? "on" : "off")" aria-pressed="@(Player.Shuffle ? "true" : "false")"><Icon Name="shuffle" /></button>
                    <button class="icon-btn" @onclick="Player.Prev" aria-label="Previous"><Icon Name="prev" Size="22" /></button>
                    <button class="play" @onclick="Player.Toggle" aria-label="@(Player.Playing ? "Pause" : "Play")"><Icon Name="@(Player.Playing ? "pause" : "play")" Size="22" /></button>
                    <button class="icon-btn" @onclick="Player.Next" aria-label="Next"><Icon Name="next" Size="22" /></button>
                    <button class="icon-btn @(Player.Repeat > 0 ? "on" : "")" data-pip="repeat" @onclick="Player.CycleRepeat" aria-label="@(Player.Repeat switch { 1 => "Repeat all", 2 => "Repeat one", _ => "Repeat off" })"><Icon Name="@(Player.Repeat == 2 ? "repeat-one" : "repeat")" /></button>
                </div>
                <div class="seek" @onclick:stopPropagation="true">
                    <span>@Time(Player.Position)</span>
                    <input type="range" min="0" max="@Math.Max(1, Player.Duration)" step="1" value="@hold.Value(Player.Position)" aria-label="Seek" aria-valuetext="@Spoken(Player.Position, Player.Duration)" style="@Fill(hold.Value(Player.Position), Player.Duration)" @onpointerdown="hold.Press" @onpointerup="hold.Release" @onpointercancel="hold.Release" @oninput="hold.Input" @onchange="OnSeek" />
                    <span>@Time(Player.Duration)</span>
                </div>
            </div>
            <div class="bar-right" @onclick:stopPropagation="true">
                @* the DJ for this queue and the mic to talk to it, together beside the heart (in the play buttons' group the mic pushed onto the heart at 900px
                   wide, and on a phone it took the place of the hidden Repeat) *@
                @if (Player.Dj is not null)
                {
                    var djOn = Player.DjOn;
                    <button class="icon-btn bar-dj @(djOn ? "on" : "")" data-pip="dj" @onclick="Player.ToggleDjAsync" aria-label="DJ" aria-pressed="@(djOn ? "true" : "false")" title="@(djOn ? "DJ on for this queue" : "DJ off for this queue")"><Icon Name="dj" Size="20" /></button>
                }
                <DjMic Class="icon-btn" Size="20" />
                <button class="icon-btn fav @(Session.IsFavorite(t) ? "on" : "")" data-pip="heart" @onclick="() => { Feedback.Heart(Session, t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" /></button>
                @if (AppHost.DevicePicker is { } picker) { <DynamicComponent Type="picker" /> }
                @* Retro and the mini player, in words behind one More (owner, 7 Nov: "icons nobody understands") *@
                <div class="bar-more">
                    <button class="icon-btn" @onclick="ToggleBarMore" aria-label="More player options" aria-haspopup="menu" aria-expanded="@(barMore ? "true" : "false")" title="More"><Icon Name="more" /></button>
                    @if (barMore)
                    {
                        <div class="menu bar-menu" role="menu">
                            <a role="menuitem" class="retro-link" href="/retro" aria-label="Retro" data-testid="bar-retro" @onclick="() => barMore = false"><Icon Name="retro" Size="18" /><span><b>Retro</b><small>Music players, a car stereo, a hi-fi…</small></span></a>
                            @if (pipOk) { <button role="menuitem" class="@(pipOn ? "on" : "")" @onclick="async () => { barMore = false; await TogglePip(); }" aria-label="Mini player (picture in picture)"><Icon Name="pip" Size="18" /><span><b>Mini player@(pipOn ? " (on)" : "")</b><small>Cover and controls on top of other tabs</small></span></button> }
                        </div>
                    }
                </div>
                <VolumeControl />
                <button class="icon-btn" data-np @onclick="() => open = true" aria-label="Full screen player"><Icon Name="expand" /></button>
                <button class="icon-btn" @onclick="Player.StopAsync" aria-label="Stop playing and close the player" title="Stop playing"><Icon Name="x" /></button>
            </div>
        </div>
    </section>
}
@code {
    // drawn again on each tick of the player's clock: the bar shows the time and the progress line
    protected override bool FollowsTime => true;
    bool open, volumeLoaded, pipOk, pipOn, barMore;
    // the bar's More menu closes on a click anywhere outside it or Escape (flacie.watchOutside calls DismissBarMore)
    DotNetObjectReference<PlayerBar>? barSelf;
    async Task ToggleBarMore()
    {
        barMore = !barMore;
        barSelf ??= DotNetObjectReference.Create(this);
        try { if (barMore) await PageJs.InvokeVoidAsync("flacie.watchOutside", ".bar-more", barSelf); else await PageJs.InvokeVoidAsync("flacie.unwatchOutside"); } catch (Exception) { }
    }
    [JSInvokable] public void Dismiss() => InvokeAsync(() => { barMore = false; StateHasChanged(); });
    ElementReference barEl;
    [Inject] ITrackInfo Infos { get; set; } = default!;
    string? accentFor = "", chipFor, chip;
    CancellationTokenSource? chipCts;
    // the serif title with its last word in italics, like the full-screen player
    static RenderFragment Title(string title) => b =>
    {
        var s = title.TrimEnd(); var i = s.LastIndexOf(' ');
        if (i < 0) { b.OpenElement(0, "i"); b.AddContent(1, s); b.CloseElement(); return; }
        b.AddContent(0, s[..(i + 1)]); b.OpenElement(1, "i"); b.AddContent(2, s[(i + 1)..]); b.CloseElement();
    };
    // the format chip ("FLAC 24/96") comes from the file's facts; a song nobody has asked about yet is read after a pause, so skipping through songs asks Jellyfin about none of them
    async Task LoadChip(Track t)
    {
        chipCts?.Cancel(); var cts = chipCts = new CancellationTokenSource(); chip = null; chipFor = t.Path;
        try
        {
            if (!Infos.IsCached(t)) await Task.Delay(1200, cts.Token);
            var m = await Infos.GetAsync(Session, t, retry: false, ct: cts.Token);
            if (cts.IsCancellationRequested || !m.Known) return;
            chip = m.HiRes ? "Hi-Res " + m.Format : m.Format;
            if (m.SampleRateHz > 0) chip += " " + (m.BitDepth > 0 ? m.BitDepth + "/" : "") + (m.SampleRateHz % 1000 == 0 ? (m.SampleRateHz / 1000).ToString() : Math.Round(m.SampleRateHz / 1000.0, 1).ToString(System.Globalization.CultureInfo.InvariantCulture));
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception) { }
    }
    async Task TogglePip() { try { pipOn = await PageJs.InvokeAsync<bool>("flacie.pipToggle"); } catch (Exception) { pipOn = false; } lyricsFor = null; if (pipOn && Player.Current is { } c) await SendLyrics(c); }

    /// <summary>The mini player's "Next:" line: the song after this one (Up next, else Autoplay's), "Title · Artist".</summary>
    string NextLine() => Player.UpNext(1).Select(u => u.Track).Concat(Player.AutoplayNext).FirstOrDefault() is { } n ? $"{n.Title} · {n.Artist}" : "";

    // the line being sung, in the mini player: the song's synced lyrics are sent once per song while it is open
    [Inject] LyricsService LyricsSvc { get; set; } = default!;
    string? lyricsFor, pipCheckedFor;
    async Task SendLyrics(Track t)
    {
        if (lyricsFor == t.Path) return;
        lyricsFor = t.Path;
        try
        {
            var l = await LyricsSvc.GetAsync(t, Session.Jellyfin);
            var lines = l is { Synced: true } ? l.Lines.Where(x => x.TimeMs >= 0).Select(x => new { t = x.TimeMs, text = x.Text }).ToArray() : [];
            if (lyricsFor == t.Path) await PageJs.InvokeVoidAsync("flacie.pipLyrics", (object)lines);
        }
        catch (Exception) { }
    }
    [Inject] IPlayerClients Registry { get; set; } = default!;
    [Inject] IServiceProvider Services { get; set; } = default!;
    [Inject] IJSRuntime PageJs { get; set; } = default!;
    sealed record ClientInfo(string Ip, string Ua, string Browser, string Os, string Screen, string Language);
    string? clientId;
    async Task RegisterClient()
    {
        try
        {
            var ci = await PageJs.InvokeAsync<ClientInfo>("flacie.clientInfo");
            clientId = Guid.NewGuid().ToString("N");
            // the page's connection where the host keeps one (the server): the dashboard lists only pages connected now
            Registry.Add(clientId, Session, Player, ci.Ip, ci.Ua, ci.Browser, ci.Os, ci.Screen, ci.Language, Services.GetService(typeof(CircuitPresence)) as CircuitPresence);
        }
        catch (Exception) { }
    }
    // the full-screen player sits over the page, so any navigation (the account menu, a link in the player, Back) has to close it first
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        var here = new Uri(Nav.Uri); lastPath = here.AbsolutePath + here.Query;
        Nav.LocationChanged += OnNavigated;
        Player.Started += OnStarted;
        Player.FullScreenRequested += OnFullScreen;
        Player.DjAskSaid += OnDjSaid;
        Player.Problem += OnProblem;
    }
    [Inject] Toasts DjToast { get; set; } = default!;
    // a song asked for through the mic has landed and is playing
    void OnDjSaid(string line) => _ = InvokeAsync(() => DjToast.Show(line));
    // the music itself failed (Jellyfin did not answer a song): said as a warning, long enough to read
    void OnProblem(string line) => _ = InvokeAsync(() => DjToast.Show(line, warn: true, seconds: 8));
    void OnFullScreen() => InvokeAsync(() => { open = true; StateHasChanged(); });
    string? lastPath;
    DotNetObjectReference<PlayerBar>? barRef;
    /// <summary>Back onto the "#now-playing" history entry (from a page the player linked to) brings the full-screen player back.</summary>
    [JSInvokable] public void ReopenFull() => InvokeAsync(() => { open = true; StateHasChanged(); });
    void OnNavigated(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // only a real page change closes it at once; the #now-playing in the address coming and going is the player's own open/close (which animates)
        var path = new Uri(e.Location).AbsolutePath + new Uri(e.Location).Query;
        var moved = lastPath is not null && path != lastPath; lastPath = path;
        if (new Uri(e.Location).Fragment == "#now-playing") { if (moved) InvokeAsync(() => { open = true; StateHasChanged(); }); return; }   // arrived Back onto the player's own history entry: it stays (or comes back)
        if (open && moved) InvokeAsync(() => { open = false; StateHasChanged(); });
    }
    [Inject] ActivityLog Activity { get; set; } = default!;
    void OnStarted(Track t)
    {
        Activity.Add("play", Session.DisplayName, $"Started {t.Title} by {t.Artist} in the web player"); if (Session.RecordPlay(t)) SaveProfile();
        // the next two songs' seek-bar shapes are made ready now, so each is drawn the moment it starts (flacie.npWavePrefetch; not on mobile data)
        var next = Player.UpNext(2).Select(u => u.Track).Concat(Player.AutoplayNext).Take(2).Select(u => u.Path).ToArray();
        if (next.Length > 0) _ = InvokeAsync(async () => { try { await PageJs.InvokeVoidAsync("flacie.npWavePrefetch", (object)next); } catch (Exception) { } });
    }
    public override void Dispose() { barRef?.Dispose(); if (clientId is not null) Registry.Remove(clientId); Nav.LocationChanged -= OnNavigated; Player.Started -= OnStarted; Player.FullScreenRequested -= OnFullScreen; Player.DjAskSaid -= OnDjSaid; Player.Problem -= OnProblem; base.Dispose(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Player.Current is { } cur)
        {
            // the bar's colours come from the cover, read once per cover in the browser (flacie.js npAccent)
            var coverUrl = Art.KeyFor(cur) is { } art ? "/art/" + Uri.EscapeDataString(CoverOverrides.Map(art)!) : null;
            if (coverUrl != accentFor) { accentFor = coverUrl; try { await PageJs.InvokeVoidAsync("flacie.npAccent", barEl, coverUrl); await PageJs.InvokeVoidAsync("flacie.appAccent", coverUrl); } catch (Exception) { } }
            if (chipFor != cur.Path) _ = LoadChip(cur);
            // the mini player may also have been opened by the browser itself (switching tabs while music plays)
            if (lyricsFor != cur.Path && pipCheckedFor != cur.Path) { pipCheckedFor = cur.Path; try { if (await PageJs.InvokeAsync<bool>("flacie.pipActive")) await SendLyrics(cur); } catch (Exception) { } }
        }
        if (!volumeLoaded)
        {
            volumeLoaded = true;
            try { await Player.LoadVolumeAsync(); await Player.LoadAutoplayAsync(); } catch (InvalidOperationException) { }
            Player.SetStashKey(Session.Jellyfin?.UserId ?? Session.Nas?.User ?? "guest");
            _ = Player.RestoreAsync(Session);
            _ = RegisterClient();
            try { pipOk = await PageJs.InvokeAsync<bool>("flacie.pipSupported"); StateHasChanged(); } catch (Exception) { }
            barRef = DotNetObjectReference.Create(this); try { await PageJs.InvokeVoidAsync("flacie.setBarRef", barRef); } catch (Exception) { }
        }
    }
    readonly SeekHold hold = new();
    Task OnSeek(ChangeEventArgs e) { if (!SeekHold.Parse(e.Value, out var s)) return Task.CompletedTask; hold.Changed(s); return Player.Seek(s); }
    static string Fill(double v, double max) => $"--fill:{(max > 0 ? Math.Clamp(v / max * 100, 0, 100) : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
}
