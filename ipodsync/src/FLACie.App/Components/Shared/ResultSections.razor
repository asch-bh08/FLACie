@inherits UserComponent
@inject ExploreState X
@* The stacked, full-width overview used by Explore (Overview tab) and Search: a Top result banner with big cover art, Songs as a list with small thumbnails,
   Albums in a row of big square covers, Artists in a row of round avatars, then Playlists and Genres. The filter pills (shared with Explore) narrow every section.
   With a query the results are ranked (typos are forgiven); without one it is a browse view (newest songs and albums, biggest artists). *@
@{
    var q = Query.Trim();
    var ranked = q.Length > 0;
    var words = FLACie.Core.Matching.SearchWords(q);
    IReadOnlyList<Track> songsAll; IReadOnlyList<Group> albumsAll, artistsAll;
    var fuzzy = false; var suggestion = "";
    if (ranked)
    {
        var r = Lib.Search(q);
        songsAll = r.Songs; albumsAll = r.Albums; artistsAll = r.Artists;
        if (r.Songs.Count == 0 && r.Albums.Count == 0 && r.Artists.Count == 0 && words.Count > 0)
        {
            // nothing matches exactly: close matches (a couple of typos), and what was probably meant
            fuzzy = true;
            songsAll = Lib.Songs.Where(t => FLACie.Core.Matching.FuzzyHit(words, t.Title, t.Artist, t.Album)).Take(100).ToList();
            albumsAll = Lib.Albums.Where(g => FLACie.Core.Matching.FuzzyHit(words, g.Name, g.Tracks[0].AlbumArtist.Length > 0 ? g.Tracks[0].AlbumArtist : g.Tracks[0].Artist)).Take(24).ToList();
            artistsAll = Lib.Artists.Where(g => FLACie.Core.Matching.FuzzyHit(words, g.Name)).Take(12).ToList();
            suggestion = FLACie.Core.Matching.Suggest(words, songsAll.Select(t => new[] { t.Title, t.Artist, t.Album }).Concat(artistsAll.Select(g => new[] { g.Name })));
        }
    }
    else
    {
        songsAll = Lib.Songs.Where(X.Allows).OrderByDescending(t => t.AddedMs).Take(60).ToList();
        albumsAll = Lib.RecentAlbums(60);
        artistsAll = Lib.Artists.OrderByDescending(g => g.Tracks.Count).Take(24).ToList();
    }
    var songs = Sorted(songsAll.Where(X.Allows).ToList());
    var albums = SortedAlbums(albumsAll.Where(g => g.Tracks.Any(X.Allows)).ToList());
    var artists = artistsAll.Where(g => g.Tracks.Any(X.Allows)).ToList();
    var plays = FindPlaylists(words);
    // a playlist named like the search is an answer on its own (owner, 26 Nov: "2026"): nothing in the library is no reason to show "Nothing matches"
    if (fuzzy && songsAll.Count + albumsAll.Count + artistsAll.Count == 0 && plays.Any(p => Same(p.Name, q))) fuzzy = false;
    var genres = FindGenres(words);
    // the top result (only for a search): an artist named like it (with or without "The"), else an album named so, else the best song (accents and punctuation do not count)
    var best = songsAll.Where(X.Allows).FirstOrDefault();
    var songIsExact = ranked && best is not null && Same(best.Title, q);
    // F6: "prodigy" means The Prodigy (played, 171 songs) over Prodigy (15)
    var topArtist = ranked ? FLACie.Core.SearchRankTop.Artist(artists, q, Session.PlayStats) : null;
    var topAlbum = ranked && !fuzzy ? albums.FirstOrDefault(g => Same(g.Name, q)) : null;
    // owner, 26 Nov: the Top result is the best match of any kind; a playlist named like the search ("2026") can be it
    var topPlaylist = ranked ? plays.FirstOrDefault(p => Same(p.Name, q)) : null;
    var topKind = FLACie.Core.SearchLayout.PickTop(topArtist is not null, topAlbum is not null, topPlaylist is not null, best is not null, songIsExact);
    var heroArtist = topKind == FLACie.Core.SearchLayout.TopKind.Artist;
    var heroAlbum = topKind == FLACie.Core.SearchLayout.TopKind.Album;
    var heroPlaylist = topKind == FLACie.Core.SearchLayout.TopKind.Playlist;
    var heroSong = ranked && topKind == FLACie.Core.SearchLayout.TopKind.Song ? best : null;
    heroArtKey = heroSong is not null && only == "" ? Art.KeyFor(heroSong) : null;
    var shown = showAll || only == "songs" ? songs.Count : Math.Min(songs.Count, SongRows);
    // F6.2: a search for an artist is laid out like their page: the Top result with their top 5 songs beside it, then Playlists, Popular, Albums, Singles & EPs
    // (Playlists: Best of, Radio, decades, genres, their own) and other artists with similar names. A search for a song keeps the song-first layout.
    var artistPage = heroArtist && topArtist is not null && only == ""
        ? FLACie.Core.ArtistPage.Of(topArtist with { Tracks = topArtist.Tracks.Where(X.Allows).ToList() }, Lib.Albums.Where(g => g.Tracks.Any(X.Allows)), Session.PlayStats) : null;
    var context = Context + (ranked ? ": " + q : "");
}
@if (ranked && fuzzy)
{
    <p class="x-hint" role="status">
        @if (songs.Count + albums.Count + artists.Count == 0) { <span>Nothing in your library matches “@q”@(X.AnyFilter ? " with these filters" : "").</span> }
        else
        {
            <span>No exact match for “@q”@(suggestion.Length > 0 ? "." : ", so these are the closest.")&nbsp;</span>
            @if (suggestion.Length > 0) { <button type="button" class="x-did" @onclick="() => OnQuery.InvokeAsync(suggestion)">Did you mean <b>@suggestion</b>?</button><span>&nbsp;Showing close matches.</span> }
        }
    </p>
}
@{ var listsKind = ListsKind && ranked; var listCount = plays.Count + Made.Count + (only == "playlists" ? AllLists.Count : 0); }
@if (ExtraKinds is not null || listsKind || (ranked && Downloadable > 0) || (ranked && (songs.Count > 0 ? 1 : 0) + (albums.Count > 0 ? 1 : 0) + (artists.Count > 0 ? 1 : 0) + (plays.Count > 0 ? 1 : 0) > 1))
{
    @* narrow the results to one kind: one choice (F26.3: Playlists shows only playlists, Albums only albums); genre and decade are in Filters.
       In the order the page shows them, with Downloadable (the catalog) last (owner, 25 Nov) *@
    <div class="sr-kinds" role="radiogroup" aria-label="Show only" data-testid="kinds">
        @foreach (var (k, label, n) in new[] { ("", "All", 1), ("songs", "Songs", songs.Count), ("artists", "Artists", artists.Count), ("albums", "Albums", albums.Count), ("playlists", "Playlists", listsKind ? 1 : plays.Count), ("downloadable", "Downloadable", ranked ? Downloadable : 0) })
        {
            if (n == 0 && only != k) continue;
            var kind = k;
            <button class="chip @(only == kind ? "on" : "")" role="radio" aria-checked="@(only == kind ? "true" : "false")" @onclick="() => PickKind(kind)">@label</button>
        }
        @ExtraKinds
    </div>
}
@UnderKinds
@if (only == "playlists" && listsKind)
{
    @* every playlist that matches (Spotify's, Deezer's, SoundCloud's, ours, and the person's own), narrowed by the Filters panel's genre and decade *@
    <section class="sr-section" aria-label="All playlists" data-testid="all-playlists">
        <h2 class="section"><i>Playlists</i>@(X.Genre.Length > 0 ? " · " + X.Genre : "")@(X.Decade.Length > 0 ? " · " + X.Decade : "")</h2>
        @if (AllLists.Count + plays.Count == 0) { <p class="status">No playlists for this yet.</p> }
        <div class="grid">
            @foreach (var m in AllLists) { <a class="card" href="/made/@Uri.EscapeDataString(m.Id)"><Cover ArtKey="@m.ArtKey" Class="square" /><span class="card-title">@m.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@m.Subtitle</span></a> }
            @foreach (var p in plays)
            {
                var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
                <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@PlaylistSub(p)</span></a>
            }
        </div>
    </section>
}
@if (artistPage is not null && topArtist is not null)
{
    var ta = topArtist;
    <section aria-label="Top result" class="sr-section sr-top">
        <div class="sr-top-main">
            <h2 class="section">Top <i>result</i></h2>
            <div class="sr-hero artist" data-np @onclick="() => PlayFull(ta.Tracks.Where(X.Allows).ToList(), ta.Name)">
                <a class="sr-art" href="/artist/@Uri.EscapeDataString(ta.Name)" aria-label="Open artist @ta.Name" @onclick="Noop" @onclick:stopPropagation><Cover ArtKey="@(ta.ArtKey)" Size="188" Class="square round" /></a>
                <div class="sr-hero-text">
                    <a class="sr-hero-title" href="/artist/@Uri.EscapeDataString(ta.Name)" @onclick="Noop" @onclick:stopPropagation>@ta.Name</a>
                    <span class="sr-hero-sub">Artist</span>
                    <span class="pills"><span class="badge plain">@Count(ta) @(Count(ta) == 1 ? "song" : "songs")</span></span>
                </div>
                <button class="sr-play" aria-label="@(On(ta.Tracks) ? "Pause" : "Play") @ta.Name" @onclick="() => PlayOnly(ta.Tracks.Where(X.Allows).ToList(), ta.Name)" @onclick:stopPropagation><Icon Name="@(On(ta.Tracks) ? "pause" : "play")" Size="22" /></button>
            </div>
        </div>
        <div class="sr-top-songs" aria-label="Top songs">
            <h2 class="section"><i>Songs</i></h2>
            <TrackList Tracks="artistPage.Top.ToList()" PlayContext="@ta.Name" Single="true" ThumbSize="40" KindTag="Song" />
        </div>
    </section>
    @* the albums and the playlists straight under the Top result, side by side, half each on a wide screen (owner, 7 Nov: "fit albums here 50/50 with
       playlists"; 5 Nov: the playlists were too far down); one above the other on a phone *@
    var pairLists = Made.Count + plays.Count;
    @if (artistPage.Albums.Count + pairLists > 0)
    {
        <div class="sr-pair @(artistPage.Albums.Count > 0 && pairLists > 0 ? "both" : "")">
            @if (artistPage.Albums.Count > 0)
            {
                <section aria-label="Albums" class="sr-section">
                    <h2 class="section"><i>Albums</i></h2>
                    <div class="row-scroll sr-albums @(artistPage.Albums.Count > 4 ? "two-rows" : "")">
                        @foreach (var g in artistPage.Albums)
                        {
                            var gy = g.Tracks.Max(t => t.Year);
                            <a class="card" href="@AlbumLink(g)"><Cover ArtKey="@(g.ArtKey)" Class="square" /><span class="card-title">@g.Name</span><span class="card-sub"><span class="kind-tag">Album</span>@(gy > 0 ? gy.ToString() : "")</span></a>
                        }
                    </div>
                </section>
            }
            @if (pairLists > 0)
            {
                <section aria-label="Playlists" class="sr-section">
                    <h2 class="section"><i>Playlists</i></h2>
                    @* F26.1: up to 15 real lists: two rows of cards on a wide screen, one row to scroll on a phone *@
                    <div class="row-scroll sr-lists @(pairLists > 4 ? "two-rows" : "")">
                        @foreach (var m in Made) { <a class="card" href="/made/@Uri.EscapeDataString(m.Id)"><Cover ArtKey="@m.ArtKey" Class="square" /><span class="card-title">@m.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@m.Subtitle</span></a> }
                        @foreach (var p in plays)
                        {
                            var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
                            <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@PlaylistSub(p)</span></a>
                        }
                    </div>
                </section>
            }
        </div>
    }
    <ListsWithArtist Artist="@ta.Name" />
    @if (artistPage.Popular.Count > 0)
    {
        <section aria-label="Popular" class="sr-section">
            <h2 class="section"><i>Popular</i></h2>
            <div class="row-scroll sr-albums">
                @foreach (var t in artistPage.Popular)
                {
                    var song = t;
                    <button type="button" class="card" data-np aria-label="Play @song.Title" @onclick="() => PlayFull([song], ta.Name)"><Cover ArtKey="@(Art.KeyFor(song))" Class="square" /><span class="card-title">@song.Title</span><span class="card-sub">@(song.Album.Length > 0 ? song.Album : "Song")</span></button>
                }
            </div>
        </section>
    }
    @foreach (var (label, rows) in new[] { ("Singles & EPs", artistPage.Singles) })
    {
        if (rows.Count == 0) continue;
        <section aria-label="@label" class="sr-section">
            <h2 class="section"><i>@label</i></h2>
            <div class="row-scroll sr-albums">
                @foreach (var g in rows)
                {
                    var gy = g.Tracks.Max(t => t.Year);
                    <a class="card" href="@AlbumLink(g)"><Cover ArtKey="@(g.ArtKey)" Class="square" /><span class="card-title">@g.Name</span><span class="card-sub">@(gy > 0 ? gy.ToString() : "")@(gy > 0 ? " · " : "")@(FLACie.Core.ArtistPage.IsSingle(g) ? (g.Tracks.Count == 1 ? "Single" : "EP") : "Album")</span></a>
                }
            </div>
        </section>
    }
    @if (artists.Where(a => a != ta).ToList() is { Count: > 0 } similar)
    {
        <section aria-label="Other artists" class="sr-section sr-similar">
            <h2 class="section">Other artists with similar names</h2>
            <div class="chips">
                @foreach (var a in similar) { <a class="chip artist-chip" href="/artist/@Uri.EscapeDataString(a.Name)"><Cover ArtKey="@(a.ArtKey)" Size="28" Class="square round" />@a.Name</a> }
            </div>
        </section>
    }
}
else
{
@* owner, 25 Nov ("heads will roll": the first result was a playlist, the song small under it): the Top result comes first, then the library's Songs,
   Artists, Albums and Playlists (yours, then the ready-made ones); the page puts the catalog last. With no Top result (a genre, "2010s") the
   ready-made playlists are the answer and stay first, like Spotify's (owner, 2 Nov). *@
var hasHero = only == "" && (heroArtist || heroAlbum || heroPlaylist || heroSong is not null);
// owner, 26 Nov: on a wide screen the Top result and the Playlists sit side by side, half each, equal weight; narrow screens and the phone stack them,
// the Top result first and full width (the css decides by width)
var pairPlaylists = hasHero && (plays.Count > 0 || Made.Count > 0) && Shows("playlists");
@if (Made.Count > 0 && only == "" && !hasHero) { @MadeRow }
@if (hasHero)
{
    <div class="sr-top-pair @(pairPlaylists ? "both" : "")">
    <section aria-label="Top result" class="sr-section sr-best-section">
        <h2 class="section">Top <i>result</i></h2>
        @if (heroArtist && topArtist is not null)
        {
            <div class="sr-hero artist" data-np @onclick="() => PlayFull(topArtist.Tracks.Where(X.Allows).ToList(), topArtist.Name)">
                <a class="sr-art" href="/artist/@Uri.EscapeDataString(topArtist.Name)" aria-label="Open artist @topArtist.Name" @onclick="Noop" @onclick:stopPropagation><Cover ArtKey="@(topArtist.ArtKey)" Size="188" Class="square round" /></a>
                <div class="sr-hero-text">
                    <a class="sr-hero-title" href="/artist/@Uri.EscapeDataString(topArtist.Name)" @onclick="Noop" @onclick:stopPropagation>@topArtist.Name</a>
                    <span class="sr-hero-sub">Artist</span>
                    <span class="pills"><span class="badge plain">@Count(topArtist) @(Count(topArtist) == 1 ? "song" : "songs")</span><span class="sr-have">In your library</span></span>
                </div>
                <button class="sr-play" aria-label="@(On(topArtist.Tracks) ? "Pause" : "Play") @topArtist.Name" @onclick="() => PlayOnly(topArtist.Tracks.Where(X.Allows).ToList(), topArtist.Name)" @onclick:stopPropagation><Icon Name="@(On(topArtist.Tracks) ? "pause" : "play")" Size="22" /></button>
            </div>
        }
        else if (heroPlaylist && topPlaylist is not null)
        {
            var pl = topPlaylist; var pArt = Session.Resolve(pl.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
            var pTracks = Session.Resolve(pl.Entries).Where(X.Allows).ToList();
            <div class="sr-hero" @onclick="() => PlayFull(pTracks, pl.Name)">
                <a class="sr-art" href="/playlist/@pl.Id" aria-label="Open playlist @pl.Name" @onclick="Noop" @onclick:stopPropagation><Cover ArtKey="@(pArt)" Size="188" Class="square" /></a>
                <div class="sr-hero-text">
                    <a class="sr-hero-title" href="/playlist/@pl.Id" @onclick="Noop" @onclick:stopPropagation>@pl.Name</a>
                    <span class="sr-hero-sub">Playlist · Yours</span>
                    <span class="pills"><span class="badge plain">@pl.Entries.Count @(pl.Entries.Count == 1 ? "song" : "songs")</span></span>
                </div>
                <button class="sr-play" aria-label="@(On(pTracks) ? "Pause" : "Play") @pl.Name" @onclick="() => PlayOnly(pTracks, pl.Name)" @onclick:stopPropagation><Icon Name="@(On(pTracks) ? "pause" : "play")" Size="22" /></button>
            </div>
        }
        else if (heroAlbum && topAlbum is not null)
        {
            var ht = topAlbum.Tracks[0]; var hy = topAlbum.Tracks.Max(t => t.Year);
            <div class="sr-hero" @onclick="() => PlayFull(topAlbum.Tracks.Where(X.Allows).ToList(), topAlbum.Name)">
                <a class="sr-art" href="@AlbumLink(topAlbum)" aria-label="Open album @topAlbum.Name" @onclick="Noop" @onclick:stopPropagation><Cover ArtKey="@(topAlbum.ArtKey)" Size="188" Class="square" /></a>
                <div class="sr-hero-text">
                    <a class="sr-hero-title" href="@AlbumLink(topAlbum)" @onclick="Noop" @onclick:stopPropagation>@topAlbum.Name</a>
                    <span class="sr-hero-sub">Album · @(ht.AlbumArtist.Length > 0 ? ht.AlbumArtist : ht.Artist)@(hy > 0 ? " · " + hy : "")</span>
                    <span class="pills"><span class="badge @ht.Source.ToString().ToLowerInvariant()">@SourceLabel.Short(ht.Source)</span><span class="badge plain">@Count(topAlbum) @(Count(topAlbum) == 1 ? "song" : "songs")</span><span class="sr-have">In your library</span></span>
                </div>
                <button class="sr-play" aria-label="@(On(topAlbum.Tracks) ? "Pause" : "Play") @topAlbum.Name" @onclick="() => PlayOnly(topAlbum.Tracks.Where(X.Allows).ToList(), topAlbum.Name)" @onclick:stopPropagation><Icon Name="@(On(topAlbum.Tracks) ? "pause" : "play")" Size="22" /></button>
            </div>
        }
        else if (heroSong is not null)
        {
            @* the song itself, big, in Now Playing's look: its cover's colours, the serif title with the last word in italics, the format chip, what it is
               to you ("In your library"), Play and the song's menu (owner, 25 Nov) *@
            var hs = heroSong; var fmt = QuickFormats.Of(hs); var facts = FormatIndex.Current?.Get(hs); var vers = Lib.OtherVersions(hs);
            var hsArtist = hs.AlbumArtist.Length > 0 ? hs.AlbumArtist : hs.Artist;
            <div class="sr-hero song sr-best" @ref="heroEl" @onclick="() => PlayFull([hs], context)">
                <button class="sr-art sr-cover" aria-label="Play @hs.Title and open the player" @onclick='() => PlayFull([hs], context)' @onclick:stopPropagation><Cover ArtKey="@(Art.KeyFor(hs))" Size="232" Class="square" Eager="true" /></button>
                <div class="sr-hero-text">
                    <span class="sr-eyebrow">Song<span aria-hidden="true"> · </span><span class="sr-have">In your library</span></span>
                    <span class="sr-hero-title">@Lead(hs.Title)<i>@Last(hs.Title)</i></span>
                    <span class="sr-hero-sub"><a href="/artist/@Uri.EscapeDataString(hsArtist)" @onclick="Noop" @onclick:stopPropagation>@hs.Artist</a>@(hs.Album.Length > 0 ? " · " + hs.Album : "")@(hs.Year > 0 ? " · " + hs.Year : "")</span>
                    <span class="pills">
                        @if (fmt.Length > 0) { <span class="badge fmt @(fmt == "HI-RES" ? "hires" : FLACie.Core.MediaInfo.LosslessCodecs.Contains(fmt.ToLowerInvariant()) ? "lossless" : "")">@(fmt == "HI-RES" ? "✦ Hi-Res" : fmt)</span> }
                        @if (facts is { Depth: > 0, Rate: > 0 }) { <span class="badge plain">@facts.Depth-bit / @((facts.Rate / 1000.0).ToString("0.#")) kHz</span> }
                        <span class="badge @hs.Source.ToString().ToLowerInvariant()">@SourceLabel.Short(hs.Source)</span>
                    </span>
                    @* how it came in ("Downloaded 5 min ago"), as on its song row: the Top result is the only place it shows now *@
                    <DownloadTag Session="Session" Artist="@hs.Artist" Title="@hs.Title" Track="hs" />
                    <span class="sr-hero-actions" @onclick:stopPropagation>
                        <button class="btn sr-go" aria-label="@(On([hs]) ? "Pause" : "Play") @hs.Title" @onclick='() => PlayOnly([hs], context)'><Icon Name="@(On([hs]) ? "pause" : "play")" Size="18" />@(On([hs]) ? "Pause" : "Play")</button>
                        @if (vers.Count > 0) { <button class="btn sr-vers" aria-expanded="@(heroVersions ? "true" : "false")" @onclick="() => heroVersions = !heroVersions">+@vers.Count @(vers.Count == 1 ? "version" : "versions")</button> }
                        <span class="sr-menu-wrap">
                            <button class="icon-btn sr-menu-btn" aria-haspopup="menu" aria-expanded="@(heroMenu ? "true" : "false")" aria-label="More for @hs.Title" @onclick="() => { heroMenu = !heroMenu; heroSub = false; }"><Icon Name="more" /></button>
                            @if (heroMenu)
                            {
                                <button class="scrim" aria-label="Close" @onclick="() => heroMenu = false"></button>
                                <div class="menu" role="menu">
                                    <button role="menuitem" @onclick='() => { Player.PlayNext(hs); Toast.Show($"“{hs.Title}” plays next"); heroMenu = false; }'>Play next</button>
                                    <button role="menuitem" @onclick='() => { Player.AddToQueue(hs); Toast.Show($"Added “{hs.Title}” to the queue"); heroMenu = false; }'>Add to queue</button>
                                    <button role="menuitem" class="has-sub" aria-expanded="@(heroSub ? "true" : "false")" @onclick="() => heroSub = !heroSub">Add to playlist <span aria-hidden="true" class="chev">›</span></button>
                                    @if (heroSub)
                                    {
                                        @if (!Session.Playlists.Any()) { <small class="menu-note">No playlists yet. Make one on the Playlists page.</small> }
                                        @foreach (var p in Session.Playlists) { <button role="menuitem" class="sub" @onclick="() => { Toast.Added(Session, p, hs, SaveProfile); heroMenu = false; }">Add to @p.Name</button> }
                                    }
                                    <hr class="menu-sep" />
                                    @if (Lib.Albums.FirstOrDefault(g => g.Tracks.Any(t => t.Path == hs.Path)) is { } hg) { <a role="menuitem" href="@AlbumLink(hg)">Go to album</a> }
                                    <a role="menuitem" href="/artist/@Uri.EscapeDataString(hsArtist)">Go to artist</a>
                                    <button role="menuitem" @onclick='async () => { heroMenu = false; await Sharing.ShareAsync(Session, "song", hs.Title, [hs]); }'>Share</button>
                                </div>
                            }
                        </span>
                    </span>
                </div>
            </div>
            @if (heroVersions && vers.Count > 0) { <div class="sr-hero-versions"><TrackList Tracks="vers" PlayContext="@context" Single="true" ThumbSize="40" KindTag="Version" /></div> }
        }
    </section>
    @if (pairPlaylists)
    {
        <div class="sr-pair-lists">
            @if (plays.Count > 0)
            {
                <section aria-label="Playlists" class="sr-section">
                    <h2 class="section"><i>Playlists</i></h2>
                    <div class="row-scroll">
                        @foreach (var p in plays)
                        {
                            var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
                            <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@PlaylistSub(p)</span></a>
                        }
                    </div>
                </section>
            }
            @if (Made.Count > 0) { @MadeRow }
        </div>
    }
    </div>
}
@* the songs under the Top result, without it again (owner, 25 Nov: "wasted space") *@
var listSongs = only == "" && heroSong is not null && hasHero ? songs.Where(t => t.Path != heroSong.Path).ToList() : songs; var listShown = Math.Min(shown, listSongs.Count);
@if (listSongs.Count > 0 && Shows("songs"))
{
    <section aria-label="Songs" class="sr-section">
        <h2 class="section">@((MarkupString)(ranked ? "<i>Songs</i>" : "Recently added <i>songs</i>"))</h2>
        <TrackList Tracks="listSongs.Take(listShown).ToList()" PlayContext="@context" Single="true" ThumbSize="48" KindTag="@(ranked ? "Song" : null)" ShowVersions="ranked" />
        @if (listSongs.Count > listShown)
        {
            @if (!string.IsNullOrEmpty(SeeAllHref)) { <a class="btn ghost sr-more" href="@SeeAllHref">See all @listSongs.Count @(listSongs.Count == 1 ? "song" : "songs")</a> }
            else { <button class="btn ghost sr-more" @onclick="() => showAll = true">Show all @listSongs.Count songs</button> }
        }
        else if (showAll && listSongs.Count > SongRows) { <button class="btn ghost sr-more" @onclick="() => showAll = false">Show fewer songs</button> }
    </section>
}
@* a search: Artists before Albums (as the chips read); the browse view keeps the newest albums first *@
@if (ranked) { @ArtistsRow(artists) }
@if (albums.Count > 0 && Shows("albums"))
{
    <section aria-label="Albums" class="sr-section">
        <h2 class="section">@((MarkupString)(ranked ? "<i>Albums</i>" : "Recently added <i>albums</i>"))</h2>
        <div class="row-scroll sr-albums">
            @foreach (var g in albums)
            {
                var gy = g.Tracks.Max(t => t.Year); var ga = g.Tracks[0].AlbumArtist.Length > 0 ? g.Tracks[0].AlbumArtist : g.Tracks[0].Artist;
                <a class="card" href="@AlbumLink(g)"><Cover ArtKey="@(g.ArtKey)" Class="square" /><span class="card-title">@g.Name</span><span class="card-sub"><span class="kind-tag">Album</span>@ga@(gy > 0 ? " · " + gy : "")</span></a>
            }
        </div>
    </section>
}
@if (!ranked) { @ArtistsRow(artists) }
@if (plays.Count > 0 && Shows("playlists") && !(only == "playlists" && listsKind) && !pairPlaylists)
{
    <section aria-label="Playlists" class="sr-section">
        <h2 class="section"><i>Playlists</i></h2>
        <div class="row-scroll">
            @foreach (var p in plays)
            {
                var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
                <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@PlaylistSub(p)</span></a>
            }
        </div>
    </section>
}
@if (Made.Count > 0 && hasHero && !pairPlaylists) { @MadeRow }
@if (genres.Count > 0 && only == "")
{
    <section aria-label="Genres" class="sr-section">
        <h2 class="section"><i>Genres</i></h2>
        <div class="sr-genres">
            @foreach (var gn in genres) { <a class="chip" href="/genre/@Uri.EscapeDataString(gn)">@gn</a> }
        </div>
    </section>
}
}
@if (ShowEmpty && songs.Count == 0 && albums.Count == 0 && artists.Count == 0 && plays.Count == 0 && genres.Count == 0 && !(ranked && fuzzy))
{
    <p class="status">@(!ranked ? "Nothing in your library yet." : X.AnyFilter ? "Nothing in your library matches “" + q + "” with these filters." : "Nothing in your library matches “" + q + "”.")</p>
}
@code {
    /// <summary>The one kind of result shown (the "Show only" chips): "" for all of them.</summary>
    string only = "";
    bool Shows(string kind) => only == "" || only == kind;
    string? onlyFor;
    // a new search starts with every kind shown again
    protected override void OnParametersSet() { if (Query != onlyFor) { onlyFor = Query; only = ""; heroMenu = heroSub = heroVersions = false; } base.OnParametersSet(); }

    /// <summary>The text to search for ("" for the browse view).</summary>
    [Parameter] public string Query { get; set; } = "";
    /// <summary>Bumped whenever the filters change, so this redraws (strings and numbers alone would not tell it).</summary>
    [Parameter] public int Rev { get; set; }
    /// <summary>"Explore" or "Search": the start of the play context shown as "Playing from".</summary>
    [Parameter] public string Context { get; set; } = "Search";
    /// <summary>Where "See all songs" goes (Explore: the Songs tab, which keeps the same filters); when empty the list opens in place.</summary>
    [Parameter] public string? SeeAllHref { get; set; }
    /// <summary>best (as ranked), az, artist, new, year or long.</summary>
    [Parameter] public string SortKey { get; set; } = "best";
    [Parameter] public int SongRows { get; set; } = 8;
    /// <summary>Ready-made playlists for the query (Best of, Radio, decades, genres): with the playlists for an artist, else in a row of their own at the top.</summary>
    [Parameter] public IReadOnlyList<MadePlaylist> Made { get; set; } = [];
    /// <summary>More chips at the end of the All / Songs / Albums / Artists row (Search's Playlists filter), so they sit on one line.</summary>
    [Parameter] public RenderFragment? ExtraKinds { get; set; }
    /// <summary>F26.3: Playlists is one of the kinds (the search page): picking it shows <see cref="AllLists"/> and the person's own, nothing else.</summary>
    [Parameter] public bool ListsKind { get; set; }
    [Parameter] public IReadOnlyList<MadePlaylist> AllLists { get; set; } = [];
    /// <summary>The kind picked ("" for All), so the page can fetch the lists it shows.</summary>
    [Parameter] public EventCallback<string> OnKind { get; set; }
    async Task PickKind(string kind) { only = kind; await OnKind.InvokeAsync(kind); }
    /// <summary>How many catalog results the page has under "More music to download": above 0 the Downloadable chip shows (only those, none of the library's).</summary>
    [Parameter] public int Downloadable { get; set; }
    /// <summary>Shown right under that row (the Playlists filter's genres and its lists, when it is on).</summary>
    [Parameter] public RenderFragment? UnderKinds { get; set; }
    [Parameter] public bool ShowEmpty { get; set; } = true;
    /// <summary>The "Did you mean ...?" link was pressed: the page puts the corrected text in its own search box.</summary>
    [Parameter] public EventCallback<string> OnQuery { get; set; }

    bool showAll;

    // ---- the Top result song card (owner, 25 Nov) ----
    [Inject] Toasts Toast { get; set; } = default!;
    [Inject] Sharing Sharing { get; set; } = default!;
    [Inject] IJSRuntime Js { get; set; } = default!;
    ElementReference heroEl;
    bool heroMenu, heroSub, heroVersions;
    string? heroArtKey, tintedFor;
    static string Lead(string title) { var s = title.TrimEnd(); var i = s.LastIndexOf(' '); return i < 0 ? "" : s[..(i + 1)]; }
    static string Last(string title) { var s = title.TrimEnd(); var i = s.LastIndexOf(' '); return i < 0 ? s : s[(i + 1)..]; }
    // the card wears its cover's colours, as Now Playing and the playlist page do (flacie.npAccent sets --np-accent, --tone ... on the card only)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (heroArtKey == tintedFor) return;
        tintedFor = heroArtKey;
        if (heroArtKey is null) return;
        try { await Js.InvokeVoidAsync("flacie.npAccent", heroEl, "/art/" + Uri.EscapeDataString(CoverOverrides.Map(heroArtKey)!) + "?v=3"); } catch (Exception) { }
    }

    /// <summary>The ready-made playlists for what was typed (Best of, Radio, decades, genres; Spotify's and Deezer's on a server that reads them).</summary>
    RenderFragment MadeRow => @<section class="made-row sr-section" aria-label="Playlists for you">
        <h2 class="section">Playlists <i>for you</i></h2>
        <div class="row-scroll">
            @foreach (var m in Made) { <a class="card" href="/made/@Uri.EscapeDataString(m.Id)"><Cover ArtKey="@m.ArtKey" Class="square" /><span class="card-title">@m.Name</span><span class="card-sub"><span class="kind-tag">Playlist</span>@m.Subtitle</span></a> }
        </div>
    </section>;

    RenderFragment ArtistsRow(IReadOnlyList<Group> artists) => @<text>@if (artists.Count > 0 && Shows("artists"))
    {
        <section aria-label="Artists" class="sr-section">
            <h2 class="section"><i>Artists</i></h2>
            <div class="row-scroll">
                @foreach (var a in artists)
                {
                    <a class="card artist" href="/artist/@Uri.EscapeDataString(a.Name)"><Cover ArtKey="@(a.ArtKey)" Class="square round" /><span class="card-title">@a.Name</span><span class="card-sub"><span class="kind-tag">Artist</span>@Count(a) @(Count(a) == 1 ? "song" : "songs")</span></a>
                }
            </div>
        </section>
    }</text>;

    void Noop() { }
    /// <summary>The banner itself: play it and bring up the full-screen player.</summary>
    async Task PlayFull(IReadOnlyList<Track> list, string context)
    {
        if (list.Count == 0) return;
        // already the current song (or a song of this album / artist): keep it going, just resume if paused, and open the player
        if (Current(list)) { if (!Player.Playing) await Player.Toggle(); }
        else await Player.Play(list, 0, context);
        Player.RequestFullScreen();
    }
    /// <summary>The round play button: just play, stay on the page.</summary>
    async Task PlayOnly(IReadOnlyList<Track> list, string context)
    {
        if (list.Count == 0) return;
        if (Current(list)) await Player.Toggle();   // pause or resume, never start over
        else await Player.Play(list, 0, context);
    }
    /// <summary>One of these songs is the one in the player right now.</summary>
    bool Current(IEnumerable<Track> list) => Player.Current is { } c && list.Any(t => t.Path == c.Path);
    /// <summary>...and it is playing (so the round button shows pause).</summary>
    bool On(IEnumerable<Track> list) => Player.Playing && Current(list);

    static bool Same(string a, string b) => string.Join(' ', FLACie.Core.Matching.SearchWords(a)) == string.Join(' ', FLACie.Core.Matching.SearchWords(b));
    // how many of a group's songs the filter pills allow
    int Count(Group g) => g.Tracks.Count(X.Allows);

    List<Track> Sorted(List<Track> l) => SortKey switch
    {
        "az" => l.OrderBy(t => Matching.SortKey(t.Title)).ToList(),
        "artist" => l.OrderBy(t => Matching.SortKey(t.Artist)).ThenBy(t => t.Album).ThenBy(t => t.DiscNo).ThenBy(t => t.TrackNo).ToList(),
        "new" => l.OrderByDescending(t => t.AddedMs).ToList(),
        "year" => l.OrderByDescending(t => t.Year).ToList(),
        "long" => l.OrderByDescending(t => t.DurationMs).ToList(),
        _ => l,
    };
    List<Group> SortedAlbums(List<Group> l) => SortKey switch
    {
        "az" => l.OrderBy(g => Matching.SortKey(g.Name)).ToList(),
        "artist" => l.OrderBy(g => Matching.SortKey(g.Tracks[0].AlbumArtist.Length > 0 ? g.Tracks[0].AlbumArtist : g.Tracks[0].Artist)).ToList(),
        "new" => l.OrderByDescending(g => g.Tracks.Max(t => t.AddedMs)).ToList(),
        "year" => l.OrderByDescending(g => g.Tracks.Max(t => t.Year)).ToList(),
        "long" => l.OrderByDescending(g => g.Tracks.Count).ToList(),
        _ => l,
    };

    // the person's playlists for the search: named like it, then those holding a song or artist that matches (owner, 7 Nov: "dreamer" should show the
    // playlists Dreamer is in), each saying what it holds; with filter pills on, only those holding something the filters allow; with no search, the first few
    Dictionary<string, string> playlistHolds = [];
    List<FLACie.Core.Playlist> FindPlaylists(IReadOnlyList<string> words)
    {
        bool allowed(FLACie.Core.Playlist p) => !X.AnyFilter || Session.Resolve(p.Entries).Any(X.Allows);
        if (words.Count == 0) { playlistHolds = []; return Session.Playlists.Where(allowed).Take(12).ToList(); }
        var hits = FLACie.Core.PlaylistHits.Find(Session.Playlists.Where(allowed), words);
        playlistHolds = hits.Where(h => h.Holds is not null).ToDictionary(h => h.List.Id, h => h.Holds!);
        return hits.Select(h => h.List).ToList();
    }
    string PlaylistSub(FLACie.Core.Playlist p) =>
        playlistHolds.TryGetValue(p.Id, out var holds) ? "Yours · " + holds : $"Yours · {p.Entries.Count} {(p.Entries.Count == 1 ? "song" : "songs")}";
    List<string> FindGenres(IReadOnlyList<string> words) =>
        words.Count == 0
            ? Lib.Songs.Where(t => t.Genre.Trim().Length > 0 && X.Allows(t)).GroupBy(t => t.Genre.Trim(), StringComparer.OrdinalIgnoreCase).OrderByDescending(g => g.Count()).Take(12).Select(g => g.Key).ToList()
            : Lib.Songs.Where(t => t.Genre.Trim().Length > 0 && X.Allows(t) && FLACie.Core.Matching.SearchHit(words, t.Genre)).Select(t => t.Genre.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(g => g).Take(12).ToList();
}
