@inherits UserComponent
@inject IJSRuntime PopJs
@* The full-screen player's volume on a PC (owner, 11 Nov: "the volume bar must be quick to reach; the pop-up is terrible, doesn't work and looks bad"):
   always in the bar, no pop-up to open first. A mute button, a wide slider in the cover's colour (drag, click, the wheel and the arrow keys all move it;
   the sound follows as it moves and the player is told when it is let go) and the level in numbers. The two sound switches (even out volume, fade between
   songs) are behind the small button beside it, which opens on a click (not on hover: a pop-up that came and went under the pointer was the complaint). *@
<div class="ls-volpill @(open ? "open" : "")" @onkeydown="Key">
    <button type="button" class="ls-volpill-mute @(Player.Volume == 0 ? "on" : "")" @onclick="Player.ToggleMuteAsync" aria-label="@(Player.Volume == 0 ? "Unmute" : "Mute")" title="@(Player.Volume == 0 ? "Unmute" : "Mute")">
        <Icon Name="@(Player.Volume == 0 ? "volume-0" : Player.Volume < 0.5 ? "volume-1" : "volume-2")" Size="22" />
    </button>
    <input class="ls-volpill-bar" type="range" min="0" max="100" step="1" value="@Pct" aria-label="Volume" aria-valuetext="@Pct%" style="--fill:@Pct%"
           oninput="flacie.volume(this.value / 100); this.style.setProperty('--fill', this.value + '%'); this.nextElementSibling.textContent = this.value + '%'"
           onwheel="event.preventDefault(); this.value = Math.max(0, Math.min(100, Number(this.value) + (event.deltaY < 0 ? 5 : -5))); this.dispatchEvent(new Event('input', { bubbles: true })); this.dispatchEvent(new Event('change', { bubbles: true }))"
           @onchange="OnVolume" />
    <b class="ls-volpill-num" aria-hidden="true">@Pct%</b>
    <button type="button" class="ls-volpill-more @(Player.LevelVolume || Player.FadeSecs > 0 ? "on" : "")" @onclick="Toggle" aria-label="Sound options" aria-haspopup="dialog" aria-expanded="@(open ? "true" : "false")" title="Sound options">
        <Icon Name="wave" Size="18" /><span class="ls-volpill-label">Sound</span>
    </button>
    @if (open)
    {
        <div class="ls-volpill-pop" role="dialog" aria-label="Sound options">
            @* on a narrow window (a tablet, a zoomed laptop) the bar has no room for the slider: it is here instead *@
            <label class="ls-volpill-popbar"><button type="button" class="ls-volpill-mute @(Player.Volume == 0 ? "on" : "")" @onclick="Player.ToggleMuteAsync" @onclick:preventDefault="true" aria-label="@(Player.Volume == 0 ? "Unmute" : "Mute")"><Icon Name="@(Player.Volume == 0 ? "volume-0" : "volume-2")" Size="20" /></button>
                <input class="ls-volpill-bar" type="range" min="0" max="100" step="1" value="@Pct" aria-label="Volume" aria-valuetext="@Pct%" style="--fill:@Pct%"
                       oninput="flacie.volume(this.value / 100); this.style.setProperty('--fill', this.value + '%')" @onchange="OnVolume" />
            </label>
            <label class="switch-row sound-row">
                <span><b>Even out volume</b><small>Loud songs down, quiet ones up</small></span>
                <input type="checkbox" role="switch" aria-label="Even out volume" checked="@Player.LevelVolume" @onchange="e => Player.SetLevelVolumeAsync((bool)(e.Value ?? false))" />
                <i class="switch" aria-hidden="true"></i>
            </label>
            <div class="sound-fade">
                <b>Fade between songs</b>
                <div class="seg" role="group" aria-label="Fade between songs">
                    @foreach (var n in FadeBetween.Choices)
                    {
                        var nn = n;
                        <button type="button" class="@(Player.FadeSecs == nn ? "sel" : "")" aria-pressed="@(Player.FadeSecs == nn ? "true" : "false")" @onclick="() => Player.SetFadeSecsAsync(nn)">@(nn == 0 ? "Off" : nn + " s")</button>
                    }
                </div>
            </div>
            <button type="button" class="ls-volpill-close" @onclick="Close">Done</button>
        </div>
    }
</div>
@code {
    bool open;
    int Pct => (int)Math.Round(Player.Volume * 100);
    Task OnVolume(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? Player.SetVolumeAsync(v / 100.0) : Task.CompletedTask;
    void Key(KeyboardEventArgs e) { if (e.Key == "Escape") _ = Close(); }
    // a click anywhere outside the pop-up (or Esc) closes it, as the other menus do (owner, 12 Nov: "make this one clickable to exit it, like click out of it")
    DotNetObjectReference<SoundTile>? me;
    async Task Toggle()
    {
        open = !open;
        me ??= DotNetObjectReference.Create(this);
        try { if (open) await PopJs.InvokeVoidAsync("flacie.watchOutside", ".ls-volpill", me); else await PopJs.InvokeVoidAsync("flacie.unwatchOutside"); } catch (Exception) { }
    }
    async Task Close() { open = false; try { await PopJs.InvokeVoidAsync("flacie.unwatchOutside"); } catch (Exception) { } }
    [JSInvokable] public void Dismiss() => InvokeAsync(() => { if (!open) return; open = false; StateHasChanged(); });
    public override void Dispose() { base.Dispose(); if (open) _ = PopJs.InvokeVoidAsync("flacie.unwatchOutside").AsTask().ContinueWith(_ => { }); me?.Dispose(); }
}
