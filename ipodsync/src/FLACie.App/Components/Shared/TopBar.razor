@inherits UserComponent
@inject IConfiguration Conf
@inject IDownloads Dls
@inject IServiceProvider TopServices
@implements IDisposable
@* Along the top, like YT Music: the logo, one search box that works from every page, and the account at the right. *@
<header class="topbar">
    <span class="top-left">
        @* the ☰: on the Explore pages it slides the menu in; elsewhere on a PC it folds the menu to its icons *@
        <button class="top-burger @(MenuOpen ? "open" : "")" @onclick="OnMenu" aria-label="Menu" title="Menu" aria-expanded="@(MenuOpen ? "true" : "false")" aria-controls="main-rail"><i></i><i></i><i></i></button>
        <a class="top-brand" href="/" aria-label="FLACie home"><Logo Size="32" Class="top-name-wrap" /></a>
    </span>
    @if (Full) { <h2 class="top-title">Explore</h2> }
    else {
    <form class="top-search" role="search" @onsubmit="Go">
        <Icon Name="search" Size="18" />
        <TextBox Type="search" Placeholder="Search songs, albums, artists, or music to download" Label="Search" Value="@q" ValueChanged="OnText" DelayMs="300" />
        @if (q.Length > 0) { <button type="button" class="icon-btn" aria-label="Clear search" @onclick="Clear" title="Clear search"><Icon Name="x" Size="16" /></button> }
        @* speak to search; a request to the DJ ("play my pop playlist") is carried out instead *@
        <DjMic Class="icon-btn" Size="18" OnHeard="Spoken" />
    </form>
    }
    <div class="top-account">
        <button class="avatar-btn" @onclick="() => open = !open" aria-haspopup="menu" aria-expanded="@(open ? "true" : "false")" aria-label="@("Account: " + Session.DisplayName)"><span class="avatar">@Initial</span></button>
        @if (open)
        {
            <button class="scrim" aria-label="Close menu" @onclick="() => open = false"></button>
            @* ONE APP 1f, the redesigned More: who you are, then every place one tap away as a grid of the kit's slots (icon over word), and Sign out
               apart at the end. A popover on a PC; at phone width a bottom sheet (kit.css), as the phone's sheets *@
            <div class="account-menu am-more" role="menu" aria-label="More">
                <div class="am-head"><span class="avatar big">@Initial</span><div><b>@Session.DisplayName</b><small>@(Session.Kind == "nas" ? "NAS" : "Jellyfin")@(Session.Jellyfin is not null && Session.Nas is not null ? " and NAS" : "")</small></div></div>
                <div class="am-grid">
                @if (AppHost.Server) { <a role="menuitem" class="k-slot" href="/account" @onclick="() => open = false"><Icon Name="artists" Size="22" /><span>Account</span></a> }
                <a role="menuitem" class="k-slot" href="/settings" @onclick="() => open = false"><Icon Name="settings" Size="22" /><span>Settings</span></a>
                @* on a phone the bottom bar has only the main places: these come here instead *@
                @if (AppHost.Server)
                {
                    <a role="menuitem" class="k-slot am-phone" href="/devices" @onclick="() => open = false"><Icon Name="devices" Size="22" /><span>Devices</span></a>
                    <a role="menuitem" class="k-slot am-phone" href="/jam" @onclick="() => open = false"><Icon Name="jam" Size="22" /><span>Jam</span></a>
                }
                <a role="menuitem" class="k-slot" href="/car" @onclick="() => open = false"><Icon Name="car" Size="22" /><span>Car mode</span></a>
                <a role="menuitem" class="k-slot am-phone" href="/headphones" @onclick="() => open = false"><Icon Name="headphones" Size="22" /><span>Headphone test</span></a>
                <a role="menuitem" class="k-slot" href="/retro" @onclick="() => open = false"><Icon Name="retro" Size="22" /><span>Retro</span></a>
                @if (AdminAccess.Is(Session, Conf))
                {
                    <a role="menuitem" class="k-slot" href="/dashboard" @onclick="() => open = false"><Icon Name="shield" Size="22" /><span>Server admin</span></a>
                    @if (Dls.Allowed) { <a role="menuitem" class="k-slot" href="/downloads" @onclick="() => open = false"><Icon Name="download" Size="22" /><span>Downloads</span></a> }
                }
                </div>
                @if (AppHost.Server) { <form method="post" action="/auth/logout" data-enhance="false"><button role="menuitem" class="k-btn-sm am-out" type="submit"><Icon Name="logout" Size="18" />Sign out</button></form> }
                else { <a role="menuitem" class="k-btn-sm am-out" href="/signout" @onclick="() => open = false"><Icon Name="logout" Size="18" />Sign out</a> }
            </div>
        }
    </div>
</header>
@code {
    /// <summary>Explore: no search box here (Explore has its own filter), a hamburger for the side menu instead.</summary>
    [Parameter] public bool Full { get; set; }
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnMenu { get; set; }
    string q = "";
    bool open;
    string Initial => Session.DisplayName.Length > 0 ? Session.DisplayName[..1].ToUpperInvariant() : "?";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Nav.LocationChanged += OnLocation;
        SyncFromUrl();
        ShareAddress();
    }

    // the phone app finds this server (downloads, seek-bar shapes, share links, the DJ) through the shared profile. Owner, 9 Nov: it used to get the address
    // this page happened to be opened at, so it flipped between frank's own and a proxy's; now it gets the one stable address (PublicAddress: Server admin,
    // FLACIE_PUBLIC_URL, or the first tailnet address seen), and nothing at all while none is known. A host without PublicAddress (the Windows app) keeps the
    // old way, never a localhost address.
    void ShareAddress()
    {
        var pageOrigin = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        string? origin;
        if (TopServices.GetService(typeof(PublicAddress)) is PublicAddress stable) origin = stable.Use(pageOrigin);
        else
        {
            var host = new Uri(pageOrigin).Host;
            origin = host is "localhost" or "127.0.0.1" or "::1" or "[::1]" || host.EndsWith(".localhost") ? null : pageOrigin;
        }
        if (origin is null) return;
        // never before the profile has been read: saving then would replace it with an empty one (tried again on every page change)
        if (!Session.ProfileLoaded) return;
        // (a profile with no services yet gets them here: the phone needs this address to share links and fetch seek-bar shapes)
        var services = Session.Profile["services"] as System.Text.Json.Nodes.JsonObject ?? (System.Text.Json.Nodes.JsonObject)(Session.Profile["services"] = new System.Text.Json.Nodes.JsonObject());
        if (services["flacieweb"]?["url"]?.GetValue<string>() == origin) return;
        services["flacieweb"] = new System.Text.Json.Nodes.JsonObject { ["url"] = origin };
        SaveProfile();
    }

    void OnLocation(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { SyncFromUrl(); ShareAddress(); InvokeAsync(StateHasChanged); }

    // the box mirrors the Search page's address, so Back and a shared link show what was searched
    void SyncFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        if (uri.AbsolutePath != "/search") { if (q.Length > 0 && !uri.AbsolutePath.StartsWith("/search")) q = ""; return; }
        var m = System.Web.HttpUtility.ParseQueryString(uri.Query)["q"] ?? "";
        if (m != q) q = m;
    }

    // typing searches as you go, after a short pause (the box waits in the browser); the Search page follows the address
    void OnText(string text) { q = text; Navigate(); }

    void Go() { Navigate(); }
    void Spoken(string text) { q = text; Navigate(); }
    void Clear() { q = ""; Navigate(); }
    void Navigate()
    {
        var onSearch = new Uri(Nav.Uri).AbsolutePath == "/search";
        Nav.NavigateTo("/search" + (q.Trim().Length > 0 ? "?q=" + Uri.EscapeDataString(q) : ""), replace: onSearch);
    }

    public override void Dispose() { Nav.LocationChanged -= OnLocation; base.Dispose(); }
}
