@inherits UserComponent
@* A list of songs. Click plays from that song with the rest of the list queued; the menu adds to queue or a playlist. *@
<ol class="tracks @(selecting ? "selecting" : "")">
    @for (var i = 0; i < Tracks.Count; i++)
    {
        var idx = i; var t = Tracks[i];
        @if (Waiting is { Count: > 0 }) { foreach (var w in Waiting.Where(w => w.Before == idx)) { @WaitingRow(w) } }
        if (gone.Contains(t.Path)) continue;
        var now = Player.Current?.Path == t.Path;
        var fmt = QuickFormats.Of(t);
        var picked = selected.Contains(idx);
        <li class="track @(now ? "now" : "") @(picked ? "picked" : "")">
            @if (selecting)
            {
                <button class="track-pick" aria-pressed="@(picked ? "true" : "false")" aria-label="Select @t.Title" @onclick="() => Pick(idx)"><Icon Name="@(picked ? "check" : "plus")" Size="18" /></button>
            }
            <button class="track-main" @onclick="e => Main(e, idx)" aria-label="@(selecting ? "Tick " + t.Title : "Play " + t.Title + " by " + t.Artist)">
                @if (Numbered) { <span class="track-no">@(t.TrackNo > 0 ? t.TrackNo : idx + 1)</span> }
                else { <Cover ArtKey="@(Art.KeyFor(t))" Size="@ThumbSize" /> }
                <span class="track-text">
                    <span class="track-title">@t.Title</span>
                    <span class="track-sub">@if (KindTag is { Length: > 0 }) { <span class="kind-tag">@KindTag</span> }@t.Artist@(ShowAlbum && t.Album.Length > 0 ? " · " + t.Album : "")@(t.Year > 0 ? " · " + t.Year : "")<span class="track-src" aria-hidden="true">@SourceLabel.Short(t.Source)</span></span>
                    <DownloadTag Session="Session" Artist="@t.Artist" Title="@t.Title" Track="t" />
                </span>
            </button>
            <span class="pills">
                <span class="badge @t.Source.ToString().ToLowerInvariant()" title="@(t.Source == TrackSource.Cloud ? SourceLabel.StreamingHint : "Where this song is played from")">@SourceLabel.Short(t.Source)</span>
                @if (fmt.Length > 0) { <span class="badge fmt @(fmt == "HI-RES" ? "hires" : MediaInfo.LosslessCodecs.Contains(fmt.ToLowerInvariant()) ? "lossless" : "")" title="@(fmt == "HI-RES" ? "Hi-Res: lossless at more than CD quality" : "File format")">@(fmt == "HI-RES" ? "✦ Hi-Res" : fmt)</span> }
            </span>
            <span class="track-time">@(t.DurationMs > 0 ? Time(t.DurationMs / 1000.0) : "")</span>
            <button class="icon-btn @(Session.IsFavorite(t) ? "on" : "")" @onclick="() => { Feedback.Heart(Session, t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" /></button>
            <button class="icon-btn" @onclick="() => { menu = menu == idx ? -1 : idx; sub = string.Empty; }" aria-label="More for @t.Title" aria-expanded="@((menu == idx) ? "true" : "false")"><Icon Name="more" /></button>
            @if (menu == idx)
            {
                <div class="menu" role="menu">
                    <button role="menuitem" @onclick='() => { Player.PlayNext(t); Toast.Show($"“{t.Title}” plays next"); menu = -1; }'>Play next</button>
                    <button role="menuitem" @onclick='() => { Player.AddToQueue(t); Toast.Show($"Added “{t.Title}” to the queue"); menu = -1; }'>Add to queue</button>
                    @* every playlist used to be listed here, one "Add to …" each: now one entry opens them (owner, 7 Nov: "menus are too complicated") *@
                    <button role="menuitem" class="has-sub" aria-expanded="@(sub == "pl" ? "true" : "false")" @onclick='() => Sub("pl")'>Add to playlist <span aria-hidden="true" class="chev">›</span></button>
                    @if (sub == "pl")
                    {
                        @if (!Session.Playlists.Any()) { <small class="menu-note">No playlists yet. Make one on the Playlists page.</small> }
                        @foreach (var p in Session.Playlists)
                        {
                            <button role="menuitem" class="sub" @onclick="() => { Toast.Added(Session, p, t, SaveProfile); menu = -1; }">Add to @p.Name</button>
                        }
                    }
                    @if (OnMove is not null)
                    {
                        <button role="menuitem" disabled="@(idx == 0)" @onclick="() => { OnMove(idx, idx - 1); menu = -1; }">Move up</button>
                        <button role="menuitem" disabled="@(idx == Tracks.Count - 1)" @onclick="() => { OnMove(idx, idx + 1); menu = -1; }">Move down</button>
                    }
                    <hr class="menu-sep" />
                    <button role="menuitem" @onclick='async () => { menu = -1; await Sharing.ShareAsync(Session, "song", t.Title, [t]); }'>Share</button>
                    <button role="menuitem" @onclick="() => { menu = -1; StartSelecting(idx); }">Select songs</button>
                    <hr class="menu-sep" />
                    <button role="menuitem" class="has-sub" aria-expanded="@(sub == "nope" ? "true" : "false")" @onclick='() => Sub("nope")'>Not for me <span aria-hidden="true" class="chev">›</span></button>
                    @if (sub == "nope")
                    {
                        <button role="menuitem" class="sub" @onclick='() => { menu = -1; Feedback.LessLikeThis(Session, t); Toast.Show($"Fewer songs like “{t.Title}”"); }'>Less like this</button>
                        <button role="menuitem" class="sub" @onclick='() => { menu = -1; gone.Add(t.Path); _ = Feedback.ThumbDown(Session, t, Player); Toast.Show($"“{t.Title}” will not be picked for you again"); }'>Never pick this song</button>
                    }
                    @if (Player.Dj is not null)
                    {
                        <button role="menuitem" class="has-sub" aria-expanded="@(sub == "dj" ? "true" : "false")" @onclick='() => Sub("dj")'>The DJ and this song <span aria-hidden="true" class="chev">›</span></button>
                        @if (sub == "dj") { <DjSongMenu Player="Player" Session="Session" Song="t" OnDone="() => menu = -1" /> }
                    }
                    @if (OnRemove is not null) { <button role="menuitem" class="danger" @onclick="() => { OnRemove(idx); menu = -1; }">Remove from playlist</button> }
                    @if (admin && Downloads.Allowed && Session.Services.SoulseekReady &&!t.Path.Contains("[Hi-Res]", StringComparison.OrdinalIgnoreCase))
                    {
                        @if (hiAsk == idx)
                        {
                            <div class="menu-ask" role="group" aria-label="Get a Hi-Res copy?"><b>Get a Hi-Res copy?</b><small>Hi-Res files are 2 to 5 times bigger (roughly 40 to 200 MB). It is saved next to this one. If no Hi-Res copy exists, nothing is changed.</small><span class="hires-actions"><button class="btn hires solid" @onclick="() => GetHiRes(t)">Download Hi-Res</button><button class="btn ghost" @onclick="() => hiAsk = -1">Cancel</button></span></div>
                        }
                        else { <button role="menuitem" class="menu-subtle" @onclick="() => AskHi(idx)"><span aria-hidden="true">✦</span> Hi-Res version…</button> }
                    }
                </div>
            }
        </li>
    }
    @if (Waiting is { Count: > 0 }) { foreach (var w in Waiting.Where(w => w.Before >= Tracks.Count)) { @WaitingRow(w) } }
</ol>
@if (selecting)
{
    @* what to do with the chosen songs, in the order they are in this list *@
    <section class="select-bar" aria-label="Selected songs">
        <b>@selected.Count selected</b>
        <button class="btn" disabled="@(selected.Count == 0)" @onclick="PlayNextAll">Play next</button>
        <button class="btn" disabled="@(selected.Count == 0)" @onclick="QueueAll">Add to queue</button>
        @if (Session.Playlists.Count > 0)
        {
            <span class="select-pl">
                <button class="btn" disabled="@(selected.Count == 0)" aria-haspopup="menu" aria-expanded="@(plMenu ? "true" : "false")" @onclick="() => plMenu = !plMenu">Add to playlist</button>
                @if (plMenu) { <span class="menu" role="menu">@foreach (var p in Session.Playlists) { <button role="menuitem" @onclick="() => ToPlaylist(p)">@p.Name</button> }</span> }
            </span>
        }
        <button class="btn ghost" @onclick="StopSelecting">Cancel</button>
    </section>
}
@code {
    [Parameter] public IReadOnlyList<Track> Tracks { get; set; } = [];
    /// <summary>F26.6: songs of an import not in the library yet, greyed in their place with their live state; they can't be played.</summary>
    [Parameter] public IReadOnlyList<WaitingSong>? Waiting { get; set; }
    [Parameter] public Action<WaitingSong>? OnRetry { get; set; }
    RenderFragment WaitingRow(WaitingSong w) => @<li class="track pending @(w.Failed ? "failed" : "")" data-testid="pending-song" aria-disabled="true">
        <span class="track-main"><Cover Size="@ThumbSize" /><span class="track-text"><span class="track-title">@w.Title</span><span class="track-sub">@w.Artist</span>
            <span class="pending-state" data-testid="pending-state">@w.Status@if (w.Percent is { } pc) {<span class="pending-bar" aria-hidden="true"><i style="width:@(pc)%"></i></span>}</span></span></span>
        @if (w.Failed && OnRetry is not null) { <button class="btn" @onclick="() => OnRetry(w)">Retry</button> }
    </li>;
    [Parameter] public bool Numbered { get; set; }
    /// <summary>Side of the small cover in a row, in pixels.</summary>
    [Parameter] public int ThumbSize { get; set; } = 44;
    /// <summary>Play only the clicked song and let Autoplay carry on (search results hold several releases of one song, which must not queue up behind it).</summary>
    [Parameter] public bool Single { get; set; }
    [Parameter] public string? PlayContext { get; set; }
    /// <summary>The playlist the list is (its DJ key), so the playlist's DJ switch counts for what plays from it.</summary>
    [Parameter] public string? PlayContextId { get; set; }
    [Parameter] public bool ShowAlbum { get; set; } = true;
    /// <summary>A small word before the artist saying what the row is ("Song"), for search results that mix kinds (owner, 7 Nov: "a label like Spotify").</summary>
    [Parameter] public string? KindTag { get; set; }
    [Parameter] public Action<int>? OnRemove { get; set; }
    /// <summary>Set on a playlist page: move the song at the first index to the second.</summary>
    [Parameter] public Action<int, int>? OnMove { get; set; }
    int menu = -1, hiAsk = -1;
    // the open sub-menu of a song's menu ("pl", "nope", "dj"): one at a time, so the menu never grows past the screen
    string sub = "";
    void Sub(string which) => sub = sub == which ? "" : which;
    // songs thumbed down here leave the list at once (the list itself is the page's, and stays as it was)
    readonly HashSet<string> gone = [];

    // ---- choosing several songs: Select in a menu (or a Shift-click) starts it; a tap then ticks or unticks a row ----
    bool selecting, plMenu;
    readonly SortedSet<int> selected = [];
    List<Track> Chosen() => selected.Where(i => i < Tracks.Count).Select(i => Tracks[i]).ToList();
    static string Songs(int n) => n == 1 ? "1 song" : n + " songs";
    void StartSelecting(int idx) { selecting = true; selected.Clear(); selected.Add(idx); }
    void StopSelecting() { selecting = false; plMenu = false; selected.Clear(); }
    void Pick(int idx) { if (!selected.Remove(idx)) selected.Add(idx); }
    Task Main(MouseEventArgs e, int idx)
    {
        if (selecting) { Pick(idx); return Task.CompletedTask; }
        if (e.ShiftKey) { StartSelecting(idx); return Task.CompletedTask; }
        return Go(idx);
    }
    void PlayNextAll() { var l = Chosen(); for (var k = l.Count - 1; k >= 0; k--) Player.PlayNext(l[k]); Toast.Show(Songs(l.Count) + " play next"); StopSelecting(); }
    void QueueAll() { var l = Chosen(); foreach (var t in l) Player.AddToQueue(t); Toast.Show("Added " + Songs(l.Count) + " to the queue"); StopSelecting(); }
    void ToPlaylist(Playlist p)
    {
        var l = Chosen(); var added = 0;
        foreach (var t in l) if (Session.AddToPlaylist(p.Id, t) == UserSession.PlaylistAdd.Added) added++;
        SaveProfile();
        Toast.Show(added == l.Count ? $"Added {Songs(added)} to {p.Name}" : $"Added {Songs(added)} to {p.Name} ({l.Count - added} already there)");
        StopSelecting();
    }
    [Inject] IDownloads Downloads { get; set; } = default!;
    [Inject] Toasts Toast { get; set; } = default!;
    [Inject] Sharing Sharing { get; set; } = default!;
    [Inject] IJSRuntime Js { get; set; } = default!;
    async Task AskHi(int idx) { hiAsk = idx; StateHasChanged(); await Task.Delay(30); try { await Js.InvokeVoidAsync("flacie.menuToEnd"); } catch (Exception) { } }
    [Inject] IConfiguration Conf { get; set; } = default!;
    bool admin => AdminAccess.Is(Session, Conf);
    // administrators only: a Hi-Res copy of a song already in the library (saved beside it; the normal download runs instead only when asked for from Search)
    void GetHiRes(Track t) { menu = -1; hiAsk = -1; Downloads.Song(Session, new CatalogSong(t.Artist, t.Title, t.Album, null, t.DurationMs, t.TrackNo, t.DiscNo), true, false); }
    // the song that is already playing is not started over: a click resumes it if paused, or opens the full-screen player
    Task Go(int i)
    {
        if (Player.Current?.Path == Tracks[i].Path) { if (!Player.Playing) return Player.Toggle(); Player.RequestFullScreen(); return Task.CompletedTask; }
        if (Single) return Player.Play([Tracks[i]], 0, PlayContext, PlayContextId);
        // songs thumbed down here are not queued behind the one pressed
        var list = gone.Count == 0 ? Tracks : Tracks.Where(x => !gone.Contains(x.Path)).ToList();
        return Player.Play(list, gone.Count == 0 ? i : list.ToList().IndexOf(Tracks[i]), PlayContext, PlayContextId);
    }
}
