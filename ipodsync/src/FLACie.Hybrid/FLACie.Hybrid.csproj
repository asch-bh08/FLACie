<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!-- Prototype: FLACie's Retro page (iPods, the desk, the listening scenes) as an Android app, with no server. The page's
         components come from FLACie.Retro, the same ones FLACie.Server shows; its styles and scripts are FLACie.Server's own
         wwwroot files, linked in below (not copied). Jellyfin is reached straight from the phone. -->
    <PropertyGroup>
        <TargetFrameworks>net9.0-android</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>FLACie.Hybrid</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>

        <ApplicationTitle>FLACie Retro</ApplicationTitle>
        <ApplicationId>dev.ashley.flacie.retro</ApplicationId>
        <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
        <SupportedOSPlatformVersion>30.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="..\IpodSync.Maui\Resources\AppIcon\appicon.svg" ForegroundFile="..\IpodSync.Maui\Resources\AppIcon\appiconfg.svg" Color="#B03CB6" />
        <MauiSplashScreen Include="..\IpodSync.Maui\Resources\Splash\splash.svg" Color="#15151c" BaseSize="128,128" />
    </ItemGroup>

    <!-- the web app's styles, scripts, fonts and pictures, served to the page from the app's own origin -->
    <ItemGroup>
        <Content Include="..\FLACie.Server\wwwroot\**\*" Exclude="..\FLACie.Server\wwwroot\manifest.webmanifest" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FLACie.Core\FLACie.Core.csproj" />
        <ProjectReference Include="..\FLACie.Retro\FLACie.Retro.csproj" />
    </ItemGroup>

</Project>
