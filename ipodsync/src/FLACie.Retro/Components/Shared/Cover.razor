@* A cover from /art, or a quiet placeholder when there's none. *@
<div class="cover @Class" style="@(Size > 0 ? $"width:{Size}px;height:{Size}px" : "")">
    <span class="cover-ph" aria-hidden="true"><Icon Name="note" Size="@(Size > 0 ? Math.Max(14, Size / 3) : 40)" /></span>
    @if (ArtKey is not null)
    {
        <img src="/art/@Uri.EscapeDataString(CoverOverrides.Map(ArtKey)!)?v=3@(Full ? "&s=full" : "")" alt="" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'" />
    }
</div>
@code {
    [Parameter] public string? ArtKey { get; set; }
    [Parameter] public int Size { get; set; }
    /// <summary>The original picture instead of the small row size (only the big Now Playing cover).</summary>
    [Parameter] public bool Full { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
