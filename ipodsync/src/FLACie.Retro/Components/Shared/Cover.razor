@* A cover from /art, or a quiet placeholder when there's none. *@
<div class="cover @Class" style="@(Size > 0 ? $"width:{Size}px;height:{Size}px" : "")">
    <span class="cover-ph" aria-hidden="true"><Icon Name="note" Size="@(Size > 0 ? Math.Max(14, Size / 3) : 40)" /></span>
    @if (ArtKey is not null)
    {
        var src = $"/art/{Uri.EscapeDataString(CoverOverrides.Map(ArtKey)!)}?v=3";
        @* a cover always on screen (the player, Now Playing) is asked for at once, not when lazy loading gets round to it; the big one shows the small cover
           (usually in the cache already) underneath straight away, and the sharp one covers it when it lands. Rows in long lists stay lazy. *@
        var now = Eager || Full;
        @* a cover that fails shows the placeholder and is asked for once more four seconds later (a new address, "&r=1", so no cached error is reused): the server
           answers 503 when the catalog could not be asked or the lookup was cut short, and the second try usually finds it (owner, 5 Nov: covers stayed blank).
           An image cannot see the status, so a real miss is asked twice too; the server remembers it, so that answer is immediate. A picture that loads (also a
           new one Blazor puts in) is shown again. *@
        @if (Full) { <img class="cover-under" src="@src" alt="" decoding="async" fetchpriority="high" onload="this.style.visibility=''" onerror="this.style.visibility='hidden';var i=this,s=i.src;if(!/&r=1$/.test(s))setTimeout(function(){if(i.isConnected&&i.src===s)i.src=s+'&r=1'},4000)" /> }
        <img src="@(src + (Full ? "&s=full" : ""))" alt="" loading="@(now ? "eager" : "lazy")" decoding="async" fetchpriority="@(now ? "high" : "auto")" onload="this.style.visibility=''" onerror="this.style.visibility='hidden';var i=this,s=i.src;if(!/&r=1$/.test(s))setTimeout(function(){if(i.isConnected&&i.src===s)i.src=s+'&r=1'},4000)" />
    }
</div>
@code {
    [Parameter] public string? ArtKey { get; set; }
    [Parameter] public int Size { get; set; }
    /// <summary>The original picture instead of the small row size (only the big Now Playing cover).</summary>
    [Parameter] public bool Full { get; set; }
    /// <summary>Always on screen (the player bar): loaded at once.</summary>
    [Parameter] public bool Eager { get; set; }
    [Parameter] public string Class { get; set; } = "";
}
