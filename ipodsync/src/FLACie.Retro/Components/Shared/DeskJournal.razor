@using FLACie.Core
@* The iPod desk's journal: an open notebook (on a phone, a pad of sticky notes) with the playing song's title and artist in handwriting, and its lyrics. Every line is here with its time (data-ms); desk.js shows
   them as they are sung, from the song's own clock in the browser (no round trip to the server, so no lag), writes the line being sung like a pen
   (unless motion is reduced) and keeps it in view when the page is full. A long line wraps onto the next rule. No lyrics: just the title.
   Nothing playing: a note saying so. *@
<div class="desk-journal lift" data-testid="desk-journal">
    <div class="page">
        <i class="sheet left"></i><i class="sheet right"></i>
        <div class="j-title">@(string.IsNullOrEmpty(Title) ? "nothing playing" : Title)@if (!string.IsNullOrEmpty(Artist)) { <small>@Artist</small> }</div>
        <div class="j-lines" data-synced="@(Synced ? "" : null)">
            @for (var i = 0; i < Lines.Count; i++)
            {
                var line = Lines[i];
                @* keyed by the song too: a new song's lines are new elements, so nothing desk.js marked on the old ones carries over *@
                <div @key="(SongKey, i)" data-testid="desk-lyric" data-ms="@(Synced ? line.TimeMs : null)">@line.Text</div>
            }
        </div>
        <div class="j-date" data-testid="desk-date">@Date</div>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Artist { get; set; }
    [Parameter] public IReadOnlyList<LyricLine> Lines { get; set; } = [];
    /// <summary>The lines carry times; otherwise desk.js spreads them over the song.</summary>
    [Parameter] public bool Synced { get; set; }
    /// <summary>Which song the lines belong to.</summary>
    [Parameter] public string? SongKey { get; set; }
    /// <summary>The viewer's own day ("15 oct"), from their browser; empty until it answers.</summary>
    [Parameter] public string Date { get; set; } = "";
}
