@* The iPod desk's keepsakes: a concert ticket stub for the artist playing (its seat and date stay the same for that artist), and, beside it, an early-2000s silver
   USB thumb drive lying flat (music to carry) with a bent paperclip (the tool for resetting an iPod). To look at, not to press. Styles: desk.css. *@
@if (Ticket)
{
<div class="desk-ticket lift" data-testid="desk-ticket" aria-hidden="true">
    <div class="stub-main">
        <small>LIVE · @Live</small>
        <b>@ArtistLine</b>
        <span>@When</span>
    </div>
    <div class="stub-tear">
        <small>ADMIT ONE</small>
        <span>SEC @Section</span><span>ROW @Row</span><span>SEAT @Seat</span>
    </div>
</div>
}
@if (Usb)
{
<div class="desk-usb lift" data-testid="desk-usb" aria-hidden="true">
    <i class="plug"><b></b><b></b></i><i class="body"><span>256MB</span><em class="led"></em></i><i class="loop"></i>
</div>
<svg class="desk-clip" data-testid="desk-clip" viewBox="0 0 120 40" aria-hidden="true">
    <path d="M 8 30 L 92 30 A 10 10 0 0 0 92 10 L 20 10 A 6 6 0 0 0 20 22 L 84 22 A 2.5 2.5 0 0 0 84 17 L 34 17" />
    <path class="bent" d="M 8 30 L 2 37" />
</svg>
}

@code {
    [Parameter] public bool Ticket { get; set; }
    [Parameter] public bool Usb { get; set; }
    /// <summary>The artist playing; empty when nothing plays (then the stub is a blank one).</summary>
    [Parameter] public string? Artist { get; set; }
    /// <summary>The song's year (0 when unknown): the stub is from that year's tour.</summary>
    [Parameter] public int Year { get; set; }

    string ArtistLine => string.IsNullOrWhiteSpace(Artist) ? "—" : Artist.Trim().ToUpperInvariant();
    int H { get { unchecked { var h = 17; foreach (var c in Artist ?? "") h = h * 31 + c; return h & 0x7fffffff; } } }
    static readonly string[] Months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
    string When => $"{1 + H % 28:00} {Months[H / 28 % 12]} {(Year > 0 ? Year : 2006)}";
    string Live => Year > 0 ? $"{Year} TOUR" : "ON TOUR";
    string Section => ((char)('A' + H / 7 % 8)).ToString();
    int Row => 1 + H / 13 % 24;
    int Seat => 1 + H / 31 % 40;
}
