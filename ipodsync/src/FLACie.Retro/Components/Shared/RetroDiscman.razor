@inherits RetroBase
@* The Discman scene: a portable CD player in brushed silver, seen straight down on a plain surface, black earbud wires snaking out of the 3.5 mm jack on its
   side. Its lid opens (OPEN) to show the disc spinning while the music plays: the disc carries a print of the album's cover (desk.js discInto, the same
   print as the iPod desk's CD). Beside it a wired remote shows what the file is and the line being sung (and MEGA BASS while it is on) and has the volume keys. Along its front edge, a backlit segment LCD with the song (CD-Text, scrolling when long), the track and the time, and the keys: previous, play/pause, next, stop
   (pause, back to the song's start), and MEGA BASS (the player's own bass shelf, flacie.js bass()). Beside it, the CDs coming up: a click plays one.
   Styles: retro.css. *@
<div class="discman">
    <div class="dm-surface" aria-hidden="true"></div>
    <div class="dm-player" data-testid="retro-unit">
        <svg class="dm-wires" viewBox="0 0 400 400" aria-hidden="true">
            <path d="M10 170 C -60 175, -95 240, -80 300 S -120 380, -150 392" />
            <path d="M-80 300 C -60 340, -30 360, -28 410" />
            <g transform="translate(-150 392) rotate(28)"><ellipse rx="17" ry="21" /><circle r="9" class="mesh" /></g>
            <g transform="translate(-28 410) rotate(-14)"><ellipse rx="17" ry="21" /><circle r="9" class="mesh" /></g>
        </svg>
        <i class="dm-jack" aria-hidden="true"></i>
        <div class="dm-body">
            <div class="dm-well" aria-hidden="@(open ? "false" : "true")">
                <div class="dm-disc @(Playing ? "" : "paused")" data-testid="dm-disc" data-spin="327" @ref="disc"><i class="hole"></i></div>
                <i class="dm-spindle"></i>
            </div>
            <div class="dm-lid @(open ? "open" : "")" data-testid="dm-lid" aria-hidden="true">
                <i class="ring"></i><span class="dm-brand">FLACIE<small>PORTABLE COMPACT DISC PLAYER · ESP</small></span>
            </div>
            <div class="dm-front">
                <div class="dm-lcd" data-testid="dm-lcd" aria-label="Track and time">
                    <span class="cdtext rt-mq" data-testid="retro-title">@(Now is null ? "NO DISC" : $"{Now.Title} · {Now.Artist}")</span>
                    <small>TRACK</small><b class="seg">@(Now is null ? "--" : TrackNo.ToString("00"))</b>
                    <b class="seg time" data-testid="dm-time">@(Now is null ? "-:--" : Clock(Position))</b>
                    <small class="bass @(Mega ? "on" : "")">MEGA BASS</small><small class="state">@(Playing ? "▶" : "❚❚")</small>
                </div>
                <div class="dm-keys">
                    <button type="button" data-ctl="prev" aria-label="Previous" @onclick="Prev">⏮</button>
                    <button type="button" data-ctl="play" class="big" aria-label="@(Playing ? "Pause" : "Play")" @onclick="Toggle">▶❚❚</button>
                    <button type="button" data-ctl="next" aria-label="Next" @onclick="Next">⏭</button>
                    <button type="button" data-ctl="stop" aria-label="Stop" @onclick="Stop">■</button>
                    <button type="button" data-ctl="bass" class="bass @(Mega ? "on" : "")" aria-pressed="@(Mega ? "true" : "false")" aria-label="Mega Bass" @onclick="Bass">MEGA<br />BASS</button>
                </div>
            </div>
            <button type="button" class="dm-open" data-ctl="open" aria-pressed="@(open ? "true" : "false")" aria-label="@(open ? "Close the lid" : "Open the lid")" @onclick="() => open = !open">OPEN</button>
        </div>
    </div>
    @* the wired remote lying beside it: a small LCD with what the file is and the line being sung, MEGA BASS lit while it is on, and the volume keys *@
    <div class="dm-remote" data-testid="dm-remote">
        <svg class="dm-rcable" viewBox="0 0 100 80" aria-hidden="true"><path d="M98 78 C 94 40, 60 56, 44 28 S 10 6, 0 2" /></svg>
        <div class="rm-in">
        <div class="rm-lcd">
            <div class="rm-l0"><span class="rt-mq" data-testid="retro-format">@(Now is null ? "NO DISC" : Format)</span><small class="@(Mega ? "on" : "")" data-testid="dm-remote-bass">MEGA BASS</small></div>
            @LyricsBox(Now?.Artist ?? "FLACIE", "rm-lyric")
            <div class="rm-l2"><span>@(Playing ? "▶" : "❚❚")</span><span data-testid="dm-vol">VOL @(VolPct / 5)</span></div>
        </div>
        <div class="rm-keys">
            <button type="button" data-ctl="vol-down" aria-label="Volume down" title="Volume down" @onclick="() => Vol(VolNow - .05)">−</button>
            <small>VOL</small>
            <button type="button" data-ctl="vol-up" aria-label="Volume up" title="Volume up" @onclick="() => Vol(VolNow + .05)">+</button>
        </div>
        </div>
    </div>
    <div class="dm-cds">
        @for (var i = 0; i < Math.Min(NextAlbums.Count, 3); i++)
        {
            var a = NextAlbums[i];
            <button type="button" class="dm-cd" style="--i:@i" data-media="album" data-album="@a.Album" aria-label="@($"Play {a.Album}")" title="@a.Album" @onclick="() => PlayAlbum(a)">
                <Cover ArtKey="@a.ArtKey" Class="dm-art" /><i class="glare"></i>
            </button>
        }
    </div>
</div>

@code {
    bool open;
    ElementReference disc;
    string? discFor;

    async Task Stop() { await Pause(); await Seek(0); }
    async Task Bass()
    {
        var want = !Mega;
        try { Mega = await Js.InvokeAsync<bool>("flacie.bass", want); } catch (Exception e) when (e is JSDisconnectedException or JSException or InvalidOperationException or OperationCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        await base.OnAfterRenderAsync(first);
        // the disc's print: the album playing, made from its cover in the browser (desk.js; the same as the desk's CD)
        var a = NowAlbum;
        var key = a is null ? "" : $"{a.Key}|{a.ArtKey}";
        if (a is null || key == discFor) return;
        discFor = key;
        var cover = a.ArtKey is null ? null : $"/art/{Uri.EscapeDataString(FLACie.Core.CoverOverrides.Map(a.ArtKey)!)}?v=3";
        try { await Js.InvokeAsync<bool>("desk.discInto", disc, null, cover, a.Artist, a.Album); }
        catch (Exception e) when (e is JSDisconnectedException or JSException or InvalidOperationException or OperationCanceledException) { }
    }
}
