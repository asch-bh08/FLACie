<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0e" />
    <base href="/" />
    <title>FLACie</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <HeadOutlet @rendermode="PageMode" />
</head>
<body>
    <Routes @rendermode="PageMode" />
    @* Blazor shows this when the live connection drops (a restart, a lost signal); it is a quiet toast that only appears if the drop lasts *@
    <div id="components-reconnect-modal" role="status" aria-live="polite">
        <span class="rc-dot" aria-hidden="true"></span>
        <span class="rc-msg rc-show">Reconnecting…</span>
        <span class="rc-msg rc-failed">Can't reach FLACie. Still trying…</span>
        <span class="rc-msg rc-rejected">The connection was reset.</span>
        <a class="rc-reload" href="">Reload</a>
    </div>
    <script src="flacie.js"></script>
    <script src="headphones.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
      // patient reconnecting (a lost signal, a phone asleep): retry for a long time, and when the server was restarted (the old page can no longer continue) reload by itself once it is back
      Blazor.start({ circuit: {
        reconnectionOptions: { maxRetries: 200, retryIntervalMilliseconds: n => Math.min(1000 + n * 500, 5000) },
        configureSignalR: b => { b.withServerTimeout(90000); b.withKeepAliveInterval(10000); },
      } });
      window.flacie.autoRecover();
    </script>
</body>
</html>

@code {
    [CascadingParameter] HttpContext HttpContext { get; set; } = default!;
    // the login page is a plain form page (it has to set the sign-in cookie); everything else is live
    IComponentRenderMode? PageMode => HttpContext.Request.Path.StartsWithSegments("/login") ? null : InteractiveServer;
}
