@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
<div class="app @(InMusic ? "full" : "") @(InMusic && menu ? "menu-open" : "")">
    <TopBar Full="InMusic" MenuOpen="menu" OnMenu="() => menu = !menu" />
    <button class="menu-scrim" tabindex="-1" aria-hidden="true" @onclick="() => menu = false"></button>
    <nav class="rail" aria-label="Main" id="main-rail">
        <div class="rail-group">
            <NavLink href="/" Match="NavLinkMatch.All"><Icon Name="home" />Home</NavLink>
            @* Explore has its own search box, so its menu leaves this one out *@
            @if (!InMusic) { <NavLink href="/search"><Icon Name="search" />Search</NavLink> }
        </div>
        <div class="rail-group">
            <a href="/explore" class="@(InMusic ? "active" : "")"><Icon Name="albums" />Explore</a>
            <NavLink href="/favorites"><Icon Name="heart" />Favourites</NavLink>
            <NavLink href="/playlists" Match="NavLinkMatch.All"><Icon Name="playlists" />Playlists</NavLink>
        </div>
        <div class="rail-group">
            <p class="rail-label">Find more</p>
            <NavLink href="/downloads"><Icon Name="download" />Downloads</NavLink>
            <NavLink href="/import"><Icon Name="playlists" />Import</NavLink>
        </div>
        <div class="rail-group">
            <p class="rail-label">Together</p>
            <NavLink href="/devices"><Icon Name="devices" />Devices</NavLink>
            <NavLink href="/jam"><Icon Name="jam" />Jam</NavLink>
            <AdminLink />
        </div>
        <div class="rail-group">
            <p class="rail-label">Tools</p>
            <NavLink href="/headphones"><Icon Name="headphones" />Headphone test</NavLink>
        </div>
    </nav>
    <main class="content">@Body</main>
    <RemoteNowPlaying />
    <PlayerBar />
    <ToastHost />
</div>
@code {
    // "All music" is lit for its four filters and their detail pages
    bool InMusic { get { var p = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0]; return new[] { "/explore", "/songs", "/albums", "/artists", "/genres", "/charts", "/album/", "/artist/", "/genre/" }.Any(x => p.StartsWith(x, StringComparison.OrdinalIgnoreCase)); } }
    // Explore uses the whole window: the side menu slides in from a hamburger and goes away again after a choice
    bool menu;
    protected override void OnInitialized() => Nav.LocationChanged += Moved;
    void Moved(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(() => { menu = false; StateHasChanged(); });
    public void Dispose() => Nav.LocationChanged -= Moved;
}
