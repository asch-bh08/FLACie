@page "/dashboard"
@page "/admin"
@attribute [Authorize]
@implements IDisposable
@inherits UserComponent
@inject IConfiguration Conf
@inject ActivityLog Log
@inject Notifier Notify
@inject SessionStore Store
@inject DownloadManager Downloads
@inject UserStateStore States
@inject DataPaths Paths
<PageTitle>Dashboard · FLACie</PageTitle>
<header class="page-head"><h1>Dashboard</h1><p class="sub">What is playing, who is on, what the server is doing, and the server's settings</p></header>
@if (allowed) { <nav class="subnav" aria-label="Dashboard sections"><a href="/dashboard#downloads">Download services</a><a href="/dashboard#opensources">Open sources</a><a href="/dashboard#background">Background downloads</a><a href="/dashboard#storage">Storage</a><a href="/dashboard#notify">Notifications</a><a href="/downloads">Download log</a></nav> }
@if (!allowed)
{
    <section class="panel"><p>This page is for the server's administrators. Ask the person who runs FLACie to make your account an administrator of the Jellyfin server, or to add you to <code>FLACIE_ADMINS</code>.</p></section>
}
else
{
    <section class="admin-block" aria-label="Devices">
        <div class="shelf-head"><div><h2>Devices</h2><small>@cards.Count(c => c.Playing && !c.Paused) playing · @cards.Count open now</small></div></div>
        @if (error is not null) { <p class="form-error">@error</p> }
        @if (cards.Count == 0) { <p class="hint">No device is connected right now.</p> }
        <div class="jf-grid">
            @foreach (var c in cards)
            {
                <article class="jf-card">
                    <div class="jf-top @(c.Playing ? "art" : "idle")" style="@(c.Playing && c.ArtKey is not null ? $"background-image:linear-gradient(to bottom,#000b,#0004 38%,#000d),url('/art/{Uri.EscapeDataString(c.ArtKey)}?v=2')" : "")">
                        <div class="jf-head"><Icon Name="devices" Size="26" /><div><b>@c.Title</b><small>@c.Sub</small></div></div>
                        <div class="jf-line">
                            <span>@(c.Playing ? c.Track : "Last activity " + c.Seen)</span>
                            @if (c.Playing && c.DurMs > 0) { <span>@Time(c.PosMs / 1000.0) / @Time(c.DurMs / 1000.0)</span> }
                        </div>
                        @if (c.Playing && c.DurMs > 0) { <div class="jf-progress"><i style="width:@Pct(c.PosMs, c.DurMs)%"></i></div> }
                    </div>
                    <div class="jf-bar">
                        <div class="jf-btns">
                            @if (c.Playing && c.Do is not null)
                            {
                                <button aria-label="@(c.Paused ? "Resume" : "Pause")" @onclick='() => Act(c, "toggle")'><Icon Name="@(c.Paused ? "play" : "pause")" Size="18" /></button>
                                <button aria-label="Stop" @onclick='() => Act(c, "stop")'><Icon Name="stop" Size="18" /></button>
                            }
                            <button aria-label="Details" @onclick="() => infoKey = c.Key"><Icon Name="info" Size="20" /></button>
                        </div>
                        <span class="jf-user">@c.User</span>
                    </div>
                </article>
            }
        </div>
    </section>

    @if (infoKey is not null && cards.FirstOrDefault(x => x.Key == infoKey) is { } ic)
    {
        var pb = ic.Info.FirstOrDefault(g => g.Head == "Playback").Rows;
        <div class="modal-scrim" @onclick="() => infoKey = null"></div>
        <div class="modal" role="dialog" aria-modal="true" aria-label="@ic.Title">
            <h3>@(pb?.FirstOrDefault(r => r.K == "Method").V switch { "Direct play" => "Direct playing", "Direct stream" => "Direct streaming", "Transcoding" => "Transcoding", _ => ic.Title })</h3>
            @if (pb?.FirstOrDefault(r => r.K == "What that means").V is { Length: > 0 } why) { <p class="modal-lead">@why</p> }
            <div class="modal-body">
                @foreach (var (head, rows) in ic.Info)
                {
                    var shown = rows.Where(r => !(head == "Playback" && r.K is "Method" or "What that means")).ToList();
                    if (shown.Count == 0) { continue; }
                    <h5>@head</h5>
                    <dl class="kv">@foreach (var (k, v) in shown) { <dt>@k</dt><dd class="@(k == "Browser string" || k == "Location" ? "path" : "")">@v</dd> }</dl>
                }
            </div>
            <div class="row-actions"><button class="btn primary" @onclick="() => infoKey = null">Got it</button></div>
        </div>
    }

    <section class="admin-block" aria-label="Server">
        <div class="shelf-head"><div><h2>Server</h2><small>Tap a number to see what is behind it</small></div></div>
        <div class="stats" role="list">
            <button class="stat @(open == "accounts" ? "on" : "")" role="listitem" aria-expanded="@(open == "accounts")" @onclick='() => Toggle("accounts")'><b>@Store.Active.Count()</b><span>Accounts on</span></button>
            <button class="stat @(open == "songs" ? "on" : "")" role="listitem" aria-expanded="@(open == "songs")" @onclick='() => Toggle("songs")'><b>@Lib.Songs.Count.ToString("N0")</b><span>Songs in your library</span></button>
            <button class="stat @(open == "storage" ? "on" : "")" role="listitem" aria-expanded="@(open == "storage")" @onclick='() => Toggle("storage")'><b>@(space is { } sp ? StorageService.Bytes(sp.Free) : "?")</b><span>Music storage free</span></button>
            <button class="stat @(open == "downloads" ? "on" : "")" role="listitem" aria-expanded="@(open == "downloads")" @onclick='() => Toggle("downloads")'><b>@activeDownloads</b><span>Downloads running</span></button>
            <button class="stat @(open == "imports" ? "on" : "")" role="listitem" aria-expanded="@(open == "imports")" @onclick='() => Toggle("imports")'><b>@runningImports</b><span>Imports running</span></button>
        </div>
        @if (open is not null)
        {
            <div class="stat-detail" aria-live="polite">
                @switch (open)
                {
                    case "accounts":
                        <h3>Accounts signed in</h3>
                        <ul class="links">
                            @foreach (var u in Store.Active)
                            {
                                var devs = sessions.Count(d => d.User.Equals(u.Jellyfin?.UserName ?? u.DisplayName, StringComparison.OrdinalIgnoreCase));
                                <li><i class="dot on"></i><span><b>@u.DisplayName</b><small>@(u.Kind == "nas" ? "NAS sign-in" : "Jellyfin") · @u.Library.Songs.Count.ToString("N0") songs@(u.Loading ? " · loading the library" : "") · @devs device@(devs == 1 ? "" : "s") connected@(AdminAccess.Is(u, Conf) ? " · admin" : "")</small></span></li>
                            }
                        </ul>
                        <p class="hint">An account is "on" while this server holds its session: from the moment it signs in until the server restarts or it signs out.</p>
                        break;
                    case "songs":
                        <h3>Your library</h3>
                        <dl class="kv">
                            <dt>Songs</dt><dd>@Lib.Songs.Count.ToString("N0") in @Lib.Albums.Count.ToString("N0") albums by @Lib.Artists.Count.ToString("N0") artists</dd>
                            @foreach (var g in Lib.Songs.GroupBy(t => t.Source).OrderByDescending(g => g.Count()))
                            {
                                <dt>From @(g.Key switch { TrackSource.Nas => "the NAS", TrackSource.Cloud => "new downloads (streaming)", _ => g.Key.ToString() })</dt><dd>@g.Count().ToString("N0") songs</dd>
                            }
                            <dt>Quality</dt><dd>@lossless.ToString("N0") lossless · @((Lib.Songs.Count - lossless - unknownFmt).ToString("N0")) lossy@(unknownFmt > 0 ? " · " + unknownFmt.ToString("N0") + " unknown" : "")</dd>
                            <dt>Playlists</dt><dd>@Session.Playlists.Count</dd>
                            <dt>Favourites</dt><dd>@Session.Favorites.Count</dd>
                            <dt>Last read</dt><dd>@(Session.LoadedAt == default ? "not yet" : Ago(Session.LoadedAt))</dd>
                        </dl>
                        <div class="row-actions"><a class="btn" href="/songs">Explore</a></div>
                        break;
                    case "storage":
                        <h3>Music storage</h3>
                        @if (space is { } m)
                        {
                            <div class="meter" role="img" aria-label="@StorageService.Bytes(m.Total - m.Free) of @StorageService.Bytes(m.Total) used"><i class="a" style="width:@Pct(m.Total - m.Free, m.Total)%"></i></div>
                            <div class="legend"><span><i class="a" style="background:var(--accent)"></i>Used @StorageService.Bytes(m.Total - m.Free)</span><span>Free @StorageService.Bytes(m.Free)</span><span>Total @StorageService.Bytes(m.Total)</span></div>
                        }
                        else { <p class="hint">The music storage didn't report its free space (no NAS is connected to this account).</p> }
                        <dl class="kv">
                            <dt>Stops downloading below</dt><dd>@States.For(Session).MinFreeGb GB free</dd>
                            <dt>Server disk</dt><dd>@StorageService.Bytes(diskFree) free of @StorageService.Bytes(diskTotal)</dd>
                            <dt>Daily charts</dt><dd>@(States.For(Session).Charts.Enabled ? "on" : "off")@(States.For(Session).Charts.LastRun.Length > 0 ? ", last run " + States.For(Session).Charts.LastRun + ": " + States.For(Session).Charts.LastNote : "")</dd>
                        </dl>
                        <div class="row-actions"><a class="btn" href="/dashboard#storage">Storage settings</a></div>
                        break;
                    case "downloads":
                        <h3>Downloads</h3>
                        @if (downloads.Count == 0) { <p class="hint">Nothing has been downloaded since the server started.</p> }
                        <ul class="feed">
                            @foreach (var (u, j) in downloads)
                            {
                                <li class="feed-row k-@(j.Finished ? (j.Stage == DownloadStage.Failed ? "alert" : "server") : "play")"><span class="feed-ico"><Icon Name="@(j.Finished ? (j.Stage == DownloadStage.Failed ? "info" : "check") : "download")" Size="16" /></span>
                                    <span class="feed-text"><b>@j.Label</b><small>@j.Kind · @u · @j.Message</small></span><time>@(j.Finished ? Ago(j.At) : "running")</time></li>
                            }
                        </ul>
                        <p class="hint">"Search" is a song someone asked for, "Autoplay" is fetched ahead for a queue, "Import" comes from a playlist file and "Chart" from the daily charts. A running download is being searched for on Soulseek or Lidarr, then moved into the library.</p>
                        break;
                    default:
                        <h3>Playlist imports</h3>
                        @if (importJobs.Count == 0) { <p class="hint">No playlist file has been imported.</p> }
                        <ul class="links">
                            @foreach (var (u, j) in importJobs)
                            {
                                <li><i class="dot @(j.State is "running" or "waiting" ? "on" : "")"></i><span><b>@j.File</b><small>@u · @j.State@(j.State == "waiting" ? " for free space" : "") · @j.Finished of @j.Total songs@(j.Failed > 0 ? " · " + j.Failed + " not found" : "")@(j.Lists.Count > 0 ? " · " + string.Join(", ", j.Lists.Take(4).Select(l => UserSession.CleanName(l.Name))) + (j.Lists.Count > 4 ? "…" : "") : "")</small></span></li>
                            }
                        </ul>
                        <div class="row-actions"><a class="btn" href="/import">Import page</a></div>
                        break;
                }
            </div>
        }
    </section>

    <section class="admin-block" aria-label="Activity">
        <div class="shelf-head"><div><h2>Activity</h2><small>The latest things that happened on this server</small></div></div>
        @if (activity.Count == 0) { <p class="hint">Nothing yet.</p> }
        <ul class="feed">
            @foreach (var a in activity)
            {
                <li class="feed-row k-@a.Kind"><span class="feed-ico"><Icon Name="@FeedIcon(a.Kind)" Size="16" /></span><span class="feed-text"><b>@a.Text</b>@if (a.User.Length > 0) { <small>@a.User</small> }</span><time>@Ago(a.At)</time></li>
            }
        </ul>
    </section>

    <section class="admin-block panel set" id="notify" aria-label="Notifications">
        <div class="set-head"><h2>Notifications</h2><p class="hint">Sends the events below to an <a href="https://ntfy.sh/" target="_blank" rel="noopener">ntfy</a> topic, so they reach your phone. Use your own ntfy server or ntfy.sh. Nothing is sent until you turn it on.</p></div>
        <label class="switch-row"><span><b>Send notifications</b><small>@(string.IsNullOrEmpty(Notify.LastResult) ? "Not sent anything yet" : "Last: " + Notify.LastResult + (Notify.LastAt is { } la ? " · " + Ago(la) : ""))</small></span><input type="checkbox" role="switch" @bind="cfg.Enabled" /><i class="switch" aria-hidden="true"></i></label>
        <div class="form">
            <label for="nu">ntfy address</label><input id="nu" @bind="cfg.Url" placeholder="https://ntfy.example.com" autocomplete="off" />
            <label for="nt">Topic</label><input id="nt" @bind="cfg.Topic" placeholder="flacie" autocomplete="off" />
            <label for="nk">Access token <span class="opt">(only if the topic needs one@(Notify.HasToken ? "; one is saved, leave empty to keep it" : ""))</span></label><input id="nk" type="password" @bind="token" autocomplete="new-password" />
        </div>
        <div class="chart-picks" role="group" aria-label="What to send">
            <label class="check-chip"><input type="checkbox" @bind="cfg.Imports" /><span>Imports finished</span></label>
            <label class="check-chip"><input type="checkbox" @bind="cfg.Charts" /><span>Daily charts</span></label>
            <label class="check-chip"><input type="checkbox" @bind="cfg.LowSpace" /><span>Storage nearly full</span></label>
            <label class="check-chip"><input type="checkbox" @bind="cfg.SignIns" /><span>Someone signs in</span></label>
            <label class="check-chip"><input type="checkbox" @bind="cfg.Started" /><span>Server started</span></label>
        </div>
        <div class="row-actions">
            <button class="btn primary" @onclick="SaveNotify">Save</button>
            <button class="btn" @onclick="TestNotify" disabled="@testing">@(testing ? "Sending…" : "Send a test")</button>
            @if (notifyMsg is not null) { <span class="hint">@notifyMsg</span> }
        </div>
    </section>
<ServerSettings />
}
@code {
    record Dev(string Id, string User, string Device, string Client, string Version, DateTime LastActivity, string? ItemId, string? Title, string? Artist, long PositionMs, long DurationMs, bool Paused, bool Controllable, System.Text.Json.Nodes.JsonObject? Raw = null)
    {
        public bool Playing => ItemId is not null;
    }
    List<Dev> sessions = []; List<ActivityEntry> activity = []; string? error;
    bool allowed; NotifyConfig cfg = new(); string token = ""; string? notifyMsg; bool testing;
    (long Free, long Total)? space; int activeDownloads, runningImports;
    Timer? timer;
    string? open;
    void Toggle(string k) { open = open == k ? null : k; Recount(); }
    void Recount() { if (open != "songs") return; lossless = Lib.Songs.Count(t => FLACie.Core.MediaInfo.LosslessCodecs.Contains(InfoService.QuickFormat(t).ToLowerInvariant())); unknownFmt = Lib.Songs.Count(t => InfoService.QuickFormat(t).Length == 0); }
    List<(string User, DownloadJob Job)> downloads = []; List<(string User, ImportJob Job)> importJobs = [];
    int lossless, unknownFmt; long diskFree, diskTotal;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        allowed = AdminAccess.Is(Session, Conf);
        if (!allowed) return;
        cfg = Notify.Current;
        Log.Added += OnLog;
        await Refresh2();
        timer = new Timer(_ => InvokeAsync(async () => { await Refresh2(); StateHasChanged(); }), null, 3000, 3000);
    }

    void OnLog() => InvokeAsync(StateHasChanged);

    async Task Refresh2()
    {
        activity = Log.Recent(60);
        try { space = States is null ? null : Guard()?.Space(Session); } catch (Exception) { space = null; }
        activeDownloads = Store.Active.Sum(u => Downloads.JobsOf(u).Count(j => !j.Finished));
        runningImports = Store.Active.Sum(u => States.For(u).Imports.Count(j => j.State is "running" or "waiting"));
        downloads = Store.Active.SelectMany(u => Downloads.JobsOf(u).Select(j => (u.DisplayName, j))).OrderBy(x => x.j.Finished).ThenByDescending(x => x.j.At).Take(40).ToList();
        importJobs = Store.Active.SelectMany(u => States.For(u).Imports.Select(j => (u.DisplayName, j))).OrderByDescending(x => x.j.State is "running" or "waiting").ThenByDescending(x => x.j.Created).Take(10).ToList();
        try { var dr = new DriveInfo(Path.GetPathRoot(Path.GetFullPath(Paths.Root))!); diskFree = dr.AvailableFreeSpace; diskTotal = dr.TotalSize; } catch (Exception) { }
        Recount();
        if (Session.Jellyfin is not { } a) { error = "Signed in without Jellyfin: only browsers are listed."; await BuildCards(); return; }
        try
        {
            var node = await Jellyfin.GetAsync(a, "/Sessions?ActiveWithinSeconds=960");
            var list = new List<Dev>();
            foreach (var o in node?.AsArray() ?? [])
            {
                if (o is null) continue;
                var item = o["NowPlayingItem"];
                var ps = o["PlayState"];
                DateTime.TryParse(o["LastActivityDate"]?.GetValue<string>(), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var last);
                list.Add(new Dev(o["Id"]?.GetValue<string>() ?? "", o["UserName"]?.GetValue<string>() ?? "", o["DeviceName"]?.GetValue<string>() ?? "", o["Client"]?.GetValue<string>() ?? "", o["ApplicationVersion"]?.GetValue<string>() ?? "", last,
                    item?["Id"]?.GetValue<string>(), item?["Name"]?.GetValue<string>(), item?["Artists"]?.AsArray().FirstOrDefault()?.GetValue<string>() ?? item?["AlbumArtist"]?.GetValue<string>(),
                    (ps?["PositionTicks"]?.GetValue<long>() ?? 0) / 10_000, (item?["RunTimeTicks"]?.GetValue<long>() ?? 0) / 10_000, ps?["IsPaused"]?.GetValue<bool>() ?? false, o["SupportsRemoteControl"]?.GetValue<bool>() ?? false, o as System.Text.Json.Nodes.JsonObject));
            }
            // Jellyfin keeps several sessions per app install; one card per device and app is enough (the playing or latest one)
            sessions = list.Where(d => d.User.Length > 0).GroupBy(d => (d.User, d.Device, d.Client)).Select(g => g.OrderByDescending(d => d.Playing).ThenByDescending(d => d.LastActivity).First()).OrderByDescending(d => d.Playing && !d.Paused).ThenByDescending(d => d.Playing).ThenByDescending(d => d.LastActivity).ToList();
            error = null; await BuildCards();
        }
        catch (Exception e) { error = "Couldn't read the device list from Jellyfin: " + e.Message; await BuildCards(); }
    }

    sealed class Card
    {
        public string Key = "", Title = "", Sub = "", User = "", Seen = "", Track = "", Artist = "";
        public bool Web, Playing, Paused;
        public string? ArtKey;
        public long PosMs, DurMs;
        public Func<string, Task>? Do;
        public List<(string Head, List<(string K, string V)> Rows)> Info = [];
    }
    List<Card> cards = [];
    string? infoKey;
    readonly Dictionary<string, MediaInfo> mediaCache = new();
    [Inject] InfoService InfoSvc { get; set; } = default!;
    [Inject] ClientRegistry Clients { get; set; } = default!;


    async Task Act(Card c, string what)
    {
        if (c.Do is { } d) { try { await d(what); Log.Add("admin", Session.DisplayName, $"{what} on {c.Title} ({c.User})"); } catch (Exception) { } }
        await Task.Delay(400); await Refresh2(); StateHasChanged();
    }

    static void Add(List<(string K, string V)> rows, string k, string? v) { if (!string.IsNullOrWhiteSpace(v)) rows.Add((k, v!)); }
    static string Rate(long bitsPerSecond) => bitsPerSecond <= 0 ? "" : bitsPerSecond >= 1_000_000 ? (bitsPerSecond / 1_000_000.0).ToString("0.0") + " Mbps" : (bitsPerSecond / 1000) + " kbps";

    async Task BuildCards()
    {
        var list = new List<Card>();
        // browsers: every open FLACie Web page, told apart by browser, system and address
        foreach (var w in Clients.All)
        {
            var t = w.Player.Current;
            var c = new Card
            {
                Key = "w" + w.Id, Web = true, Title = w.Browser + (w.Os.Length > 0 ? " on " + w.Os : ""), Sub = string.Join(" · ", new[] { w.Ip, w.Host }.Where(x => x.Length > 0)), User = w.User,
                Seen = "opened " + Ago(w.Since), Playing = t is not null, Paused = !w.Player.Playing, ArtKey = t?.ArtKey, Track = t?.Title ?? "", Artist = t?.Artist ?? "",
                PosMs = (long)(w.Player.Position * 1000), DurMs = (long)(w.Player.Duration * 1000),
                Do = async k => { switch (k) { case "toggle": await w.Player.ToggleAsync(); break; case "next": await w.Player.NextAsync(); break; case "prev": await w.Player.PrevAsync(); break; default: await w.Player.StopAsync(); break; } },
            };
            if (t is not null)
            {
                var pb = new List<(string, string)>(); Add(pb, "Method", "Direct play"); Add(pb, "What that means", "The original file is sent to the browser as it is, without converting it");
                c.Info.Add(("Playback", pb));
                if (!mediaCache.TryGetValue(t.Path, out var mi)) { try { mi = await InfoSvc.GetAsync(w.Session, t); mediaCache[t.Path] = mi; } catch (Exception) { mi = null!; } }
                if (mi is not null)
                {
                    var f = new List<(string, string)>(); Add(f, "Format", mi.Format + (mi.Tier.Length > 0 ? " · " + mi.Tier : "")); Add(f, "Codec", mi.Codec.ToUpperInvariant()); Add(f, "Bit rate", mi.BitrateKbps > 0 ? mi.BitrateKbps + " kbps" : "");
                    Add(f, "Sampling", mi.Sampling); Add(f, "Channels", mi.ChannelsName); Add(f, "Size", mi.SizeBytes > 0 ? StorageService.Bytes(mi.SizeBytes) : ""); Add(f, "Source", mi.Source); Add(f, "Location", mi.Path);
                    c.Info.Add(("File", f));
                }
            }
            var cl = new List<(string, string)>(); Add(cl, "Browser", w.Browser); Add(cl, "System", w.Os); Add(cl, "Address", w.Ip); Add(cl, "Computer", w.Host); Add(cl, "Screen", w.Screen); Add(cl, "Language", w.Language);
            Add(cl, "Opened", w.Since.ToLocalTime().ToString("HH:mm")); Add(cl, "Browser string", w.Ua); c.Info.Add(("Client", cl));
            list.Add(c);
        }
        // other apps signed in to Jellyfin (the phone app, Jellyfin's own web page, ...); FLACie Web's own session is shown above, per browser
        foreach (var d in sessions.Where(s => s.Device != "FLACie Web"))
        {
            var raw = d.Raw; var item = raw?["NowPlayingItem"] as System.Text.Json.Nodes.JsonObject; var ps = raw?["PlayState"]; var tr = raw?["TranscodingInfo"];
            var c = new Card
            {
                Key = "j" + d.Id, Title = d.Device, Sub = (d.Client + " " + d.Version).Trim(), User = d.User, Seen = Ago(d.LastActivity), Playing = d.Playing, Paused = d.Paused,
                ArtKey = d.ItemId is null ? null : "jf" + d.ItemId, Track = d.Title ?? "", Artist = d.Artist ?? "", PosMs = d.PositionMs, DurMs = d.DurationMs,
                Do = d.Controllable ? (k => Cmd(d, k switch { "prev" => "PreviousTrack", "next" => "NextTrack", "toggle" => "PlayPause", _ => "Stop" })) : null,
            };
            if (d.Playing)
            {
                var method = ps?["PlayMethod"]?.GetValue<string>() ?? "";
                var pb = new List<(string, string)>();
                Add(pb, "Method", method switch { "DirectPlay" => "Direct play", "DirectStream" => "Direct stream", "Transcode" => "Transcoding", "" => "Not reported", var m => m });
                Add(pb, "What that means", method switch { "DirectPlay" => "The original file is played as it is", "DirectStream" => "The audio is untouched but repackaged for this device", "Transcode" => "Jellyfin converts the audio on the fly for this device", _ => "" });
                if (tr is not null)
                {
                    Add(pb, "Converted to", ((tr["AudioCodec"]?.GetValue<string>() ?? "") + " in " + (tr["Container"]?.GetValue<string>() ?? "")).Trim().ToUpperInvariant());
                    Add(pb, "At", Rate(tr["Bitrate"]?.GetValue<long>() ?? 0));
                    Add(pb, "Why", string.Join(", ", (tr["TranscodeReasons"] as System.Text.Json.Nodes.JsonArray)?.Select(x => (x?.GetValue<string>() ?? "")) ?? []));
                }
                c.Info.Add(("Playback", pb));
                var src = (item?["MediaSources"] as System.Text.Json.Nodes.JsonArray)?.FirstOrDefault() as System.Text.Json.Nodes.JsonObject;
                var au = (src?["MediaStreams"] as System.Text.Json.Nodes.JsonArray)?.OfType<System.Text.Json.Nodes.JsonObject>().FirstOrDefault(x => x["Type"]?.GetValue<string>() == "Audio");
                var f = new List<(string, string)>();
                Add(f, "Container", src?["Container"]?.GetValue<string>()?.ToUpperInvariant()); Add(f, "Codec", au?["Codec"]?.GetValue<string>()?.ToUpperInvariant());
                Add(f, "Bit rate", Rate(au?["BitRate"]?.GetValue<long>() ?? src?["Bitrate"]?.GetValue<long>() ?? 0));
                Add(f, "Sampling", au is null ? "" : ((au["BitDepth"]?.GetValue<int>() is > 0 and var bd ? bd + "-bit / " : "") + ((au["SampleRate"]?.GetValue<int>() ?? 0) / 1000.0).ToString("0.#") + " kHz"));
                Add(f, "Channels", au?["Channels"]?.GetValue<int>() is { } ch ? (ch == 1 ? "Mono" : ch == 2 ? "Stereo" : ch + " channels") : "");
                Add(f, "Size", (src?["Size"]?.GetValue<long>() ?? 0) > 0 ? StorageService.Bytes(src!["Size"]!.GetValue<long>()) : ""); Add(f, "Location", src?["Path"]?.GetValue<string>() ?? item?["Path"]?.GetValue<string>());
                if (f.Count > 0) c.Info.Add(("File", f));
            }
            var cl = new List<(string, string)>(); Add(cl, "App", (d.Client + " " + d.Version).Trim()); Add(cl, "Device", d.Device); Add(cl, "Device id", raw?["DeviceId"]?.GetValue<string>());
            Add(cl, "Address", raw?["RemoteEndPoint"]?.GetValue<string>()); Add(cl, "Account", d.User); Add(cl, "Last activity", d.LastActivity.ToLocalTime().ToString("HH:mm:ss")); Add(cl, "Remote control", d.Controllable ? "yes" : "no");
            c.Info.Add(("Client", cl));
            list.Add(c);
        }
        cards = list.OrderByDescending(c => c.Playing && !c.Paused).ThenByDescending(c => c.Playing).ToList();
    }
    StorageGuard? guard;
    StorageGuard? Guard() => guard ??= (StorageGuard?)ServiceProvider.GetService(typeof(StorageGuard));
    [Inject] IServiceProvider ServiceProvider { get; set; } = default!;

    async Task Cmd(Dev d, string cmd)
    {
        try { await Jellyfin.PostAsync(Session.Jellyfin!, $"/Sessions/{d.Id}/Playing/{cmd}", null); Log.Add("admin", Session.DisplayName, $"{cmd} on {d.Device} ({d.User})"); } catch (Exception) { }
        await Task.Delay(500); await Refresh2();
    }

    void SaveNotify() { Notify.Save(cfg, token.Length > 0 ? token : null); token = ""; notifyMsg = "Saved."; }
    async Task TestNotify()
    {
        SaveNotify(); testing = true; StateHasChanged();
        var (ok, msg) = await Notify.SendAsync("FLACie test", "If you can read this, notifications from FLACie work.", 3, "tada");
        notifyMsg = ok ? "Test sent. Check your phone." : "Not sent: " + msg; testing = false;
    }

    static string Ago(DateTime utc)
    {
        var s = (DateTime.UtcNow - utc).TotalSeconds;
        return s < 10 ? "just now" : s < 60 ? (int)s + " s ago" : s < 3600 ? (int)(s / 60) + " min ago" : s < 86400 ? (int)(s / 3600) + " h ago" : (int)(s / 86400) + " d ago";
    }
    static string Pct(long v, long max) => Math.Clamp(v * 100.0 / Math.Max(1, max), 0, 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    static string FeedIcon(string kind) => kind switch { "play" => "play", "signin" => "artists", "import" => "download", "charts" => "chart", "server" => "settings", "alert" => "info", "admin" => "shield", _ => "note" };

