@page "/charts"
@attribute [Authorize]
@inherits UserComponent
<PageTitle>Explore · FLACie</PageTitle>
<header class="page-head"><h1><i>Explore</i></h1></header>
<MusicTabs Active="Charts" />
<div class="mood-chips" role="tablist" aria-label="Charts">
    @foreach (var c in ChartsService.Available)
    {
        var id = c.Id;
        <button role="tab" class="mood @(id == current ? "on" : "")" aria-selected="@((id == current) ? "true" : "false")" @onclick="() => Pick(id)">@c.Name</button>
    }
</div>
@if (loading) { <Skeleton Label="Loading the chart…" /> }
else if (songs.Count == 0) { <div class="empty-state"><p class="status">The chart couldn't be loaded right now.<small>The charts come from the internet; it may be a moment's hiccup.</small></p><button class="btn" @onclick="() => Pick(current)">Try again</button></div> }
else
{
    @* a list of what's popular: the daily download and the Download buttons only appear where the server downloads at all *@
    <p class="hint">@owned of @songs.Count are in your library.@(!Downloads.Allowed ? "" : State.Charts.Enabled ? " New ones are added to your library every day." : " Daily downloads are off (Server admin > Background downloads).")</p>
    <ol class="chart-list">
        @for (var i = 0; i < songs.Count; i++)
        {
            var s = songs[i]; var have = Lib.Find(s.Title, s.Artist) ?? Lib.FindLoose(s.Title, s.Artist); var jb = Downloads.JobFor(Session, s.Artist, s.Title);
            <li class="chart-row">
                <span class="rank">@(i + 1)</span>
                <Cover ArtKey="@(s.ArtUrl is null ? null : Art.ExternalKey(s.ArtUrl))" Size="48" />
                <span class="chart-text"><b>@s.Title</b><small>@s.Artist</small>@if (jb is not null && have is null) { <span class="track-dl @(jb.Stage == DownloadStage.Failed ? "bad" : jb.Stage == DownloadStage.Done ? "ok" : "")"><i aria-hidden="true"></i>@jb.Message@(jb.Current is { } c && !jb.Finished ? " · " + OpenSourceSettings.Name(c) : jb.Source is { } src ? " · from " + OpenSourceSettings.Name(src) : "")</span> }
                    else if (have is not null) { <DownloadTag Session="Session" Artist="@have.Artist" Title="@have.Title" Track="have" /> }</span>
                @if (have is not null) { <button class="btn" @onclick="() => Player.Play([have], 0, current_name)"><Icon Name="play" Size="16" />Play</button> }
                else if (Downloads.Allowed) { <button class="btn" disabled="@(!Session.Services.Any || jb is { Finished: false })" @onclick="() => Downloads.Song(Session, s)"><Icon Name="download" Size="16" />@(jb is { Finished: false } ? "Downloading…" : jb is { Stage: DownloadStage.Failed } ? "Try again" : "Download")</button> }
            </li>
        }
    </ol>
}
@code {
    [Inject] ChartsService ChartSvc { get; set; } = default!;
    [Inject] UserStateStore States { get; set; } = default!;
    [Inject] DownloadManager Downloads { get; set; } = default!;
    UserState State => States.For(Session);
    int current; bool loading = true; List<CatalogSong> songs = [];
    string current_name => ChartsService.Available.FirstOrDefault(c => c.Id == current).Name ?? "Chart";
    int owned => songs.Count(s => Lib.Find(s.Title, s.Artist) is not null || Lib.FindLoose(s.Title, s.Artist) is not null);

    Action? onJobs;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); onJobs = () => InvokeAsync(StateHasChanged); Downloads.Subscribe(Session, onJobs); await Pick(0); }
    public override void Dispose() { if (onJobs is not null) Downloads.Unsubscribe(Session, onJobs); base.Dispose(); }
    async Task Pick(int id) { current = id; loading = true; StateHasChanged(); songs = await ChartSvc.ChartAsync(id); loading = false; }
}
