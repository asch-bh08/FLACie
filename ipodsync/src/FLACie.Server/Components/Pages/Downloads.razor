@page "/downloads"
@attribute [Authorize]
@implements IDisposable
@inherits UserComponent
@inject DownloadManager Manager
@inject DownloadLog Log
@inject IConfiguration Conf
@inject IJSRuntime Js
<PageTitle>Downloads · FLACie</PageTitle>
@{ Rebuild(); }
<header class="page-head"><h1>Downloads</h1></header>
<p class="hint dl-intro">Everything the server fetched for @(everyone ? "everyone" : "you"), newest first, kept across restarts. Each download tries Soulseek first, then the free sources and YouTube (if switched on in Settings), then Lidarr; open one to see what each source said.</p>
<nav class="subnav" aria-label="Download sections">
    <a href="/downloads#running">Running <b>@running.Count</b></a><a href="/downloads#failed">Failed <b>@failed.Count</b></a><a href="/downloads#soulseek">Soulseek <b>@soulseek.Count</b></a><a href="/downloads#lidarr">Lidarr <b>@lidarr.Count</b></a><a href="/downloads#open">YouTube and open sources <b>@open.Count</b></a>
</nav>
<div class="dl-tools">
    <input type="search" class="dl-filter" placeholder="Filter by song, artist or user" aria-label="Filter downloads" @bind="filter" @bind:event="oninput" />
    @if (admin) { <label class="dl-every"><input type="checkbox" checked="@everyone" @onchange="e => everyone = (bool)(e.Value ?? false)" /> Everyone's downloads</label> }
</div>

<section class="panel wide dl-sec" id="running">
    <h2>Running now <small>@running.Count</small></h2>
    @if (running.Count == 0) { <p class="hint">Nothing is downloading.</p> }
    @foreach (var j in running)
    {
        <div class="dl-row running">
            <Cover ArtKey="@(j.ArtKey)" Size="44" />
            <div class="dl-main">
                <b>@j.Label</b>
                <small>@j.Message</small>
                <small class="dl-meta">@(j.Current is { } c ? "Working on " + OpenSourceSettings.Name(c) + " · " : "")@KindText(j.Kind) · started <time data-utc="@Iso(j.At)">@Ago(j.At)</time> · @Took(DateTime.UtcNow - j.At) so far</small>
            </div>
            @if (j.Current is { } cur) { <span class="badge dl-src @cur">@OpenSourceSettings.Name(cur)</span> }
        </div>
    }
</section>

@Section("failed", "Failed", failed, "Nothing failed.", true)
@Section("soulseek", "Soulseek", soulseek, "Nothing came from Soulseek yet.", false)
@Section("lidarr", "Lidarr", lidarr, "Nothing came from Lidarr yet.", false)
@Section("open", "YouTube and open sources", open, "Nothing came from YouTube, the Internet Archive, Audius or Jamendo yet.", false)

@code {
    string filter = "";
    bool everyone, admin;
    Action? onJobs; Timer? tick;
    readonly Dictionary<string, int> shown = [];
    const int Page = 15;

    List<DownloadJob> running = [];
    List<DownloadRecord> failed = [], soulseek = [], lidarr = [], open = [];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        admin = AdminAccess.Is(Session, Conf);
        onJobs = () => InvokeAsync(StateHasChanged);
        Manager.Subscribe(Session, onJobs);
        // running jobs show how long they have been going: redraw every few seconds while any is
        tick = new Timer(_ => { if (running.Count > 0) InvokeAsync(StateHasChanged); }, null, 3000, 3000);
    }


    protected override void OnAfterRender(bool firstRender) { _ = Js.InvokeVoidAsync("flacie.times"); }

    bool Matches(string? a, string? b = null, string? c = null) => filter.Trim().Length == 0 || new[] { a, b, c }.Any(x => x?.Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase) == true);

    void Rebuild()
    {
        running = Manager.JobsOf(Session).Where(j => !j.Finished && Matches(j.Label)).ToList();
        var all = (everyone && admin ? Log.Everyone() : Log.For(Session.Id)).Where(r => Matches(r.Label, r.UserName, r.Message)).ToList();
        failed = all.Where(r => !r.Done).ToList();
        soulseek = all.Where(r => r.Done && r.Source == "soulseek").ToList();
        lidarr = all.Where(r => r.Done && r.Source == "lidarr").ToList();
        open = all.Where(r => r.Done && r.Source is "ytdl" or "archive" or "audius" or "jamendo").ToList();
    }

    RenderFragment Section(string id, string title, List<DownloadRecord> rows, string empty, bool bad) => @<section class="panel wide dl-sec" id="@id">
        <h2>@title <small>@rows.Count</small>@if (bad && rows.Any(DownloadManager.CanRetry)) { <button class="btn ghost dl-retry-all" @onclick="RetryAll">Retry all</button> }</h2>
        @if (retryNote is { Length: > 0 } && bad) { <p class="hint" role="status">@retryNote</p> }
        @if (rows.Count == 0) { <p class="hint">@empty</p> }
        @foreach (var r in rows.Take(shown.GetValueOrDefault(id, Page)))
        {
            <details class="dl-row @(bad ? "bad" : "")">
                <summary>
                    <Cover ArtKey="@(r.ArtKey)" Size="44" />
                    <div class="dl-main">
                        <b>@r.Label</b>
                        <small class="@(bad ? "dl-why" : "")">@r.Message</small>
                        <small class="dl-meta">@KindText(r.Kind) · <time data-utc="@Iso(r.FinishedAt)" data-abs="1" data-rel="@Ago(r.FinishedAt)">@Ago(r.FinishedAt)</time> · took @Took(r.Took)@(everyone ? " · " + r.UserName : "")</small>
                    </div>
                    @if (r.Source is { } s) { <span class="badge dl-src @s">@OpenSourceSettings.Name(s)</span> }
                    else
                    {
                        <span class="badge dl-src failed">Failed</span>
                        @if (DownloadManager.CanRetry(r) && !everyone)
                        {
                            var again = Manager.JobFor(Session, r.Artist, r.Title) is { Finished: false };
                            <button class="btn ghost dl-retry" disabled="@again" @onclick="() => Retry(r)" @onclick:preventDefault @onclick:stopPropagation>@(again ? "Retrying…" : "Retry")</button>
                        }
                    }
                </summary>
                <ol class="dl-trail">
                    @foreach (var st in r.Trail)
                    {
                        <li class="@(st.Miss ? "miss" : "")"><time data-utc="@Iso(st.At)" data-abs="time">@st.At.ToString("HH:mm:ss")</time> @(st.Source is { } ss && !st.Text.StartsWith(OpenSourceSettings.Name(ss), StringComparison.OrdinalIgnoreCase) ? OpenSourceSettings.Name(ss) + ": " : "")@st.Text</li>
                    }
                </ol>
                @if (r.File is { Length: > 0 }) { <p class="dl-file">Saved as <code>@r.File</code></p> }
                else if (r.Done) { <p class="dl-file">Filed by Lidarr into your library; it shows up after the next Jellyfin scan.</p> }
            </details>
        }
        @if (rows.Count > shown.GetValueOrDefault(id, Page)) { <button class="btn ghost" @onclick="() => shown[id] = shown.GetValueOrDefault(id, Page) + 25">Show more (@(rows.Count - shown.GetValueOrDefault(id, Page)) older)</button> }
    </section>;

    string? retryNote;
    void Retry(DownloadRecord r) { retryNote = Manager.Retry(Session, r) ? $"Trying \"{r.Title}\" again." : null; }
    void RetryAll()
    {
        var n = Manager.RetryAll(Session, Log.For(Session.Id));
        retryNote = n == 0 ? "Nothing to retry." : $"Trying {n} song{(n == 1 ? "" : "s")} again. They show under Running now.";
    }

    static string KindText(string kind) => kind switch { "Search" => "You asked for it", "Autoplay" => "Fetched ahead for Autoplay", "Playlist" => "From a playlist", "Import" => "From an import", "Chart" => "Daily charts", _ => kind };
    static string Iso(DateTime utc) => DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToString("o");
    static string Took(TimeSpan t) => t.TotalSeconds < 1 ? "under a second" : t.TotalSeconds < 90 ? $"{(int)t.TotalSeconds} s" : t.TotalMinutes < 90 ? $"{(int)t.TotalMinutes} min" : $"{(int)t.TotalHours} h";
    static string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        return d.TotalSeconds < 60 ? "just now" : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes} min ago" : d.TotalHours < 24 ? $"{(int)d.TotalHours} h ago" : d.TotalDays < 2 ? "yesterday" : $"{(int)d.TotalDays} days ago";
    }

    public override void Dispose() { if (onJobs is not null) Manager.Unsubscribe(Session, onJobs); tick?.Dispose(); base.Dispose(); }
}
