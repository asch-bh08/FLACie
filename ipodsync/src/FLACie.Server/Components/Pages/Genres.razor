@page "/genres"
@attribute [Authorize]
@inherits UserComponent
@inject ExploreState X
<PageTitle>Explore · FLACie</PageTitle>
<header class="page-head"><h1>Explore</h1><p class="sub">@list.Count genres</p></header>
<MusicTabs Active="Genres" />
<ExploreBar Tab="Genres" Changed="Refresh" />
<LibraryStatus />
@if (list.Count == 0 && Lib.Songs.Count > 0) { <p class="status">@(X.Filtering ? "Nothing matches these filters." : "None of your songs have a genre tag yet.")</p> }
<div class="grid">
    @foreach (var g in list)
    {
        <a class="card" href="/genre/@Uri.EscapeDataString(g.Name)"><Cover ArtKey="@(g.ArtKey)" Class="square" /><span class="card-title">@g.Name</span><span class="card-sub">@g.Tracks.Count songs</span></a>
    }
</div>
@code {
    List<Group> list = [];
    Library? built; int builtVersion = -1;
    void Build() { if (ReferenceEquals(built, Lib) && builtVersion == X.Version) return; built = Lib; builtVersion = X.Version; list = X.Genres(Lib); }
    void Refresh() { Build(); StateHasChanged(); }
    protected override void OnParametersSet() => Build();
    protected override bool ShouldRender() { Build(); return true; }
}
