@page "/import"
@attribute [Authorize]
@implements IDisposable
@inherits UserComponent
@inject PlaylistLinkReader Links
<PageTitle>Import playlists · FLACie</PageTitle>
@* F25.2 (owner, 5 Nov: "this page is ugly"): the new look. One paste box first (the service's mark shows as the link is recognised), a smaller file
   drop second, Replace as a real switch, readable text that wraps at every width, and past imports listed compactly with the old ones folded away. *@
<div class="sp imp">
<header class="page-head"><h1>Import <i>playlists</i></h1></header>

@* only for those the server lets fetch whole lists (DownloadPolicy.MayBulk); the page is not linked for anyone else, and ImportManager refuses them too *@
@if (!Policy.MayBulk(Session))
{
    <section class="imp-card"><p>Importing playlists isn't turned on for your account on this server. Ask the person who runs it.</p></section>
}
else
{
    <section class="imp-card" aria-label="Paste a link">
        <h2 class="imp-title">Paste a playlist link</h2>
        <p class="imp-text">From Spotify, Apple Music, YouTube, SoundCloud or Deezer: any playlist or album anyone can open (Share, then Copy link). Songs you have are added at once; the rest are found and downloaded on this server in the background.</p>
        <form class="imp-link" @onsubmit="FromLink" @onsubmit:preventDefault>
            @{ var seen = PlaylistLinks.Recognise(link); }
            <span class="imp-mark @(seen is null ? "" : "on " + Key(seen.Service))" data-testid="import-service" aria-live="polite">@(seen is null ? "" : Name(seen.Service))</span>
            <input type="url" aria-label="Playlist link" placeholder="Paste a playlist link" @bind="link" @bind:event="oninput" />
            <button class="btn primary" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(link))">@(busy ? "Reading…" : "Import")</button>
        </form>
        @if (error is not null) { <p class="form-error" role="alert">@error</p> }
        <label class="switch-row imp-switch">
            <span><b>Replace playlists with the same name</b><small>An existing playlist of that name (a tag like "(FLAC)" is ignored) is made to hold exactly the imported songs</small></span>
            <input type="checkbox" role="switch" data-testid="import-replace" checked="@replace" @onchange="e => replace = (bool)(e.Value ?? false)" /><i class="switch" aria-hidden="true"></i>
        </label>
        <div class="imp-drop">
            <InputFile OnChange="Upload" accept=".xml,.m3u,.m3u8,.csv,.txt,.text" aria-label="Choose a playlist file" />
            <span><b>Or drop a file</b> · iTunes Library.xml, M3U, a Spotify CSV, or text with one "Artist - Title" a line (## starts a playlist)</span>
            @if (busy) { <span class="hint">Reading…</span> }
        </div>
        @if (!Session.Services.Any) { <p class="imp-text">Downloads aren't set up yet, so only songs you already have are added. Set them up in the <a href="/dashboard#downloads">Server admin</a>.</p> }
    </section>
}

@{ var recent = Jobs.Where(j => !Old(j)).ToList(); var old = Jobs.Where(Old).ToList(); }
@if (Jobs.Count == 0) { <p class="imp-text">Nothing imported yet.</p> }
@if (recent.Count > 0)
{
    <section class="imp-card" aria-label="Imports">
        <h2 class="imp-title">Imports</h2>
        <ul class="imp-jobs">@foreach (var job in recent) { @Row(job) }</ul>
    </section>
}
@if (old.Count > 0)
{
    <details class="imp-card imp-old" data-testid="import-older">
        <summary>Older <span class="hint">(@old.Count)</span></summary>
        <ul class="imp-jobs">@foreach (var job in old) { @Row(job) }</ul>
    </details>
}
</div>

@code {
    [Inject] ImportManager Imports { get; set; } = default!;
    [Inject] DownloadPolicy Policy { get; set; } = default!;
    [Inject] UserStateStore States { get; set; } = default!;
    bool busy, replace; string? error;
    Action<UserSession>? onChange; Timer? tick;
    List<ImportJob> Jobs => States.For(Session).Imports.OrderByDescending(j => j.Created).ToList();

    /// <summary>Finished more than a week ago: folded under Older.</summary>
    static bool Old(ImportJob j) => j.IsOld(DateTime.UtcNow);

    static string Key(PlaylistLinks.Service s) => s.ToString().ToLowerInvariant();
    static string Name(PlaylistLinks.Service s) => s switch { PlaylistLinks.Service.Apple => "Apple Music", PlaylistLinks.Service.YouTube => "YouTube", _ => s.ToString() };
    static string SourceName(string? s) => s switch { "spotify" => "Spotify", "deezer" => "Deezer", "apple" => "Apple Music", "youtube" => "YouTube", "soundcloud" => "SoundCloud", _ => "File" };

    RenderFragment Row(ImportJob job) => @<li class="imp-job" data-testid="import-job">
        <span class="imp-mark on @(job.Source ?? "file")" title="@SourceName(job.Source)">@SourceName(job.Source)</span>
        <span class="imp-job-text">
            <b>@job.File</b>
            <small>@job.Added of @job.Total added · @job.Created.ToLocalTime().ToString("d MMM") · @StateText(job)</small>
            @if (job.State == "running") { <span class="bar-meter" role="progressbar" aria-valuemin="0" aria-valuemax="@job.Total" aria-valuenow="@job.Finished"><i style="width:@(job.Total == 0 ? 0 : job.Finished * 100 / job.Total)%"></i></span> }
        </span>
        <span class="imp-job-actions">
            @foreach (var l in job.Lists.Where(l => l.PlaylistId is not null).Take(1)) { <a class="btn ghost" href="/playlist/@l.PlaylistId">Open</a> }
            @if (job.State is "running" or "waiting") { <button class="btn ghost" @onclick="() => Imports.Cancel(Session, job.Id)">Stop</button> }
            @if (job.Failed > 0 && job.State != "running") { <button class="btn ghost" @onclick="() => Imports.Retry(Session, job.Id)">Retry @job.Failed</button> }
        </span>
    </li>;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        onChange = s => { if (ReferenceEquals(s, Session)) InvokeAsync(StateHasChanged); };
        Imports.Changed += onChange;
        tick = new Timer(_ => InvokeAsync(StateHasChanged), null, 2000, 2000);
    }

    string link = "";
    async Task FromLink()
    {
        busy = true; error = null;
        try
        {
            await Imports.StartLinkAsync(Session, Links, link, replace);
            link = "";
        }
        catch (InvalidDataException ex) { error = ex.Message; }
        catch (ImportNotAllowedException ex) { error = ex.Message; }
        catch (Exception ex) { error = FriendlyError.Of(ex); }
        finally { busy = false; }
    }

    async Task Upload(InputFileChangeEventArgs e)
    {
        busy = true; error = null;
        try
        {
            var f = e.File;
            using var ms = new MemoryStream();
            await using (var s = f.OpenReadStream(20 * 1024 * 1024)) await s.CopyToAsync(ms);
            Imports.Start(Session, f.Name, ms.ToArray(), replace);
        }
        catch (InvalidDataException ex) { error = ex.Message; }
        catch (ImportNotAllowedException ex) { error = ex.Message; }
        catch (IOException) { error = "That file is too big (limit 20 MB)."; }
        catch (Exception ex) { error = FriendlyError.Of(ex); }
        finally { busy = false; }
    }

    static string StateText(ImportJob j) => j.State switch
    {
        "running" => j.Failed > 0 ? $"working, {j.Failed} not found" : "working",
        "waiting" => "waiting for free space",
        "done" => j.Failed > 0 ? $"{j.Failed} not found" : "finished",
        _ => j.State,
    };

    public override void Dispose() { if (onChange is not null) Imports.Changed -= onChange; tick?.Dispose(); base.Dispose(); }
}
