@page "/ipod"
@attribute [Authorize]
@layout EmptyLayout
@implements IAsyncDisposable
@inherits UserComponent
@inject IJSRuntime Js
<PageTitle>iPod · FLACie</PageTitle>
@* The iPod mode: every iPod of the Android emulator (23 models, their colours, the mono / colour / nano screens, Cover Flow, the settings), on the page and in the Windows app.
   Wheel by drag, tap, hold and flick; mouse wheel; keys: arrows, Enter, Esc, Space. Touch models show the FLACie player in their screen. *@
<div class="ipod-stage @(flat ? "flat" : "") @(color.Dark ? "dark" : "") @(panel ? "dock-open" : "")" data-testid="ipod" data-model="@model.Id" data-color="@color.Name" data-look="@(desk ? "desk" : flat ? "wheel" : "device")" data-scene="@IpodPrefs.SceneKeys[prefs.Scene]" style="@StageStyle">
    @if (retro) { <RetroScene Kind="@prefs.Scene" /> }
    else if (desk)
    {
        <DeskScene Jack="@DeskJacks.For(model.Id)" Aspect="@model.Aspect" Radius="@model.Radius" Journal="@DeskJournalPart" Cds="@DeskCdsPart" Polaroid="@DeskPolaroidPart"
                   Options="@prefs.Desk" Props="@DeskPropsPart" MeterReadout="@DeskRateLine" MeterRate="@DeskRate" Finish="@DeskFinishes.For(model, color)">@Area()</DeskScene>
    }
    else { @Area() }
    <a class="ipod-exit" href="/" aria-label="Back to FLACie" title="Back to FLACie" data-testid="ipod-exit"><Icon Name="chevron-left" Size="18" /></a>
    <button class="ipod-gear" type="button" tabindex="-1" aria-label="@(panel ? "Hide the panel" : "Show the panel")" title="Panel: pick an iPod, colour and look" data-testid="ipod-gear" @onclick="TogglePanel"><Icon Name="settings" Size="18" /></button>
    <aside class="ipod-dock ipod-panel @(panel ? "open" : "")" data-testid="ipod-panel" aria-label="iPod panel">
        <h2>iPod</h2>
        <section class="dock-np" data-testid="ipod-dock-np">
            @if (Player.Current is { } cur)
            {
                <div class="dock-cover"><Cover ArtKey="@cur.ArtKey" Full="true" Class="dock-art" /></div>
                <div class="dock-meta"><b>@cur.Title</b><span>@cur.Artist</span><small>@cur.Album</small></div>
                <div class="dock-bar"><i style="width:@Pct()%"></i></div>
                <div class="dock-times"><span>@Fmt(Player.Position)</span><span>-@Fmt(Math.Max(0, Player.Duration - Player.Position))</span></div>
                <div class="dock-ctl">
                    <button type="button" aria-label="Previous" @onclick="() => Player.Prev()" tabindex="-1"><Icon Name="prev" Size="18" /></button>
                    <button type="button" class="big" aria-label="@(Player.Playing ? "Pause" : "Play")" @onclick="() => Player.Toggle()" tabindex="-1"><Icon Name="@(Player.Playing ? "pause" : "play")" Size="22" /></button>
                    <button type="button" aria-label="Next" @onclick="() => Player.Next()" tabindex="-1"><Icon Name="next" Size="18" /></button>
                </div>
            }
            else { <p class="dock-empty">Nothing is playing. Pick a song on the iPod: Music &rsaquo; Songs, or Shuffle Songs.</p> }
        </section>
        <section data-testid="scene-options">
            <h3>Scene</h3>
            <div class="scene-chips">
                @for (var i = 0; i < IpodPrefs.SceneNames.Length; i++)
                {
                    var k = i;
                    <button type="button" class="ipod-chip @(prefs.Scene == k ? "on" : "")" data-scene="@IpodPrefs.SceneKeys[k]" aria-pressed="@(prefs.Scene == k ? "true" : "false")" tabindex="-1" @onclick="() => PickScene(k)">@IpodPrefs.SceneNames[k]</button>
                }
            </div>
        </section>
        @if (!retro)
        {
        <section>
            <h3>Model</h3>
            <div class="dock-seg" role="tablist">
                @foreach (var g in IpodModels.Groups)
                {
                    var gg = g;
                    <button type="button" class="@(gg == pickGroup ? "on" : "")" data-group="@gg" tabindex="-1" @onclick="() => pickGroup = gg">@GroupShort(gg)</button>
                }
            </div>
            <div class="dock-models">
                @foreach (var m in IpodModels.InGroup(pickGroup))
                {
                    <button type="button" class="ipod-chip @(m.Id == model.Id ? "on" : "")" data-model="@m.Id" tabindex="-1" @onclick="() => PickModel(m.Id)" title="@m.Blurb"><span>@m.Name</span><small>@m.Year</small></button>
                }
            </div>
        </section>
        <section>
            <h3>Colour <small>@color.Name</small></h3>
            <div class="ipod-chips">
                @for (var i = 0; i < model.Colors.Count; i++)
                {
                    var ci = i;
                    <button type="button" class="ipod-chip swatch @(ci == prefs.Color ? "on" : "")" data-color="@model.Colors[ci].Name" tabindex="-1" @onclick="() => PickColor(ci)" title="@model.Colors[ci].Name" aria-label="@model.Colors[ci].Name" style="--sw1:@model.Colors[ci].Top;--sw2:@model.Colors[ci].Bottom"></button>
                }
            </div>
        </section>
        <section>
            <h3>Look</h3>
            <div class="dock-seg">
                <button type="button" class="ipod-chip @(!flat && !desk ? "on" : "")" data-look="device" tabindex="-1" @onclick="() => PickLook(IpodPrefs.LookDevice)">Device</button>
                @if (!model.Touch) { <button type="button" class="ipod-chip @(flat ? "on" : "")" data-look="wheel" tabindex="-1" @onclick="() => PickLook(IpodPrefs.LookWheelOnly)">Wheel only</button> }
                <button type="button" class="ipod-chip @(desk ? "on" : "")" data-look="desk" tabindex="-1" @onclick="() => PickLook(IpodPrefs.LookDesk)">Desk</button>
            </div>
        </section>
        @if (desk)
        {
            <section data-testid="desk-options">
                <h3>Desk</h3>
                <div class="dock-seg">
                    @for (var i = 0; i < DeskOptions.PhonesNames.Length; i++)
                    {
                        var k = i;
                        <button type="button" class="ipod-chip @(prefs.Desk.Phones == k ? "on" : "")" data-desk-phones="@k" tabindex="-1" @onclick="() => DeskSet(d => d.Phones = k)">@DeskOptions.PhonesNames[k]</button>
                    }
                </div>
                <div class="desk-opts">
                    @DeskOpt("vu", "Preamp", prefs.Desk.Vu, d => d.Vu = !d.Vu)
                    @DeskOpt("ticket", "Ticket", prefs.Desk.Ticket, d => d.Ticket = !d.Ticket)
                    @DeskOpt("usb", "USB & clip", prefs.Desk.Usb, d => d.Usb = !d.Usb)
                    @DeskOpt("pencil", "Pencil", prefs.Desk.Pencil, d => d.Pencil = !d.Pencil)
                </div>
            </section>
        }
        }
        @if (retro)
        {
        <section class="dock-help" data-testid="scene-help">
            <h3>How to use</h3>
            <ul>
                @foreach (var line in SceneHelp[prefs.Scene]) { <li>@((MarkupString)line)</li> }
                <li>Click a <b>disc, record or tape</b> lying about to play it. The music never stops when you switch scenes.</li>
            </ul>
        </section>
        }
        else
        {
        <section class="dock-help">
            <h3>How to use</h3>
            <ul>
                <li><b>Scroll</b> with the mouse wheel, the up/down keys, or by dragging round the ring.</li>
                <li><b>Select</b>: click the middle, or Enter. <b>Back</b>: MENU, or Esc.</li>
                <li><b>Next / previous</b>: the sides of the ring or the left/right keys; hold to seek.</li>
                <li><b>Play / pause</b>: the bottom of the ring, or Space.</li>
                <li>Everything is also in <b>Settings</b> on the iPod itself.</li>
            </ul>
            <p class="ipod-blurb">@model.Name · @model.Year. @model.Blurb</p>
        </section>
        }
    </aside>
</div>

@code {
    // the help for each retro scene (index = IpodPrefs.Scene; the iPod's own help is the list above)
    static readonly string[][] SceneHelp =
    [
        [],
        ["<b>Play / pause</b>, <b>next</b> and <b>previous</b>: the head unit's keys.", "<b>Volume</b>: turn the knob (scroll or the arrow keys); press it to mute.", "<b>Presets 1–6</b>: stations made from your biggest genres (each shuffles its genre), then the albums coming up.", "<b>Eject</b> slides the CD out; click the slot to play on."],
        ["<b>Play / pause</b>: START · STOP on the turntable, or PHONO on the receiver.", "<b>Next / previous</b>: ◀◀ and ▶▶ on the receiver. Turn the <b>tuning knob</b> (scroll) to seek.", "Click the <b>record</b> to drop the needle: nearer the middle goes further in.", "<b>Pitch</b>: the slider changes the speed. <b>Crate</b>: flip through and click the front sleeve."],
        ["<b>REW / FF</b>: previous and next. <b>▶ ❚❚</b>: play or pause.", "<b>Stop / eject</b> drops the door open; play shuts it.", "<b>Deck B</b> holds what comes next: click the tape to play it.", "The <b>EQ sliders</b> are the music's own EQ (100 Hz to 8 kHz): drag one, scroll it or use the arrow keys. <b>VOL</b> is the volume."],
        ["<b>Jog dial</b>: turn it (scroll or the arrow keys) to skip; press the middle to play or pause.", "<b>Eject</b> pops the disc up; click it to put it back.", "The <b>MiniDiscs</b> on the desk are the albums coming up and your playlists."],
        ["<b>▶❚❚</b> plays or pauses, <b>■</b> stops (back to the song's start), <b>⏮ ⏭</b> skip.", "<b>OPEN</b> lifts the lid: the disc, printed with the album's cover, spins inside while it plays.", "<b>MEGA BASS</b> lifts the bass of the music itself (its light is on while it does).", "The <b>CDs</b> beside it are the albums coming up."],
    ];

    // ---------------------------------------------------------------- the iPod itself (on the stage, or lying on the desk)

    RenderFragment Area() => @<text>
    <div class="ipod-area" @ref="stage" tabindex="0" @onkeydown="Key" @onwheel="OnMouseWheel" @onwheel:preventDefault="@(!model.Touch)" @onclick="FocusStage" data-testid="ipod-keys" aria-label="iPod: arrow keys scroll, Enter selects, Escape goes back">
      <div class="ipod-fit" @ref="fitEl">
        <div class="ipod fam-@FamClass @(model.Touch ? "touch m-" + model.Id : "click ctl-" + ControlsKey) @(model.Touch && color.LightFace ? "light-face" : "") @(model.Buttons ? "btns" : "")" @ref="device" data-testid="ipod-device" data-controls="@(model.Touch ? null : ControlsKey)" data-w="@F(Bw)" data-h="@F(Bh)" style="@DeviceStyle">
        @if (model.Touch)
        {
            <div class="ipod-face" style="@FaceStyle"></div>
            <div class="ipod-glass" style="@ScreenStyle" data-testid="ipod-touch-screen"><div class="ios-scale" style="@TouchScaleStyle"><IpodTouchOs @ref="touchOs" Prefs="prefs" W="TouchW" H="TouchH" Compact="@(TouchW < 300)" Clock="@clock" Battery="@battery" Model="@model.Id" Tint="@color.Bottom" /></div></div>
            @if (model.Home) { <div class="ipod-home" style="@HomeStyle" role="button" aria-label="Home" title="Home (Esc)" data-testid="ipod-home-button" @onclick="TouchHome"><i></i></div> }
        }
        else
        {
            <div class="ipod-bezel" style="@BezelStyle"></div>
            <div class="ipod-lcd fam-@FamClass @LcdTheme @(narrow ? "narrow" : "") @(tall ? "tall" : "")" style="@ScreenStyle" data-testid="ipod-lcd">
                <div class="lcd-in" style="@LcdInStyle">
                    @if (tool != "") { @ToolScreen() }
                    else if (showNow && Player.Current is { } t) { @NowPlaying(t) }
                    else if (nav.Kind == IpodKind.CoverFlow) { @CoverFlow() }
                    else { @ListScreen() }
                </div>
            </div>
            @if (model.KeyRow)
            {
                @* the 3rd generation's four touch buttons, lit red-orange, in a row between the screen and the wheel (flacie.js presses them by their data-zone, as the ring's zones) *@
                <div class="ipod-keyrow" data-testid="ipod-keyrow" style="@KeyRowStyle">
                    <div class="ipod-key" style="left:21%" data-zone="prev" data-testid="ipod-prev" aria-label="Previous song" title="Previous (left arrow); hold to rewind"><Icon Name="prev" Size="15" /></div>
                    <div class="ipod-key" style="left:40.33%" data-zone="menu" data-testid="ipod-menu" aria-label="Menu" title="Menu (Esc); hold to go home"><span>MENU</span></div>
                    <div class="ipod-key" style="left:59.67%" data-zone="play" data-testid="ipod-play" aria-label="Play or pause" title="Play / pause (Space)"><Icon Name="play" Size="12" /><Icon Name="pause" Size="12" /></div>
                    <div class="ipod-key" style="left:79%" data-zone="next" data-testid="ipod-next" aria-label="Next song" title="Next (right arrow); hold to fast-forward"><Icon Name="next" Size="15" /></div>
                </div>
            }
            <div class="ipod-wheel" @ref="wheel" data-testid="ipod-wheel" style="@WheelStyle" title="@(model.KeyRow ? "Drag around the wheel to scroll; press the middle to select. The buttons above it are MENU, previous, next and play/pause." : "Drag around the scroll wheel to scroll. Tap MENU, the arrows, play/pause or the middle. Hold the arrows to seek, hold MENU to go home.")">
                @* (the 3rd generation's wheel has nothing printed on it: only the middle button) *@
                @if (model.Buttons)
                {
                    @* the 1st and 2nd generations: four buttons on a ring (MENU top, previous left, next right, play/pause bottom) round the scroll wheel *@
                    <div class="wscroll"></div>
                    <span class="wl wl-menu" data-testid="ipod-menu" aria-label="Menu" title="Menu (Esc)">MENU</span>
                    <span class="wl wl-next" data-testid="ipod-next" aria-label="Next song" title="Next (right arrow)"><Icon Name="next" Size="11" /></span>
                    <span class="wl wl-prev" data-testid="ipod-prev" aria-label="Previous song" title="Previous (left arrow)"><Icon Name="prev" Size="11" /></span>
                    <span class="wl wl-play" data-testid="ipod-play" aria-label="Play or pause" title="Play / pause (Space)"><Icon Name="play" Size="9" /><Icon Name="pause" Size="9" /></span>
                }
                else if (!model.KeyRow)
                {
                    <span class="wl wl-menu" data-testid="ipod-menu" aria-label="Menu" title="Menu (Esc)">MENU</span>
                    <span class="wl wl-next" data-testid="ipod-next" aria-label="Next song" title="Next (right arrow)"><Icon Name="next" Size="16" /></span>
                    <span class="wl wl-prev" data-testid="ipod-prev" aria-label="Previous song" title="Previous (left arrow)"><Icon Name="prev" Size="16" /></span>
                    <span class="wl wl-play" data-testid="ipod-play" aria-label="Play or pause" title="Play / pause (Space)"><Icon Name="play" Size="12" /><Icon Name="pause" Size="12" /></span>
                }
                <div class="ipod-center" data-testid="ipod-center" aria-label="Select" title="Select (Enter)"></div>
            </div>
        }
        </div>
      </div>
    </div>
    </text>;

    // ---------------------------------------------------------------- screens (RenderFragments)

    RenderFragment Header(string title, string? right = null) => @<div class="lcd-hdr" data-testid="ipod-header">
        <span class="lcd-play">@if (Player.Current is not null) { @(Player.Playing ? "▶" : "❚❚") }</span>
        <b class="lcd-fade" @key="title" data-testid="ipod-title">@title</b>
        <span class="lcd-right">@if (right is not null) { <span class="lcd-clock" data-testid="ipod-count">@right</span> }@if (prefs.Clock && clock.Length > 0) { <span class="lcd-clock">@clock</span> }<span class="lcd-batt @(charging ? "chg" : "")" style="--lvl:@battery%"></span></span>
    </div>;

    RenderFragment ListScreen() => @<text>
        @Header(nav.Title)
        <div class="lcd-body @(split ? "split" : "")">
            <div class="lcd-list-wrap">
                <ul class="lcd-list @(nav.LastMove > 0 ? "slide-in" : nav.LastMove < 0 ? "slide-back" : "")" @key="nav.Depth + nav.Title" data-testid="ipod-list">
                    @foreach (var (r, i) in nav.Visible.Select((r, i) => (r, i + nav.Top)))
                    {
                        var idx = i;
                        <li class="@(i == nav.Selected ? "sel" : "")" data-testid="ipod-row" @onclick="() => RowClick(idx)">
                            @if (r.Checked is not null) { <i class="lcd-tick">@(r.Checked == true ? "✓" : "")</i> }
                            @if (narrow && Fam == IpodFamily.Nano && IsArtKind) { <span class="lcd-thumb"><Cover ArtKey="@(r.ArtKey)" Class="lcd-art" /></span> }
                            <span class="lcd-label">@r.Label</span>
                            @if (r.Value is not null) { <span class="lcd-val">@r.Value</span> }
                            @if (r.Opens) { <em>›</em> }
                        </li>
                    }
                    @if (nav.Rows.Count == 0) { <li class="empty">@(Lib.Songs.Count == 0 ? "Loading…" : "Nothing here")</li> }
                </ul>
                @if (nav.Thumb is { } th) { <div class="lcd-scroll"><i style="top:@Pc(th.Start)%;height:@Pc(th.Length)%"></i></div> }
            </div>
            @if (split) { @Pane() }
        </div>
    </text>;

    RenderFragment Pane() => @<div class="lcd-pane" data-testid="ipod-pane">
        @if (nav.Kind == IpodKind.Menu)
        {
            @if (Player.Current is { } pt && tall)
            {
                <div class="pane-art"><Cover ArtKey="@(pt.ArtKey)" Class="lcd-art" /></div>
                <small class="pane-acc">NOW PLAYING</small><b>@pt.Title</b><span>@(pt.Artist.Length > 0 ? pt.Artist : pt.Album)</span>
            }
            else if (nav.Current is { } cur)
            {
                <div class="pane-tile"><Icon Name="@GlyphFor(cur.Label)" Size="@(tall ? 90 : 72)" Weight="1.6" /></div>
            }
        }
        else if (nav.Current is { } c)
        {
            <div class="pane-art"><Cover ArtKey="@(c.ArtKey)" Class="lcd-art" /></div>
            <b>@c.Label</b>
            @if (!string.IsNullOrEmpty(c.Sub)) { <span class="pane-acc">@c.Sub</span> }
            @if (!string.IsNullOrEmpty(c.Detail)) { <small>@c.Detail</small> }
        }
    </div>;

    RenderFragment CoverFlow() => @<div class="cf" data-testid="ipod-coverflow">
        <span class="ipod-sr" data-testid="ipod-title">@nav.Title</span>
        <div class="cf-stage">
            @for (var i = Math.Max(0, nav.Selected - 4); i <= Math.Min(nav.Rows.Count - 1, nav.Selected + 4); i++)
            {
                var off = i - nav.Selected;
                <div class="cf-item @(off == 0 ? "mid" : "")" style="@CfStyle(off)" data-off="@off"><Cover ArtKey="@(nav.Rows[i].ArtKey)" Class="lcd-art" /></div>
            }
        </div>
        @if (nav.Current is { } c) { <div class="cf-cap"><b data-testid="ipod-cf-title">@c.Label</b><span>@c.Sub</span></div> }
        else { <div class="cf-cap"><b>No Albums</b></div> }
    </div>;

    RenderFragment ToolScreen() => @<text>
        @Header(tool == "clock" ? "Clock" : "Stopwatch")
        <div class="tool" data-testid="ipod-tool">
            <div class="tool-time" data-testid="ipod-tool-time">@(tool == "clock" ? (clock.Length > 0 ? clock : DateTime.Now.ToString("t")) : Watch())</div>
            <div class="tool-sub">@(tool == "clock" ? dateText : (running ? "Select: stop" : "Select: start") + "  ·  ⏮ reset")</div>
        </div>
    </text>;

    RenderFragment NowPlaying(Track t) => @<text>
        @Header("Now Playing", tall && Fam == IpodFamily.Nano && Player.Queue.Count > 1 ? (Player.Index + 1) + " of " + Player.Queue.Count : null)
        <div class="lnp" data-testid="ipod-np">
            <div class="lnp-art"><Cover ArtKey="@(t.ArtKey)" Class="lcd-art" /></div>
            <div class="lnp-meta">
                @if (Player.Queue.Count > 1) { <small data-testid="ipod-np-count">@(Player.Index + 1) of @Player.Queue.Count</small> }
                <b data-testid="ipod-np-title">@t.Title</b><span>@t.Artist</span><span class="lnp-album">@t.Album</span>
            </div>
            @if (hudOn && npMode == 2)
            {
                <div class="lnp-hud rate" data-testid="ipod-rating" aria-label="Rating"><span class="stars">@Stars(Session.Rating(t))</span></div>
            }
            else if (hudOn && npMode == 0)
            {
                <div class="lnp-hud vol" data-testid="ipod-volume"><Icon Name="stop" Size="9" /><div class="lnp-bar @(FamClass == "mono" ? "blocks" : "")">@if (FamClass == "mono") { @for (var b = 0; b < 16; b++) { <i class="@(b < (int)(Player.Volume * 16 + 0.001) ? "on" : "")"></i> } } else { <i style="width:@Pc(Player.Volume)%"></i> }</div><Icon Name="play" Size="9" /></div>
            }
            else
            {
                <div class="lnp-hud time" data-testid="ipod-time">
                    <div class="lnp-bar @(hudOn && npMode == 1 ? "knob" : "")"><i style="width:@Pct()%"></i>@if (hudOn && npMode == 1) { <u class="knob" style="left:@Pct()%" data-testid="ipod-scrub"></u> }</div>
                    <div class="lnp-times"><span>@Fmt(Player.Position)</span><span>-@Fmt(Math.Max(0, Player.Duration - Player.Position))</span></div>
                </div>
            }
        </div>
    </text>;

    // ---------------------------------------------------------------- state

    readonly IpodNav nav = new(8);
    readonly WheelDetents detents = new(34);
    IpodPrefs prefs = new();
    readonly List<IReadOnlyList<Track>?> tracks = [];
    readonly List<IReadOnlyList<Group>?> groups = [];
    ElementReference stage, device, wheel, fitEl;
    IpodTouchOs? touchOs;
    string pickGroup = IpodModels.Classic;
    double wheelAcc;
    DotNetObjectReference<Ipod>? self;
    bool scrub => npMode == 1;
    int npMode;
    string tool = "", dateText = "";
    bool running; DateTime watchStart; TimeSpan watchBase; System.Threading.Timer? watchTimer;
    bool first2 = true; string lastFitKey = "";
    bool showNow, panel = true, started, loaded, inited, initTouch;
    DateTime hudUntil = DateTime.MinValue;
    string clock = ""; int battery = 100; bool charging;
    System.Threading.Timer? ticker; CancellationTokenSource? hudCts;

    IpodModel model => prefs.CurrentModel;
    IpodColor color => prefs.CurrentColor;
    bool flat => prefs.Look == IpodPrefs.LookWheelOnly && !model.Touch;
    bool desk => prefs.Look == IpodPrefs.LookDesk && !retro;
    // another listening scene instead of the iPod (iPod panel › Scene): the stage shows it, and the iPod's own parts are put away
    bool retro => prefs.Scene != IpodPrefs.SceneIpod;
    void PickScene(int k)
    {
        if (k == prefs.Scene) return;
        prefs.Scene = k; Save();
        if (retro) { _ = Js.InvokeVoidAsync("flacie.ipodDispose").AsTask(); }
        inited = false; lastFitKey = "";   // (back on the iPod: its wheel, keys and fit are set up again)
        showNow = !retro && Player.Current is not null; npMode = 0;
    }
    bool initDesk;

    // ---------------------------------------------------------------- the desk: the journal (lyrics), the Now Playing card, the CDs and what comes next
    [Inject] LyricsService LyricsSvc { get; set; } = default!;
    [Inject] MbOverlay MbChoices { get; set; } = default!;
    [Inject] InfoService Infos { get; set; } = default!;
    Lyrics? deskLyrics; string? deskLyricsFor;
    // the viewer's own day (their clock, not the server's): "15 oct" for the journal; empty until the browser answers
    string deskDate = "", deskWeekday = ""; bool deskDayAsked;
    DeskAlbum? DeskNow => DeskSources.Current(Player.Queue, Player.Index);
    // the CD rack: the next eight albums in play order (round again with repeat all)
    IReadOnlyList<DeskAlbum> DeskNext => DeskSources.Next(Player.Queue, Player.PlayOrder, Player.Index, 8, Player.Repeat == 1);

    RenderFragment DeskJournalPart => @<DeskJournal Title="@Player.Current?.Title" Artist="@Player.Current?.Artist" Lines="@(deskLyrics?.Lines ?? [])" Synced="@(deskLyrics?.Synced ?? false)" SongKey="@deskLyricsFor" Date="@deskDate" />;
    RenderFragment DeskPolaroidPart => @<DeskNowCard Now="@Player.Current" Format="@DeskFormatLine" />;
    RenderFragment DeskCdsPart => @<DeskCds Now="@DeskNow" Next="@DeskNext" Queue="@Player.Queue" DiscUrl="@DiscUrlFor(DeskNow)" Playing="@Player.Playing" OnPlay="@DeskPlay" OnToggle="@(() => Player.Toggle())" />;

    // the Now Playing card's line about the file: what FLACie read from it (as the Info tab does; cached, and a burst of skips does not ask about every
    // song it passes), until then the extension and a bit rate from its size
    MediaInfo? deskInfo; string? deskInfoFor; CancellationTokenSource? deskInfoCts;
    string DeskFormatLine => Player.Current is { } t ? DeskFormat.Line(deskInfoFor == t.Path ? deskInfo : null, t) : "";
    int DeskRate => Player.Current is { } t && deskInfoFor == t.Path && deskInfo is { SampleRateHz: > 0 } i ? i.SampleRateHz : 0;
    // the preamp's meter: what the file is played at ("44.1 kHz · 16-bit")
    string DeskRateLine => Player.Current is { } t && deskInfoFor == t.Path && deskInfo is { SampleRateHz: > 0 } i
        ? (i.SampleRateHz % 1000 == 0 ? $"{i.SampleRateHz / 1000}" : $"{i.SampleRateHz / 1000.0:0.#}") + " kHz" + (i.BitDepth > 0 ? $" · {i.BitDepth}-bit" : "") : "";
    async Task DeskInfoFollow()
    {
        if (!desk || Player.Current is not { } t || t.Path == deskInfoFor) return;
        deskInfoCts?.Cancel(); var cts = deskInfoCts = new CancellationTokenSource(); var ct = cts.Token;
        deskInfoFor = t.Path; deskInfo = null;
        try
        {
            if (!Infos.IsCached(t)) { await Task.Delay(400, ct); if (deskInfoFor != t.Path) return; }
            var got = await Infos.GetAsync(Session, t, ct: ct);
            if (deskInfoFor == t.Path)
            {
                deskInfo = got; await InvokeAsync(StateHasChanged);
                // the EQ's graph, if it is made later, is opened at the file's own rate (so it is not resampled on its way through)
                if (got.SampleRateHz > 0) try { await Js.InvokeVoidAsync("flacie.toneRate", got.SampleRateHz); } catch (Exception) { }
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception) { }
    }

    // the desk's options (iPod panel › Desk)
    RenderFragment DeskOpt(string key, string name, bool on, Action<DeskOptions> flip) =>
        @<button type="button" class="ipod-chip @(on ? "on" : "")" data-desk-opt="@key" aria-pressed="@(on ? "true" : "false")" tabindex="-1" @onclick="() => DeskSet(flip)">@name</button>;
    void DeskSet(Action<DeskOptions> change) { change(prefs.Desk); Save(); }

    // the keepsakes: a ticket stub for the artist playing, a USB stick and a paperclip
    RenderFragment DeskPropsPart => @<text>
        <DeskKeepsakes Ticket="@prefs.Desk.Ticket" Usb="@prefs.Desk.Usb" Artist="@Player.Current?.Artist" Year="@(Player.Current?.Year ?? 0)" />
    </text>;

    // a CD played while shuffling plays the whole album, in album order, then the shuffle carries on; otherwise the queue goes on from that album
    async Task DeskPlay(DeskAlbum a) { if (Player.Shuffle) await Player.PlayRun(a.Tracks); else await Player.SkipTo(a.QueueIndex); await FocusStage(); }

    async Task DeskDayFromBrowser()
    {
        try
        {
            var d = await Js.InvokeAsync<string[]>("desk.today");
            if (d is [var date, var weekday] && (date != deskDate || weekday != deskWeekday)) { deskDate = date; deskWeekday = weekday; await InvokeAsync(StateHasChanged); }
        }
        catch (Exception) { }
    }

    /// <summary>Where the playing album's own disc picture (Cover Art Archive "Medium") is asked for, when the user matched its release on MusicBrainz: FLACie's
    /// /desk/disc (the server fetches and keeps it); the browser falls back to a print made from the cover when there is none.</summary>
    string? DiscUrlFor(DeskAlbum? album)
    {
        if (album is null || MbChoices.Get(album.First) is not { ReleaseMbid: var release } || !DeskDiscPictures.ValidId(release)) return null;
        return $"/desk/disc/{release}";
    }

    /// <summary>The journal's lyrics follow the song; an answer for a song that is no longer playing is dropped.</summary>
    async Task DeskLyricsFollow()
    {
        if (!desk || Player.Current is not { } t || t.Path == deskLyricsFor) return;
        deskLyricsFor = t.Path; deskLyrics = null;
        Lyrics? got = null;
        try { got = await LyricsSvc.GetAsync(t, Session.Jellyfin); } catch (Exception) { }
        if (DeskLyrics.Accept(t.Path, Player.Current?.Path)) { deskLyrics = got; await InvokeAsync(StateHasChanged); }
    }
    IpodFamily Fam => model.Family;
    string FamClass => Fam switch { IpodFamily.Mono => "mono", IpodFamily.Video => "video", IpodFamily.Nano => "nano", _ => "touch" };
    string LcdTheme => Fam == IpodFamily.Nano || Fam == IpodFamily.Touch ? (color.DarkUi ? "pal-dark" : "pal-light") : "";
    IpodScreenSize Lcd => IpodModels.ScreenSize(model, !flat);
    bool tall => Lcd.H > 300;
    bool narrow => Lcd.W < 280;
    bool IsArtKind => nav.Kind is IpodKind.Songs or IpodKind.Albums or IpodKind.Artists;
    bool split => Fam != IpodFamily.Mono && !narrow && (IsArtKind || (Fam != IpodFamily.Video && nav.Kind == IpodKind.Menu));
    bool hudOn => DateTime.UtcNow < hudUntil;
    int HeaderH => Fam switch { IpodFamily.Mono => 16, IpodFamily.Video => 22, _ => 26 };
    int RowH => Fam switch { IpodFamily.Mono => 14, IpodFamily.Video => 24, _ => tall ? 38 : 27 };
    int RowsFit => Math.Max(2, (Lcd.H - HeaderH) / RowH);

    // device geometry: the body is 300 px wide; everything else is a fraction of it
    const double Bw = 300;
    // the device look follows the real proportions; "wheel only" is the faceplate: the screen across the top and the wheel under it, whatever the model
    double Bh => flat ? FlatSh + 22 + KeyRoom + 2 * FlatR + 16 : Bw / model.Aspect;
    double FlatSh => Bw * Lcd.H / Lcd.W;
    double FlatR => Bw * 0.36;
    /// <summary>A scale factor with enough digits that the screen ends exactly at its bezel (two digits were up to a pixel off at a big zoom).</summary>
    static string K(double v) => v.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
    string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string Pc(double v) => (v * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    double Sx => flat ? 0 : model.Screen.L * Bw; double Sy => flat ? 0 : model.Screen.T * Bh; double Sw => flat ? Bw : model.Screen.W * Bw; double Sh => flat ? FlatSh : model.Screen.H * Bh;
    double WCx => flat ? Bw / 2 : model.WheelCx * Bw; double WCy => flat ? FlatSh + 22 + KeyRoom + FlatR : model.WheelCy * Bh; double WR => flat ? FlatR : model.WheelR * Bw;
    // the 3rd generation's row of buttons: round, 14% of the body wide, centred between the screen's bezel and the wheel (in the wheel-only look a band of
    // its own between the screen and the wheel, so that look is taller by as much)
    double KeyD => 0.14 * Bw;
    double KeyRoom => model.KeyRow && flat ? KeyD + 14 : 0;
    double KeyCy => flat ? FlatSh + 18 + KeyD / 2 : (Sy + Sh + model.BezelInset * Bw + WCy - WR) / 2;
    string KeyRowStyle => $"top:{F(KeyCy - KeyD / 2)}px;height:{F(KeyD)}px;--kd:{F(KeyD)}px";
    /// <summary>The controls, for the CSS and the page script: "click" (the click wheel), "scroll" (the 1st generation's turning wheel in its ring of buttons),
    /// "touch" (the 2nd's touch wheel in the same ring), "row" (the 3rd's touch wheel under its row of buttons).</summary>
    string ControlsKey => model.Controls switch { IpodControls.ScrollWheel => "scroll", IpodControls.TouchWheel => "touch", IpodControls.TouchRow => "row", _ => "click" };

    string StageStyle => $"--backdrop:{color.Backdrop}";
    string DeviceStyle => $"width:{F(Bw)}px;height:{F(Bh)}px;--top:{color.Top};--bottom:{color.Bottom};--edge:{color.Edge};--bezel:{color.Bezel};--rad:{F(model.Radius * Bw)}px;" +
        $"--wr1:{color.Wheel.RingLight};--wr2:{color.Wheel.RingDark};--wedge:{color.Wheel.Edge};--wc1:{color.Wheel.CenterLight};--wc2:{color.Wheel.CenterDark};--wce:{color.Wheel.CenterEdge};--wlabel:{color.Wheel.Label};" +
        $"--flat1:{IpodModels.Lighten(color.Top, 0.2)};--flat2:{color.Bottom}";
    string ScreenStyle => $"left:{F(Sx)}px;top:{F(Sy)}px;width:{F(Sw)}px;height:{F(Sh)}px";
    string BezelStyle { get { var b = model.BezelInset * Bw; return $"left:{F(Sx - b)}px;top:{F(Sy - b)}px;width:{F(Sw + 2 * b)}px;height:{F(Sh + 2 * b)}px;border-radius:{F(Math.Max(3, b * 1.6))}px"; } }
    int TouchW => model.Id.StartsWith("nano") ? 240 : 320;
    int TouchH => (int)Math.Round(TouchW * Sh / Sw);
    string TouchScaleStyle => $"width:{TouchW}px;height:{TouchH}px;transform:scale({K(Sw / TouchW)},{K(Sh / TouchH)})";
    void TouchHome() { touchOs?.GoHome(); _ = FocusStage(); }

    string LcdInStyle => $"width:{Lcd.W}px;height:{Lcd.H}px;transform:scale({K(Sw / Lcd.W)},{K(Sh / Lcd.H)})";
    string FaceStyle { get { var i = 0.02 * Bw; return $"left:{F(i)}px;top:{F(i)}px;right:{F(i)}px;bottom:{F(i)}px;border-radius:{F(model.Radius * Bw * 0.9)}px"; } }
    string HomeStyle { get { var cy = (model.Screen.B + (1 - model.Screen.B) * 0.5) * Bh; var r = 0.085 * Bw; return $"left:{F(Bw / 2 - r)}px;top:{F(cy - r)}px;width:{F(2 * r)}px;height:{F(2 * r)}px"; } }
    string WheelStyle => $"left:{F(WCx - WR)}px;top:{F(WCy - WR)}px;width:{F(2 * WR)}px;height:{F(2 * WR)}px";
    string CfStyle(int off)
    {
        var s = Math.Min(Lcd.W * 0.46, Lcd.H * 0.5); var k = Math.Clamp(off, -1, 1); var a = Math.Abs(k); var side = off < 0 ? -1 : 1;
        var beyond = Math.Max(0, Math.Abs(off) - 1);
        var x = k * s * 0.62 + side * beyond * s * 0.2; var rot = -side * 62 * a; var z = -a * 70 - beyond * 20;
        var fade = Math.Clamp(1 - Math.Max(0, Math.Abs(off) - 2.5) * 0.6, 0, 1);
        return $"width:{F(s)}px;height:{F(s)}px;margin-left:{F(-s / 2)}px;opacity:{F(fade)};z-index:{10 - Math.Abs(off)};transform:translateX({F(x)}px) translateZ({F(z)}px) rotateY({F(rot)}deg)";
    }
    static string GlyphFor(string label) => label switch
    {
        "Music" or "Browse" => "note", "Playlists" => "playlists", "Artists" => "artists", "Albums" or "Cover Flow" or "Genres" => "albums", "Songs" => "songs", "Settings" => "settings",
        "Shuffle Songs" => "shuffle", "Now Playing" => "play", "Voice Memos" or "Extras" => "wave", _ => "note",
    };

    // ---------------------------------------------------------------- start

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Root();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first)
        {
            self = DotNetObjectReference.Create(this);
            await LoadPrefs();
            // the volume the music plays at (kept in the browser): read here too, iPod mode opened straight away has no player bar to read it
            try { await Player.LoadVolumeAsync(); } catch (Exception) { }
            loaded = true; Fit(); Root(); RefreshClock(); await RefreshBattery();
            // opened while a song plays: start on Now Playing (MENU goes to the menu, as on an iPod picked up mid-song)
            if (Player.Current is not null) { showNow = true; npMode = 0; }
            ticker = new System.Threading.Timer(_ => { RefreshClock(); InvokeAsync(StateHasChanged); }, null, 20_000, 20_000);
            StateHasChanged(); return;
        }
        _ = DeskLyricsFollow(); _ = DeskInfoFollow();
        if (desk && !deskDayAsked) { deskDayAsked = true; _ = DeskDayFromBrowser(); }
        if (retro)
        {
            // another scene: no iPod to fit or wire up; the panel starts open only where there is room for it beside the scene
            if (first2 && loaded) { first2 = false; try { panel = await Js.InvokeAsync<bool>("flacie.wideScreen"); StateHasChanged(); } catch (Exception) { } }
            return;
        }
        var fitKey = model.Id + flat + desk;
        if (loaded && fitKey != lastFitKey) { lastFitKey = fitKey; _ = Js.InvokeVoidAsync("flacie.ipodFit").AsTask(); }
        var wantTouch = model.Touch;
        if (loaded && (!inited || initTouch != wantTouch || initDesk != desk))
        {
            inited = true; initTouch = wantTouch; initDesk = desk;
            try { object? w = wantTouch ? null : wheel; var wide = await Js.InvokeAsync<bool>("flacie.ipodInit", stage, device, w, self, new { deg = prefs.DegreesPerDetent }, fitEl); if (first2) { first2 = false; panel = wide; StateHasChanged(); } } catch (Exception) { }
        }
    }

    void RefreshClock() { try { clock = DateTime.Now.ToString("t"); } catch (Exception) { } _ = ClockFromBrowser(); if (desk) _ = DeskDayFromBrowser(); }
    async Task ClockFromBrowser() { try { var c = await Js.InvokeAsync<string>("flacie.ipodClock"); if (!string.IsNullOrEmpty(c) && c != clock) { clock = c; await InvokeAsync(StateHasChanged); } } catch (Exception) { } }
    async Task RefreshBattery() { try { var b = await Js.InvokeAsync<System.Text.Json.JsonElement>("flacie.ipodBattery"); battery = b[0].GetInt32(); charging = b[1].GetBoolean(); } catch (Exception) { } }

    static string GroupShort(string g) => g == IpodModels.Classic ? "Classic" : g == IpodModels.Mini ? "mini" : g == IpodModels.Nano ? "nano" : "touch";
    async Task FocusStage() { try { await stage.FocusAsync(); } catch (Exception) { } }
    void TogglePanel() { panel = !panel; _ = Js.InvokeVoidAsync("flacie.ipodFit").AsTask(); }

    void Fit() { nav.VisibleRows = RowsFit; detents.DegreesPerDetent = prefs.DegreesPerDetent; }

    // the iPod's settings (model, colour, look, scene, desk, wheel...) are kept in this browser and with the account (the profile), so they follow the person to
    // another browser, device or the Windows app (whose server's port, and so its storage, changes each launch). The newer copy wins when the page opens.
    void Save()
    {
        var json = prefs.ToJson(); var at = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        _ = Js.InvokeVoidAsync("flacie.stash", "flacie.ipod", json).AsTask(); _ = Js.InvokeVoidAsync("flacie.stash", "flacie.ipod.at", at.ToString()).AsTask();
        Session.SetSetting("ipod", json, at); SaveAccountSoon();
        _ = Js.InvokeVoidAsync("flacie.ipodConfig", new { deg = prefs.DegreesPerDetent }).AsTask();
    }
    async Task LoadPrefs()
    {
        string? json = null; long localAt = 0;
        try { json = await Js.InvokeAsync<string?>("flacie.unstash", "flacie.ipod"); long.TryParse(await Js.InvokeAsync<string?>("flacie.unstash", "flacie.ipod.at"), out localAt); } catch (Exception) { }
        // the account's copy, unless this browser's is newer; a copy here without a time (kept before settings went with the account) counts as the newest
        if (Session.GetSetting("ipod") is { } acc && (json is null || (localAt > 0 && acc.At > localAt))) json = acc.Json;
        else if (json is not null) { Session.SetSetting("ipod", json, localAt > 0 ? localAt : DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()); SaveAccountSoon(); }
        prefs = IpodPrefs.FromJson(json);
    }
    // (a knob turned or a chip clicked a few times saves the profile once, a moment later)
    CancellationTokenSource? accountSave;
    void SaveAccountSoon()
    {
        accountSave?.Cancel(); var cts = accountSave = new CancellationTokenSource();
        _ = Task.Delay(1500, cts.Token).ContinueWith(t => { if (!t.IsCanceled) SaveProfile(); }, TaskScheduler.Default);
    }

    // ---------------------------------------------------------------- menus

    IReadOnlySet<string> Hidden => prefs.HiddenMenu;

    void Root()
    {
        nav.Reset(); tracks.Clear(); groups.Clear(); Fit();
        PushLevel(IpodMenus.RootTitle, RootRows(), IpodKind.Menu);
    }

    IReadOnlyList<IpodRow> RootRows() => IpodMenus.Root(Fam, Hidden, Player.Current is not null);
    /// <summary>The main menu lists "Now Playing" only while something is queued and follows Settings &gt; Main Menu: refreshed whenever it is shown again.</summary>
    void RefreshRoot() => nav.ReplaceAt(0, RootRows());

    void PushLevel(string title, IReadOnlyList<IpodRow> rows, IpodKind kind, IReadOnlyList<Track>? ts = null, IReadOnlyList<Group>? gs = null)
    {
        nav.Push(title, rows, kind); tracks.Add(ts); groups.Add(gs);
    }

    IReadOnlyList<Group> PlaylistGroups() => Session.Playlists.Select(p => { var ts = Session.Resolve(p.Entries); return new Group(p.Name, ts, ts.Select(t => t.ArtKey).FirstOrDefault(a => a is not null)); }).ToList();

    IpodPlayback PlaybackInfo => IpodActions.Info(Player, prefs, Lib, Session.Playlists.Count);

    /// <summary>The rows of the level on top when they depend on a setting (so a change shows at once, the highlight kept).</summary>
    void RefreshLevel(string? id = null)
    {
        switch (id ?? levelId)
        {
            case "m:appearance": nav.Replace(IpodMenus.Appearance(prefs)); break;
            case "m:playback": nav.Replace(IpodMenus.PlaybackPage(PlaybackInfo, prefs)); break;
            case "m:controls": nav.Replace(IpodMenus.Controls(prefs)); break;
            case "m:mainmenu": nav.Replace(IpodMenus.MainMenu(Fam, Hidden)); break;
            case "m:models": break;
        }
    }
    string levelId = "";
    readonly List<string> levelIds = [];

    // ---------------------------------------------------------------- input

    [JSInvokable]
    public async Task Turned(double degrees, double dps)
    {
        var n = detents.Feed(degrees, WheelFeel.Gain(dps, showNow ? 0 : nav.Rows.Count, prefs.WheelAccel));
        if (n != 0) await Turn(n);
    }
    [JSInvokable] public void Released() => detents.Release();
    [JSInvokable] public async Task Zone(string zone)
    {
        Feedback("press");
        switch (zone)
        {
            case "center": await Press(); break;
            case "menu": Menu(); break;
            case "next": await Player.Next(); if (showNow) Hud(); break;
            case "prev": if (tool == "stopwatch") WatchReset(); else { await Player.Prev(); if (showNow) Hud(); } break;
            case "play": await Player.Toggle(); break;
        }
        StateHasChanged();
    }
    [JSInvokable] public async Task Hold(string zone)
    {
        if (zone == "menu") { showNow = false; tool = ""; StopRender(); nav.ToRoot(); TrimStacks(); RefreshRoot(); Feedback("press"); }
        else { await Player.SkipByAsync(zone == "next" ? 4 : -4); Hud(); }
        StateHasChanged();
    }

    void Feedback(string kind) { if (prefs.Clicker != 0) _ = Js.InvokeVoidAsync("flacie.ipodTick", kind, prefs.ClickSound, prefs.ClickVolume, prefs.Haptics).AsTask(); }

    async Task Turn(int n)
    {
        if (showNow)
        {
            if (npMode == 0) { var cap = prefs.VolumeLimit / 100.0; await Player.SetVolumeAsync(Math.Clamp(Player.Volume + n / 32.0, 0, cap)); }
            else if (npMode == 1) await Player.SkipByAsync(n * Math.Max(1, Player.Duration / 120.0));
            else if (Player.Current is { } cur) Rate(cur, Math.Clamp(Session.Rating(cur) + n, 0, 5));
            Feedback("tick"); Hud(); await InvokeAsync(StateHasChanged); return;
        }
        if (nav.Turn(n)) { Feedback("tick"); await InvokeAsync(StateHasChanged); }
    }

    void Hud()
    {
        hudUntil = DateTime.UtcNow.AddMilliseconds(2200);
        hudCts?.Cancel(); hudCts = new(); var tok = hudCts.Token;
        _ = Task.Delay(2300, tok).ContinueWith(t => { if (!t.IsCanceled) InvokeAsync(StateHasChanged); });
    }

    void OnMouseWheel(WheelEventArgs e)
    {
        if (model.Touch) return;
        wheelAcc += e.DeltaMode == 0 ? e.DeltaY : e.DeltaY * 40;
        var n = (int)(wheelAcc / 50); if (n == 0 && Math.Abs(e.DeltaY) >= 1 && Math.Abs(wheelAcc) >= 1 && (DateTime.UtcNow - lastWheel).TotalMilliseconds > 250) n = Math.Sign(wheelAcc);
        lastWheel = DateTime.UtcNow;
        if (n != 0) { wheelAcc = 0; _ = Turn(n); }
    }
    DateTime lastWheel = DateTime.MinValue;

    async Task Key(KeyboardEventArgs e)
    {
        if (model.Touch)
        {
            if (e.Key is "Escape" or "Backspace") { touchOs?.Back(); }
            else if (e.Key == " ") await Player.Toggle();
            else if (e.Key == "ArrowRight") await Player.Next();
            else if (e.Key == "ArrowLeft") await Player.Prev();
            return;
        }
        switch (e.Key)
        {
            case "ArrowDown": await Turn(1); break;
            case "ArrowUp": await Turn(-1); break;
            case "Enter": Feedback("press"); await Press(); break;
            case "Escape": case "Backspace": Menu(); break;
            case "ArrowRight": await Player.Next(); if (showNow) Hud(); break;
            case "ArrowLeft": if (tool == "stopwatch") WatchReset(); else { await Player.Prev(); if (showNow) Hud(); } break;
            case " ": await Player.Toggle(); break;
        }
    }

    async Task RowClick(int i) { nav.Select(i); Feedback("press"); await Press(); }

    void Menu()
    {
        if (tool != "") { tool = ""; StopRender(); return; }
        if (showNow) { showNow = false; return; }
        if (nav.Back()) { TrimStacks(); if (nav.Depth == 1) RefreshRoot(); }
    }

    void TrimStacks() { if (tracks.Count > nav.Depth) { tracks.RemoveRange(nav.Depth, tracks.Count - nav.Depth); groups.RemoveRange(nav.Depth, groups.Count - nav.Depth); } if (levelIds.Count > nav.Depth) levelIds.RemoveRange(nav.Depth, levelIds.Count - nav.Depth); levelId = levelIds.Count > 0 ? levelIds[^1] : ""; }

    void Open(string title, IReadOnlyList<IpodRow> rows, IpodKind kind, string id, IReadOnlyList<Track>? ts = null, IReadOnlyList<Group>? gs = null)
    {
        PushLevel(title, rows, kind, ts, gs);
        while (levelIds.Count < nav.Depth - 1) levelIds.Add("");
        levelIds.Add(id); levelId = id;
    }

    async Task Press()
    {
        if (tool == "stopwatch") { WatchToggle(); return; }
        if (tool != "") return;
        if (showNow) { npMode = (npMode + 1) % 3; Hud(); return; }
        var row = nav.Current; if (row is null) return;
        var id = row.Id;
        if (id.StartsWith("cyc:")) { await CycleSetting(id[4..]); return; }
        if (id.StartsWith("tgl:menu:")) { var name = id[9..]; if (!prefs.HiddenMenu.Remove(name)) prefs.HiddenMenu.Add(name); Save(); RefreshLevel(); RefreshRoot(); return; }
        if (id.StartsWith("set:model:")) { ChooseModel(id[10..]); return; }
        if (id.StartsWith("set:color:")) { prefs.Color = int.Parse(id.AsSpan(10)); Save(); RefreshColorLevel(); return; }
        if (id.StartsWith("m:group:")) { var g = id[8..]; Open(IpodMenus.GroupTitle(g), IpodMenus.Models(g, prefs.Model), IpodKind.Settings, "m:models"); return; }
        if (IpodContent.Level(id, Lib, PlaylistGroups) is { } lv) { Open(lv.Title, lv.Rows, lv.Kind, id, lv.Tracks, lv.Groups); return; }
        switch (id)
        {
            case "m:none": break;
            case "m:clock": tool = "clock"; _ = LoadDate(); break;
            case "m:stopwatch": tool = "stopwatch"; if (running) StartRender(); break;
            case "m:music": Open(IpodMenus.MusicTitle(Fam), IpodMenus.Music(Fam), IpodKind.Menu, id); break;
            case "m:browse": Open("Browse", IpodMenus.Music(IpodFamily.Mono), IpodKind.Menu, id); break;
            case "m:extras": Open("Extras", IpodMenus.Extras(), IpodKind.Menu, id); break;
            case "m:memos": Open("Voice Memos", [new IpodRow("No Memos", "m:none", false)], IpodKind.Memos, id); break;
            case "m:shuffle": if (Lib.Songs.Count > 0) { await Player.ShuffleAll(Lib.Songs, "iPod"); showNow = Player.Current is not null; npMode = 0; } break;
            case "m:np": if (Player.Current is not null) { showNow = true; npMode = 0; Hud(); } break;
            case "m:settings": Open("Settings", IpodMenus.Settings(), IpodKind.Settings, id); break;
            case "m:appearance": Open("Appearance", IpodMenus.Appearance(prefs), IpodKind.Settings, id); break;
            case "m:models": Open("Model", IpodMenus.ModelGroups(), IpodKind.Settings, "m:modelgroups"); break;
            case "m:colors": Open("Colour", IpodMenus.Colors(model, prefs.Color), IpodKind.Settings, id); break;
            case "m:playback": Open("Playback", IpodMenus.PlaybackPage(PlaybackInfo, prefs), IpodKind.Settings, id); break;
            case "m:controls": Open("Controls", IpodMenus.Controls(prefs), IpodKind.Settings, id); break;
            case "m:mainmenu": Open("Main Menu", IpodMenus.MainMenu(Fam, Hidden), IpodKind.Settings, id); break;
            case "m:about": Open("About", IpodMenus.About(PlaybackInfo), IpodKind.Settings, id); break;
            case "m:reset": Open("Reset Settings", IpodMenus.Reset(), IpodKind.Settings, id); break;
            case "m:account": Nav.NavigateTo("/account"); break;
            case "m:flacie": Nav.NavigateTo("/settings"); break;
            case "m:cancel": Menu(); break;
            case "m:doreset": prefs.Reset(); Save(); Menu(); ApplyLook(); RebuildAll(); break;
            default: await PressContent(id); break;
        }
    }

    async Task PressContent(string id)
    {
        var level = nav.Depth - 1;
        var (next, play) = IpodContent.Open(id, new IpodLevel(nav.Title, nav.Rows, nav.Kind, tracks[level], groups[level]));
        if (next is not null) Open(next.Title, next.Rows, next.Kind, "", next.Tracks, next.Groups);
        else if (play is not null)
        {
            if (play.Shuffle) await Player.ShuffleAll(play.List, "iPod"); else await Player.Play(play.List, play.Index, "iPod");
            showNow = Player.Current is not null; npMode = 0; if (showNow) Hud();
        }
    }

    // ---------------------------------------------------------------- settings actions

    async Task CycleSetting(string name)
    {
        if (!await IpodActions.CycleAsync(name, prefs, Player)) return;
        if (name == "look") { var keep = nav.Selected; Save(); ApplyLook(); RebuildAll(); nav.Select(keep); return; }
        if (name is "wheelSpeed" or "wheelAccel" or "clicker" or "clickVolume" or "volumeLimit" or "clock") { Fit(); Save(); }
        RefreshLevel();
    }

    void ChooseModel(string id)
    {
        var old = model; prefs.ChooseModel(id); Save();
        Fit(); ApplyLook();
        if (old.Family != model.Family || old.Touch != model.Touch) RebuildAll();
        else { Fit(); RebuildAll(); }
    }

    void RefreshColorLevel() { nav.Replace(IpodMenus.Colors(model, prefs.Color)); }

    /// <summary>From the panel: the iPod starts again at its main menu (from Settings on the device itself the person stays in Settings).</summary>
    // (a song playing: the iPod comes back on Now Playing, whatever changed)
    void PickModel(string id) { prefs.ChooseModel(id); Save(); pickGroup = model.Group; Root(); showNow = Player.Current is not null; npMode = 0; _ = FocusStage(); }
    void PickColor(int i) { prefs.Color = i; Save(); _ = FocusStage(); }
    void PickLook(int look) { prefs.Look = look; Save(); Root(); showNow = Player.Current is not null; npMode = 0; _ = FocusStage(); }

    void ApplyLook() { Fit(); }

    /// <summary>After a model, family or look change: the menus start again at the main menu, then Settings &gt; Appearance, so the person is where they were.</summary>
    void RebuildAll()
    {
        Root();
        Open("Settings", IpodMenus.Settings(), IpodKind.Settings, "m:settings");
        Open("Appearance", IpodMenus.Appearance(prefs), IpodKind.Settings, "m:appearance");
        showNow = false;
    }

    // ---------------------------------------------------------------- bits

    // ---------------------------------------------------------------- Extras: clock and stopwatch, and the stars

    async Task LoadDate() { try { dateText = await Js.InvokeAsync<string>("flacie.ipodDate"); await InvokeAsync(StateHasChanged); } catch (Exception) { } }
    TimeSpan Elapsed => running ? watchBase + (DateTime.UtcNow - watchStart) : watchBase;
    string Watch() { var t = Elapsed; return $"{(int)t.TotalMinutes:00}:{t.Seconds:00}.{t.Milliseconds / 10:00}"; }
    void WatchToggle() { if (running) { watchBase = Elapsed; running = false; StopRender(); } else { watchStart = DateTime.UtcNow; running = true; StartRender(); } }
    void WatchReset() { watchBase = TimeSpan.Zero; if (running) watchStart = DateTime.UtcNow; }
    void StartRender() { watchTimer ??= new System.Threading.Timer(_ => InvokeAsync(StateHasChanged), null, 100, 100); }
    void StopRender() { watchTimer?.Dispose(); watchTimer = null; }

    static string Stars(int n) => new string('★', n) + new string('☆', 5 - n);
    void Rate(Track t, int stars)
    {
        Session.SetRating(t, stars); SaveProfile();
        if (t.JellyfinId is { Length: > 0 } id && Session.Jellyfin is { } a) _ = Task.Run(async () => { try { await Jellyfin.SetRatingAsync(a, id, stars); } catch { } });
    }

    string Pct() => Player.Duration > 0 ? Pc(Math.Clamp(Player.Position / Player.Duration, 0, 1)) : "0";
    static string Fmt(double s) => IpodContent.Time(s);

    public async ValueTask DisposeAsync()
    {
        hudCts?.Cancel(); ticker?.Dispose(); watchTimer?.Dispose();
        try { await Js.InvokeVoidAsync("flacie.ipodDispose"); } catch (Exception) { }
        self?.Dispose();
    }
}
