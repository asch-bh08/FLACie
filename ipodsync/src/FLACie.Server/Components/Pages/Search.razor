@page "/search"
@attribute [Authorize]
@implements IDisposable
@inherits UserComponent
@inject ExploreState X
<PageTitle>@(q.Length > 0 ? q + " · " : "")Search · FLACie</PageTitle>
<h1 class="sr-only">Search</h1>
@{
    var r = Lib.Search(q); var jobs = Downloads.JobsOf(Session).Where(j => j.Kind == "Search").ToList();
    // the filter pills (shared with Explore) narrow every section below
    var songs = r.Songs.Where(X.Allows).ToList();
    var albums = r.Albums.Where(g => g.Tracks.Any(X.Allows)).ToList();
    var artists = r.Artists.Where(g => g.Tracks.Any(X.Allows)).ToList();
    var plays = FindPlaylists();
    var genres = FindGenres();
    var topSong = songs.FirstOrDefault();
    // the top result: an artist named exactly like the search, else an album named so, else the best song (accents and punctuation do not count)
    var songIsExact = topSong is not null && Same(topSong.Title, q);
    var topArtist = artists.FirstOrDefault(g => Same(g.Name, q));
    var heroArtist = topArtist is not null && !songIsExact;
    var topAlbum = albums.FirstOrDefault(g => Same(g.Name, q));
    var heroAlbum = !heroArtist && topAlbum is not null && !songIsExact;
}
@if (jobs.Count > 0)
{
    <section class="panel wide" aria-label="Downloads">
        <h2>Downloads</h2>
        @foreach (var j in jobs)
        {
            <div class="job @(j.Stage == DownloadStage.Failed ? "bad" : "")">
                <Cover ArtKey="@(j.ArtKey)" Size="40" />
                <span class="job-text"><b>@j.Label</b><small>@j.Message</small></span>
            </div>
        }
        @if (jobs.Any(x => x.Finished)) { <button class="btn ghost" @onclick="() => Downloads.DismissFinished(Session)">Clear finished</button> }
    </section>
}
@if (q.Trim().Length == 0)
{
    <div class="empty">
        <Icon Name="search" Size="40" />
        <h2>Search your music</h2>
        <p class="hint">Type in the box above. Punctuation doesn't matter: "scream and shout will i am" finds Scream &amp; Shout. Anything you don't have shows up under More music, ready to download.</p>
    </div>
}
else
{
    <ExploreBar Compact="true" Changed="OnFilters" />
    @if (songs.Count > 0 || heroAlbum || heroArtist)
    {
        <div class="sr-wrap"><div class="sr-top">
            <section aria-label="Top result">
                <h2 class="section">Top result</h2>
                @if (heroArtist && topArtist is not null)
                {
                    <div class="sr-hero artist">
                        <a href="/artist/@Uri.EscapeDataString(topArtist.Name)" aria-label="Open artist @topArtist.Name"><Cover ArtKey="@(topArtist.ArtKey)" Size="148" Class="square round" /></a>
                        <div class="sr-hero-text">
                            <a class="sr-hero-title" href="/artist/@Uri.EscapeDataString(topArtist.Name)">@topArtist.Name</a>
                            <span class="sr-hero-sub">Artist</span>
                            <span class="pills"><span class="badge plain">@Count(topArtist) @(Count(topArtist) == 1 ? "song" : "songs")</span></span>
                        </div>
                        <button class="sr-play" aria-label="Play @topArtist.Name" @onclick="() => Player.Play(topArtist.Tracks.Where(X.Allows).ToList(), 0, topArtist.Name)"><Icon Name="play" Size="22" /></button>
                    </div>
                }
                else if (heroAlbum && topAlbum is not null)
                {
                    var ht = topAlbum.Tracks[0]; var hy = topAlbum.Tracks.Max(t => t.Year);
                    <div class="sr-hero">
                        <a href="@AlbumLink(topAlbum)" aria-label="Open album @topAlbum.Name"><Cover ArtKey="@(topAlbum.ArtKey)" Size="148" Class="square" /></a>
                        <div class="sr-hero-text">
                            <a class="sr-hero-title" href="@AlbumLink(topAlbum)">@topAlbum.Name</a>
                            <span class="sr-hero-sub">Album · @(ht.AlbumArtist.Length > 0 ? ht.AlbumArtist : ht.Artist)@(hy > 0 ? " · " + hy : "")</span>
                            <span class="pills"><span class="badge @ht.Source.ToString().ToLowerInvariant()">@SourceLabel.Short(ht.Source)</span><span class="badge plain">@Count(topAlbum) @(Count(topAlbum) == 1 ? "song" : "songs")</span></span>
                        </div>
                        <button class="sr-play" aria-label="Play @topAlbum.Name" @onclick="() => Player.Play(topAlbum.Tracks.Where(X.Allows).ToList(), 0, topAlbum.Name)"><Icon Name="play" Size="22" /></button>
                    </div>
                }
                else if (topSong is not null)
                {
                    var fmt = InfoService.QuickFormat(topSong); var facts = FormatIndex.Current?.Get(topSong);
                    <div class="sr-hero">
                        <button class="sr-cover" aria-label="Play @topSong.Title" @onclick='() => Player.Play([topSong], 0, "Search: " + q)'><Cover ArtKey="@(Art.KeyFor(topSong))" Size="148" Class="square" /></button>
                        <div class="sr-hero-text">
                            <span class="sr-hero-title">@topSong.Title</span>
                            <span class="sr-hero-sub">Song · <a href="/artist/@Uri.EscapeDataString(topSong.AlbumArtist.Length > 0 ? topSong.AlbumArtist : topSong.Artist)">@topSong.Artist</a>@(topSong.Album.Length > 0 ? " · " + topSong.Album : "")</span>
                            <span class="pills">
                                <span class="badge @topSong.Source.ToString().ToLowerInvariant()">@SourceLabel.Short(topSong.Source)</span>
                                @if (fmt.Length > 0) { <span class="badge fmt @(fmt == "HI-RES" ? "hires" : FLACie.Core.MediaInfo.LosslessCodecs.Contains(fmt.ToLowerInvariant()) ? "lossless" : "")">@(fmt == "HI-RES" ? "✦ Hi-Res" : fmt)</span> }
                                @if (facts is { Depth: > 0, Rate: > 0 }) { <span class="badge plain">@facts.Depth-bit / @((facts.Rate / 1000.0).ToString("0.#")) kHz</span> }
                                @if (facts is { Kbps: > 0 }) { <span class="badge plain">@facts.Kbps kbps</span> }
                            </span>
                        </div>
                        <button class="sr-play" aria-label="Play @topSong.Title" @onclick='() => Player.Play([topSong], 0, "Search: " + q)'><Icon Name="play" Size="22" /></button>
                    </div>
                }
            </section>
            <section aria-label="Songs">
                <h2 class="section">Songs</h2>
                <TrackList Tracks="songs.Take(5).ToList()" PlayContext="@("Search: " + q)" Single="true" />
            </section>
        </div></div>
        @if (songs.Count > 5)
        {
            @if (showAllSongs)
            {
                <TrackList Tracks="songs.Skip(5).ToList()" PlayContext="@("Search: " + q)" Single="true" />
                <button class="btn ghost sr-more" @onclick="() => showAllSongs = false">Show fewer songs</button>
            }
            else { <button class="btn ghost sr-more" @onclick="() => showAllSongs = true">Show all @songs.Count songs</button> }
        }
    }
    @if (artists.Count > 0)
    {
        <h2 class="section">Artists</h2>
        <div class="row-scroll">
            @foreach (var a in artists)
            {
                <a class="card artist" href="/artist/@Uri.EscapeDataString(a.Name)"><Cover ArtKey="@(a.ArtKey)" Class="square round" /><span class="card-title">@a.Name</span><span class="card-sub">Artist · @Count(a) @(Count(a) == 1 ? "song" : "songs")</span></a>
            }
        </div>
    }
    @if (albums.Count > 0)
    {
        <h2 class="section">Albums</h2>
        <div class="row-scroll">
            @foreach (var g in albums)
            {
                var gy = g.Tracks.Max(t => t.Year); var ga = g.Tracks[0].AlbumArtist.Length > 0 ? g.Tracks[0].AlbumArtist : g.Tracks[0].Artist;
                <a class="card" href="@AlbumLink(g)"><Cover ArtKey="@(g.ArtKey)" Class="square" /><span class="card-title">@g.Name</span><span class="card-sub">@ga@(gy > 0 ? " · " + gy : "")</span></a>
            }
        </div>
    }
    @if (plays.Count > 0)
    {
        <h2 class="section">Playlists</h2>
        <div class="row-scroll">
            @foreach (var p in plays)
            {
                var art = Session.Resolve(p.Entries.Take(8)).Select(t => t.ArtKey).FirstOrDefault(k => k is not null);
                <a class="card" href="/playlist/@p.Id"><Cover ArtKey="@(art)" Class="square" /><span class="card-title">@p.Name</span><span class="card-sub">Playlist · @p.Entries.Count @(p.Entries.Count == 1 ? "song" : "songs")</span></a>
            }
        </div>
    }
    @if (genres.Count > 0)
    {
        <h2 class="section">Genres</h2>
        <div class="sr-genres">
            @foreach (var gn in genres) { <a class="chip" href="/genre/@Uri.EscapeDataString(gn)">@gn</a> }
        </div>
    }
    @if (songs.Count == 0 && albums.Count == 0 && artists.Count == 0 && plays.Count == 0 && genres.Count == 0 && !webBusy && webSongs.Count == 0 && webAlbums.Count == 0)
    {
        <p class="status">@(X.AnyFilter ? "Nothing in your library matches \"" + q + "\" with these filters." : "Nothing in your library matches \"" + q + "\".")</p>
    }
    @if (webBusy || webSongs.Count > 0 || webAlbums.Count > 0)
    {
        <h2 class="section">More music @(webBusy ? "(searching…)" : "")</h2>
        @if (!Session.Services.Any) { <p class="hint">To download these, set up Soulseek or Lidarr in the <a href="/dashboard#downloads">Dashboard</a> (administrators). Your phone's setup is picked up automatically.</p> }
        @if (webAlbums.Count > 0)
        {
            <div class="row-scroll">
                @foreach (var a in webAlbums)
                {
                    var ja = Downloads.JobFor(Session, a.Artist, a.CleanTitle);
                    <div class="card">
                        <Cover ArtKey="@(a.ArtUrl is null ? null : Art.ExternalKey(a.ArtUrl))" Class="square" />
                        <span class="card-title">@a.CleanTitle</span>
                        <span class="card-sub">@a.Artist · @a.Kind</span>
                        @if (ja is not null) { <span class="track-dl @(ja.Stage == DownloadStage.Failed ? "bad" : ja.Stage == DownloadStage.Done ? "ok" : "")"><i aria-hidden="true"></i>@ja.Message@(ja.Current is { } ca && !ja.Finished ? " · " + OpenSourceSettings.Name(ca) : ja.Source is { } sa ? " · from " + OpenSourceSettings.Name(sa) : "")</span> }
                        <button class="btn" disabled="@(!Session.Services.Any || ja is { Finished: false })" @onclick="() => Downloads.Album(Session, a)"><Icon Name="download" Size="16" />@(ja is { Finished: false } ? "Downloading…" : ja is { Stage: DownloadStage.Failed } ? "Try again" : "Download")</button>
                    </div>
                }
            </div>
        }
        @if (webSongs.Count > 0)
        {
            <ul class="tracks">
                @foreach (var s in webSongs)
                {
                    var jb = Downloads.JobFor(Session, s.Artist, s.Title); var hiKey = FLACie.Core.Matching.MatchKey(s.Title, s.Artist);
                    <li class="track @(hiAsk == hiKey ? "asking" : "")">
                        <span class="track-main">
                            <Cover ArtKey="@(s.ArtUrl is null ? null : Art.ExternalKey(s.ArtUrl))" Size="44" />
                            <span class="track-text"><span class="track-title">@s.Title</span><span class="track-sub">@s.Artist@(s.Album.Length > 0 ? " · " + s.Album : "")</span>@if (jb is not null) { <span class="track-dl @(jb.Stage == DownloadStage.Failed ? "bad" : jb.Stage == DownloadStage.Done ? "ok" : "")"><i aria-hidden="true"></i>@jb.Message@(jb.Current is { } c && !jb.Finished ? " · " + OpenSourceSettings.Name(c) : jb.Source is { } src ? " · from " + OpenSourceSettings.Name(src) : "")</span> }</span>
                        </span>
                        <span class="track-time">@Time(s.DurationMs / 1000.0)</span>
                        <span class="track-actions">
                        <button class="btn" disabled="@(!Session.Services.Any || jb is { Finished: false })" @onclick="() => Downloads.Song(Session, s)"><Icon Name="download" Size="16" />@(jb is { Finished: false } ? "Downloading…" : jb is { Stage: DownloadStage.Failed } ? "Try again" : "Download")</button>
                        <span class="dl-more">
                            <button class="icon-btn" aria-haspopup="menu" aria-expanded="@((dlMenu == hiKey) ? "true" : "false")" aria-label="More download options for @s.Title" @onclick="() => dlMenu = dlMenu == hiKey ? null : hiKey"><Icon Name="lines" Size="20" /></button>
                            @if (dlMenu == hiKey)
                            {
                                <button class="scrim" aria-label="Close" @onclick="() => dlMenu = null"></button>
                                <div class="dl-menu" role="menu">
                                    <button role="menuitem" disabled="@(!Session.Services.Any || jb is { Finished: false })" @onclick="() => { dlMenu = null; Downloads.Song(Session, s); }"><Icon Name="download" Size="16" />Download</button>
                                    @if (isAdmin && Session.Services.SoulseekReady) { <button role="menuitem" class="hi" disabled="@(jb is { Finished: false })" @onclick="() => { dlMenu = null; hiAsk = hiKey; }"><span aria-hidden="true">✦</span> Hi-Res download…</button> }
                                    <a role="menuitem" href="https://www.youtube.com/results?search_query=@Uri.EscapeDataString(s.Artist + " " + s.Title)" target="_blank" rel="noopener" @onclick="() => dlMenu = null">Find on YouTube</a>
                                </div>
                            }
                        </span>
                        </span>
                        @if (isAdmin && hiAsk == hiKey) { <div class="hires-ask track-ask" role="group" aria-label="Download in Hi-Res?"><b>Download "@s.Title" in Hi-Res?</b><span>Hi-Res files are 2 to 5 times bigger (roughly 40 to 200 MB). If no Hi-Res copy exists, you get the normal quality instead. Only this song.</span><span class="hires-actions"><button class="btn hires solid" @onclick="() => { hiAsk = null; Downloads.Song(Session, s, true); }">Download Hi-Res</button><button class="btn ghost" @onclick="() => hiAsk = null">Cancel</button></span></div> }
                    </li>
                }
            </ul>
        }
    }
}
@code {
    [Parameter, SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [Inject] WebCatalog Catalog { get; set; } = default!;
    [Inject] DownloadManager Downloads { get; set; } = default!;
    [Inject] IConfiguration Conf { get; set; } = default!;
    bool isAdmin => AdminAccess.Is(Session, Conf);
    string q = ""; string? hiAsk, dlMenu;
    bool showAllSongs;
    static bool Same(string a, string b) => string.Join(' ', FLACie.Core.Matching.SearchWords(a)) == string.Join(' ', FLACie.Core.Matching.SearchWords(b));
    // how many of a group's songs the filter pills allow
    int Count(Group g) => g.Tracks.Count(X.Allows);
    void OnFilters() { showAllSongs = false; }

    // playlists and genres whose name matches the search (and, with filter pills on, that hold something the filters allow)
    List<FLACie.Core.Playlist> FindPlaylists()
    {
        var words = FLACie.Core.Matching.SearchWords(q);
        if (words.Count == 0) return [];
        return Session.Playlists.Where(p => FLACie.Core.Matching.SearchHit(words, p.Name) && (!X.AnyFilter || Session.Resolve(p.Entries).Any(X.Allows))).Take(12).ToList();
    }
    List<string> FindGenres()
    {
        var words = FLACie.Core.Matching.SearchWords(q);
        if (words.Count == 0) return [];
        return Lib.Songs.Where(t => t.Genre.Trim().Length > 0 && X.Allows(t) && FLACie.Core.Matching.SearchHit(words, t.Genre)).Select(t => t.Genre.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(g => g).Take(12).ToList();
    }
    List<CatalogSong> webSongs = [];
    List<CatalogAlbum> webAlbums = [];
    bool webBusy;
    CancellationTokenSource? pending;
    Action? onJobs;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        onJobs = () => InvokeAsync(StateHasChanged);
        Downloads.Subscribe(Session, onJobs);
    }

    // the query lives in the address (the top search box writes it), so Back, reload and shared links all work
    protected override void OnParametersSet()
    {
        var next = (Q ?? "").Trim();
        if (next == q) return;
        q = next;
        pending?.Cancel();
        webSongs = []; webAlbums = [];
        if (q.Length < 2) { webBusy = false; return; }
        var cts = pending = new CancellationTokenSource();
        webBusy = true;
        _ = SearchWeb(q, cts.Token);
    }

    async Task SearchWeb(string query, CancellationToken ct)
    {
        try
        {
            var songs = await Catalog.SongsAsync(query, 20, ct);
            var albums = await Catalog.AlbumsWithTopAsync(query, songs.FirstOrDefault(), ct);
            // what the library already has isn't offered again
            var have = Lib.Songs.Select(Matching.MatchKey).ToHashSet();
            var haveAlbums = Lib.Albums.Select(a => a.Tracks[0].AlbumKey).ToHashSet();
            webSongs = songs.Where(s => !have.Contains(Matching.MatchKey(s.Title, s.Artist))).ToList();
            webAlbums = albums.Where(a => !haveAlbums.Contains(Matching.PrimaryArtist(a.Artist) + "|" + Matching.AlbumNorm(a.CleanTitle))).ToList();
            webBusy = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
        catch (Exception) { webBusy = false; await InvokeAsync(StateHasChanged); }
    }

    public override void Dispose() { pending?.Cancel(); if (onJobs is not null) Downloads.Unsubscribe(Session, onJobs); base.Dispose(); }
}
