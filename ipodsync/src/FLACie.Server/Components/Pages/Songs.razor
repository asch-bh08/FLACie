@page "/songs"
@attribute [Authorize]
@inherits UserComponent
<PageTitle>Songs · FLACie</PageTitle>
<header class="page-head">
    <h1>All music</h1>
    <p class="sub">@Lib.Songs.Count songs</p>
    <div class="chips"><button class="btn primary" @onclick="() => Player.ShuffleAll(Lib.Songs)" disabled="@(Lib.Songs.Count == 0)"><Icon Name="shuffle" Size="18" />Shuffle all</button></div>
</header>
<MusicTabs Active="Songs" />
<LibraryStatus />
<div class="tracks virtual">
    <Virtualize Items="rows" Context="row" ItemSize="60">
        <div class="track @(Player.Current?.Path == row.T.Path ? "now" : "")">
            <button class="track-main" @onclick='() => Player.Play(Lib.Songs, row.I, "Songs")' aria-label="Play @row.T.Title by @row.T.Artist">
                <Cover ArtKey="@(row.T.ArtKey)" Size="44" />
                <span class="track-text"><span class="track-title">@row.T.Title</span><span class="track-sub">@row.T.Artist@(row.T.Album.Length > 0 ? " · " + row.T.Album : "")</span></span>
            </button>
            <span class="pills">
                <span class="badge @row.T.Source.ToString().ToLowerInvariant()" title="Where this song is played from">@(row.T.Source switch { TrackSource.Nas => "NAS", TrackSource.Cloud => "Download", _ => row.T.Source.ToString() })</span>
                @if (InfoService.QuickFormat(row.T) is { Length: > 0 } fmt) { <span class="badge fmt @(MediaInfo.LosslessCodecs.Contains(fmt.ToLowerInvariant()) ? "lossless" : "")" title="File format">@fmt</span> }
            </span>
            <span class="track-time">@(row.T.DurationMs > 0 ? Time(row.T.DurationMs / 1000.0) : "")</span>
        </div>
    </Virtualize>
</div>
@code {
    record Row(Track T, int I);
    List<Row> rows = [];
    Library? built;
    protected override void OnParametersSet() { if (!ReferenceEquals(built, Lib)) { built = Lib; rows = Lib.Songs.Select((t, i) => new Row(t, i)).ToList(); } }
    protected override bool ShouldRender() { if (!ReferenceEquals(built, Lib)) OnParametersSet(); return true; }
}
