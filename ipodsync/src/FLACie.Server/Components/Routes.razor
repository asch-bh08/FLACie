<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Pages.Ipod).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized><RedirectToLogin /></NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound><NotFoundPanel /></NotFound>
</Router>
