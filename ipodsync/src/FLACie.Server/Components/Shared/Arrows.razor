@* Previous / next buttons for the row under this heading (the row scrolls without a scrollbar). *@
<span class="arrows">
    <button class="icon-btn" type="button" aria-label="Scroll left" onclick="flacie.scrollRow(this,-1)"><Icon Name="chevron-left" Size="20" /></button>
    <button class="icon-btn" type="button" aria-label="Scroll right" onclick="flacie.scrollRow(this,1)"><Icon Name="chevron-right" Size="20" /></button>
</span>
