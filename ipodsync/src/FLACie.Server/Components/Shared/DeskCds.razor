@using FLACie.Core
@inject IJSRuntime Js
@* The iPod desk's CDs: the next album lying open (its booklet, and the disc in the tray: the release's own disc picture when FLACie has one, otherwise a print
   made from the cover), the two after it in a small stack, and a note. A click, or Enter or Space on a focused CD, plays that album. Styles: desk.css. *@
@if (Next.Count > 0)
{
<div class="desk-open lift" data-testid="desk-open-cd" role="button" tabindex="0" aria-label="@($"Play {Next[0].Album} by {Next[0].Artist}")" title="@($"Play {Next[0].Album}")" @onclick="() => Pick(0)" @onkeydown="e => Key(e, 0)">
    <div class="lid"><Cover ArtKey="@Next[0].ArtKey" Class="desk-art" /></div>
    <div class="tray"><div class="disc @(Playing ? "" : "paused")" data-testid="desk-disc" @ref="disc"></div></div>
    <div class="hinge"></div>
</div>
}
<div class="desk-stack" data-testid="desk-stack">
    @for (var i = Math.Min(Next.Count, 3) - 1; i >= 1; i--)
    {
        var k = i;
        <div class="desk-case lift s@(k)" data-testid="desk-case" role="button" tabindex="0" aria-label="@($"Play {Next[k].Album} by {Next[k].Artist}")" title="Play @Next[k].Album" @onclick="() => Pick(k)" @onkeydown="e => Key(e, k)"><Cover ArtKey="@Next[k].ArtKey" Class="desk-art" /></div>
    }
</div>
<div class="desk-note lift" data-testid="desk-note">
    <small>Up next</small><span>@(Next.Count > 0 ? $"{Next[0].Album} · {Next[0].Artist}" : "nothing queued")</span>
</div>

@code {
    [Parameter] public IReadOnlyList<DeskAlbum> Next { get; set; } = [];
    /// <summary>Where FLACie serves the next album's own disc picture (/desk/disc/…), when its release is known; null otherwise.</summary>
    [Parameter] public string? DiscUrl { get; set; }
    [Parameter] public bool Playing { get; set; }
    [Parameter] public EventCallback<DeskAlbum> OnPlay { get; set; }

    ElementReference disc;
    string? discFor;

    Task Pick(int i) => i < Next.Count ? OnPlay.InvokeAsync(Next[i]) : Task.CompletedTask;
    Task Key(KeyboardEventArgs e, int i) => e.Key is "Enter" or " " ? Pick(i) : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        // a new album on top: its disc (the picture, or a print from the cover); desk.js clears the old one at once and drops an answer that comes too late
        var a = Next.Count > 0 ? Next[0] : null;
        var key = a is null ? "" : $"{a.Key}|{DiscUrl}|{a.ArtKey}";
        if (a is null || key == discFor) return;
        discFor = key;
        var cover = a.ArtKey is null ? null : $"/art/{Uri.EscapeDataString(CoverOverrides.Map(a.ArtKey)!)}?v=3";
        try { await Js.InvokeAsync<bool>("desk.discInto", disc, DiscUrl, cover, a.Artist, a.Album); }
        catch (JSDisconnectedException) { } catch (InvalidOperationException) { } catch (JSException) { } catch (OperationCanceledException) { }
    }
}
