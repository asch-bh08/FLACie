@using FLACie.Core
@inject IJSRuntime Js
@* The iPod desk's CDs. The album playing now lies open on the desk (its booklet, and its disc spinning in the tray: the release's own disc picture when
   FLACie has one, otherwise a print made from the cover); a click on it pauses and plays. The albums coming up stand in a clear acrylic stand, seen from
   above: the next one in the front slot, its cover whole; behind it the ones after lean back in the rack, only their top edges showing. A click on one
   plays that album. (What is up next, song by song, is on the queue card: DeskQueue.) Every CD is a button (Tab, Enter, Space). Styles: desk.css. *@
@if (Now is { } now)
{
<div class="desk-open lift" data-testid="desk-open-cd" role="button" tabindex="0" aria-label="@($"Now playing: {now.Album} by {now.Artist}")" title="@(Playing ? "Pause" : "Play")" @onclick="Toggle" @onkeydown="ToggleKey">
    <div class="lid"><Cover ArtKey="@now.ArtKey" Class="desk-art" /></div>
    <div class="tray"><div class="disc @(Playing ? "" : "paused")" data-testid="desk-disc" @ref="disc"></div></div>
    <div class="hinge"></div>
</div>
}
<div class="desk-stand lift" data-testid="desk-stand">
    <i class="slab" aria-hidden="true"></i>
    <div class="rack">
        @for (var i = Math.Min(Next.Count, 4) - 1; i >= 1; i--)
        {
            var k = i; var a = Next[k];
            <div class="edge" data-testid="desk-case" style="--i:@(k - 1)" role="button" tabindex="0" aria-label="@($"Play {a.Album} by {a.Artist}")" title="Play @a.Album" @onclick="() => Pick(k)" @onkeydown="e => Key(e, k)">
                <Cover ArtKey="@a.ArtKey" Class="desk-art" /><span class="spine">@a.Album · @a.Artist</span>
            </div>
        }
    </div>
    @if (Next.Count > 0)
    {
        var a0 = Next[0];
        <div class="front" data-testid="desk-case" data-front role="button" tabindex="0" aria-label="@($"Play {a0.Album} by {a0.Artist}")" title="Up next: @a0.Album" @onclick="() => Pick(0)" @onkeydown="e => Key(e, 0)">
            <Cover ArtKey="@a0.ArtKey" Class="desk-art" /><i class="hinge" aria-hidden="true"></i><i class="glare" aria-hidden="true"></i>
        </div>
    }
    else { <div class="front empty" aria-hidden="true"></div> }
    <i class="lip" aria-hidden="true"></i>
</div>

@code {
    /// <summary>The album playing now (the open CD); null when nothing plays.</summary>
    [Parameter] public DeskAlbum? Now { get; set; }
    /// <summary>The albums after it, in play order (the stand: the first in front).</summary>
    [Parameter] public IReadOnlyList<DeskAlbum> Next { get; set; } = [];
    /// <summary>Where FLACie serves the playing album's own disc picture (/desk/disc/…), when its release is known; null otherwise.</summary>
    [Parameter] public string? DiscUrl { get; set; }
    [Parameter] public bool Playing { get; set; }
    [Parameter] public EventCallback<DeskAlbum> OnPlay { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    ElementReference disc;
    string? discFor;

    Task Pick(int i) => i < Next.Count ? OnPlay.InvokeAsync(Next[i]) : Task.CompletedTask;
    Task Key(KeyboardEventArgs e, int i) => e.Key is "Enter" or " " ? Pick(i) : Task.CompletedTask;
    Task Toggle() => OnToggle.InvokeAsync();
    Task ToggleKey(KeyboardEventArgs e) => e.Key is "Enter" or " " ? Toggle() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        // another album playing: its disc (the picture, or a print from the cover); desk.js clears the old one at once and drops an answer that comes too late
        var a = Now;
        var key = a is null ? "" : $"{a.Key}|{DiscUrl}|{a.ArtKey}";
        if (a is null || key == discFor) return;
        discFor = key;
        var cover = a.ArtKey is null ? null : $"/art/{Uri.EscapeDataString(CoverOverrides.Map(a.ArtKey)!)}?v=3";
        try { await Js.InvokeAsync<bool>("desk.discInto", disc, DiscUrl, cover, a.Artist, a.Album); }
        catch (JSDisconnectedException) { } catch (InvalidOperationException) { } catch (JSException) { } catch (OperationCanceledException) { }
    }
}
