@* The iPod desk: a wall, a wooden desk (or a felt mat), a monitor behind the iPod showing the music, a studio speaker either side, the iPod itself (ChildContent, unchanged)
   and a shelf in front (Shelf). Pure layout: it owns no player state. Styles: desk.css. *@
<div class="desk @(Surface == 1 ? "desk-matte" : "desk-wood") @(Dark ? "desk-dark" : "")" data-testid="desk">
    <div class="desk-wall" aria-hidden="true"></div>
    <div class="desk-top" aria-hidden="true"><i class="desk-edge"></i></div>
    <BackgroundVisualizerCanvas Style="@VizStyle" Title="@Title" />
    @Speaker("l")
    @Speaker("r")
    <div class="desk-ipod">
        <div class="desk-contact" aria-hidden="true"></div>
        @ChildContent
    </div>
    @if (Shelf is not null) { <div class="desk-front">@Shelf</div> }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The shelf (a MediaShelf), drawn in the front band of the desk.</summary>
    [Parameter] public RenderFragment? Shelf { get; set; }
    /// <summary>0 wood, 1 felt mat.</summary>
    [Parameter] public int Surface { get; set; }
    /// <summary>bars, wave or particles.</summary>
    [Parameter] public string VizStyle { get; set; } = "bars";
    /// <summary>The playing song's title (the monitor's idle picture shows it).</summary>
    [Parameter] public string Title { get; set; } = "";
    /// <summary>Evening light: a darker wall and a warm lamp (follows the iPod colour's dark flag).</summary>
    [Parameter] public bool Dark { get; set; }

    static RenderFragment Speaker(string side) => @<div class="desk-spk desk-spk-@side" data-testid="desk-speaker" aria-hidden="true">
        <div class="cab">
            <i class="tweeter"></i>
            <i class="woofer"><b></b></i>
            <i class="port"></i>
        </div>
    </div>;
}
