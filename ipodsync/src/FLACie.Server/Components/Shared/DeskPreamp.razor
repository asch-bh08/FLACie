@implements IDisposable
@inject IJSRuntime Js
@inject PlayerState Player
@* The iPod desk's preamp: a small brushed-metal box with the VU meter (its needle: desk.js, from the one analyser read) and three knobs. VOLUME is the player's
   volume; BASS and TREBLE shape the music itself (flacie.js tone(): two shelves, kept for next time). A knob turns with the wheel, the arrow keys, or a drag
   up and down (retro.js turns a drag into arrow keys). Styles: desk.css. *@
<div class="desk-vu desk-preamp lift" data-testid="desk-preamp">
  <div class="vu-face" aria-hidden="true">
    <svg class="vu-scale" viewBox="0 0 100 60">
      <path d="M 12 46 A 46 46 0 0 1 88 46" fill="none" stroke="#3a2a1a" stroke-width=".7"/>
      <path d="M 70.6 22.6 A 46 46 0 0 1 88 46" fill="none" stroke="#c0392b" stroke-width="2.2"/>
      @foreach (var (deg, label) in VuTicks)
      {
        var r = deg * Math.PI / 180;
        <line x1="@F(50 + Math.Sin(r) * 41)" y1="@F(60 - Math.Cos(r) * 41)" x2="@F(50 + Math.Sin(r) * 46)" y2="@F(60 - Math.Cos(r) * 46)" stroke="@(deg >= 22 ? "#c0392b" : "#3a2a1a")" stroke-width=".8"/>
        @((MarkupString)$"<text x=\"{F(50 + Math.Sin(r) * 35)}\" y=\"{F(60 - Math.Cos(r) * 35 + 2)}\" text-anchor=\"middle\" font-size=\"5.2\" fill=\"{(deg >= 22 ? "#c0392b" : "#3a2a1a")}\">{label}</text>")
      }
      <text x="50" y="44" text-anchor="middle" font-size="8" font-weight="700" fill="#3a2a1a">VU</text>
    </svg>
    <i class="needle" data-needle></i><i class="pivot"></i><i class="glass"></i>
  </div>
  <div class="pre-knobs">
    <div class="pre-knob big">
      <button type="button" class="knob" data-knob="vol" data-wheel role="slider" aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@VolPct"
              style="--r:@F(-135 + 270 * Player.Volume)deg" @onkeydown="VolKey" @onwheel="VolWheel"><i></i></button>
      <small>VOLUME</small>
    </div>
    <div class="pre-knob">
      <button type="button" class="knob" data-knob="bass" data-wheel role="slider" aria-label="Bass" aria-valuemin="-12" aria-valuemax="12" aria-valuenow="@low" aria-valuetext="@Db(low)"
              style="--r:@F(low * 11.25)deg" @onkeydown="e => ToneKey(e, true)" @onwheel="e => ToneWheel(e, true)"><i></i></button>
      <small>BASS</small>
    </div>
    <div class="pre-knob">
      <button type="button" class="knob" data-knob="treble" data-wheel role="slider" aria-label="Treble" aria-valuemin="-12" aria-valuemax="12" aria-valuenow="@high" aria-valuetext="@Db(high)"
              style="--r:@F(high * 11.25)deg" @onkeydown="e => ToneKey(e, false)" @onwheel="e => ToneWheel(e, false)"><i></i></button>
      <small>TREBLE</small>
    </div>
  </div>
  <span class="pre-brand" aria-hidden="true">FLACIE · PRE-1</span>
</div>

@code {
    // the VU meter's scale: degrees from upright, and the marks
    static readonly (double Deg, string Label)[] VuTicks = [(-42, "20"), (-27, "10"), (-17, "7"), (-8, "5"), (2, "3"), (13, "1"), (22, "0"), (31, "1"), (42, "3")];
    static string F(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    static string Db(int v) => v == 0 ? "flat" : $"{(v > 0 ? "+" : "")}{v} dB";
    int VolPct => (int)Math.Round(Player.Volume * 100);
    int low, high;

    protected override void OnInitialized() => Player.Changed += Refresh;
    void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Player.Changed -= Refresh;

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (!first) return;
        try { var t = await Js.InvokeAsync<int[]>("flacie.toneGet"); if (t is [var l, var h]) { low = l; high = h; StateHasChanged(); } } catch (Exception e) when (Gone(e)) { }
    }
    static bool Gone(Exception e) => e is JSDisconnectedException or JSException or InvalidOperationException or OperationCanceledException or TaskCanceledException;

    Task Vol(double v) => Player.SetVolumeAsync(Math.Clamp(Math.Round(v * 20) / 20, 0, 1));
    Task VolKey(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowUp" or "ArrowRight" => Vol(Player.Volume + .05), "ArrowDown" or "ArrowLeft" => Vol(Player.Volume - .05),
        "Home" => Vol(0), "End" => Vol(1), _ => Task.CompletedTask,
    };
    Task VolWheel(WheelEventArgs e) => Vol(Player.Volume + (e.DeltaY < 0 ? .05 : -.05));

    async Task Tone(bool bass, int v)
    {
        v = Math.Clamp(v, -12, 12);
        if (bass) low = v; else high = v;
        try { var t = await Js.InvokeAsync<int[]>("flacie.tone", low, high); if (t is [var l, var h]) { low = l; high = h; } } catch (Exception e) when (Gone(e)) { }
    }
    Task ToneKey(KeyboardEventArgs e, bool bass)
    {
        var v = bass ? low : high;
        return e.Key switch
        {
            "ArrowUp" or "ArrowRight" => Tone(bass, v + 1), "ArrowDown" or "ArrowLeft" => Tone(bass, v - 1),
            "Home" or "0" => Tone(bass, 0), _ => Task.CompletedTask,
        };
    }
    Task ToneWheel(WheelEventArgs e, bool bass) => Tone(bass, (bass ? low : high) + (e.DeltaY < 0 ? 1 : -1));
}
