@* The iPod desk's tapes (iPod panel › Desk): a cassette and a small stack of MiniDiscs, each one of your playlists, its name handwritten on the label;
   a click (or Enter or Space) plays it. The newest playlist is the cassette, whose reels turn while music plays; the next ones are the MiniDiscs.
   With no playlists the cassette is a blank mixtape. Styles: desk.css. *@
@if (Cassette)
{
    var tape = Playlists.Count > 0 ? Playlists[0] : null;
    <div class="desk-cassette lift" data-testid="desk-cassette" role="button" tabindex="0" aria-disabled="@(tape is null ? "true" : null)"
         aria-label="@(tape is null ? "A blank mixtape" : $"Play {tape.Name}")" title="@(tape is null ? "Make a playlist to fill this tape" : $"Play {tape.Name}")"
         @onclick="() => Pick(tape)" @onkeydown="e => Key(e, tape)">
        <div class="shell">
            <div class="label"><span class="desk-hand">@(tape?.Name ?? "mixtape")</span><small>@(tape is null ? "side A" : $"side A · {tape.Count} {(tape.Count == 1 ? "song" : "songs")}")</small></div>
            <div class="window"><i class="reel @(Playing ? "" : "paused")"></i><i class="tape"></i><i class="reel @(Playing ? "" : "paused")"></i></div>
            <i class="screw"></i><i class="screw"></i><i class="screw"></i><i class="screw"></i>
        </div>
    </div>
}
@if (Minidiscs)
{
    var discs = Playlists.Skip(1).Take(3).ToList();
    <div class="desk-minidiscs" data-testid="desk-minidiscs">
        @for (var i = Math.Max(discs.Count, 2) - 1; i >= 0; i--)
        {
            var d = i < discs.Count ? discs[i] : null;
            <div class="md lift @(i % 2 == 0 ? "blue" : "smoke")" data-md style="--i:@i" role="button" tabindex="0" aria-disabled="@(d is null ? "true" : null)" aria-label="@(d is null ? "A blank MiniDisc" : $"Play {d.Name}")"
                 @onclick="() => Pick(d)" @onkeydown="e => Key(e, d)"><i class="shutter"></i><span class="desk-hand">@(d?.Name ?? "")</span></div>
        }
    </div>
}

@code {
    /// <summary>One of your playlists as the desk shows it: newest first, only playlists with songs in this library.</summary>
    public sealed record Tape(string Id, string Name, int Count);

    [Parameter] public IReadOnlyList<Tape> Playlists { get; set; } = [];
    [Parameter] public bool Cassette { get; set; }
    [Parameter] public bool Minidiscs { get; set; }
    [Parameter] public bool Playing { get; set; }
    [Parameter] public EventCallback<Tape> OnPlay { get; set; }

    Task Pick(Tape? t) => t is null ? Task.CompletedTask : OnPlay.InvokeAsync(t);
    Task Key(KeyboardEventArgs e, Tape? t) => e.Key is "Enter" or " " ? Pick(t) : Task.CompletedTask;
}
