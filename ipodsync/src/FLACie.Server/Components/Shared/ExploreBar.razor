@inherits UserComponent
@inject ExploreState X
@* The filters over Explore's lists, kept to one quiet row: the search box, Sort, and a Filters button with how many are on. What is on shows as removable
   pills under the row. Genre, decade and quality are the main filters; bit rate, bit depth, sample rate and codec live in an "Audio specs" drawer. *@
<div class="x-bar @(Compact ? "compact" : "")">
    <div class="x-top">
        @if (!Compact)
        {
        <label class="x-search"><Icon Name="search" Size="20" /><input type="search" placeholder="@Placeholder" aria-label="Search this list" value="@X.Query" autocomplete="off" spellcheck="false" @oninput="e => Set(() => X.Query = e.Value?.ToString() ?? string.Empty)" />
            @if (X.Query.Length > 0) { <button type="button" class="x-clear" aria-label="Clear search" @onclick="() => Set(() => X.Query = string.Empty)"><Icon Name="x" Size="16" /></button> }
        </label>
        <Dropdown Class="x-sort" Label="Sort" ShowAny="false" Options="sortOptions" Value="@X.Sort" ValueChanged="v => Set(() => X.Sort = v)" />
        }
        <button type="button" class="x-ftoggle @(open || ActiveCount > 0 ? "on" : "")" aria-expanded="@(open ? "true" : "false")" aria-controls="x-panel" @onclick="() => open = !open">
            <Icon Name="lines" Size="18" /><span>Filters@(ActiveCount > 0 ? $" ({ActiveCount} active)" : "")</span><Icon Name="@(open ? "chevron-up" : "chevron-down")" Size="16" />
        </button>
    </div>
    @if (!Compact && X.Query.Trim().Length > 0 && X.Fuzzy)
    {
        <p class="x-hint" role="status">
            @if (X.TextHits == 0) { <span>Nothing matches “@X.Query.Trim()”, not even closely. Try fewer letters, or clear a filter.</span> }
            else
            {
                <span>No exact match for “@X.Query.Trim()”@(X.Suggestion.Length > 0 ? "." : ", so these are the closest.")&nbsp;</span>
                @if (X.Suggestion.Length > 0) { <button type="button" class="x-did" @onclick="() => Set(() => X.Query = X.Suggestion)">Did you mean <b>@X.Suggestion</b>?</button><span>&nbsp;Showing close matches.</span> }
            }
        </p>
    }
    @if (chips.Count > 0)
    {
        <div class="x-chips" role="group" aria-label="Active filters">
            @foreach (var c in chips)
            {
                var remove = c.Remove;
                <button type="button" class="x-chip" aria-label="Remove filter @c.Text" @onclick="() => Set(remove)"><span>@c.Text</span><Icon Name="x" Size="13" /></button>
            }
            @if (chips.Count > 1) { <button type="button" class="x-reset" @onclick="() => Set(X.Clear)">Clear all</button> }
        </div>
    }
    @if (open)
    {
        <div class="x-panel" id="x-panel">
            <div class="x-row">
                <Dropdown Label="Genre" Options="genreOptions" Value="@X.Genre" ValueChanged="v => Set(() => X.Genre = v)" />
                <Dropdown Label="Decade" Options="decadeOptions" Value="@X.Decade" ValueChanged="v => Set(() => X.Decade = v)" />
                <Dropdown Label="Quality" Options="qualityOptions" Value="@X.Format" ValueChanged="v => Set(() => X.Format = v)" />
                <button type="button" class="x-specs-toggle @(specs || SpecCount > 0 ? "on" : "")" aria-expanded="@(specs ? "true" : "false")" aria-controls="x-specs" @onclick="() => specs = !specs">
                    <span>Audio specs@(SpecCount > 0 ? $" ({SpecCount})" : "")</span><Icon Name="@(specs ? "chevron-up" : "chevron-down")" Size="16" />
                </button>
            </div>
            @if (specs)
            {
                <div class="x-row x-specs" id="x-specs">
                    <Dropdown Label="Codec" Options="ExploreState.CodecChoices" Value="@X.Codec" ValueChanged="v => Set(() => X.Codec = v)" />
                    <Dropdown Label="Bit rate" Options="kbpsOptions" Value="@X.Kbps" ValueChanged="v => Set(() => X.Kbps = v)" />
                    <Dropdown Label="Bit depth" Options="depthOptions" Value="@X.Depth" ValueChanged="v => Set(() => X.Depth = v)" />
                    <Dropdown Label="Sample rate" Options="rateOptions" Value="@X.Rate" ValueChanged="v => Set(() => X.Rate = v)" />
                </div>
            }
            @if (SpecCount + (X.Format.Length > 0 ? 1 : 0) > 0 && Probe.Pending > 0) { <small class="x-note" role="status">Still reading the real format of @Probe.Pending.ToString("N0") songs, so some may not show yet.</small> }
        </div>
    }
</div>
@if (!Compact)
{
<nav class="az-rail" aria-label="First letter">
    <button class="@(X.Letter.Length == 0 ? "on" : "")" aria-pressed="@((X.Letter.Length == 0) ? "true" : "false")" title="All songs" @onclick="() => Set(() => X.Letter = string.Empty)">All</button>
    @foreach (var l in letters)
    {
        var c = l;
        <button class="@(X.Letter == c ? "on" : "")" aria-pressed="@((X.Letter == c) ? "true" : "false")" @onclick="() => Set(() => X.Letter = X.Letter == c ? string.Empty : c)">@c</button>
    }
</nav>
}
@code {
    [Parameter] public string Tab { get; set; } = "Songs";
    /// <summary>Search results use only the Filters button, the pills and the drawer (the text is the box at the top of the page; no sort, no A to Z).</summary>
    [Parameter] public bool Compact { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Inject] FormatProbeService Probe { get; set; } = default!;
    static readonly string[] letters = ["#", .. "ABCDEFGHIJKLMNOPQRSTUVWXYZ".Select(c => c.ToString())];
    (List<string> Genres, List<string> Decades) choices = ([], []);
    Library? built;
    bool open, specs;

    record Chip(string Text, Action Remove);

    static readonly DropOption[] qualityOptions = [new("lossless", "Lossless (FLAC, ALAC…)"), new("lossy", "Lossy (MP3, AAC…)"), new("hires", "✦ Hi-Res")];
    static readonly DropOption[] kbpsOptions = ExploreState.KbpsChoices;
    static readonly DropOption[] depthOptions = ExploreState.DepthChoices.Select(c => new DropOption(c.Item1, c.Item2)).ToArray();
    static readonly DropOption[] rateOptions = ExploreState.RateChoices.Select(c => new DropOption(c.Item1, c.Item2)).ToArray();
    DropOption[] genreOptions = [], decadeOptions = [];

    int SpecCount => new[] { X.Codec, X.Kbps, X.Depth, X.Rate }.Count(v => v.Length > 0);
    int ActiveCount => SpecCount + new[] { X.Genre, X.Decade, X.Format }.Count(v => v.Length > 0);

    List<Chip> chips
    {
        get
        {
            var l = new List<Chip>();
            if (X.Letter.Length > 0) l.Add(new("Starts with " + X.Letter, () => X.Letter = ""));
            if (X.Genre.Length > 0) l.Add(new(X.Genre, () => X.Genre = ""));
            if (X.Decade.Length > 0) l.Add(new(X.Decade, () => X.Decade = ""));
            if (X.Format.Length > 0) l.Add(new(qualityOptions.FirstOrDefault(o => o.Value == X.Format)?.Text ?? X.Format, () => X.Format = ""));
            if (X.Codec.Length > 0) l.Add(new(ExploreState.CodecChoices.FirstOrDefault(o => o.Value == X.Codec)?.Text ?? X.Codec, () => X.Codec = ""));
            if (X.Kbps.Length > 0) l.Add(new(kbpsOptions.FirstOrDefault(o => o.Value == X.Kbps)?.Text ?? X.Kbps, () => X.Kbps = ""));
            if (X.Depth.Length > 0) l.Add(new(depthOptions.FirstOrDefault(o => o.Value == X.Depth)?.Text ?? X.Depth, () => X.Depth = ""));
            if (X.Rate.Length > 0) l.Add(new(rateOptions.FirstOrDefault(o => o.Value == X.Rate)?.Text ?? X.Rate, () => X.Rate = ""));
            return l;
        }
    }

    string Placeholder => Tab switch { "Songs" => "Search songs by title, artist or album", "Albums" => "Search albums by name or artist", "Artists" => "Search artists", _ => "Search genres" };

    DropOption[] sortOptions => SortList.Select(o => new DropOption(o.Item1, o.Item2)).ToArray();
    (string, string)[] SortList => Tab switch
    {
        "Songs" => [("az", "Title A–Z"), ("za", "Title Z–A"), ("artist", "Artist"), ("new", "Recently added"), ("year", "Newest year"), ("oldest", "Oldest year"), ("long", "Longest")],
        "Albums" => [("az", "Name A–Z"), ("za", "Name Z–A"), ("artist", "Artist"), ("new", "Recently added"), ("year", "Newest year"), ("oldest", "Oldest year"), ("long", "Most songs")],
        "Artists" => [("az", "Name A–Z"), ("za", "Name Z–A"), ("long", "Most songs")],
        _ => [("az", "Name A–Z"), ("za", "Name Z–A"), ("long", "Most songs")],
    };

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(built, Lib))
        {
            built = Lib; choices = ExploreState.Choices(Lib);
            genreOptions = choices.Genres.Select(g => new DropOption(g, g)).ToArray();
            decadeOptions = choices.Decades.Select(d => new DropOption(d, d)).ToArray();
        }
        // a sort that this tab doesn't have falls back to A–Z
        if (!SortList.Any(o => o.Item1 == X.Sort)) X.Sort = "az";
    }
    protected override bool ShouldRender() { OnParametersSet(); return true; }

    async Task Set(Action change) { change(); X.Touch(); await Changed.InvokeAsync(); }
}
