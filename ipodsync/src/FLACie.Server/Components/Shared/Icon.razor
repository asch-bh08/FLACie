@* One icon set for the whole app (24x24, drawn with strokes), so nothing depends on emoji or font symbols. *@
<svg class="ic" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true" focusable="false"
     fill="@(Filled ? "currentColor" : "none")" stroke="@(Filled ? "none" : "currentColor")" stroke-width="@Weight" stroke-linecap="round" stroke-linejoin="round">@((MarkupString)Paths)</svg>
