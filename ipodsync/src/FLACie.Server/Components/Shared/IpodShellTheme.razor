@* The iPod desk's shell finish (in the iPod panel): the model's own colour, clear acrylic, or anodised metal over the model's colour. Styles: desk.css (.finish-*). *@
<div class="dock-seg" role="radiogroup" aria-label="Shell finish">
    @for (var i = 0; i < Names.Length; i++)
    {
        var f = i;
        <button type="button" class="ipod-chip @(f == Finish ? "on" : "")" data-finish="@Keys[f]" role="radio" aria-checked="@(f == Finish ? "true" : "false")" tabindex="-1" @onclick="() => FinishChanged.InvokeAsync(f)">@Names[f]</button>
    }
</div>

@code {
    /// <summary>0 the model's colour, 1 clear acrylic, 2 anodised.</summary>
    [Parameter] public int Finish { get; set; }
    [Parameter] public EventCallback<int> FinishChanged { get; set; }

    /// <summary>The CSS class each finish puts on the iPod (finish-model changes nothing).</summary>
    public static readonly string[] Keys = ["model", "acrylic", "anodised"];
    static readonly string[] Names = ["Colour", "Acrylic", "Anodised"];
}
