@* Explore: the library cut four ways, plus the charts. *@
<div class="mood-chips" role="tablist" aria-label="Explore">
    @foreach (var (name, href) in tabs)
    {
        <a class="mood @(Active == name ? "on" : "")" role="tab" aria-selected="@((Active == name) ? "true" : "false")" href="@href">@name</a>
    }
</div>
@code {
    [Parameter, EditorRequired] public string Active { get; set; } = "Songs";
    static readonly (string, string)[] tabs = [("Overview", "/explore"), ("Songs", "/songs"), ("Albums", "/albums"), ("Artists", "/artists"), ("Genres", "/genres"), ("Charts", "/charts")];
}
