@inherits UserComponent
@implements IDisposable
@* Full-screen player: the cover, the controls, and beside it the queue, the synced lyrics or the file's real format. *@
@{ var t = Player.Current; }
<div class="np @(panelOpen ? "sheet" : "")" role="dialog" aria-modal="true" aria-label="Now Playing">
    @if (t is not null && Art.KeyFor(t) is { } art) { <img class="np-backdrop" src="/art/@Uri.EscapeDataString(art)?v=2" alt="" /> }
    <div class="np-shade"></div>
    <header class="np-top">
        <button class="icon-btn" @onclick="Back" aria-label="Close Now Playing"><Icon Name="chevron-down" Size="24" /></button>
        <span class="np-where">Playing from @(t is null ? "" : SourceName(t))</span>
        <a class="icon-btn np-set" href="/settings" aria-label="Settings"><Icon Name="settings" Size="22" /></a><span class="np-spacer"></span>
    </header>
    @if (t is not null)
    {
        <div class="np-body">
            <section class="np-main">
                <button class="np-cover-btn" @onclick="Player.Toggle" aria-label="@(Player.Playing ? "Pause" : "Play")">
                    <Cover ArtKey="@(Art.KeyFor(t))" Class="np-cover" />
                    <span class="np-cover-state" aria-hidden="true"><Icon Name="@(Player.Playing ? "pause" : "play")" Size="56" /></span>
                </button>
                <div class="np-meta">
                    <div class="np-titles">
                        <h2>@t.Title</h2>
                        <p class="np-artist"><a href="/artist/@Uri.EscapeDataString(t.AlbumArtist.Length > 0 ? t.AlbumArtist : t.Artist)" @onclick="OnClose">@t.Artist</a>@(AlbumOf(t).Length > 0 ? " · " + AlbumOf(t) : "")</p>
                        <div class="pills">
                            <span class="badge @t.Source.ToString().ToLowerInvariant()">@SourceName(t)</span>
                            @if (info is not null && info.Format.Length > 0) { <span class="badge fmt @(info.HiRes ? "hires" : info.Lossless ? "lossless" : "")">@(info.HiRes ? "✦ Hi-Res" : info.Format)</span> }
                            @if (info is not null && info.Sampling.Length > 0) { <span class="badge plain">@info.Sampling</span> }
                            @if (info is not null && info.BitrateKbps > 0) { <span class="badge plain">@info.BitrateKbps kbps</span> }
                        </div>
                    </div>
                    <button class="icon-btn lg @(Session.IsFavorite(t) ? "on" : "")" @onclick="() => { Session.ToggleFavorite(t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" Size="24" /></button>
                </div>
                <div class="seek big">
                    <span>@Time(Player.Position)</span>
                    <input type="range" min="0" max="@Math.Max(1, Player.Duration)" step="1" value="@Player.Position" aria-label="Seek" style="--fill:@(Player.Duration > 0 ? Math.Clamp(Player.Position / Player.Duration * 100, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "0")%" @onchange="OnSeek" />
                    <span>@Time(Player.Duration)</span>
                </div>
                <div class="np-controls">
                    <button class="icon-btn lg @(Player.Shuffle ? "on" : "")" @onclick="Player.ToggleShuffle" aria-label="Shuffle @(Player.Shuffle ? "on" : "off")" aria-pressed="@Player.Shuffle"><Icon Name="shuffle" Size="22" /></button>
                    <button class="icon-btn lg" @onclick="Player.Prev" aria-label="Previous"><Icon Name="prev" Size="28" /></button>
                    <button class="play big" @onclick="Player.Toggle" aria-label="@(Player.Playing ? "Pause" : "Play")"><Icon Name="@(Player.Playing ? "pause" : "play")" Size="30" /></button>
                    <button class="icon-btn lg" @onclick="Player.Next" aria-label="Next"><Icon Name="next" Size="28" /></button>
                    <button class="icon-btn lg @(Player.Repeat > 0 ? "on" : "")" @onclick="Player.CycleRepeat" aria-label="@(Player.Repeat switch { 1 => "Repeat all", 2 => "Repeat one", _ => "Repeat off" })"><Icon Name="@(Player.Repeat == 2 ? "repeat-one" : "repeat")" Size="22" /></button>
                </div>
                <div class="np-volume"><VolumeControl /></div>
            </section>
            <section class="np-side">
                <div class="np-tabs" role="tablist">
                    <button role="tab" aria-selected="@(tab == "queue")" class="@(tab == "queue" ? "on" : "")" @onclick='() => Open("queue")'><Icon Name="queue" Size="18" />Up next</button>
                    <button role="tab" aria-selected="@(tab == "lyrics")" class="@(tab == "lyrics" ? "on" : "")" @onclick='() => Open("lyrics")'><Icon Name="lyrics" Size="18" />Lyrics</button>
                    <button role="tab" aria-selected="@(tab == "info")" class="@(tab == "info" ? "on" : "")" @onclick='() => Open("info")'><Icon Name="info" Size="18" />Info</button>
                </div>
                <div class="np-panel" role="tabpanel">
                    <div class="sheet-head"><button class="sheet-song" @onclick="() => panelOpen = false" aria-label="Back to the cover"><Cover ArtKey="@(Art.KeyFor(t))" Size="44" /><span><b>@t.Title</b><small>@t.Artist · @TabTitle</small></span></button><button class="icon-btn" @onclick="() => panelOpen = false" aria-label="Back to the cover"><Icon Name="chevron-down" Size="24" /></button></div>
                    @if (tab == "queue")
                    {
                        <div class="q-head">
                            <div><small>Playing from</small><b>@(Player.Context ?? "Your queue")</b></div>
                        </div>
                        <label class="switch-row">
                            <span><b>Autoplay</b><small>Add similar songs to the end of the queue</small></span>
                            <input type="checkbox" role="switch" checked="@Player.Autoplay" @onchange="e => Player.SetAutoplayAsync((bool)(e.Value ?? false))" />
                            <i class="switch" aria-hidden="true"></i>
                        </label>
                        <ol class="upnext">
                            <li class="now"><div class="q-row"><Cover ArtKey="@(Art.KeyFor(t))" Size="44" /><span><b>@t.Title</b><small>@t.Artist</small></span><em class="eq @(Player.Playing ? "on" : "")" aria-label="Now playing"><i></i><i></i><i></i></em></div></li>
                            @{ var shownAuto = false; }
                            @foreach (var (i, u) in Player.UpNext(30))
                            {
                                @if (!shownAuto && Player.AutoplayFrom >= 0 && i >= Player.AutoplayFrom)
                                {
                                    shownAuto = true;
                                    <li class="q-divider">Autoplay · similar to what you were playing</li>
                                }
                                <li><button class="q-row" @onclick="() => Player.SkipTo(i)"><Cover ArtKey="@(Art.KeyFor(u))" Size="44" /><span><b>@u.Title</b><small>@u.Artist</small></span><span class="q-time">@Time(u.DurationMs / 1000.0)</span></button></li>
                            }
                            @if (!Player.UpNext(1).Any() && Player.Autoplay && Player.AutoplayNext.Count > 0)
                            {
                                <li class="q-divider">Autoplay · up next after this</li>
                                @foreach (var u in Player.AutoplayNext)
                                {
                                    <li><button class="q-row" @onclick="() => Player.Play([u], 0, Player.Context)"><Cover ArtKey="@(Art.KeyFor(u))" Size="44" /><span><b>@u.Title</b><small>@u.Artist</small></span><span class="q-time">@Time(u.DurationMs / 1000.0)</span></button></li>
                                }
                            }
                        </ol>
                        @if (!Player.UpNext(1).Any() && (!Player.Autoplay || Player.AutoplayNext.Count == 0)) { <p class="hint">Nothing after this song. Turn Autoplay on to keep the music going.</p> }
                    }
                    else if (tab == "lyrics")
                    {
                        @if (lyricsLoading) { <p class="hint">Looking for lyrics…</p> }
                        else if (lyrics is null) { <p class="hint">No lyrics found for this song.</p> }
                        else
                        {
                            <ol class="lyrics @(lyrics.Synced ? "synced" : "")" id="lyrics">
                                @for (var i = 0; i < lyrics.Lines.Count; i++)
                                {
                                    var line = lyrics.Lines[i];
                                    <li>
                                        @if (lyrics.Synced) { <button @onclick="() => Player.Seek(line.TimeMs / 1000.0)">@(line.Text.Length == 0 ? " " : line.Text)</button> }
                                        else { <span>@(line.Text.Length == 0 ? " " : line.Text)</span> }
                                    </li>
                                }
                            </ol>
                            <p class="hint src">Lyrics from @lyrics.Source</p>
                        }
                    }
                    else
                    {
                        <TrackInfoPanel Track="t" Info="info" Loading="infoLoading" Album="@(realAlbumFor == t.Path ? realAlbum : null)" />
                    }
                </div>
            </section>
        </div>
    }
</div>
@code {
    [Parameter] public EventCallback OnClose { get; set; }
    [Inject] LyricsService LyricsSvc { get; set; } = default!;
    [Inject] InfoService Infos { get; set; } = default!;
    [Inject] IJSRuntime Js { get; set; } = default!;
    [Inject] IHttpClientFactory Http { get; set; } = default!;
    string? realAlbum, realAlbumFor;
    string AlbumOf(Track t) => realAlbumFor == t.Path && realAlbum is { Length: > 0 } a ? a : t.Album;
    DotNetObjectReference<NowPlaying>? self;
    string tab = "queue"; string? shownTab = "queue";
    [JSInvokable] public Task Closed() => OnClose.InvokeAsync();
    // on a phone the first Back closes an open sheet (back to the cover), the next one closes the player
    async Task Back()
    {
        try { if (panelOpen && await Js.InvokeAsync<bool>("flacie.sheetMode")) { panelOpen = false; return; } } catch (Exception) { }
        try { await Js.InvokeVoidAsync("flacie.npBack"); } catch (Exception) { await OnClose.InvokeAsync(); }
    }
    string TabTitle => tab switch { "lyrics" => "Lyrics", "info" => "Info", _ => "Up next" };
    public override void Dispose() { self?.Dispose(); _ = Js.InvokeVoidAsync("flacie.npReset").AsTask().ContinueWith(_ => { }); base.Dispose(); }
    Lyrics? lyrics; bool lyricsLoading; string? lyricsFor;
    MediaInfo? info; bool infoLoading; string? infoFor;
    string? lyricsPushed;

    // on a phone the panel is a sheet over the cover: a tab opens it, the same tab again closes it (on a wide screen it is always there)
    bool panelOpen;
    void Open(string t) { if (tab == t && panelOpen) { panelOpen = false; return; } tab = t; panelOpen = true; if (t == "lyrics") _ = LoadLyrics(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { self = DotNetObjectReference.Create(this); try { await Js.InvokeVoidAsync("flacie.npOpen", self); } catch (Exception) { } }
        if (shownTab != tab) { shownTab = tab; try { await Js.InvokeVoidAsync("flacie.panelTop"); } catch (Exception) { } }
        if (Player.Current is not { } t) return;
        // a new song: refresh whatever is showing
        if (infoFor != t.Path) { await LoadInfo(); _ = LoadRealAlbum(t); }
        if (tab == "lyrics" && lyricsFor != t.Path) await LoadLyrics();
        // the highlight runs in the browser (flacie.js) off the audio clock itself, so it never trails the singer by a round trip
        var wantLyrics = tab == "lyrics" && lyrics is { Synced: true } ? t.Path : null;
        if (wantLyrics != lyricsPushed)
        {
            lyricsPushed = wantLyrics;
            try { if (wantLyrics is null) await Js.InvokeVoidAsync("flacie.clearLyrics"); else await Js.InvokeVoidAsync("flacie.setLyrics", lyrics!.Lines.Select(l => l.TimeMs).ToArray()); } catch (Exception) { }
        }
    }

    // a song filed on a compilation shows the album it really belongs to
    async Task LoadRealAlbum(Track t)
    {
        realAlbumFor = null; realAlbum = null;
        if (!Art.OnCompilation(t.Artist, t.AlbumArtist, t.Album)) return;
        var hit = await MediaEndpoints.OnlineAlbum(Http.CreateClient("media"), t.Artist, "", t.Title, CancellationToken.None);
        if (Player.Current?.Path != t.Path || hit is not { Album.Length: > 0 }) return;
        realAlbum = hit.Value.Album; realAlbumFor = t.Path;
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadInfo()
    {
        if (Player.Current is not { } t) return;
        infoFor = t.Path; infoLoading = true; info = null;
        await InvokeAsync(StateHasChanged);
        var got = await Infos.GetAsync(Session, t);
        if (infoFor == t.Path) { info = got; infoLoading = false; }
        await InvokeAsync(StateHasChanged);
    }

    async Task LoadLyrics()
    {
        if (Player.Current is not { } t) return;
        lyricsFor = t.Path; lyricsLoading = true; lyrics = null; lyricsPushed = null;
        await InvokeAsync(StateHasChanged);
        var got = await LyricsSvc.GetAsync(t, Session.Jellyfin);
        if (lyricsFor == t.Path) { lyrics = got; lyricsLoading = false; }
        await InvokeAsync(StateHasChanged);
    }

    static string SourceName(Track t) => SourceLabel.PlayingFrom(t.Source);
    Task OnSeek(ChangeEventArgs e) => double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var s) ? Player.Seek(s) : Task.CompletedTask;
}
