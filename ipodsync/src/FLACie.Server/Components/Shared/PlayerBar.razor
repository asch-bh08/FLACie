@inherits UserComponent
@if (Player.Current is { } t)
{
    @if (open) { <NowPlaying OnClose="() => open = false" /> }
    <section class="player" aria-label="Player">
        <input class="bar-progress" type="range" min="0" max="@Math.Max(1, Player.Duration)" step="1" value="@Player.Position" aria-label="Seek" style="@Fill(Player.Position, Player.Duration)" @onchange="OnSeek" />
        <div class="bar">
            <button class="bar-song" @onclick="() => open = true" aria-label="Open Now Playing">
                <Cover ArtKey="@(t.ArtKey)" Size="52" />
                <span class="bar-text"><b>@t.Title</b><small>@t.Artist</small></span>
            </button>
            <div class="bar-controls">
                <div class="buttons">
                    <button class="icon-btn @(Player.Shuffle ? "on" : "")" @onclick="Player.ToggleShuffle" aria-label="Shuffle @(Player.Shuffle ? "on" : "off")" aria-pressed="@Player.Shuffle"><Icon Name="shuffle" /></button>
                    <button class="icon-btn" @onclick="Player.Prev" aria-label="Previous"><Icon Name="prev" Size="22" /></button>
                    <button class="play" @onclick="Player.Toggle" aria-label="@(Player.Playing ? "Pause" : "Play")"><Icon Name="@(Player.Playing ? "pause" : "play")" Size="22" /></button>
                    <button class="icon-btn" @onclick="Player.Next" aria-label="Next"><Icon Name="next" Size="22" /></button>
                    <button class="icon-btn @(Player.Repeat > 0 ? "on" : "")" @onclick="Player.CycleRepeat" aria-label="@(Player.Repeat switch { 1 => "Repeat all", 2 => "Repeat one", _ => "Repeat off" })"><Icon Name="@(Player.Repeat == 2 ? "repeat-one" : "repeat")" /></button>
                </div>
                <div class="seek">
                    <span>@Time(Player.Position)</span>
                    <input type="range" min="0" max="@Math.Max(1, Player.Duration)" step="1" value="@Player.Position" aria-label="Seek" style="@Fill(Player.Position, Player.Duration)" @onchange="OnSeek" />
                    <span>@Time(Player.Duration)</span>
                </div>
            </div>
            <div class="bar-right">
                <button class="icon-btn fav @(Session.IsFavorite(t) ? "on" : "")" @onclick="() => { Session.ToggleFavorite(t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" /></button>
                <VolumeControl />
                <button class="icon-btn" @onclick="() => open = true" aria-label="Full screen player"><Icon Name="expand" /></button>
            </div>
        </div>
    </section>
}
@code {
    bool open, volumeLoaded;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!volumeLoaded)
        {
            volumeLoaded = true;
            try { await Player.LoadVolumeAsync(); } catch (InvalidOperationException) { }
            Player.SetStashKey(Session.Jellyfin?.UserId ?? Session.Nas?.User ?? "guest");
            _ = Player.RestoreAsync(Session);
        }
    }
    Task OnSeek(ChangeEventArgs e) => double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var s) ? Player.Seek(s) : Task.CompletedTask;
    static string Fill(double v, double max) => $"--fill:{(max > 0 ? Math.Clamp(v / max * 100, 0, 100) : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
}
