@inherits RetroBase
@* The car stereo scene: a night dashboard seen through a rain-streaked windshield (city lights blurred beyond it, the wiper sweeping), a single-DIN head unit
   with an amber dot-matrix display (what the file is and the EQ, the title, the line being sung, the track), a CD slot, an EQ key stepping the sounds, a volume knob, six presets and the transport keys, and the climate dials under it. Bound to the player:
   play/pause, previous, next; eject pauses and the disc slides out (a click on it, or the slot, plays again); the display "tunes" to a station on every
   new song; the presets are radio stations made from your biggest genres (ROCK, POP, ...: each shuffles its genre), then the albums coming up; the knob is the volume (turned by scrolling or the arrow keys; pressed, it mutes). Styles: retro.css. *@
<div class="car">
    <div class="car-city" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="car-rain" aria-hidden="true"><i></i><i></i></div>
    <div class="car-wiper" aria-hidden="true"><i></i></div>
    <div class="car-cabin" aria-hidden="true"><i class="liner"></i><i class="pillar l"></i><i class="pillar r"></i><i class="mirror"></i></div>
    <div class="car-dash">
        <div class="car-console" aria-hidden="true"><i class="cvent l"></i><i class="cvent r"></i><i class="seam"></i></div>
        <div class="car-glove" aria-hidden="true"><i class="latch"></i></div>
        <div class="car-vent l" aria-hidden="true"></div><div class="car-vent r" aria-hidden="true"></div>
        <div class="car-unit" data-testid="retro-unit">
            <button type="button" class="cu-knob" data-testid="car-knob" role="slider" aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@VolPct"
                    style="--r:@((-135 + 270 * Player.Volume).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))deg"
                    title="Turn for the volume (drag, scroll or arrow keys); press to mute" @onclick="() => Player.ToggleMuteAsync()" @onwheel="KnobWheel" data-wheel data-knob @onkeydown="KnobKey"><i></i></button>
            <div class="cu-mid">
                <div class="cu-slot" data-testid="car-slot" @onclick="Insert" title="@(ejected ? "Put the disc back in" : "")">
                    <i class="cu-disc @(ejected ? "out" : "")" data-testid="car-disc" style="@ArtStyle"></i>
                </div>
                <div class="cu-display" data-testid="car-display">
                    <div class="cu-line0"><span data-testid="retro-format" class="rt-mq">@(Now is null ? "NO DISC" : Format)</span><span data-testid="car-eq-name">EQ @EqName</span></div>
                    <div class="cu-line1 rt-mq" data-testid="retro-title">@Ticker</div>
                    @LyricsBox(Now?.Album, "cu-lyric")
                    <div class="cu-line2"><span>@(Now is null ? "NO DISC" : ejected ? "EJECT" : $"TRK {TrackNo:00}")</span><span>@(Now is null ? "--:--" : Clock(Position))</span><span>@(Source) @(Playing ? "▸" : "❚❚")</span></div>
                    @if (Now is not null) { <div class="cu-tune" @key="Now.Path" aria-hidden="true">TUNING&nbsp;&nbsp;FM @Freq</div> }
                    <i class="cu-dots" aria-hidden="true"></i>
                </div>
                <div class="cu-presets">
                    @for (var i = 0; i < Presets.Count; i++)
                    {
                        var p = Presets[i]; var n = i + 1;
                        <button type="button" class="cu-pre @(p.Station is { } ps && Player.Context == Ctx(ps) ? "on" : "")" data-preset="@n" data-media="@(p.Station is null ? "album" : "genre")" data-album="@p.Album?.Album" aria-label="@($"Preset {n}: {p.Title}")" title="@p.Title" @onclick="() => PlayPreset(p)"><b>@n</b><small>@p.Name</small></button>
                    }
                    @for (var i = Presets.Count; i < 6; i++) { <button type="button" class="cu-pre" disabled><b>@(i + 1)</b><small>—</small></button> }
                </div>
            </div>
            <div class="cu-keys">
                <button type="button" data-ctl="eject" aria-label="Eject" @onclick="Eject">⏏</button>
                <button type="button" data-ctl="prev" aria-label="Previous" @onclick="Prev">⏮</button>
                <button type="button" data-ctl="play" aria-label="@(Playing ? "Pause" : "Play")" @onclick="PlayKey">⏯</button>
                <button type="button" data-ctl="next" aria-label="Next" @onclick="Next">⏭</button>
                <button type="button" data-ctl="eq" aria-label="@($"EQ: {EqName}. Press for the next sound")" title="@($"Sound: {EqName} (press for the next)")" @onclick="EqKey">EQ</button>
            </div>
            <span class="cu-brand" aria-hidden="true">FLACIE · CD-1</span>
        </div>
        <div class="car-climate" aria-hidden="true">
            <button type="button" tabindex="-1" class="dial temp" style="--r:@(climate[0])deg" @onclick="() => Turn(0)"><i></i></button>
            <button type="button" tabindex="-1" class="dial fan" style="--r:@(climate[1])deg" @onclick="() => Turn(1)"><i></i></button>
            <button type="button" tabindex="-1" class="dial mode" style="--r:@(climate[2])deg" @onclick="() => Turn(2)"><i></i></button>
        </div>
    </div>
</div>

@code {
    bool ejected;
    readonly int[] climate = [-30, 20, 60];

    sealed record Preset(string Name, string Title, FLACie.Core.CarPresets.Station? Station, FLACie.Core.DeskAlbum? Album);
    /// <summary>The six presets: a station for each of your biggest genres, then (keys left over) the albums coming up.</summary>
    List<Preset> Presets => [.. Stations.Select(s => new Preset(s.Label, s.Genre, s, null)).Concat(NextAlbums.Select(a => new Preset(Short(a.Album), a.Album, null, a))).Take(6)];
    // (grouped again only when the library changes: the scene redraws on every tick of the song)
    IReadOnlyList<FLACie.Core.CarPresets.Station> Stations { get { var songs = Lib.Songs; if (!ReferenceEquals(songs, stationsOf) || songs.Count != stationsCount) { stationsOf = songs; stationsCount = songs.Count; stations = FLACie.Core.CarPresets.Stations(songs); } return stations; } }
    IReadOnlyList<FLACie.Core.CarPresets.Station> stations = []; object? stationsOf; int stationsCount = -1;
    /// <summary>What the display says is playing: the station when a preset started it, else the CD.</summary>
    string Source => Stations.FirstOrDefault(s => Ctx(s) == Player.Context) is { } s ? s.Label : "CD";
    /// <summary>The name a station plays under (the player shows it as where the music comes from).</summary>
    static string Ctx(FLACie.Core.CarPresets.Station s) => $"{s.Genre} radio";
    static string Short(string album) => album.Length <= 10 ? album.ToUpperInvariant() : album[..9].TrimEnd().ToUpperInvariant() + "…";

    string Ticker => Now is null ? "INSERT DISC" : $"{Now.Title}  —  {Now.Artist}".ToUpperInvariant();
    string Freq => (87.5 + Hash(Now?.Path) % 205 / 10.0).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    string ArtStyle => Now?.ArtKey is { } k ? $"--art:url('/art/{Uri.EscapeDataString(FLACie.Core.CoverOverrides.Map(k)!)}?v=3')" : "";

    async Task PlayKey() { if (ejected) { await Insert(); return; } await Toggle(); }
    async Task Eject() { ejected = true; await Pause(); }
    async Task Insert() { if (!ejected) return; ejected = false; await Resume(); }
    async Task PlayPreset(Preset p) { ejected = false; if (p.Station is { } s) await Player.ShuffleAll(s.Tracks, Ctx(s)); else if (p.Album is { } a) await PlayAlbum(a); }

    Task KnobWheel(WheelEventArgs e) => SetVolume(Player.Volume + (e.DeltaY < 0 ? 0.05 : -0.05));
    Task KnobKey(KeyboardEventArgs e) => e.Key switch
    {
        "ArrowUp" or "ArrowRight" => SetVolume(Player.Volume + 0.05),
        "ArrowDown" or "ArrowLeft" => SetVolume(Player.Volume - 0.05),
        _ => Task.CompletedTask,
    };
    void Turn(int i) { climate[i] = climate[i] >= 120 ? -120 : climate[i] + 30; }
}
