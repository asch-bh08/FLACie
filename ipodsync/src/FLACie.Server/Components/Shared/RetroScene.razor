@using FLACie.Core
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject PlayerState Player
@* A listening scene beside the iPod (iPod panel › Scene): the car stereo, the hi-fi, the boombox or the MiniDisc system. desk.js runs its moving parts from
   the player's one analyser (--low --mid --high --beat on the scene, meter needles: data-needle), so no scene fetches a song twice. Styles: retro.css. *@
<div class="retro retro-@Key" data-testid="retro" data-scene="@Key" data-playing="@(Player.Playing ? "true" : "false")" @ref="root">
    @switch (Kind)
    {
        case IpodPrefs.SceneCar: <RetroCar /> break;
        case IpodPrefs.SceneHifi: <RetroHifi /> break;
        case IpodPrefs.SceneBoombox: <RetroBoombox /> break;
        case IpodPrefs.SceneMinidisc: <RetroMinidisc /> break;
        case IpodPrefs.SceneDiscman: <RetroDiscman /> break;
    }
    @* the desk's light and film over every scene, so they all read as one set of photographs *@
    <DeskFilm Id="@($"retro-{Key}")" Shade="@Light.Shade" Sun="@Light.Sun" Blur="@Light.Blur" Class="@($"film-{Key}")" />
</div>

@code {
    [Parameter] public int Kind { get; set; }
    string Key => IpodPrefs.SceneKeys[Math.Clamp(Kind, 0, IpodPrefs.SceneKeys.Length - 1)];
    // each scene's own light (the blinds' shade, the sun through them, how soft their edges are): the car at night and the hi-fi's lamp-lit evening have no
    // blinds at all; the boombox's workshop a low warm sun; the MiniDisc's dorm a hazy afternoon; the Discman's linen a bright, gentle morning
    (double Shade, double Sun, double Blur) Light => Kind switch
    {
        IpodPrefs.SceneCar or IpodPrefs.SceneHifi => (0, 0, 7),
        IpodPrefs.SceneBoombox => (0.1, 0.24, 9),
        IpodPrefs.SceneMinidisc => (0.06, 0.16, 16),
        IpodPrefs.SceneDiscman => (0.08, 0.2, 12),
        _ => (0.2, 0.32, 7),
    };

    ElementReference root;
    int startedFor = -1;
    bool started;

    protected override void OnInitialized() => Player.Changed += Refresh;
    void Refresh() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool first)
    {
        // the moving parts read the scene's elements once at start: start again for another scene
        if (startedFor == Kind) return;
        startedFor = Kind;
        try { await Js.InvokeVoidAsync("desk.start", root, new { }); await Js.InvokeVoidAsync("retro.start", root); started = true; } catch (Exception e) when (Gone(e)) { }
    }

    static bool Gone(Exception e) => e is JSDisconnectedException or JSException or InvalidOperationException or OperationCanceledException;

    public async ValueTask DisposeAsync()
    {
        Player.Changed -= Refresh;
        if (!started) return;
        try { await Js.InvokeVoidAsync("desk.stop"); await Js.InvokeVoidAsync("retro.stop"); } catch (Exception e) when (Gone(e)) { }
    }
}
