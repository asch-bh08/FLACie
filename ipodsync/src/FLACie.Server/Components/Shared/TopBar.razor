@inherits UserComponent
@inject IConfiguration Conf
@implements IDisposable
@* Along the top, like YT Music: the logo, one search box that works from every page, and the account at the right. *@
<header class="topbar">
    <span class="top-left">
        @if (Full) { <button class="top-burger @(MenuOpen ? "open" : "")" @onclick="OnMenu" aria-label="Menu" aria-expanded="@MenuOpen" aria-controls="main-rail"><i></i><i></i><i></i></button> }
        <a class="top-brand" href="/" aria-label="FLACie home"><Logo Size="32" Class="top-name-wrap" /></a>
    </span>
    @if (Full) { <h2 class="top-title">Explore</h2> }
    else {
    <form class="top-search" role="search" @onsubmit="Go">
        <Icon Name="search" Size="18" />
        <input type="search" placeholder="Search songs, albums, artists, or music to download" aria-label="Search" value="@q" @oninput="OnInput" autocomplete="off" />
        @if (q.Length > 0) { <button type="button" class="icon-btn" aria-label="Clear search" @onclick="Clear"><Icon Name="x" Size="16" /></button> }
    </form>
    }
    <div class="top-account">
        <button class="avatar-btn" @onclick="() => open = !open" aria-haspopup="menu" aria-expanded="@open" aria-label="@("Account: " + Session.DisplayName)"><span class="avatar">@Initial</span></button>
        @if (open)
        {
            <button class="scrim" aria-label="Close menu" @onclick="() => open = false"></button>
            <div class="account-menu" role="menu">
                <div class="am-head"><span class="avatar big">@Initial</span><div><b>@Session.DisplayName</b><small>@(Session.Kind == "nas" ? "NAS" : "Jellyfin")@(Session.Jellyfin is not null && Session.Nas is not null ? " and NAS" : "")</small></div></div>
                <a role="menuitem" href="/account" @onclick="() => open = false"><Icon Name="artists" Size="18" />Account</a>
                <a role="menuitem" href="/downloads" @onclick="() => open = false"><Icon Name="download" Size="18" />Downloads</a>
                @if (AdminAccess.Is(Session, Conf)) { <a role="menuitem" href="/dashboard" @onclick="() => open = false"><Icon Name="shield" Size="18" />Dashboard</a> }
                <a role="menuitem" href="/settings" @onclick="() => open = false"><Icon Name="settings" Size="18" />Settings</a>
                <form method="post" action="/auth/logout" data-enhance="false"><button role="menuitem" type="submit"><Icon Name="logout" Size="18" />Sign out</button></form>
            </div>
        }
    </div>
</header>
@code {
    /// <summary>Explore: no search box here (Explore has its own filter), a hamburger for the side menu instead.</summary>
    [Parameter] public bool Full { get; set; }
    [Parameter] public bool MenuOpen { get; set; }
    [Parameter] public EventCallback OnMenu { get; set; }
    string q = "";
    bool open;
    CancellationTokenSource? pending;
    string Initial => Session.DisplayName.Length > 0 ? Session.DisplayName[..1].ToUpperInvariant() : "?";

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Nav.LocationChanged += OnLocation;
        SyncFromUrl();
        ShareAddress();
    }

    // the phone app finds this server (to hand over playlist files) through the shared profile; a localhost address is no use to it
    void ShareAddress()
    {
        var origin = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);
        var host = new Uri(origin).Host;
        if (host is "localhost" or "127.0.0.1" or "::1" or "[::1]" || host.EndsWith(".localhost")) return;
        var services = Session.Profile["services"] as System.Text.Json.Nodes.JsonObject;
        if (services is null || services["flacieweb"]?["url"]?.GetValue<string>() == origin) return;
        services["flacieweb"] = new System.Text.Json.Nodes.JsonObject { ["url"] = origin };
        SaveProfile();
    }

    void OnLocation(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) { SyncFromUrl(); InvokeAsync(StateHasChanged); }

    // the box mirrors the Search page's address, so Back and a shared link show what was searched
    void SyncFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        if (uri.AbsolutePath != "/search") { if (q.Length > 0 && !uri.AbsolutePath.StartsWith("/search")) q = ""; return; }
        var m = System.Web.HttpUtility.ParseQueryString(uri.Query)["q"] ?? "";
        if (m != q) q = m;
    }

    // typing searches as you go, after a short pause; the Search page follows the address
    async Task OnInput(ChangeEventArgs e)
    {
        q = e.Value?.ToString() ?? "";
        pending?.Cancel(); var cts = pending = new CancellationTokenSource();
        try { await Task.Delay(300, cts.Token); } catch (OperationCanceledException) { return; }
        Navigate();
    }

    void Go() { pending?.Cancel(); Navigate(); }
    void Clear() { q = ""; Navigate(); }
    void Navigate()
    {
        var onSearch = new Uri(Nav.Uri).AbsolutePath == "/search";
        Nav.NavigateTo("/search" + (q.Trim().Length > 0 ? "?q=" + Uri.EscapeDataString(q) : ""), replace: onSearch);
    }

    public override void Dispose() { Nav.LocationChanged -= OnLocation; pending?.Cancel(); base.Dispose(); }
}
