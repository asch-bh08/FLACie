@* The file behind a song: format and quality at a glance, then a graph for whatever you pick. Every graph but the bit rate is live: it moves with the song as it plays. *@
@implements IAsyncDisposable
@inject IJSRuntime Js
@if (Loading) { <p class="hint">Reading the file…</p> }
else if (Info is null) { <p class="hint">No details available for this song.</p> }
else
{
    <div class="info">
        <div class="info-head">
            <span class="fmt-big @(Info.HiRes ? "hires" : Info.Lossless ? "lossless" : "")">@(Info.HiRes ? "HI-RES" : Info.Format.Length > 0 ? Info.Format : "AUDIO")</span>
            <div><b>@(Info.Tier.Length > 0 ? Info.Tier : "Quality unknown")</b><small>@Info.Sampling@(Info.Sampling.Length > 0 && Info.ChannelsName.Length > 0 ? " · " : "")@Info.ChannelsName</small></div>
        </div>

        <div class="graph-box">
            <div class="facts" role="tablist" aria-label="Graph to show">
                @foreach (var (id, big, small) in Picks())
                {
                    var m = id;
                    <button role="tab" class="fact choose @(mode == m ? "on" : "")" aria-selected="@((mode == m) ? "true" : "false")" @onclick="() => Pick(m)"><b>@big</b>@if (small.Length > 0) { <small>@small</small> }</button>
                }
            </div>
            <div class="graph-head">
                <h4>@Title</h4>
                @if (mode == "rate") { <span class="tag">From the file</span> }
                else { <span class="tag live"><i aria-hidden="true"></i>Live</span> }
            </div>
            <p class="graph-hint">@Hint</p>
            @if (mode == "rate")
            {
                <div class="bars" role="img" aria-label="Bit rate against common formats">
                    @foreach (var (name, v, me) in RateBars())
                    {
                        <div class="bar-row @(me ? "me" : "")"><span>@name</span><div class="bar-track"><i style="width:@Pct(v, RateMax)%"></i></div><b>@v kbps</b></div>
                    }
                </div>
            }
            else if (unavailable) { <p class="viz-off">The live graphs aren't available in this browser.</p> }
            else { <canvas id="viz" class="viz @mode @(Info.HiRes ? "tall" : "")" role="img" aria-label="@Title"></canvas> }
        </div>

        <section class="kv-sec">
            <h4>Song</h4>
            <dl class="kv">
                <dt>Title</dt><dd>@Track.Title</dd>
                <dt>Artist</dt><dd>@Track.Artist</dd>
                @if ((Album ?? Track.Album).Length > 0) { <dt>Album</dt><dd>@(Album ?? Track.Album)</dd> }
                @if (Album is not null && Track.Album.Length > 0 && Album != Track.Album) { <dt>Filed under</dt><dd class="dim">@Track.Album@(Track.AlbumArtist.Length > 0 && Track.AlbumArtist != Track.Artist ? " (" + Track.AlbumArtist + ")" : "")</dd> }
                @if (Track.Year > 0) { <dt>Year</dt><dd>@Track.Year</dd> }
                @if (Track.Genre.Length > 0) { <dt>Genre</dt><dd>@Track.Genre</dd> }
                @if (Track.TrackNo > 0) { <dt>Track</dt><dd>@(Track.DiscNo > 1 ? Track.DiscNo + "-" : "")@Track.TrackNo</dd> }
                @if (Info.DurationMs > 0) { <dt>Length</dt><dd>@Clock(Info.DurationMs)</dd> }
            </dl>
        </section>
        <section class="kv-sec">
            <h4>File</h4>
            <dl class="kv">
                <dt>Source</dt><dd><span class="badge @Track.Source.ToString().ToLowerInvariant()" title="@(Track.Source == TrackSource.Cloud ? SourceLabel.StreamingHint : "Where this song is played from")">@Info.Source</span></dd>
                <dt>Came from</dt><dd>@Origin</dd>
                @if (Info.Codec.Length > 0) { <dt>Codec</dt><dd>@Info.Codec.ToUpperInvariant()@(Info.Container.Length > 0 && !string.Equals(Info.Container, Info.Codec, StringComparison.OrdinalIgnoreCase) ? " in " + Info.Container.ToUpperInvariant() : "")</dd> }
                @if (Info.SizeBytes > 0) { <dt>Size</dt><dd>@Size(Info.SizeBytes)</dd> }
                @if (Info.Path.Length > 0) { <dt>Location</dt><dd class="path">@Info.Path</dd> }
                <dt>Playing</dt><dd>@(Converted ? "Converted to MP3 by Jellyfin, because browsers can't play " + Info.Format + " files" : Track.Source == TrackSource.Cloud ? "Streaming from your server: a new download that Jellyfin has not scanned yet. Original file, not converted." : "Original file, streamed without converting")</dd>
                <dt>Playback</dt><dd>@Playback</dd>
            </dl>
        </section>
    </div>
}
@code {
    [Parameter] public Track Track { get; set; } = default!;
    [Parameter] public MediaInfo? Info { get; set; }
    [Parameter] public bool Loading { get; set; }
    /// <summary>The song's own album when the file is filed on a compilation or another release.</summary>
    [Parameter] public string? Album { get; set; }

    // curve = live spectrum, leds = bars, wall = scrolling spectrogram, loud = loudness meter, stereo = phase scope and L/R meters, rate = bit rate
    string mode = "curve";
    string? shown; bool unavailable;
    double outRate = -1;

    bool Converted => Info is not null && MediaInfo.NotPlayableInBrowsers.Contains(Info.Codec.ToLowerInvariant()) || MediaInfo.NotPlayableInBrowsers.Contains(Info?.Container.ToLowerInvariant() ?? "");

    /// <summary>The path from file to speaker as this browser can tell it: the file's own rate, the decoder, and the rate the device runs at.</summary>
    MarkupString Playback
    {
        get
        {
            if (Info is null || outRate < 0) return new("Checking this device…");
            var src = $"{System.Net.WebUtility.HtmlEncode(Info.Format)} {Info.Sampling}".Trim();
            var rate = Info.SampleRateHz;
            if (outRate == 0 || rate == 0) return new($"{src} → this browser's decoder → your device. The device's rate is not reported here.");
            var dev = $"{outRate / 1000.0:0.#} kHz";
            var same = Math.Abs(outRate - rate) < 1;
            var flag = same ? "<span class=\"badge lossless\">Native rate</span>" : "<span class=\"badge\">Resampled by device</span>";
            var note = same ? " A browser mixes through the system sound mixer, so it can't be bit-exact." : $" The system mixer runs at {dev}, so the browser hands over the sound at that rate. The Android app and a USB DAC can do better.";
            return new($"{src} → browser decoder → device mixer at {dev} {flag}<small class=\"dim\">{note}</small>");
        }
    }

    IEnumerable<(string Id, string Big, string Small)> Picks()
    {
        if (Info!.BitrateKbps > 0) yield return ("rate", Info.BitrateKbps.ToString(), "kbps");
        // the spectrum is always a choice (it is what opens first), with the sample rate beside it when the file says
        yield return ("curve", "Spectrum", Info.SampleRateHz > 0 ? (Info.SampleRateHz / 1000.0).ToString("0.#") + " kHz" : "");
        yield return ("loud", Info.BitDepth > 0 ? Info.BitDepth.ToString() : "Level", Info.BitDepth > 0 ? "bit" : "");
        yield return ("stereo", Info.Channels == 1 ? "Mono" : "Stereo", "");
        yield return ("leds", "Visualizer", "");
        yield return ("wall", "Spectrogram", "");
    }

    string Title => mode switch { "rate" => "Bit rate", "curve" => "Spectrum", "leds" => "Visualizer", "wall" => "Spectrogram", "loud" => "Loudness", _ => "Stereo" };
    string Hint => mode switch
    {
        "rate" => "How much data each second of the song uses, next to common formats.",
        "curve" => $"How loud each pitch is right now: deep sounds on the left, high sounds on the right, up to {(Info!.SampleRateHz > 0 ? (Info.SampleRateHz / 2000.0).ToString("0.#") : "22")} kHz (half this file's sample rate). A lossless file usually has sound out to the right edge; an MP3 is cut off by its encoder (about 16 kHz at 128 kbps, about 20 kHz at 320 kbps: the dashed line marks it).",
        "leds" => "The song as it plays, deep sounds on the left and high ones on the right.",
        "wall" => "Pitch runs up the side (deep at the bottom, high at the top) and brighter means louder. The newest sound is on the right and scrolls left.",
        "loud" => "How loud the song is right now, in dB (0 is the loudest a file can go), and the last ten seconds of it.",
        _ => "The dots show what left and right do together: a thin vertical line is the same sound in both, a wide cloud is a wide stereo picture. The bars are the level of each side.",
    };


    /// <summary>Where the file came from, in a sentence: a recent download (and from which source, when) or "in the library from the start".</summary>
    MarkupString Origin
    {
        get
        {
            if (Info is null) return default;
            var from = Info.OriginSource.Length > 0 ? OpenSourceSettings.Name(Info.OriginSource) : "";
            if (Info.Origin == "downloaded")
            {
                var when = Info.OriginAt is { } at ? $" <time data-utc=\"{DateTime.SpecifyKind(at, DateTimeKind.Utc):o}\" data-abs=\"1\" data-rel=\"{Ago(at)}\">{Ago(at)}</time>" : "";
                var tail = Track.Source == TrackSource.Cloud ? " It is streaming from your server until the next Jellyfin scan." : "";
                return new($"Downloaded {(from.Length > 0 ? "from <b>" + System.Net.WebUtility.HtmlEncode(from) + "</b>" : "by FLACie")}{when}.{tail}");
            }
            return new(Track.Source == TrackSource.Nas ? "On your NAS. FLACie has no download record for it." : "In your Jellyfin library. FLACie has no download record for it, so it was already there or was added before the log began.");
        }
    }

    static string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        return d.TotalSeconds < 60 ? "just now" : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes} min ago" : d.TotalHours < 24 ? $"{(int)d.TotalHours} h ago" : d.TotalDays < 2 ? "yesterday" : $"{(int)d.TotalDays} days ago";
    }
    void Pick(string m) { mode = m; shown = null; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Info is null || Loading) { shown = null; return; }
        await Safe(() => Js.InvokeVoidAsync("flacie.times").AsTask());
        if (outRate < 0) { try { outRate = await Js.InvokeAsync<double>("flacie.outputRate"); } catch (Exception) { outRate = 0; } StateHasChanged(); }
        if (mode == "rate") { if (shown != "rate") { shown = "rate"; await Safe(() => Js.InvokeVoidAsync("flacie.vizStop").AsTask()); } return; }
        var key = mode + "|" + Track.Path + "|" + Info.SampleRateHz;   // a new song can run at another rate, which needs a new graph
        if (shown == key || unavailable) return;
        shown = key;
        try { if (!await Js.InvokeAsync<bool>("flacie.viz", "viz", mode, Info.SampleRateHz, CutHz, CutLabel)) { unavailable = true; StateHasChanged(); } } catch (Exception) { }
    }

    static async Task Safe(Func<Task> f) { try { await f(); } catch (Exception) { } }
    public async ValueTask DisposeAsync() => await Safe(() => Js.InvokeVoidAsync("flacie.vizStop").AsTask());

    IEnumerable<(string Name, int V, bool Me)> RateBars()
    {
        var l = new List<(string, int, bool)> { ("MP3, low", 128, false), ("MP3, high", 320, false), ("CD, uncompressed", 1411, false), ("This file", Info!.BitrateKbps, true) };
        return l.OrderBy(x => x.Item2);
    }
    // where an MP3 encoder at this bitrate usually stops the sound (LAME's lowpass): 128k ~16 kHz, 192k ~19 kHz, 256k ~20 kHz, 320k ~20.5 kHz. A 320k MP3 reaching 20 kHz is normal, not a sign of a better file.
    int CutHz => Info is { } i && i.Codec.Equals("mp3", StringComparison.OrdinalIgnoreCase) && i.BitrateKbps > 0 ? (i.BitrateKbps <= 96 ? 15000 : i.BitrateKbps <= 128 ? 16000 : i.BitrateKbps <= 160 ? 17500 : i.BitrateKbps <= 192 ? 19000 : i.BitrateKbps <= 256 ? 20000 : 20500) : 16000;   // other formats: the usual 128 kbps MP3 line, as a yardstick
    string CutLabel => Info is { } i2 && i2.Codec.Equals("mp3", StringComparison.OrdinalIgnoreCase) && i2.BitrateKbps > 0 ? $"{i2.BitrateKbps} kbps MP3 usually ends here" : "MP3 usually ends here";
    double RateMax => Math.Max(1411, Info?.BitrateKbps ?? 0);

    static string Pct(double v, double max) => Math.Clamp(v / max * 100, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    static string Size(long b) => b >= 1 << 30 ? $"{b / (double)(1 << 30):0.##} GB" : $"{b / (double)(1 << 20):0.#} MB";
    static string Clock(long ms) => $"{ms / 60000}:{ms / 1000 % 60:00}";
}
