@inherits UserComponent
@* A list of songs. Click plays from that song with the rest of the list queued; the menu adds to queue or a playlist. *@
<ol class="tracks">
    @for (var i = 0; i < Tracks.Count; i++)
    {
        var idx = i; var t = Tracks[i];
        var now = Player.Current?.Path == t.Path;
        var fmt = InfoService.QuickFormat(t);
        <li class="track @(now ? "now" : "")">
            <button class="track-main" @onclick="() => Player.Play(Tracks, idx)" aria-label="Play @t.Title by @t.Artist">
                @if (Numbered) { <span class="track-no">@(t.TrackNo > 0 ? t.TrackNo : idx + 1)</span> }
                else { <Cover ArtKey="@(t.ArtKey)" Size="44" /> }
                <span class="track-text">
                    <span class="track-title">@t.Title</span>
                    <span class="track-sub">@t.Artist@(ShowAlbum && t.Album.Length > 0 ? " · " + t.Album : "")</span>
                </span>
            </button>
            <span class="pills">
                <span class="badge @t.Source.ToString().ToLowerInvariant()" title="Where this song is played from">@(t.Source switch { TrackSource.Nas => "NAS", TrackSource.Cloud => "Download", _ => t.Source.ToString() })</span>
                @if (fmt.Length > 0) { <span class="badge fmt @(MediaInfo.LosslessCodecs.Contains(fmt.ToLowerInvariant()) ? "lossless" : "")" title="File format">@fmt</span> }
            </span>
            <span class="track-time">@(t.DurationMs > 0 ? Time(t.DurationMs / 1000.0) : "")</span>
            <button class="icon-btn @(Session.IsFavorite(t) ? "on" : "")" @onclick="() => { Session.ToggleFavorite(t); SaveProfile(); }" aria-label="@(Session.IsFavorite(t) ? "Remove from favourites" : "Add to favourites")"><Icon Name="@(Session.IsFavorite(t) ? "heart-fill" : "heart")" /></button>
            <button class="icon-btn" @onclick="() => menu = menu == idx ? -1 : idx" aria-label="More for @t.Title" aria-expanded="@(menu == idx)"><Icon Name="more" /></button>
            @if (menu == idx)
            {
                <div class="menu" role="menu">
                    <button role="menuitem" @onclick="() => { Player.PlayNext(t); menu = -1; }">Play next</button>
                    <button role="menuitem" @onclick="() => { Player.AddToQueue(t); menu = -1; }">Add to queue</button>
                    @foreach (var p in Session.Playlists)
                    {
                        <button role="menuitem" @onclick="() => { Session.AddToPlaylist(p.Id, t); SaveProfile(); menu = -1; }">Add to @p.Name</button>
                    }
                    @if (OnRemove is not null) { <button role="menuitem" class="danger" @onclick="() => { OnRemove(idx); menu = -1; }">Remove from playlist</button> }
                </div>
            }
        </li>
    }
</ol>
@code {
    [Parameter] public IReadOnlyList<Track> Tracks { get; set; } = [];
    [Parameter] public bool Numbered { get; set; }
    [Parameter] public bool ShowAlbum { get; set; } = true;
    [Parameter] public Action<int>? OnRemove { get; set; }
    int menu = -1;
}
