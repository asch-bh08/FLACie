<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- FLACie's licence, the third-party notices, their full texts and the privacy notice, served at /licenses and /privacy. Copies of the files at the top of
       the repository (the Docker image is built from ipodsync/src only); LegalFilesTests fails when they drift apart. -->
  <ItemGroup>
    <Content Include="legal\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FLACie.Core\FLACie.Core.csproj" />
    <ProjectReference Include="..\FLACie.Retro\FLACie.Retro.csproj" />
    <ProjectReference Include="..\FLACie.App\FLACie.App.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.117</Version>
    <InformationalVersion>1.0 b117</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
