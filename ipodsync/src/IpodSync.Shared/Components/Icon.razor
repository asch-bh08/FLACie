        "star" => """<path d="m12 3.5 2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9L6.7 20l1.1-6L3.4 9.8l6-.8z"/>""",
        "trash" => """<path d="M4 7h16M9 7V5h6v2M6 7l1 13h10l1-13"/>""",
        "image" => """<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m4 18 5-5 4 4 3-3 4 4"/>""",
        "folder" => """<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>""",
        "warn" => """<path d="M12 4 2.5 20h19z"/><path d="M12 10v4M12 17h.01"/>""",
        "info" => """<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>""",
        "back" => """<path d="M15 5 8 12l7 7"/>""",
