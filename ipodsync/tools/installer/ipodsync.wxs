<!--
  Windows installer for the ipodsync app (IpodSync.Maui). Built by tools\build-installer.ps1:
  a self-contained publish (no .NET / Windows App SDK needed on the target) packed into a per-user MSI;
  installs to %LOCALAPPDATA%\Programs\ipodsync without admin rights, adds a Start menu shortcut, and
  upgrades in place (same UpgradeCode, MajorUpgrade). iPod backups live in Documents\ipodsync and are never
  touched by install/uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="FLACie" Manufacturer="FLACie" Version="$(Version)" Scope="perUser"
           UpgradeCode="B480A45D-C957-4961-8E9C-6D1802B43BAC" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of FLACie is already installed." />

    <!-- Close the running app (WM_CLOSE: it stops its server child itself) before files are replaced or removed, on upgrade
         and uninstall alike; then end the player server if anything is still holding it. Without this Restart Manager only
         queued the old files for deletion at the next reboot and the old app kept running. Matching is by image name. -->
    <util:CloseApplication Id="CloseFlacieApp" Target="IpodSync.Maui.exe" CloseMessage="yes" EndSessionMessage="no"
                           Timeout="20" RebootPrompt="no" Description="FLACie is running and has to be closed first." Sequence="1" />
    <util:CloseApplication Id="CloseFlacieServer" Target="FLACie.Server.exe" CloseMessage="no" TerminateProcess="1"
                           Timeout="5" RebootPrompt="no" Sequence="2" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(PublishDir)\IpodSync.Maui.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FLACie" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="FLACie" Description="Sync and edit classic iPods without iTunes"
                  Target="[INSTALLFOLDER]IpodSync.Maui.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ipodsync" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(PublishDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
