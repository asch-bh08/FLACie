@inherits StateComponent
@inject IHostPickers Pickers

@if (State.Db is { } db)
{
    <div style="display:grid; grid-template-columns: minmax(0,1fr) 320px; gap:16px; align-items:start;">
        <div>
            <div class="row">
                <input class="text-input grow" placeholder="Search title, artist, album…" @bind="_query" @bind:event="oninput" />
                <select class="text-input" @bind="_filter">
                    <option value="all">All songs</option>
                    <option value="noart">Without cover art</option>
                    <option value="rated">Rated</option>
                    <option value="pending">With pending changes</option>
                </select>
                <span class="muted small">@Rows.Count of @db.Tracks.Count</span>
            </div>
            <div class="table-wrap tall">
                <table class="data-table">
                    <colgroup><col style="width:34%" /><col style="width:22%" /><col style="width:24%" /><col style="width:8%" /><col style="width:12%" /></colgroup>
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => Sort("title")'>Title @Arrow("title")</th>
                            <th class="sortable" @onclick='() => Sort("artist")'>Artist @Arrow("artist")</th>
                            <th class="sortable" @onclick='() => Sort("album")'>Album @Arrow("album")</th>
                            <th class="sortable num" @onclick='() => Sort("time")'>Time @Arrow("time")</th>
                            <th class="sortable" @onclick='() => Sort("rating")'>Rating @Arrow("rating")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <Virtualize Items="Rows" ItemSize="32" OverscanCount="30" Context="t" SpacerElement="tr">
                            @{
                                var f = State.PendingFields(t.Id);
                                var stars = State.PendingStars(t.Id) ?? t.Stars;
                                var removing = State.IsPendingRemoval(t.Id);
                                var pending = f is not null || State.PendingStars(t.Id) is not null || State.PendingArtwork(t.Id) is not null;
                            }
                            <tr class="@(t.Id == _selectedId ? "selected" : "") @(removing ? "removing" : pending ? "pending" : "")" @onclick="() => Select(t)">
                                <td title="@t.Title">@(f?.Title ?? t.Title)</td>
                                <td title="@t.Artist">@(f?.Artist ?? t.Artist)</td>
                                <td title="@t.Album">@(f?.Album ?? t.Album)</td>
                                <td class="num">@Time(t.LengthMs)</td>
                                <td style="color:#ffd25f">@(stars > 0 ? new string('★', stars) : "")</td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="panel detail" style="position:sticky; top:0;">
            @if (Selected is { } t)
            {
                var removing = State.IsPendingRemoval(t.Id);
                var pendingArt = State.PendingArtwork(t.Id);
                <div class="cover">
                    @if (_coverUrl is not null && pendingArt is null)
                    {
                        <img src="@_coverUrl" alt="" />
                    }
                    else if (pendingArt is not null)
                    {
                        <span class="small muted" style="font-size:13px; padding:12px; text-align:center">@(pendingArt == "remove" ? "Cover will be removed" : $"New cover queued: {pendingArt}")</span>
                    }
                    else
                    {
                        <span>♪</span>
                    }
                </div>

                @if (removing)
                {
                    <div class="banner bad small">Queued for deletion from the iPod.</div>
                }

                @if (State.CanWrite && !removing)
                {
                    <label class="field">Title <input class="text-input" @bind="_title" /></label>
                    <label class="field">Artist <input class="text-input" @bind="_artist" /></label>
                    <label class="field">Album <input class="text-input" @bind="_album" /></label>
                    <div class="row">
                        <button class="btn small" @onclick="SaveFields" disabled="@(!FieldsChanged(t))">Queue edit</button>
                        @if (State.PendingFields(t.Id) is not null)
                        {
                            <button class="linkish" @onclick="() => UndoFields(t)">undo edit</button>
                        }
                    </div>

                    <div class="row stars" title="Rating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            int n = i;
                            var cur = State.PendingStars(t.Id) ?? t.Stars;
                            <button class="@(n <= cur ? "on" : "")" @onclick="() => State.SetRating(t, cur == n ? 0 : n)">★</button>
                        }
                    </div>
                }
                else
                {
                    <h3 style="margin-top:0">@t.Title</h3>
                    <div>@t.Artist</div>
                    <div class="muted">@t.Album</div>
                }

                <div class="kv">
                    <div>Time</div><div>@Time(t.LengthMs)</div>
                    <div>Format</div><div>@t.FileTypeDescription, @t.Bitrate kbps, @(t.SampleRate / 1000.0) kHz</div>
                    <div>Size</div><div>@Size(t.SizeBytes)</div>
                    <div>Plays</div><div>@t.PlayCount</div>
                    @if (!string.IsNullOrEmpty(t.AlbumArtist)) { <div>Album artist</div><div>@t.AlbumArtist</div> }
                    @if (!string.IsNullOrEmpty(t.Genre)) { <div>Genre</div><div>@t.Genre</div> }
                    <div>File</div><div class="mono">@t.RelativePath</div>
                </div>

                @if (State.CanWrite && !removing)
                {
                    <h3>Cover art</h3>
                    <div class="row">
                        @if (Pickers.Available)
                        {
                            <button class="btn small" @onclick="PickCover" disabled="@(!State.Backend.Capabilities.CanTranscode)">Choose image…</button>
                        }
                        @if (t.HasArtwork)
                        {
                            <button class="btn small" @onclick="() => State.RemoveArtwork(t)">Remove</button>
                        }
                    </div>
                    @if (!Pickers.Available)
                    {
                        <div class="row">
                            <input class="text-input grow" placeholder="Image or audio file path" @bind="_coverPath" />
                            <button class="btn small" @onclick="() => QueueCover(_coverPath)" disabled="@string.IsNullOrWhiteSpace(_coverPath)">Set</button>
                        </div>
                    }
                    <label class="check small"><input type="checkbox" @bind="_wholeAlbum" /> Apply to the whole album (@AlbumTracks(t).Count songs)</label>
                    @if (!State.Backend.Capabilities.CanTranscode)
                    {
                        <div class="muted small">Cover art needs ffmpeg, which wasn't found on this PC.</div>
                    }

                    <h3>Playlists</h3>
                    var targets = State.EffectivePlaylists().Where(v => !v.IsSmart && !v.IsPodcast).ToList();
                    var inLists = targets.Where(v => v.TrackIds.Contains(t.Id)).Select(v => v.Name).ToList();
                    <div class="small muted" style="margin-bottom:6px">@(inLists.Count == 0 ? "Not in any playlist" : "In: " + string.Join(", ", inLists))</div>
                    <div class="row">
                        <select class="text-input grow" @bind="_playlistKey">
                            <option value="">Add to playlist…</option>
                            @foreach (var v in targets.Where(v => !v.TrackIds.Contains(t.Id)))
                            {
                                <option value="@v.Key">@v.Name</option>
                            }
                        </select>
                        <button class="btn small" disabled="@string.IsNullOrEmpty(_playlistKey)" @onclick="() => AddToPlaylist(t)">Add</button>
                    </div>

                    <h3>Danger zone</h3>
                    @if (_confirmDelete)
                    {
                        <div class="confirm">
                            Delete “@t.Title” from the iPod? It is removed from every playlist. The audio file is left in place (harmless), and a backup is taken when you write.
                            <div class="row" style="margin-top:8px">
                                <button class="btn danger small" @onclick="() => { State.RemoveTrack(t); _confirmDelete = false; }">Queue delete</button>
                                <button class="btn small" @onclick="() => _confirmDelete = false">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button class="btn danger small" @onclick="() => _confirmDelete = true">Delete from iPod…</button>
                    }
                }
            }
            else
            {
                <div class="muted small">Select a song to see details@(State.CanWrite ? ", edit tags, set its rating or cover, or add it to a playlist" : "").</div>
            }
        </div>
    </div>
}

@code {
    private string _query = "";
    private string _filter = "all";
    private string _sort = "artist";
    private bool _desc;
    private uint? _selectedId;
    private string _title = "", _artist = "", _album = "";
    private string? _coverUrl;
    private string _coverPath = "";
    private bool _wholeAlbum;
    private string _playlistKey = "";
    private bool _confirmDelete;

    private Track? Selected => _selectedId is uint id ? State.TrackById(id) : null;
    private ItunesDatabase? _shownDb;

    // After a write the library is re-read: refresh the selected song's cover and fields.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ReferenceEquals(State.Db, _shownDb)) return;
        bool reload = _shownDb is not null;
        _shownDb = State.Db;
        if (reload && Selected is { } t) { await Select(t); StateHasChanged(); }
        else if (reload && _selectedId is not null) { _selectedId = null; StateHasChanged(); }
    }

    private List<Track>? _rowsCache;
    private string? _rowsKey;

    private List<Track> Rows
    {
        get
        {
            var db = State.Db!;
            string key = $"{db.GetHashCode()}|{_query}|{_filter}|{_sort}|{_desc}|{State.Pending.Count}";
            if (_rowsCache is not null && key == _rowsKey) return _rowsCache;
            IEnumerable<Track> q = db.Tracks;
            if (!string.IsNullOrWhiteSpace(_query))
            {
                var words = _query.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                q = q.Where(t => words.All(w =>
                    (t.Title?.Contains(w, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Artist?.Contains(w, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (t.Album?.Contains(w, StringComparison.OrdinalIgnoreCase) ?? false)));
            }
            q = _filter switch
            {
                "noart" => q.Where(t => !t.HasArtwork),
                "rated" => q.Where(t => t.Stars > 0),
                "pending" => q.Where(t => State.Pending.Any(p => p.Op.TrackId == t.Id || p.Op.TrackIds?.Contains(t.Id) == true)),
                _ => q,
            };
            q = _sort switch
            {
                "title" => Order(q, t => t.Title ?? ""),
                "album" => _desc ? q.OrderByDescending(t => t.Album ?? "", StringComparer.OrdinalIgnoreCase).ThenBy(t => t.DiscNumber).ThenBy(t => t.TrackNumber)
                                 : q.OrderBy(t => t.Album ?? "", StringComparer.OrdinalIgnoreCase).ThenBy(t => t.DiscNumber).ThenBy(t => t.TrackNumber),
                "time" => _desc ? q.OrderByDescending(t => t.LengthMs) : q.OrderBy(t => t.LengthMs),
                "rating" => _desc ? q.OrderBy(t => t.Stars) : q.OrderByDescending(t => t.Stars),
                _ => _desc ? q.OrderByDescending(t => t.Artist ?? "", StringComparer.OrdinalIgnoreCase).ThenBy(t => t.Album).ThenBy(t => t.TrackNumber)
                           : q.OrderBy(t => t.Artist ?? "", StringComparer.OrdinalIgnoreCase).ThenBy(t => t.Album ?? "", StringComparer.OrdinalIgnoreCase).ThenBy(t => t.DiscNumber).ThenBy(t => t.TrackNumber),
            };
            _rowsCache = q.ToList();
            _rowsKey = key;
            return _rowsCache;
        }
    }

    private IEnumerable<Track> Order(IEnumerable<Track> q, Func<Track, string> k) =>
        _desc ? q.OrderByDescending(k, StringComparer.OrdinalIgnoreCase) : q.OrderBy(k, StringComparer.OrdinalIgnoreCase);

    private void Sort(string col) { if (_sort == col) _desc = !_desc; else { _sort = col; _desc = false; } }
    private MarkupString Arrow(string col) => new(_sort == col ? (_desc ? "▾" : "▴") : "");

    private List<Track> AlbumTracks(Track t) => State.Db!.Tracks
        .Where(x => string.Equals(x.Album, t.Album, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(x.AlbumArtist ?? x.Artist, t.AlbumArtist ?? t.Artist, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private async Task Select(Track t)
    {
        _selectedId = t.Id;
        var f = State.PendingFields(t.Id);
        _title = f?.Title ?? t.Title ?? "";
        _artist = f?.Artist ?? t.Artist ?? "";
        _album = f?.Album ?? t.Album ?? "";
        _confirmDelete = false;
        _playlistKey = "";
        _coverUrl = null;
        if (t.HasArtwork && State.ActiveRoot is { } root)
        {
            uint id = t.Id;
            string? url = null;
            try { url = await State.Backend.GetArtworkDataUrlAsync(root, t.ArtworkId); } catch { }
            if (_selectedId == id) _coverUrl = url;
        }
    }

    private bool FieldsChanged(Track t)
    {
        var f = State.PendingFields(t.Id);
        return _title != (f?.Title ?? t.Title ?? "") || _artist != (f?.Artist ?? t.Artist ?? "") || _album != (f?.Album ?? t.Album ?? "");
    }

    private void SaveFields()
    {
        if (Selected is not { } t) return;
        if (string.IsNullOrWhiteSpace(_title)) { State.Error = "A song needs a title."; return; }
        State.SetTrackFields(t, _title.Trim(), _artist.Trim(), _album.Trim());
    }

    private void UndoFields(Track t)
    {
        State.SetTrackFields(t, t.Title ?? "", t.Artist ?? "", t.Album ?? "");
        _title = t.Title ?? ""; _artist = t.Artist ?? ""; _album = t.Album ?? "";
    }

    private async Task PickCover()
    {
        var files = await Pickers.PickFilesAsync(PickKind.Image, false);
        if (files.Count > 0) QueueCover(files[0]);
    }

    private void QueueCover(string path)
    {
        if (Selected is not { } t || string.IsNullOrWhiteSpace(path)) return;
        path = path.Trim().Trim('"');
        if (!File.Exists(path)) { State.Error = $"File not found: {path}"; return; }
        State.SetArtwork(_wholeAlbum ? AlbumTracks(t) : [t], path);
        _coverPath = "";
    }

    private void AddToPlaylist(Track t)
    {
        var v = State.EffectivePlaylists().FirstOrDefault(v => v.Key == _playlistKey);
        if (v is null) return;
        State.AddToPlaylist(v, [t.Id]);
        _playlistKey = "";
    }
}
