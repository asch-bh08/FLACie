@page "/"
@inherits StateComponent

<PageTitle>ipodsync</PageTitle>

<div class="shell">
    <header class="topbar">
        <span class="brand">ipodsync</span>
        <div class="device-picker">
            @if (State.Devices.Count > 0)
            {
                <select class="text-input" value="@State.ActiveRoot" @onchange="OnDeviceChanged" disabled="@State.Busy">
                    @foreach (var d in State.Devices)
                    {
                        <option value="@d.RootPath">@d.RootPath @(d.VolumeLabel) @(d.HasDatabase ? "" : "(no library)")</option>
                    }
                </select>
            }
            else
            {
                <span class="muted small">@(State.Scanning ? "Looking for iPods…" : "No iPod connected")</span>
            }
            <button class="btn small" @onclick="State.RefreshDevicesAsync" disabled="@(State.Scanning || State.Busy)" title="Look for iPods again">⟳</button>
        </div>

        <div class="chips">
            @if (State.Db is { } db)
            {
                <span class="chip">@db.Tracks.Count songs</span>
                <span class="chip">@db.Playlists.Count(p => !p.IsMaster) playlists</span>
                @if (State.ActiveDevice is { TotalBytes: > 0 } dev)
                {
                    <span class="chip @(dev.FreeBytes < 300L * 1024 * 1024 ? "warn" : "")">@Size(dev.FreeBytes) free</span>
                }
                @if (State.HealthLoading)
                {
                    <span class="chip">checking databases…</span>
                }
                else if (State.Health is { } h)
                {
                    <span class="chip @Cls(h.SignaturesValid)" title="@h.SignatureDetail">@Mark(h.SignaturesValid) signatures</span>
                    <span class="chip @Cls(h.DatabasesInSync)" title="@h.SyncDetail">@Mark(h.DatabasesInSync) databases</span>
                    <span class="chip @Cls(h.ArtworkOk)" title="@h.ArtworkDetail">@Mark(h.ArtworkOk) artwork</span>
                }
            }
        </div>
    </header>

    <div class="body">
        <nav class="nav">
            <button class="@Active(Tab.Library)" @onclick="() => _tab = Tab.Library">Library</button>
            <button class="@Active(Tab.Playlists)" @onclick="() => _tab = Tab.Playlists">Playlists</button>
            @if (State.CanWrite)
            {
                <button class="@Active(Tab.Add)" @onclick="() => _tab = Tab.Add">Add music</button>
                <button class="@Active(Tab.Sync)" @onclick="() => _tab = Tab.Sync">Sync a folder</button>
                <button class="@Active(Tab.Import)" @onclick="() => _tab = Tab.Import">Import playlist</button>
            }
            <div class="sep"></div>
            @if (State.CanWrite)
            {
                <button class="@Active(Tab.Changes)" @onclick="() => _tab = Tab.Changes">
                    Changes @if (State.Pending.Count > 0) { <span class="count">@State.Pending.Count</span> }
                </button>
                <button class="@Active(Tab.Backups)" @onclick="() => _tab = Tab.Backups">Backups</button>
            }
            <button class="@Active(Tab.Device)" @onclick="() => _tab = Tab.Device">Device health</button>
            <button class="@Active(Tab.Jellyfin)" @onclick="() => _tab = Tab.Jellyfin">Jellyfin</button>
        </nav>

        <main class="main">
            @if (_tab != Tab.Changes)
            {
                <ChangesBar OnReview="() => _tab = Tab.Changes" />
            }
            @if (State.Error is not null)
            {
                <div class="banner bad"><strong>Error</strong> — @State.Error <button class="linkish" @onclick="() => { State.Error = null; }">dismiss</button></div>
            }
            @if (!State.CanWrite && State.Backend.Capabilities.ReadOnlyReason is { } why)
            {
                <div class="banner warn">Read-only: @why</div>
            }

            @if (State.ActiveRoot is null && _tab is not (Tab.Jellyfin or Tab.Backups))
            {
                <div class="empty">
                    <div class="big">🎵</div>
                    @if (State.Backend.LoadNeedsUserAction && State.Devices.Count > 0)
                    {
                        <p>@State.Devices[0].VolumeLabel</p>
                        <button class="btn primary" @onclick="() => State.SelectDeviceAsync(State.Devices[0].RootPath)">Load library</button>
                    }
                    else
                    {
                        <p>@(State.Scanning ? "Looking for iPods…" : "Plug in an iPod (disk mode) and press ⟳.")</p>
                    }
                </div>
            }
            else if (State.Loading && State.Db is null)
            {
                <div class="empty"><p>Reading the library…</p></div>
            }
            else
            {
                @switch (_tab)
                {
                    case Tab.Library: <LibraryTab /> break;
                    case Tab.Playlists: <PlaylistsTab /> break;
                    case Tab.Add: <AddMusicTab /> break;
                    case Tab.Sync: <SyncFolderTab /> break;
                    case Tab.Import: <ImportPlaylistTab OnQueued="() => _tab = Tab.Changes" /> break;
                    case Tab.Changes: <ChangesPanel Wide="true" /> break;
                    case Tab.Backups: <BackupsTab /> break;
                    case Tab.Device: <DeviceTab /> break;
                    case Tab.Jellyfin: <JellyfinTab /> break;
                }
            }
        </main>
    </div>
</div>

@code {
    private enum Tab { Library, Playlists, Add, Sync, Import, Changes, Backups, Device, Jellyfin }
    private Tab _tab = Tab.Library;

    private string Active(Tab t) => _tab == t ? "active" : "";
    private static string Cls(bool? ok) => ok switch { true => "ok", false => "bad", _ => "" };
    private static string Mark(bool? ok) => ok switch { true => "✓", false => "✗", _ => "–" };

    protected override async Task OnInitializedAsync()
    {
        if (State.Devices.Count == 0) await State.RefreshDevicesAsync();
    }

    private async Task OnDeviceChanged(ChangeEventArgs e)
    {
        if (e.Value is string root && root.Length > 0) await State.SelectDeviceAsync(root);
    }
}
