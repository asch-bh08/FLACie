<!--
  Windows installer for the ipodsync app (IpodSync.Maui). Built by tools\build-installer.ps1:
  a self-contained publish (no .NET / Windows App SDK needed on the target) packed into a per-user MSI;
  installs to %LOCALAPPDATA%\Programs\ipodsync without admin rights, adds a Start menu shortcut, and
  upgrades in place (same UpgradeCode, MajorUpgrade). iPod backups live in Documents\ipodsync and are never
  touched by install/uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ipodsync" Manufacturer="ipodsync" Version="$(Version)" Scope="perUser"
           UpgradeCode="B480A45D-C957-4961-8E9C-6D1802B43BAC" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of ipodsync is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(PublishDir)\IpodSync.Maui.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ipodsync" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="AppShortcut" Name="ipodsync" Description="Sync classic iPods without iTunes"
                  Target="[INSTALLFOLDER]IpodSync.Maui.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ipodsync" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(PublishDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
